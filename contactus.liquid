          <textarea class="f-ta" id="body" name="contact[body]" placeholder="Tell us how we can help — the more detail, the better!" required></textarea>
          <span class="f-err">Please enter your message.</span>
        </div>
      </div>

      <!-- File upload (note: Shopify native contact form doesn't handle file uploads;
           for file uploads use a third-party form app like "Hulk Form Builder" or "EasyForms") -->
      <div class="f-grid f-full">
        <div>
          <div class="upload-zone" id="uploadZone" role="button" tabindex="0" aria-label="Upload a file">
