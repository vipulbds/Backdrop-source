// FILE UPLOAD
var uz=document.getElementById('uploadZone');
var fi=document.getElementById('fileIn');
var uf=document.getElementById('upFiles');
var files=[];
if(uz&&fi){
uz.addEventListener('click',function(){fi.click()});
uz.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' ')fi.click()});
uz.addEventListener('dragover',function(e){e.preventDefault();uz.classList.add('drag')});
uz.addEventListener('dragleave',function(){uz.classList.remove('drag')});
uz.addEventListener('drop',function(e){e.preventDefault();uz.classList.remove('drag');addFiles(e.dataTransfer.files)});
fi.addEventListener('change',function(){addFiles(fi.files)});
}
function addFiles(list){
  Array.from(list).forEach(function(f){
    if(f.size>10*1024*1024){alert(f.name+' exceeds 10 MB');return}
    files.push(f);
    var el=document.createElement('div');el.className='up-file';
    el.innerHTML='<span>&#128196; '+f.name+'</span><button type="button" onclick="rmFile(\''+f.name+'\',this)">&#10005;</button>';
    uf.appendChild(el);
  });
}
function rmFile(name,btn){files=files.filter(function(f){return f.name!==name});btn.closest('.up-file').remove()}

