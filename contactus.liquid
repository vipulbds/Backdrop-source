          </div>
          <p class="f-hint" style="text-align:center">File attachments require a Shopify form app (e.g. Hulk Form Builder).</p>
        </div>
      </div>

      <!-- Newsletter -->
      {%- if section.settings.show_newsletter -%}
      <div class="cb-row">
        <input type="checkbox" id="nl" name="contact[Newsletter Opt-in]" value="Yes"/>
        <label for="nl">{{ section.settings.newsletter_label | default: 'Subscribe me to the newsletter for new arrivals, photography tips &amp; exclusive deals.' }}</label>
      </div>
      {%- endif -%}

      <!-- Privacy -->
      <div class="cb-row">
        <input type="checkbox" id="priv" required/>
        <label for="priv">I agree to the <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}" target="_blank" rel="noopener">Privacy Policy</a> and consent to being contacted. <span class="req">*</span></label>
