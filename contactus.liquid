            </div>
          </div>
          <span class="f-err">Please enter your mobile number.</span>
        </div>
      </div>

      <!-- Business name -->
      <div class="f-grid f-full">
        <div class="field">
          <label for="biz">Business Name <span class="opt">(optional)</span></label>
          <input class="f-in" type="text" id="biz" name="contact[Business Name]" placeholder="Lumie re Co."/>
        </div>
      </div>

      <!-- Subject -->
      <div class="f-grid f-full">
        <div class="field" id="w-subject">
          <label for="subject">Subject <span class="req">*</span></label>
          <select class="f-sel" id="subject" name="contact[Subject]" required>
            <option value="" disabled selected>Select a topic…</option>
            <option value="Product Information">Product Information</option>
            <option value="Order Status / Tracking">Order Status / Tracking</option>
            <option value="Returns &amp; Refunds">Returns &amp; Refunds</option>
            <option value="Bulk / Wholesale Pricing">Bulk / Wholesale Pricing</option>
            <option value="Custom Size or Colour Request">Custom Size or Colour Request</option>
            <option value="Samples Request">Samples Request</option>
            <option value="Shipping Question">Shipping Question</option>
            <option value="Partnership / Collaboration">Partnership / Collaboration</option>
            <option value="Media / Press">Media / Press</option>
            <option value="Other">Other</option>
          </select>
          <span class="f-err">Please select a subject.</span>
        </div>
      </div>

      <!-- Order number (shown for "My Order") -->
      <div class="f-grid f-full" id="orderRow" style="display:none">
        <div class="field">
          <label for="orderNum">Order Number</label>
          <input class="f-in" type="text" id="orderNum" name="contact[Order Number]" placeholder="e.g. BS-00123"/>
