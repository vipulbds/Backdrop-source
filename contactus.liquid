        </div>
      </div>

      <!-- Product -->
      <div class="f-grid f-full">
        <div class="field">
          <label for="product">Backdrop / Product <span class="opt">(optional)</span></label>
          <input class="f-in" type="text" id="product" name="contact[Product]" placeholder="e.g. Muslin 5×7 Warm Ivory — SKU BS-MU-0045"/>
        </div>
      </div>

      <!-- Message — Shopify maps "contact[body]" to email body -->
      <div class="f-grid f-full">
        <div class="field" id="w-body">
