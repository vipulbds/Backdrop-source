  {% else %}
    {% assign first_image_url = product.featured_image | img_url: '580x' %}
  {% endif %}
  {% assign variant = product.selected_or_first_available_variant %}
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": "{{ product.title | escape }}",
  "image": "{{ first_image_url }}",
  "description": "{{ product.title | escape }}",
  "sku": "{{ variant.sku }}",
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": "USD",
    "price": "{{ variant.price | divided_by: 100.00 }}",
    "availability": "https://schema.org/InStock"
  }
}
</script>

<script>
  // Variants JSON (may NOT include featured media/image in many themes)
  window.productVariants = window.productVariants || {{ product.variants | json }};

  // ✅ Reliable map from Liquid: Variant ID -> Featured Media ID
  window.variantMediaMap = {
    {% for v in product.variants %}
      "{{ v.id }}": {% if v.featured_media %} "{{ v.featured_media.id }}" {% else %} null {% endif %}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

document.addEventListener("DOMContentLoaded", function() {
  const allVariants = window.productVariants || [];

  // -----------------------------
  // MAIN PRODUCT GALLERY
  // -----------------------------
  const containerMain = document.getElementById('main-product-gallery');
  const trackMain = document.getElementById('main-gallery-track');
  const itemsMain = document.querySelectorAll('.main-gallery-slide');
  const prevButtonMain = document.getElementById('main-gallery-prev-btn');
  const nextButtonMain = document.getElementById('main-gallery-next-btn');

  if (!containerMain || !trackMain || itemsMain.length === 0) return;

  if (itemsMain.length <= 1) {
    containerMain.classList.add('single-item');
    return;
  }

  const itemWidthMain = itemsMain[0].offsetWidth;
  let currentIndexMain = 0;

  function updateNavButtonsMain() {
    if (!prevButtonMain || !nextButtonMain) return;
    if (currentIndexMain === 0) prevButtonMain.classList.add('disabled');
    else prevButtonMain.classList.remove('disabled');

    if (currentIndexMain === itemsMain.length - 1) nextButtonMain.classList.add('disabled');
    else nextButtonMain.classList.remove('disabled');
  }

  function resetHiddenClasses() {
    trackMain.querySelectorAll('.hide').forEach(el => el.classList.remove('hide'));
  }

  function goToSlideMain(indexMain) {
    if (indexMain < 0 || indexMain >= itemsMain.length) return;
    resetHiddenClasses();
    trackMain.style.transform = `translateX(-${indexMain * itemWidthMain}px)`;
    currentIndexMain = indexMain;
    updateNavButtonsMain();
  }

  // ✅ expose globally so other scripts/apps can call it
  window.goToSlideMain = goToSlideMain;

  goToSlideMain(0);

  if (nextButtonMain) {
    nextButtonMain.addEventListener('click', () => {
      if (!nextButtonMain.classList.contains('disabled')) goToSlideMain(currentIndexMain + 1);
    });
  }
  if (prevButtonMain) {
    prevButtonMain.addEventListener('click', () => {
      if (!prevButtonMain.classList.contains('disabled')) goToSlideMain(currentIndexMain - 1);
    });
  }

  // -----------------------------
  // HELPERS
  // -----------------------------
  function normalizeMediaId(id) {
    if (!id) return null;
    const s = String(id);
    const m = s.match(/(\d+)\s*$/); // supports gid://.../123
    return m ? m[1] : s;
  }

  function normalizeImgUrl(url) {
    if (!url) return null;
    return String(url).split('?')[0].toLowerCase();
  }

  function syncCarouselToMedia(mediaId) {
    const wanted = normalizeMediaId(mediaId);
    if (!wanted) return false;

    for (let i = 0; i < itemsMain.length; i++) {
      // Your theme might store data-media-id either INSIDE or ON the slide
      const inside = itemsMain[i].querySelector('[data-media-id]');
      const slideAttr = itemsMain[i].getAttribute('data-media-id');

      const raw = (inside && inside.getAttribute('data-media-id')) || slideAttr || null;
      const slideMediaId = raw ? normalizeMediaId(raw) : null;

      if (slideMediaId && slideMediaId === wanted) {
        goToSlideMain(i);
        return true;
      }
    }
    return false;
  }

  // ✅ expose globally
  window.syncCarouselToMedia = syncCarouselToMedia;

  function syncCarouselToImageUrl(imgUrl) {
    const wanted = normalizeImgUrl(imgUrl);
    if (!wanted) return false;

    const wantedFile = wanted.split('/').pop();

    for (let i = 0; i < itemsMain.length; i++) {
      const img = itemsMain[i].querySelector('img');
      const src = img ? normalizeImgUrl(img.getAttribute('src') || img.getAttribute('data-src')) : null;
      if (!src) continue;

      const srcFile = src.split('/').pop();

      // Match by filename first (CDN differences), else contains
      if (wantedFile && srcFile && srcFile === wantedFile) {
        goToSlideMain(i);
        return true;
      }
      if (src.includes(wanted) || wanted.includes(src)) {
        goToSlideMain(i);
        return true;
      }
    }
    return false;
  }

  function syncByVariantId(variantId) {
    if (!variantId) return;

    // ✅ First: use Liquid map (most reliable)
    const mappedMedia = window.variantMediaMap ? window.variantMediaMap[String(variantId)] : null;
    if (mappedMedia) {
      if (syncCarouselToMedia(mappedMedia)) return;
      console.warn("[Gallery] Media found from Liquid map but slide not found. Check data-media-id in slides. media:", mappedMedia);
      return;
    }

    // Fallback: try from JSON
    const v = allVariants.find(x => String(x.id) === String(variantId));
    if (!v) {
      console.warn("[Gallery] Variant id not found in productVariants:", variantId);
      return;
    }

    const mediaId =
      (v.featured_media && v.featured_media.id) ||
      v.featured_media_id ||
      (v.featured_image && v.featured_image.id) ||
      null;

    if (mediaId && syncCarouselToMedia(mediaId)) return;

    const imgUrl =
      (v.featured_image && v.featured_image.src) ||
      (typeof v.featured_image === 'string' ? v.featured_image : null) ||
      null;

    if (imgUrl && syncCarouselToImageUrl(imgUrl)) return;

    console.warn("[Gallery] Variant matched but no media/image mapping found. Assign variant image in admin.", v);
  }

  // -----------------------------
  // READ CURRENT VARIANT ID (APO-safe)
  // -----------------------------
  function getVariantIdFromUrl() {
    try {
      const u = new URL(window.location.href);
      return u.searchParams.get('variant');
    } catch (e) {
      return null;
    }
  }

  function getVariantIdFromHiddenInput() {
    const el = document.querySelector('input[name="id"], select[name="id"]');
    return el ? el.value : null;
  }

  function getCurrentVariantId() {
    return getVariantIdFromHiddenInput() || getVariantIdFromUrl() || null;
  }

  // -----------------------------
  // APO HOOK: Listen to APO options (mw_opts)
  // -----------------------------
  function isApoOptionElement(el) {
    if (!el) return false;
    const name = el.getAttribute('name') || '';
    return name.startsWith('mw_opts');
  }

  function onOptionsPossiblyChanged() {
    setTimeout(() => {
      const vid = getCurrentVariantId();
      if (vid) {
        syncByVariantId(vid);
      }
    }, 80);
  }

  document.addEventListener('change', (e) => {
    if (isApoOptionElement(e.target)) onOptionsPossiblyChanged();
  });

  document.addEventListener('input', (e) => {
    if (isApoOptionElement(e.target)) onOptionsPossiblyChanged();
  });

  // also watch URL changes (APO often sets ?variant=xxxx)
  let lastUrlVariant = getVariantIdFromUrl();
  setInterval(() => {
    const current = getVariantIdFromUrl();
    if (current && current !== lastUrlVariant) {
      lastUrlVariant = current;
      syncByVariantId(current);
    }
  }, 200);

  // initial
  const initialVid = getCurrentVariantId();
  if (initialVid) syncByVariantId(initialVid);

  // -----------------------------
  // Thumbnail click (kept)
  // -----------------------------
  document.querySelectorAll('.thumbnailImg').forEach(thumbnail => {
    thumbnail.addEventListener('click', (event) => {
      const mediaId = event.currentTarget.dataset.mediaId;
      if (mediaId) syncCarouselToMedia(mediaId);
    });
  });

});
</script>

