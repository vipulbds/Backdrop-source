{%- comment -%} ── Hide the store header on BackdropSource Ads pages only ── {%- endcomment -%}
<script>
(function(){
  function hide(el){ if(el&&el.style) el.style.setProperty('display','none','important'); }
  function run(){
    var sec = document.querySelector('.section-sponsorship-landing,.section-owner-wizard,.section-sponsor-flow')
           || document.querySelector('[id^="bds-spn-"],[id^="bds-own-"],[id^="bds-spon-"]');
    if(!sec) return;                       // not an Ads page → leave the header alone
    var node = sec.closest('.shopify-section') || sec;
    while(node && node.tagName !== 'BODY'){ // climb to <body>, hiding everything above the section
      var p = node.previousElementSibling;
      while(p){ if(p.tagName!=='SCRIPT'&&p.tagName!=='STYLE'&&p.tagName!=='LINK') hide(p); p = p.previousElementSibling; }
      node = node.parentElement;
    }
  }
  run();
  document.addEventListener('DOMContentLoaded', run);
  setTimeout(run, 300); setTimeout(run, 800);
})();
</script>

