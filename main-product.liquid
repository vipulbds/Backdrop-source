  <script>
    (function () {
      function getMainSwiperWrapper(wrapper) {
        var all = Array.from(wrapper.querySelectorAll('.swiper-wrapper'));
        if (all.length === 0) return null;
        if (all.length === 1) return all[0];

        /* When multiple swipers exist, the main gallery has the widest slides.
         * Thumbnail strip slides are much narrower. */
        var widest = all[0];
        var widestW = 0;
        all.forEach(function (sw) {
          var slide = sw.querySelector('.swiper-slide');
          var w = slide ? slide.offsetWidth : 0;
          if (w > widestW) { widestW = w; widest = sw; }
        });
        /* Fall back to first-in-DOM if layout hasn't happened yet (all widths 0) */
        return widestW > 0 ? widest : all[0];
      }

      function fixGalleryFrames() {
        var wrapper = document.querySelector('.product__media-wrapper');
        if (!wrapper) return;

        var mainSwiper = getMainSwiperWrapper(wrapper);
        if (!mainSwiper) return;

        /* Fix aspect-ratio on any media container inside the main gallery.
         * Targets both inline --aspect-ratio and padding-bottom patterns. */
        mainSwiper.querySelectorAll('*').forEach(function (el) {
          var s = el.getAttribute('style') || '';
          var hasAR = s.indexOf('--aspect-ratio') !== -1;
          var hasPB = s.indexOf('padding-bottom') !== -1;
          var isMedia = el.classList.contains('product__media') || el.classList.contains('media');
          if (!hasAR && !hasPB && !isMedia) return;
          el.style.setProperty('padding-bottom', '0', 'important');
          el.style.setProperty('aspect-ratio', '1 / 1', 'important');
          el.style.setProperty('--aspect-ratio', '1', 'important');
          el.style.setProperty('height', 'auto', 'important');
          el.style.setProperty('position', 'relative', 'important');
          el.style.setProperty('overflow', 'hidden', 'important');
        });

        /* Ensure images fill the flex container (no absolute positioning —
           avoids Photoswipe disruption on close) */
        mainSwiper.querySelectorAll('img').forEach(function (img) {
          if (img.closest && img.closest('.pswp')) return;
          img.style.setProperty('display', 'block', 'important');
          img.style.setProperty('width', '100%', 'important');
          img.style.setProperty('height', '100%', 'important');
          img.style.setProperty('object-fit', 'contain', 'important');
          img.style.setProperty('object-position', 'center', 'important');
          /* Remove any Photoswipe inline overrides */
          img.style.removeProperty('position');
          img.style.removeProperty('top');
          img.style.removeProperty('left');
          img.style.removeProperty('transform');
          img.style.removeProperty('will-change');
          img.style.removeProperty('max-width');
        });
      }

      /* burstFix: re-applies fixGalleryFrames every 80ms for `durationMs`.
       * Photoswipe's close animation takes ~300-500ms and resets styles during
       * that window — a burst ensures we always win the race. */
      function burstFix(durationMs) {
        fixGalleryFrames(); // immediate first call
        var end = Date.now() + (durationMs || 2000);
        var timer = setInterval(function () {
          fixGalleryFrames();
          if (Date.now() >= end) clearInterval(timer);
        }, 80);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fixGalleryFrames);
      } else {
        fixGalleryFrames();
      }
      /* Re-run after carousel JS initialises slides at various breakpoints */
      setTimeout(fixGalleryFrames, 300);
      setTimeout(fixGalleryFrames, 800);
      setTimeout(fixGalleryFrames, 1500);

      /* ── Re-apply frames after Photoswipe lightbox closes ─────────────────
       * Photoswipe's close animation runs up to ~500ms and resets image styles
       * during that window. burstFix() fires every 80ms for 2s so we always
       * restore correct layout regardless of timing. */

      // Photoswipe v5 events fired on document
      document.addEventListener('pswp:close',      function () { burstFix(2000); });
      document.addEventListener('pswp:destroy',     function () { burstFix(2000); });
      document.addEventListener('photoswipe:close', function () { burstFix(2000); });

      // Watch for .pswp element losing pswp--open class (v4 / theme variants)
      var _pswpObs = new MutationObserver(function (mutations) {
        mutations.forEach(function (mut) {
          if (mut.type === 'attributes' && mut.attributeName === 'class') {
            var el = mut.target;
            if (el.classList && el.classList.contains('pswp') && !el.classList.contains('pswp--open')) {
              burstFix(2000);
            }
          }
          if (mut.type === 'childList') {
            mut.removedNodes.forEach(function (node) {
              if (node.classList && (node.classList.contains('pswp') || node.classList.contains('pswp__bg'))) {
                burstFix(2000);
              }
            });
          }
        });
      });
      _pswpObs.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });

      // Native <dialog> close (some themes)
      document.addEventListener('close', function (e) {
        if (e.target && (e.target.tagName === 'DIALOG' || (e.target.classList && e.target.classList.contains('pswp')))) {
          burstFix(2000);
        }
      }, true);
    })();
  </script>

  <script>
    /* ── Judge.me rating enlargement — JS override beats inline styles ── */
    (function () {
      function fixJudgeMe() {
        /* "4.69 out of 5" link */
        document.querySelectorAll('.jdgm-rev-widg__summary-text a.jdgm-link, a.jdgm-link[href*="judge.me/reviews"]').forEach(function (el) {
          el.setAttribute('style', 'font-size:42px!important;font-weight:700!important;line-height:1.1!important;text-decoration:underline!important');
        });
        /* Individual stars */
        document.querySelectorAll('.jdgm-rev-widg__summary-stars .jdgm-star').forEach(function (el) {
          el.setAttribute('style', 'font-size:28px!important;line-height:1!important;width:auto!important;height:auto!important');
        });
        /* "Based on X reviews" */
        document.querySelectorAll('.jdgm-rev-widg__summary-text').forEach(function (el) {
          if (!el.querySelector('a')) return;
          el.style.setProperty('font-size', '14px', 'important');
        });
      }
      fixJudgeMe();
      setTimeout(fixJudgeMe, 300);
      setTimeout(fixJudgeMe, 800);
      setTimeout(fixJudgeMe, 2000);
      new MutationObserver(fixJudgeMe).observe(document.body, { childList: true, subtree: true });
    })();
  </script>
