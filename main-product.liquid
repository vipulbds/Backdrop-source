{%- liquid
  assign media_layout = section.settings.gallery_layout | default: 'carousel'
  assign mobile_thumbnails = section.settings.mobile_thumbnails | default: 'hide'
  assign enable_image_zoom = section.settings.enable_image_zoom | default: false
  assign enable_sticky_info = section.settings.enable_sticky_info

  assign product_class = 'product--' | append: section.settings.media_size
  assign product_class = product_class | append: ' product--' | append: media_layout
  assign product_class = product_class | append: ' product--media-has-' | append: product.media.size
  if product.media.size > 1
    assign product_class = product_class | append: ' product--media-has-many'
  endif

  case media_layout
    when 'grid-mix'
      assign media_modulo = product.media.size | modulo: 3
      if media_modulo == 2
        assign product_class = product_class | append: ' product--odd-media'
      endif
  endcase

  assign current_variant = product.selected_or_first_available_variant
  assign show_percent_badge = false
  if current_variant.compare_at_price > current_variant.price
    assign show_percent_badge = true
    assign savings_amount = current_variant.compare_at_price | minus: current_variant.price
    assign percent_off = savings_amount | times: 100 | divided_by: current_variant.compare_at_price
  endif
-%}
<product-info
  id="MainProduct-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  class="section block section-{{ section.id }} section--padding page-width color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- assign has_models = product.media | where: 'media_type', 'model' | first -%}
  {%- if has_models -%}
    <link id="ModelViewerStyle" rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print" onload="this.media='all'">
    <link id="ModelViewerOverride" rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print" onload="this.media='all'">
  {%- endif -%}
  {%- if enable_image_zoom -%}
    <link id="Photoswipe" rel="stylesheet"
      href="{{ 'photoswipe-component.css' | asset_url }}"
      media="print" onload="this.media='all'">
  {%- endif -%}

  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>

  <style>
    /* Global Typography & Color Palette */
    :root {
      /* Font Sizes */
      --font-h1-desktop: 42px;
      --font-h1-mobile: 32px;
      --font-h2-desktop: 32px;
      --font-h2-mobile: 24px;
      --font-h3-desktop: 24px;
      --font-h3-mobile: 20px;
      --font-h4-desktop: 20px;
      --font-h4-mobile: 18px;
      --font-body-desktop: 16px;
      --font-body-mobile: 15px;
      --font-small-desktop: 14px;
      --font-small-mobile: 13px;
      --font-button-desktop: 16px;
      --font-button-mobile: 15px;
      --font-nav-desktop: 15px;
      --font-nav-mobile: 14px;

      /* Colors */
      --color-crimson: #B31942;
      --color-navy: #0A3161;
      --color-white: #FFFFFF;
      --color-off-white: #F5F6F8;
      --color-border-gray: #E0E4EE;
    }

    /* Base Styles (Mobile First) */
    .section-{{ section.id }} {
      background-color: var(--color-white) !important;
      color: var(--color-navy) !important;
    }

    .section-{{ section.id }} h1, .section-{{ section.id }} .h1,
    .section-{{ section.id }} h2, .section-{{ section.id }} .h2,
    .section-{{ section.id }} h3, .section-{{ section.id }} .h3,
    .section-{{ section.id }} h4, .section-{{ section.id }} .h4 { 
      color: var(--color-navy) !important;
    }

    .section-{{ section.id }} h1, .section-{{ section.id }} .h1 { font-size: var(--font-h1-mobile) !important; }
    .section-{{ section.id }} h2, .section-{{ section.id }} .h2 { font-size: var(--font-h2-mobile) !important; }
    .section-{{ section.id }} h3, .section-{{ section.id }} .h3 { font-size: var(--font-h3-mobile) !important; }
    .section-{{ section.id }} h4, .section-{{ section.id }} .h4 { font-size: var(--font-h4-mobile) !important; }
    
    .section-{{ section.id }},
    .section-{{ section.id }} p,
    .section-{{ section.id }} .rte,
    .section-{{ section.id }} .rte p,
    .section-{{ section.id }} .product__text,
    .section-{{ section.id }} .product__description-fullwidth,
    .section-{{ section.id }} .product__inventory-text,
    .section-{{ section.id }} .product__tax,
    .section-{{ section.id }} .font-body,
    .section-{{ section.id }} .volume-pricing-note { 
      font-size: var(--font-body-mobile) !important; 
      color: var(--color-navy) !important;
    }

    .section-{{ section.id }} .small-text,
    .section-{{ section.id }} .caption,
    .section-{{ section.id }} .product__text--caption,
    .section-{{ section.id }} .product__sku,
    .section-{{ section.id }} .product__inventory-stock-bar { 
      font-size: var(--font-small-mobile) !important; 
    }

    .section-{{ section.id }} .button,
    .section-{{ section.id }} .btn,
    .section-{{ section.id }} .product-form__submit,
    .section-{{ section.id }} .btn--underline,
    .section-{{ section.id }} .product-assembly-guide-btn span { 
      font-size: var(--font-button-mobile) !important; 
    }

    .section-{{ section.id }} .navigation__item,
    .section-{{ section.id }} .menu-drawer__menu-item,
    .section-{{ section.id }} .breadcrumb__link { 
      font-size: var(--font-nav-mobile) !important; 
      color: var(--color-navy) !important;
    }

    /* Desktop Styles */
    @media screen and (min-width: 750px) {
      .section-{{ section.id }} h1, .section-{{ section.id }} .h1 { font-size: var(--font-h1-desktop) !important; }
      .section-{{ section.id }} h2, .section-{{ section.id }} .h2 { font-size: var(--font-h2-desktop) !important; }
      .section-{{ section.id }} h3, .section-{{ section.id }} .h3 { font-size: var(--font-h3-desktop) !important; }
      .section-{{ section.id }} h4, .section-{{ section.id }} .h4 { font-size: var(--font-h4-desktop) !important; }
      
      .section-{{ section.id }},
      .section-{{ section.id }} p,
      .section-{{ section.id }} .rte,
      .section-{{ section.id }} .rte p,
      .section-{{ section.id }} .product__text,
      .section-{{ section.id }} .product__description-fullwidth,
      .section-{{ section.id }} .product__inventory-text,
      .section-{{ section.id }} .product__tax,
      .section-{{ section.id }} .font-body,
      .section-{{ section.id }} .volume-pricing-note { 
        font-size: var(--font-body-desktop) !important; 
      }

      .section-{{ section.id }} .small-text,
      .section-{{ section.id }} .caption,
      .section-{{ section.id }} .product__text--caption,
      .section-{{ section.id }} .product__sku,
      .section-{{ section.id }} .product__inventory-stock-bar { 
        font-size: var(--font-small-desktop) !important; 
      }

      .section-{{ section.id }} .button,
      .section-{{ section.id }} .btn,
      .section-{{ section.id }} .product-form__submit,
      .section-{{ section.id }} .btn--underline,
      .section-{{ section.id }} .product-assembly-guide-btn span { 
        font-size: var(--font-button-desktop) !important; 
      }

      .section-{{ section.id }} .navigation__item,
      .section-{{ section.id }} .menu-drawer__menu-item,
      .section-{{ section.id }} .breadcrumb__link { 
        font-size: var(--font-nav-desktop) !important; 
      }
    }

    .product__percent-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background-color: var(--color-crimson) !important;
      color: var(--color-white) !important;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      padding: 4px 10px;
      border-radius: 4px;
      line-height: 1;
      white-space: nowrap;
    }
    .product__badges-wrapper {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
      margin-bottom: 8px;
    }
    .product__percent-badge[data-percent-badge] {
      transition: opacity 0.2s ease;
    }

    /* Uniform Product Image Frames (1:1 Aspect Ratio) — flex approach so
       Photoswipe close animation cannot disrupt the layout */
    .product__media-wrapper .product__media,
    .product__media-wrapper .media,
    .product__media-wrapper [style*="--aspect-ratio"],
    .product__media-wrapper [style*="padding-bottom"] {
      aspect-ratio: 1 / 1 !important;
      --aspect-ratio: 1 !important;
      padding-bottom: 0 !important;
      height: auto !important;
      position: relative !important;
      overflow: hidden !important;
      width: 100% !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    /* Gallery images — fill the flex container without absolute positioning.
       Using width/height 100% on a flex child avoids Photoswipe disruption. */
    .product__media-wrapper .swiper-slide .product__media img,
    .product__media-wrapper .swiper-slide .media img,
    .product__media-wrapper .product__media > img,
    .product__media-wrapper .media > img {
      display: block !important;
      width: 100% !important;
      height: 100% !important;
      max-width: none !important;
      object-fit: contain !important;
      object-position: center !important;
      flex-shrink: 0 !important;
    }

    /* Restore thumbnail containers — covers thumb/thumbs/thumbnail AND nav/-nav patterns */
    .product__media-wrapper [class*="thumb"] .media,
    .product__media-wrapper [class*="thumb"] .product__media,
    .product__media-wrapper [class*="thumb"] [style*="--aspect-ratio"],
    .product__media-wrapper [class*="thumb"] [style*="padding-bottom"],
    .product__media-wrapper [class*="-nav"] .media,
    .product__media-wrapper [class*="-nav"] .product__media,
    .product__media-wrapper [class*="-nav"] [style*="--aspect-ratio"],
    .product__media-wrapper [class*="-nav"] [style*="padding-bottom"] {
      aspect-ratio: unset !important;
      --aspect-ratio: unset !important;
      padding-bottom: revert !important;
      height: unset !important;
      overflow: unset !important;
    }

    /* Thumbnail images — cover their small frame naturally */
    .product__media-wrapper [class*="thumb"] .media img,
    .product__media-wrapper [class*="thumb"] .product__media img,
    .product__media-wrapper [class*="-nav"] .media img,
    .product__media-wrapper [class*="-nav"] .product__media img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
    }

    /* Add to Cart Button Styling (Pill Shape & Brand Color) */
    .product-form__submit {
      background-color: var(--color-navy) !important; /* Navy Blue Brand Color */
      color: var(--color-white) !important;
      border: none !important;
      border-radius: 50px !important;
      padding: 15px 30px !important;
      font-weight: 700 !important;
      letter-spacing: 0.05em !important;
      text-transform: uppercase !important;
      transition: all 0.3s ease !important;
      cursor: pointer !important;
      width: 100% !important;
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      flex: 1 !important;
      min-width: 200px !important;
    }
    
    .product-form__submit:hover {
      background-color: var(--color-crimson) !important; /* Crimson Red Highlight on Hover */
      transform: translateY(-2px) !important;
      box-shadow: 0 5px 15px rgba(10, 49, 97, 0.2) !important;
    }    /* Standardized Layout: Qty + ATC on top, Shop Pay below */
    .product-form__buttons {
      display: flex !important;
      flex-wrap: wrap !important;
      flex-direction: row !important;
      align-items: center !important;
      gap: 12px !important;
      width: 100% !important;
    }

    quantity-input,
    .product-form__input--quantity {
      flex: 0 0 auto !important;
      width: 140px !important;
      margin: 0 !important;
    }

    .product-form__submit {
      flex: 1 !important;
      min-width: 180px !important;
      margin: 0 !important;
      border-radius: 50px !important;
    }

    .shopify-payment-button {
      flex: 0 0 100% !important; /* Force to new line */
      width: 100% !important;
      margin-top: 5px !important;
    }

    .shopify-payment-button__button--unbranded,
    .shopify-payment-button [data-testid="ShopPay-button"] {
      border-radius: 50px !important;
      padding: 15px 30px !important;
      font-weight: 700 !important;
      min-height: 54px !important;
      width: 100% !important;
    }

    @media (max-width: 768px) {
      .product-form__buttons {
        gap: 10px !important;
      }
      quantity-input,
      .product-form__input--quantity {
        width: 110px !important;
      }
      .product-form__submit {
        min-width: unset !important;
        padding: 12px 15px !important;
        font-size: 14px !important;
      }
    }

    /* Hide Redundant Add to Cart in Volume Discount Table */
    .hulkapps-volumes table th:nth-child(3),
    .hulkapps-volumes table td:nth-child(3),
    .hulkapps-volumes .hulkapps-volumes-item-add-to-cart,
    .hulkapps-volumes .add-to-cart-column {
      display: none !important;
    }

    /* Dividers and Borders */
    .section-{{ section.id }} .product__description-fullwidth {
      background-color: var(--color-off-white) !important;
      border: 1px solid var(--color-border-gray) !important;
    }
    .section-{{ section.id }} .product__block {
      border-bottom-color: var(--color-border-gray) !important;
    }

    /* Center and Style Utility Buttons */
    .section-{{ section.id }} .design-template-selector,
    .section-{{ section.id }} .setup-instruction,
    .section-{{ section.id }} .design-template-btn,
    .section-{{ section.id }} .btn-request-sample-image,
    .section-{{ section.id }} .product-assembly-guide-btn {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      text-align: center !important;
      width: 100% !important;
      margin: 10px 0 !important;
    }

    /* Icon With Text Alignment */
    .section-{{ section.id }} .icon-with-text--horizontal {
      display: flex !important;
      flex-wrap: wrap !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 15px !important;
      width: 100% !important;
      margin: 10px 0 !important;
      list-style: none !important;
      padding: 0 !important;
    }
    .section-{{ section.id }} .icon-with-text__item {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 8px !important;
      text-align: center !important;
      line-height: 1.2 !important;
    }
    .section-{{ section.id }} .icon-with-text__item svg,
    .section-{{ section.id }} .icon-with-text__item img {
      flex-shrink: 0 !important;
    }
    /* Addon Buttons Styling & Centering */
    .section-{{ section.id }} .product__block--addons {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 15px !important;
      width: 100% !important;
      margin: 15px 0 !important;
    }
    .section-{{ section.id }} .product__block--addons .btn {
      background-color: var(--color-off-white) !important;
      color: var(--color-navy) !important;
      border: 1px solid var(--color-border-gray) !important;
      padding: 8px 16px !important;
      border-radius: 8px !important;
      font-weight: 600 !important;
      font-size: 13px !important;
      transition: all 0.2s ease !important;
      display: flex !important;
      align-items: center !important;
      gap: 8px !important;
    }
    .section-{{ section.id }} .product__block--addons .btn:hover {
      background-color: var(--color-border-gray) !important;
      border-color: var(--color-navy) !important;
      transform: translateY(-1px) !important;
    }
    .section-{{ section.id }} .product__block--addons .btn svg {
      width: 16px !important;
      height: 16px !important;
    }

    /* ── Zero out block padding for title / SKU / reviews / price ── */
    .section-{{ section.id }} .product__block--title,
    .section-{{ section.id }} .product__block--sku,
    .section-{{ section.id }} .product__block--price,
    .section-{{ section.id }} .product__block--\@app {
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      border: none !important;
      outline: none !important;
      box-shadow: none !important;
    }

    /* ── Remove any border/box from the price container itself ── */
    .section-{{ section.id }} .product__block--price .f-price,
    .section-{{ section.id }} .product__block--price [class*="f-price"] {
      border: none !important;
      outline: none !important;
      box-shadow: none !important;
    }

    /* ── Title: tight line-height, no margin on heading tag ── */
    .section-{{ section.id }} .product__block--title h1,
    .section-{{ section.id }} .product__block--title h2,
    .section-{{ section.id }} .product__block--title .product__title {
      line-height: 1.1 !important;
      margin: 0 !important;
    }

    /* ── SKU: no paragraph margin ── */
    .section-{{ section.id }} .product__block--sku p,
    .section-{{ section.id }} .product__sku {
      margin: 0 !important;
      padding: 0 !important;
      line-height: 1.4 !important;
    }

    /* ── Reviews (@app block): collapse internal spacing ── */
    .section-{{ section.id }} .product__block--\@app > * {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }

    /* ── Price: layout ── */
    .section-{{ section.id }} .product__block--price .f-price {
      margin: 0 !important;
      line-height: 1.3 !important;
    }

    /* Compare-at (strikethrough) price — gray, visible */
    .section-{{ section.id }} .product__block--price .f-price__sale .f-price-item--regular,
    .section-{{ section.id }} .product__block--price .f-price__sale .f-price-item--regular s,
    .section-{{ section.id }} .product__block--price .f-price__sale .f-price-item--regular * {
      font-size: 1.4rem !important;
      font-weight: 400 !important;
      color: #9aa0ad !important;
      text-decoration: line-through !important;
    }

    /* Current sale price — navy, bold, large */
    .section-{{ section.id }} .product__block--price .f-price-item--sale {
      font-size: 22px !important;
      font-weight: 700 !important;
      color: var(--color-navy) !important;
    }

    /* Regular (no-sale) price — navy, bold, large */
    .section-{{ section.id }} .product__block--price .f-price__regular .f-price-item--regular {
      font-size: 22px !important;
      font-weight: 700 !important;
      color: var(--color-navy) !important;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }} .product__block--price .f-price-item--sale,
      .section-{{ section.id }} .product__block--price .f-price__regular .f-price-item--regular {
        font-size: 28px !important;
      }
      .section-{{ section.id }} .product__block--price .f-price__sale .f-price-item--regular,
      .section-{{ section.id }} .product__block--price .f-price__sale .f-price-item--regular s,
      .section-{{ section.id }} .product__block--price .f-price__sale .f-price-item--regular * {
        font-size: 2rem !important;
      }
    }

    /* ── Step picker — force bold on all key elements ── */
    .section-{{ section.id }} .pc-h {
      font-weight: 700 !important;
      font-size: 14px !important;
    }
    .section-{{ section.id }} .pr .pt {
      font-weight: 700 !important;
      font-size: 18px !important;
      color: var(--color-navy) !important;
    }
    .section-{{ section.id }} .uz-lbl {
      font-weight: 700 !important;
      font-size: 17px !important;
      color: var(--color-navy) !important;
      text-transform: capitalize !important;
      letter-spacing: .01em !important;
    }
    .section-{{ section.id }} .pf label {
      font-weight: 600 !important;
      font-size: 11px !important;
      text-transform: capitalize !important;
      letter-spacing: .04em !important;
    }
    .section-{{ section.id }} .cta {
      font-weight: 600 !important;
    }

    /* ── Row gaps between those 4 blocks — TIGHT stacked rhythm ── */
    .section-{{ section.id }} .product__block--title  { padding-bottom: 0 !important; }
    .section-{{ section.id }} .product__block--sku    { padding-top: 0 !important; padding-bottom: 0 !important; }
    .section-{{ section.id }} .product__block--\@app  { padding-top: 0 !important; padding-bottom: 0 !important; }
    .section-{{ section.id }} .product__block--price  { padding-top: 0 !important; padding-bottom: 0 !important; }

    /* ── Kill any inherited gap on the wrapper that contains all blocks ── */
    .section-{{ section.id }} .product__info-wrapper,
    .section-{{ section.id }} .product__info,
    .section-{{ section.id }} .product__details {
      gap: 0 !important;
      row-gap: 0 !important;
    }
    /* ── Belt-and-braces: every .product__block sits flush against its neighbours ── */
    .section-{{ section.id }} .product__block {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    /* ── Star rating widget: drop ALL internal margin/padding from Judge.me ── */
    .section-{{ section.id }} .product__block--\@app,
    .section-{{ section.id }} .product__block--\@app *,
    .section-{{ section.id }} .product__block--\@app .jdgm-rev-widg,
    .section-{{ section.id }} .product__block--\@app .jdgm-rev-widg__summary,
    .section-{{ section.id }} .product__block--\@app .jdgm-rev-widg__title,
    .section-{{ section.id }} .product__block--\@app .jdgm-rev-widg__summary-text,
    .section-{{ section.id }} .product__block--\@app .jdgm-rev-widg__summary-stars,
    .section-{{ section.id }} .product__block--\@app .jdgm-prev-badge,
    .section-{{ section.id }} .product__block--\@app .jdgm-widget {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }
    /* ── SKU block: zero margin top to sit flush under title ── */
    .section-{{ section.id }} .product__block--sku p,
    .section-{{ section.id }} .product__block--sku,
    .section-{{ section.id }} .product__sku {
      margin: 0 !important;
      padding: 0 !important;
    }

    /* ── Judge.me review widget — override section font-size resets ── */
    .section-{{ section.id }} .jdgm-rev-widg__summary-stars .jdgm-star {
      font-size: 28px !important;
      line-height: 1 !important;
      width: auto !important;
      height: auto !important;
    }
    .section-{{ section.id }} .jdgm-rev-widg__summary-text a.jdgm-link,
