  <script>
    (function () {
      const section = document.getElementById('MainProduct-{{ section.id }}');
      if (!section) return;
      function updatePercentBadge(variant) {
        let badge = section.querySelector('[data-percent-badge]');
        if (variant && variant.compare_at_price && variant.compare_at_price > variant.price) {
          const savings = variant.compare_at_price - variant.price;
          const percent = Math.round((savings / variant.compare_at_price) * 100);
          if (!badge) {
            const mediaWrapper = section.querySelector('.product__media-wrapper');
            if (mediaWrapper) {
              const newWrapper = document.createElement('div');
              newWrapper.className = 'product__badges-wrapper';
              newWrapper.style.cssText = 'position:absolute;top:12px;left:12px;z-index:10;';
              newWrapper.innerHTML = '<span class="product__percent-badge" data-percent-badge></span>';
              mediaWrapper.prepend(newWrapper);
              badge = newWrapper.querySelector('[data-percent-badge]');
            }
          }
          if (badge) {
            badge.textContent = percent + '% OFF';
            badge.style.display = '';
            if (badge.parentElement) badge.parentElement.style.display = '';
          }
        } else {
          if (badge) {
            badge.style.display = 'none';
            if (badge.parentElement) badge.parentElement.style.display = 'none';
          }
        }
      }
      section.addEventListener('variant:change', function (e) {
        if (e.detail && e.detail.variant) updatePercentBadge(e.detail.variant);
      });
      document.addEventListener('shopify:section:load', function () {
        updatePercentBadge({{ current_variant | json }});
      });
    })();
  </script>

