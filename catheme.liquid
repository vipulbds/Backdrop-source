<!doctype html>

{% if settings.enable_tz %}

  {% if settings.page_template contains page.template_suffix and page.template_suffix != ''  %}
      {% include 'tz_theme.liquid' %}
  {% elsif settings.product_template contains product.template_suffix and product.template_suffix != '' %}
      {% include 'tz_theme.liquid' %}
  {% elsif settings.collection_template contains collection.template_suffix and collection.template_suffix != '' %}
      {% include 'tz_theme.liquid' %}

  {% else %}
      {% include 'bds_theme.liquid' %}
  {% endif %}

{% else %}
{% include 'bds_theme.liquid' %}
{% endif %}

{% if settings.hide_content %}
{{content_for_header}}
{{content_for_layout}}
{% endif %}

