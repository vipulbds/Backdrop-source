  {% comment %}
    ════════════════════════════════════════════════════════════════════
    BACKDROPSOURCE — SPONSORSHIP LANDING  (Shopify 2.0 section)
    File: sections/sponsorship-landing.liquid
    ────────────────────────────────────────────────────────────────────
    Marketing entry page for the BackdropSource Ads sponsorship platform.
    Faithful conversion of backdropsource-ads-mockup (v4):

    - Optional top sub-nav  ·  Trust bar
    - Hero with dual CTAs (owner → lead modal · sponsor → scroll)
    - How it works (4 steps)
    - ROI calculator (4 sliders, green break-even insight)
    - Testimonials  ·  Sponsor logo MARQUEE
    - Before / After backdrop comparison (empty vs sponsor-filled)
    - Lazy 3D video  ·  CTA footer
    - Lead-capture MODAL (name / email / phone)

    PERFORMANCE
    - No icon-font CDN: icons are inline SVG (zero extra requests).
    - All CSS scoped under .bds-spon; JS scoped to {{ section.id }}.
    - Video iframe + library video load only on click (preload=none).
    - Marquee + insight are pure CSS / tiny vanilla JS.

    LEAD FORM
    - The modal posts to the "Lead form endpoint" (a Google Apps Script
      Web App URL). Leave blank to just show the success message (demo).
    ════════════════════════════════════════════════════════════════════
  {% endcomment %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
  <script src="{{ 'bds-forms.js' | asset_url }}" defer></script>

  {%- liquid
    assign sp = section.settings
    assign uid = section.id
  -%}

  <style>
  #shopify-section-{{ uid }} .bds-spon{
    --bds-accent: {{ sp.color_accent | default: '#C0395B' }};
    --bds-accent-dark: {{ sp.color_accent_dark | default: '#9e2e4a' }};
    --bds-accent-light: {{ sp.color_accent_light | default: '#e8708a' }};
    --bds-navy: {{ sp.color_navy | default: '#0F2554' }};
    --bds-navy-mid: {{ sp.color_navy_mid | default: '#1A3A7A' }};
    --bds-navy-deep: {{ sp.color_navy_deep | default: '#0D1F3C' }};
    --bds-green: {{ sp.color_green | default: '#5dca8a' }};
    --bds-white:#fff; --bds-off-white:#f8f7f4;
    --bds-gray-100:#f1efe8; --bds-gray-200:#e5e3dc;
    --bds-gray-500:#888780; --bds-gray-700:#444441; --bds-gray-900:#2c2c2a;
    --bds-r-sm:8px; --bds-r-md:12px; --bds-r-lg:16px;
    --bds-fd:'DM Serif Display', Georgia, serif;
    --bds-fb:'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  }
  .bds-spon,.bds-spon *,.bds-spon *::before,.bds-spon *::after{box-sizing:border-box}
  .bds-spon{font-family:var(--bds-fb);color:var(--bds-gray-900);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:clip;
    /* Full-bleed: break out of the theme's centred page container so the hero
      spans edge-to-edge and the left gutter is controlled by section padding. */
    width:auto;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw)}
  .bds-spon p{margin:0}
  .bds-spon h1,.bds-spon h2,.bds-spon h3,.bds-spon h4{margin:0;font-weight:400}
  .bds-spon a{text-decoration:none;color:inherit}
  .bds-spon button{font-family:inherit;cursor:pointer}
  .bds-spon img{max-width:100%;display:block}

  /* ── Buttons ── */
  .bds-spon .bds-btn{display:inline-flex;align-items:center;gap:8px;border:none;padding:14px 26px;border-radius:var(--bds-r-sm);font-size:15px;font-weight:500;font-family:var(--bds-fb);cursor:pointer;transition:background .2s,transform .15s,border-color .2s;line-height:1.2}
  .bds-spon .bds-btn--primary{background:var(--bds-accent);color:#fff}
  .bds-spon .bds-btn--primary:hover{background:var(--bds-accent-dark);transform:translateY(-1px)}
  .bds-spon .bds-btn--white{background:#fff;color:var(--bds-navy);font-weight:600}
  .bds-spon .bds-btn--white:hover{transform:translateY(-1px)}
  .bds-spon .bds-btn--ghost{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.3)}
  .bds-spon .bds-btn--ghost:hover{border-color:rgba(255,255,255,.6)}
  .bds-spon .bds-btn--sm{padding:10px 20px;font-size:13px;gap:6px}
  .bds-spon .bds-btn--sm svg{width:16px;height:16px}
  .bds-spon .bds-btn-ic{width:32px;height:32px;border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .bds-spon .bds-btn-ic svg{width:16px;height:16px}
  .bds-spon .bds-btn-tag{font-size:12px;opacity:.7;font-weight:400}

  /* ── Sub-nav ── */
  /* Transparent overlay on load (video shows through); navy background after scroll */
  .bds-spon .bds-nav{position:fixed;top:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;padding:16px 48px;background:transparent;flex-wrap:wrap;gap:12px;z-index:1000;transition:background .3s ease,box-shadow .3s ease,padding .25s ease}
  .bds-spon .bds-nav.is-scrolled{background:#fff;box-shadow:0 2px 14px rgba(0,0,0,.1);padding-top:12px;padding-bottom:12px}
  /* When scrolled (white bar), switch the logo + links to dark text */
  .bds-spon .bds-nav.is-scrolled .bds-nav-logo{color:var(--bds-gray-900)!important}
  .bds-spon .bds-nav.is-scrolled .bds-nav-logo svg{color:var(--bds-accent)!important}
  .bds-spon .bds-nav.is-scrolled .bds-nav-logo .ac{color:var(--bds-accent)!important}
  .bds-spon .bds-nav.is-scrolled .bds-nav-logo .pre{color:var(--bds-gray-500)!important}
  .bds-spon .bds-nav.is-scrolled .bds-nav-links a{color:var(--bds-gray-900)}
  .bds-spon .bds-nav.is-scrolled .bds-nav-links a:hover{color:#000}
  .bds-spon .bds-nav-logo{font-family:var(--bds-fd);font-size:22px;color:#fff!important;display:flex;align-items:center;gap:8px;text-decoration:none;opacity:1}
  .bds-spon .bds-nav-logo svg{width:22px;height:22px;color:var(--bds-accent-light)!important;flex-shrink:0}
  .bds-spon .bds-nav-logo-img{height:{{ sp.logo_img_h | default: 34 }}px;width:auto;max-width:240px;object-fit:contain;display:block}
  .bds-spon .bds-nav-logo .ac{color:var(--bds-accent-light)!important}
  .bds-spon .bds-nav-logo .pre{font-family:var(--bds-fb);font-size:13px;font-weight:600;color:rgba(255,255,255,.65)!important}
  .bds-spon .bds-nav-badge{font-size:12px;background:var(--bds-accent);color:#fff;padding:2px 8px;border-radius:4px;font-family:var(--bds-fb);font-weight:600;letter-spacing:.03em}
  .bds-spon .bds-nav-right{display:flex;align-items:center;gap:24px;flex-wrap:wrap;justify-content:flex-end}
  .bds-spon .bds-nav-links{display:flex;gap:26px;align-items:center}
  .bds-spon .bds-nav-links a{font-size:14px;font-weight:600;color:var(--bds-gray-900);transition:color .2s;cursor:pointer}
  .bds-spon .bds-nav-links a:hover{color:#000}
  .bds-spon .bds-nav-cta{background:var(--bds-accent);color:#fff;border:none;padding:10px 20px;border-radius:var(--bds-r-sm);font-size:14px;font-weight:500;display:inline-flex;align-items:center;gap:6px}
  .bds-spon .bds-nav-cta:hover{background:var(--bds-accent-dark)}
  .bds-spon .bds-nav-cta svg{width:14px;height:14px}

  /* ── Trust bar ── */
  .bds-spon .bds-trust{display:flex;align-items:center;gap:32px;padding:18px 48px;background:var(--bds-gray-100);flex-wrap:wrap;justify-content:center}
  .bds-spon .bds-trust-item{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--bds-gray-500);font-weight:500}
  .bds-spon .bds-trust-item svg{width:15px;height:15px;color:var(--bds-green);flex-shrink:0}

  /* ── Hero ── */
  /* Desktop hero is intentionally shorter than the viewport so the stats counter
   band below it is visible on first paint (no scroll needed). nav overlays the
   hero, so it adds no height; ~70vh hero + ~110px stats band fits in 100vh. */
.bds-spon .bds-hero{background:linear-gradient(135deg,var(--bds-navy) 0%,var(--bds-navy-mid) 55%,var(--bds-navy-deep) 100%);padding:104px 28px 56px;position:relative;overflow:hidden;display:flex;align-items:stretch;min-height:calc(100svh - 116px)}
  .bds-spon section{scroll-margin-top:78px}
  /* Turn-on-sound control for the hero background video */
  .bds-spon .bds-hero-audio{position:absolute;right:28px;bottom:24px;z-index:3;display:inline-flex;align-items:center;gap:8px;padding:9px 16px;border-radius:99px;border:1px solid rgba(255,255,255,.32);background:rgba(8,15,30,.45);backdrop-filter:blur(6px);color:#fff;font-size:13px;font-weight:500;cursor:pointer;transition:background .2s,border-color .2s}
  .bds-spon .bds-hero-audio:hover{background:rgba(8,15,30,.72);border-color:rgba(255,255,255,.6)}
  .bds-spon .bds-hero-audio svg{width:16px;height:16px;flex-shrink:0}
  /* Mobile/tablet: the sound toggle sits at the top-right OVER the video banner (the hero stacks) */
  @media(max-width:768px){ .bds-spon .bds-hero-audio{top:74px;bottom:auto;right:14px;padding:7px 12px;font-size:12px} }
  .bds-spon .bds-hero::before{content:'';position:absolute;top:-120px;right:-80px;width:480px;height:480px;background:radial-gradient(circle,rgba(192,57,91,.15) 0%,transparent 70%);pointer-events:none}
  .bds-spon .bds-hero::after{content:'';position:absolute;bottom:-60px;left:-60px;width:360px;height:360px;background:radial-gradient(circle,rgba(0,36,125,.4) 0%,transparent 70%);pointer-events:none}
  .bds-spon .bds-hero-inner{position:relative;z-index:2;max-width:1120px;margin:0 auto;width:100%;display:flex;flex-direction:column;justify-content:flex-start}
  .bds-spon .bds-hero-content{margin-top:clamp(10px,7vh,80px)}
  .bds-spon .bds-hero-cta{margin-top:auto;width:100%;max-width:560px}
  .bds-spon .bds-eyebrow{display:inline-flex;align-items:center;gap:8px;background:rgba(192,57,91,.15);border:1px solid rgba(192,57,91,.35);padding:6px 14px;border-radius:20px;margin-bottom:16px}
  .bds-spon .bds-eyebrow span{font-size:12px;color:var(--bds-accent-light);font-weight:500;letter-spacing:.03em}
  .bds-spon .bds-pulse{width:7px;height:7px;background:var(--bds-accent);border-radius:50%;animation:bdsPulse 1.8s ease-in-out infinite;flex-shrink:0}
  @keyframes bdsPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.4)}}
  .bds-spon .bds-hero h1{font-family:var(--bds-fd);font-size:clamp(32px,4.6vw,48px);color:#fff;line-height:1.12;margin-bottom:14px;max-width:600px}
  .bds-spon .bds-hero h1 em{color:var(--bds-accent-light);font-style:normal}
  .bds-spon .bds-hero-sub{font-size:16px;color:rgba(255,255,255,.6);max-width:480px;line-height:1.6;margin-bottom:22px}
  .bds-spon .bds-iam{font-size:13px;color:rgba(255,255,255,.4);font-weight:500;text-transform:uppercase;letter-spacing:.08em;margin-bottom:12px}
  /* Hero FULL-BLEED background video — heading + CTA overlaid on top (agencytbi style) */
  .bds-spon .bds-hero-bg{position:absolute;inset:0;z-index:0;overflow:hidden;background:#0A1628 center/cover no-repeat}
  /* Desktop: video FILLS the hero edge-to-edge (cover). Supply a ~2:1 video so nothing is cropped. */
  .bds-spon .bds-hero-bg video{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:100%;height:100%;object-fit:cover;pointer-events:none}
  /* Embedded iframe (YouTube/Vimeo): scale to fully cover the hero (no letterboxing) */
  .bds-spon .bds-hero-bg.is-embed iframe{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:100vw;height:56.25vw;min-width:177.78vh;min-height:100vh;border:0;pointer-events:none}
/* Mobile-specific hero video: hidden on desktop. Only rendered when the owner
   uploads one — otherwise the desktop video is reused on mobile too. */
.bds-spon .bds-hero-bg--mob{display:none}
  .bds-spon .bds-hero-scrim{position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(8,15,30,.9) 0%,rgba(8,15,30,.7) 34%,rgba(8,15,30,.2) 66%,transparent 100%),linear-gradient(0deg,rgba(8,15,30,.55) 0%,transparent 42%)}
  .bds-spon .bds-hero-content{max-width:560px}
  .bds-spon .bds-hero h1{max-width:560px}
  .bds-spon .bds-hero-sub{max-width:520px}
  .bds-spon .bds-hero-btns{display:flex;gap:14px;flex-wrap:wrap;margin:28px 0 0;align-items:stretch;max-width:560px}
  .bds-spon .bds-hero-btns .bds-btn{flex:1 1 240px;min-width:0;min-height:52px;align-items:center;justify-content:center;margin:0}
  /* Mobile: keep BOTH buttons on a single row, compact (icon + label, no tag) */
  @media(max-width:560px){
    .bds-spon .bds-hero-btns{gap:10px;flex-wrap:nowrap;margin-top:20px}
    .bds-spon .bds-hero-btns .bds-btn{flex:1 1 0;min-height:0;padding:11px 8px;font-size:13px;gap:7px;line-height:1.25}
    .bds-spon .bds-hero-btns .bds-btn-tag{display:none}
    .bds-spon .bds-hero-btns .bds-btn-ic{width:26px;height:26px}
    .bds-spon .bds-hero-btns .bds-btn-ic svg{width:14px;height:14px}
  }
  .bds-spon .bds-stats{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid rgba(255,255,255,.14);border-radius:var(--bds-r-md);overflow:hidden;background:rgba(13,31,60,.45);backdrop-filter:blur(6px);margin-top:26px;max-width:600px}
  .bds-spon .bds-stat-figure{display:inline-block}
  @media(max-width:768px){
    /* Stacked mobile hero: the video shows in FULL (uncropped 16:9 banner) at the top,
      then the heading + CTA sit below it on the gradient — no cover-crop / zoom. */
    .bds-spon .bds-hero{display:block;height:auto;max-height:none;min-height:auto;padding:64px 0 0;overflow:visible}
    .bds-spon .bds-hero-bg{position:relative;inset:auto;width:100%;aspect-ratio:16/9;height:auto}
    .bds-spon .bds-hero-bg video{top:0;left:0;transform:none;width:100%;height:100%;object-fit:cover}
    .bds-spon .bds-hero-bg.is-embed iframe{top:0;left:0;transform:none;width:100%;height:100%;min-width:0;min-height:0}
    .bds-spon .bds-hero-scrim{display:none}
    .bds-spon .bds-hero-inner{padding:24px 18px 34px}
    .bds-spon .bds-hero-content{margin-top:0}
    .bds-spon .bds-hero-cta{margin-top:20px}
    /* Swap to the mobile video when one was uploaded (else the desktop one stays). */
    .bds-spon .bds-hero-bg--mob{display:block}
    .bds-spon .bds-hero.has-mobvid .bds-hero-bg--desk{display:none}
  }
  .bds-spon .bds-stat{padding:13px 12px;text-align:center;border-right:1px solid rgba(255,255,255,.07)}
  .bds-spon .bds-stat:last-child{border-right:none}
  .bds-spon .bds-stat-num{font-size:18px;font-weight:600;color:#fff;display:flex;align-items:center;justify-content:center;gap:6px;flex-wrap:wrap}
  .bds-spon .bds-stat-badge{display:inline-block;background:rgba(93,202,138,.2);color:var(--bds-green);font-size:9px;font-weight:500;padding:1px 6px;border-radius:10px}
  .bds-spon .bds-stat-label{font-size:10.5px;color:rgba(255,255,255,.4);margin-top:2px;line-height:1.3}
  /* Hero bar — full-width counters band directly below the video */
  .bds-spon .bds-herobar{background:var(--bds-navy-deep)}
  .bds-spon .bds-herobar .bds-stats{margin:0;width:100%;max-width:none;border-radius:0;border-left:0;border-right:0;background:transparent;backdrop-filter:none}
  .bds-spon .bds-herobar .bds-stat{padding:26px 20px}
  .bds-spon .bds-herobar .bds-stat-num{font-size:clamp(22px,2.6vw,32px);gap:8px}
  .bds-spon .bds-herobar .bds-stat-label{font-size:clamp(11px,1vw,13px);margin-top:4px}
  .bds-spon .bds-herobar .bds-stat-badge{font-size:10px;padding:2px 8px}
  @media(max-width:560px){ .bds-spon .bds-herobar .bds-stat{padding:18px 12px} }

  /* ── Section commons ── */
  .bds-spon .bds-section{padding:48px 48px;max-width:1180px;margin:0 auto}
  .bds-spon .bds-section--alt{background:var(--bds-off-white);max-width:none}
  .bds-spon .bds-section--alt > .bds-sec-inner{max-width:1180px;margin:0 auto}
  .bds-spon .bds-label{font-size:12px;font-weight:600;color:var(--bds-accent);text-transform:uppercase;letter-spacing:.1em;margin-bottom:12px;text-align:center}
  .bds-spon .bds-title{font-family:var(--bds-fd);font-size:clamp(28px,3.6vw,36px);color:var(--bds-gray-900);margin-bottom:12px;line-height:1.2;text-align:center}
  .bds-spon .bds-sub{font-size:16px;color:var(--bds-gray-500);max-width:680px;line-height:1.65;margin:0 auto 36px;text-align:center}

  /* ── How it works ── */
  .bds-spon .bds-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
  .bds-spon .bds-step{position:relative;background:#fff;border:1px solid var(--bds-gray-200);border-radius:var(--bds-r-lg);padding:26px 24px;text-align:left;display:flex;flex-direction:column;gap:11px;transition:box-shadow .2s,transform .2s,border-color .2s}
  .bds-spon .bds-step:hover{box-shadow:0 8px 26px rgba(0,0,0,.07);transform:translateY(-3px);border-color:#d8d5cc}
  .bds-spon .bds-step-num{width:42px;height:42px;border-radius:11px;background:var(--bds-accent);color:#fff;display:flex;align-items:center;justify-content:center;font-family:var(--bds-fd);font-size:19px;line-height:1;flex-shrink:0}
  .bds-spon .bds-step-title{font-size:16px;font-weight:700;color:var(--bds-gray-900);line-height:1.3}
  .bds-spon .bds-step-body{font-size:16px;color:var(--bds-gray-500);line-height:1.65}
  @media (max-width:860px){.bds-spon .bds-steps{grid-template-columns:repeat(2,1fr)}}
  @media (max-width:540px){.bds-spon .bds-steps{grid-template-columns:1fr}}

  /* ── ROI calculator ── */
  .bds-spon .bds-roi{display:grid;grid-template-columns:1fr 1fr;gap:24px}
  .bds-spon .bds-roi-controls{background:#fff;border:1px solid rgba(0,0,0,.1);border-radius:var(--bds-r-lg);padding:28px}
  .bds-spon .bds-roi-results{background:var(--bds-navy);border-radius:var(--bds-r-lg);padding:28px;position:relative;display:flex;flex-direction:column}
  /* Semicircular "% covered" gauge (reference look) */
  .bds-spon .bds-roi-gauge{position:relative;width:300px;max-width:100%;height:170px;margin:6px auto 4px}
  .bds-spon .bds-roi-gauge svg{width:100%;height:100%;overflow:visible}
  .bds-spon .bds-roi-gauge svg [data-gauge]{transition:stroke-dasharray .35s cubic-bezier(.4,0,.2,1)}
  .bds-spon .bds-roi-gauge-c{position:absolute;left:0;right:0;bottom:2px;text-align:center}
  .bds-spon .bds-roi-gauge-c .v{font-family:var(--bds-fd);font-size:50px;color:#fff;line-height:1;font-variant-numeric:tabular-nums}
  .bds-spon .bds-roi-gauge-c .l{font-size:13px;color:rgba(255,255,255,.45);margin-top:6px}
  /* Left controls card: eyebrow + live-update footer (wireframe) */
  .bds-spon .bds-roi-ctrl-eyebrow{font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--bds-gray-500);margin-bottom:24px}
  .bds-spon .bds-roi-ctrl-foot{display:flex;align-items:center;gap:9px;font-size:13px;color:var(--bds-gray-500);margin-top:6px;padding-top:18px;border-top:1px solid var(--bds-gray-200)}
  .bds-spon .bds-roi-ctrl-foot i{width:8px;height:8px;border-radius:50%;background:var(--bds-green);flex-shrink:0}
  /* Right results card: top investment line + two stat cards (wireframe) */
  .bds-spon .bds-roi-top{display:flex;align-items:baseline;gap:7px;flex-wrap:wrap;margin-bottom:2px}
  .bds-spon .bds-roi-top-l{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.5)}
  .bds-spon .bds-roi-top-sep{color:rgba(255,255,255,.4)}
  .bds-spon .bds-roi-top-v{font-size:15px;font-weight:700;color:#fff;font-variant-numeric:tabular-nums}
  .bds-spon .bds-roi-cards{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:8px}
  .bds-spon .bds-roi-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:var(--bds-r-md);padding:18px}
  .bds-spon .bds-roi-card-l{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:rgba(255,255,255,.5);margin-bottom:10px}
  .bds-spon .bds-roi-card-v{font-family:var(--bds-fd);font-size:clamp(24px,2.8vw,33px);line-height:1;color:#fff;font-variant-numeric:tabular-nums}
  .bds-spon .bds-roi-card-v.is-green{color:var(--bds-green)}
  .bds-spon .bds-roi-card-v.is-amber{color:#fff}
  .bds-spon .bds-roi-card-s{font-size:12px;color:rgba(255,255,255,.4);margin-top:9px}
  .bds-spon .bds-slider{margin-bottom:22px}
  .bds-spon .bds-slider-lbl{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
  .bds-spon .bds-slider-lbl span:first-child{font-size:13px;color:var(--bds-gray-500);font-weight:500}
  .bds-spon .bds-slider-val{font-size:14px;font-weight:600;color:var(--bds-gray-900);background:var(--bds-gray-100);padding:3px 12px;border-radius:6px}
  .bds-spon input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:8px;border-radius:99px;background:var(--bds-gray-200);outline:none;cursor:pointer;margin:14px 0}
  .bds-spon input[type=range]::-webkit-slider-runnable-track{height:8px;border-radius:99px;background:transparent}
  .bds-spon input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;margin-top:-7px;width:22px;height:22px;border-radius:50%;background:var(--bds-accent);border:3px solid #fff;box-shadow:0 2px 8px rgba(192,57,91,.45),0 0 0 1px rgba(0,0,0,.05);cursor:grab;transition:transform .15s ease,box-shadow .15s ease}
  .bds-spon input[type=range]:hover::-webkit-slider-thumb{transform:scale(1.12);box-shadow:0 3px 12px rgba(192,57,91,.55),0 0 0 6px rgba(192,57,91,.14)}
  .bds-spon input[type=range]:active::-webkit-slider-thumb{cursor:grabbing;box-shadow:0 2px 8px rgba(192,57,91,.5),0 0 0 8px rgba(192,57,91,.18)}
  .bds-spon input[type=range]:focus-visible::-webkit-slider-thumb{box-shadow:0 2px 8px rgba(192,57,91,.45),0 0 0 6px rgba(192,57,91,.22)}
  .bds-spon input[type=range]::-moz-range-track{height:8px;border-radius:99px;background:var(--bds-gray-200)}
  .bds-spon input[type=range]::-moz-range-progress{height:8px;border-radius:99px;background:var(--bds-accent)}
  .bds-spon input[type=range]::-moz-range-thumb{width:22px;height:22px;border-radius:50%;background:var(--bds-accent);border:3px solid #fff;box-shadow:0 2px 8px rgba(192,57,91,.45);cursor:grab;transition:transform .15s ease}
  .bds-spon input[type=range]:hover::-moz-range-thumb{transform:scale(1.12)}
  .bds-spon input[type=range]:active::-moz-range-thumb{cursor:grabbing}
  .bds-spon .bds-roi-figures{flex:1;display:flex;flex-direction:column;justify-content:center}
  /* Result rows: label/content on the left, value on the right */
  .bds-spon .bds-roi-row{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:18px 0;border-bottom:1px solid rgba(255,255,255,.08)}
  .bds-spon .bds-roi-row:last-child{border-bottom:none}
  .bds-spon .bds-roi-rowl{display:flex;flex-direction:column;gap:5px;min-width:0}
  .bds-spon .bds-roi-rowlbl{font-size:11px;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.07em;font-weight:600}
  .bds-spon .bds-roi-rowsub{font-size:11px;color:rgba(255,255,255,.32);line-height:1.4}
  .bds-spon .bds-roi-statrow{display:flex;justify-content:space-between;align-items:center;padding:0 0 18px;border-bottom:1px solid rgba(255,255,255,.08)}
  .bds-spon .bds-roi-statlbl{font-size:11px;color:rgba(255,255,255,.45);text-transform:uppercase;letter-spacing:.06em}
  .bds-spon .bds-roi-statval{font-family:var(--bds-fd);font-size:26px;color:rgba(255,255,255,.9);font-variant-numeric:tabular-nums;white-space:nowrap}
  .bds-spon .bds-slider-val{font-variant-numeric:tabular-nums}
  .bds-spon .bds-roi-split{display:grid;grid-template-columns:1fr 1fr}
  .bds-spon .bds-roi-cell{padding:18px 0;display:flex;flex-direction:column;gap:6px}
  .bds-spon .bds-roi-cell:first-child{padding-right:18px;border-right:1px solid rgba(255,255,255,.08)}
  .bds-spon .bds-roi-cell:last-child{padding-left:18px}
  .bds-spon .bds-roi-celllbl{font-size:11px;color:rgba(255,255,255,.45);text-transform:uppercase;letter-spacing:.06em}
  .bds-spon .bds-roi-cellval{font-family:var(--bds-fd);font-size:clamp(22px,2.3vw,28px);color:#fff;line-height:1.1;font-variant-numeric:tabular-nums;white-space:nowrap}
  .bds-spon .bds-roi-cellval.is-green{color:var(--bds-green)}
  .bds-spon .bds-roi-cellval.is-amber{color:#fbbf24}
  .bds-spon .bds-roi-cellsub{font-size:11px;color:rgba(255,255,255,.3);line-height:1.4}
  .bds-spon .bds-roi-cta{width:100%;margin-top:auto;background:var(--bds-accent);color:#fff;border:none;padding:14px;border-radius:var(--bds-r-sm);font-size:14px;font-weight:500}
  .bds-spon .bds-roi-cta-wrap{padding-top:22px;margin-top:auto}
  .bds-spon .bds-roi-cta:hover{background:var(--bds-accent-dark)}
  .bds-spon .bds-roi-dots{position:absolute;top:16px;right:16px;display:flex;gap:6px}
  .bds-spon .bds-roi-dots i{width:7px;height:7px;background:rgba(255,255,255,.15);border-radius:50%}

  /* ── Owner Analytics ── */
  .bds-spon .an-wrap{position:relative;background:linear-gradient(135deg,#0a1628 0%,#0f2554 45%,#0a1628 100%);overflow:hidden;padding:76px 48px}
  .bds-spon .an-canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:0;opacity:.7}
  .bds-spon .an-inner{position:relative;z-index:1;max-width:1140px;margin:0 auto}
  .bds-spon .an-label{font-size:11px;font-weight:600;color:var(--bds-accent-light);text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px;display:flex;align-items:center;gap:8px}
  .bds-spon .an-label::before{content:'';width:22px;height:2px;background:var(--bds-accent);border-radius:2px;flex-shrink:0}
  .bds-spon .an-title{font-family:var(--bds-fd);font-size:clamp(26px,3vw,40px);color:#fff;line-height:1.12;margin-bottom:10px}
  .bds-spon .an-title em{font-style:italic;color:var(--bds-accent)}
  .bds-spon .an-sub{font-size:15px;color:rgba(255,255,255,.55);line-height:1.7;margin-bottom:34px;max-width:560px}
  .bds-spon .an-grid{display:grid;grid-template-columns:1fr 420px;gap:64px;align-items:center}
  .bds-spon .an-flag{display:inline-flex;align-items:center;gap:7px;background:rgba(192,57,91,.08);border:.5px solid rgba(192,57,91,.22);padding:5px 13px;border-radius:20px;margin-bottom:20px}
  .bds-spon .an-flag span{font-size:11px;color:var(--bds-accent);font-weight:500}
  .bds-spon .an-pulse{width:6px;height:6px;background:var(--bds-accent);border-radius:50%;animation:bdsPulse 1.8s ease-in-out infinite;flex-shrink:0}
  .bds-spon .an-h{font-family:var(--bds-fd);font-size:clamp(22px,2.6vw,32px);color:#fff;line-height:1.18;margin-bottom:10px}
  .bds-spon .an-h em{font-style:italic;color:var(--bds-accent)}
  .bds-spon .an-p{font-size:14px;color:rgba(255,255,255,.52);line-height:1.75;margin-bottom:26px;max-width:430px}
  .bds-spon .an-p a{color:var(--bds-accent-light);font-weight:600;text-decoration:underline;text-underline-offset:3px}
  .bds-spon .an-tag{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.06);border:.5px solid rgba(255,255,255,.14);padding:6px 14px;border-radius:20px;font-size:11px;font-weight:600;color:rgba(255,255,255,.7);margin-bottom:18px}
  .bds-spon .an-tag::before{content:'✦';font-size:9px;color:var(--bds-accent)}
  .bds-spon .an-list{list-style:none;display:flex;flex-direction:column;margin:0 0 30px;padding:0}
  .bds-spon .an-list li{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:500;color:rgba(255,255,255,.75);padding:11px 0;border-bottom:.5px solid rgba(255,255,255,.08)}
  .bds-spon .an-list li:first-child{border-top:.5px solid rgba(255,255,255,.08)}
  .bds-spon .an-list li::before{content:'✓';color:var(--bds-accent);font-weight:600;font-size:13px;flex-shrink:0}
  .bds-spon .an-cta{display:inline-flex;align-items:center;gap:7px;padding:13px 26px;border-radius:var(--bds-r-sm);background:var(--bds-accent);color:#fff;font-size:14px;font-weight:500;border:none;cursor:pointer;transition:background .2s,transform .15s}
  .bds-spon .an-cta:hover{background:var(--bds-accent-dark);transform:translateY(-2px)}
  /* phone mockup */
  .bds-spon .an-phone-col{display:flex;justify-content:center}
  .bds-spon .an-phone-glow{position:relative;display:inline-block}
  .bds-spon .an-phone-glow::before{content:'';position:absolute;inset:-18px;border-radius:52px;background:radial-gradient(ellipse at 40% 30%,rgba(192,57,91,.13) 0%,rgba(15,37,84,.07) 55%,transparent 100%);z-index:0;pointer-events:none}
  .bds-spon .an-phone{position:relative;z-index:1;background:linear-gradient(160deg,#1e3068,#111d45);border-radius:50px;padding:15px;width:300px;max-width:100%;box-shadow:0 2px 0 rgba(255,255,255,.14) inset,0 0 0 1.5px rgba(255,255,255,.12),0 50px 100px rgba(13,31,60,.45)}
  /* Owner-uploaded mobile image (replaces the built-in phone mockup) — no frame/border */
  .bds-spon .an-phone-img{position:relative;z-index:1;display:block;width:400px;max-width:100%;border:0;border-radius:18px;box-shadow:0 30px 70px rgba(13,31,60,.4)}
  /* When a custom image is used, drop the decorative glow halo behind it */
  .bds-spon .an-phone-glow:has(.an-phone-img)::before{content:none}
  .bds-spon .an-screen{background:#f0eeea;border-radius:36px;overflow:hidden;position:relative}
  .bds-spon .an-glare{position:absolute;top:0;left:0;right:0;height:55%;background:linear-gradient(170deg,rgba(255,255,255,.07) 0%,transparent 70%);border-radius:36px 36px 0 0;pointer-events:none;z-index:5}
  .bds-spon .an-island{position:absolute;top:10px;left:50%;transform:translateX(-50%);width:88px;height:25px;background:#080f22;border-radius:16px;z-index:10}
  .bds-spon .an-ph{background:var(--bds-navy);padding:46px 16px 11px;display:flex;justify-content:space-between;align-items:center}
  .bds-spon .an-ph-t{font-size:8.5px;font-weight:600;color:#fff}
  .bds-spon .an-ph-s{font-size:6.5px;color:rgba(255,255,255,.4);margin-top:1px}
  .bds-spon .an-ph-logo{width:28px;height:28px;background:var(--bds-accent);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:8.5px;font-weight:700;color:#fff}
  .bds-spon .an-pb{padding:12px 11px 15px;display:flex;flex-direction:column;gap:8px}
  .bds-spon .an-pg2{display:grid;grid-template-columns:1fr 1fr;gap:7px}
  .bds-spon .an-pg3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:7px}
  .bds-spon .an-pc{background:#fff;border-radius:11px;border:1px solid #e5e3dc;padding:11px 12px}
  .bds-spon .an-pc-l{font-size:6.5px;font-weight:600;text-transform:uppercase;letter-spacing:.7px;color:#9ca3af;margin-bottom:3px}
  .bds-spon .an-pc-v{font-size:22px;font-family:var(--bds-fd);color:var(--bds-gray-900);line-height:1}
  .bds-spon .an-pc-u{font-size:8px;font-weight:600;color:#16a34a;margin-top:2px}
  .bds-spon .an-pc-d{color:var(--bds-accent)!important}
  .bds-spon .an-pbar{background:#fff;border-radius:11px;border:1px solid #e5e3dc;padding:11px 12px}
  .bds-spon .an-pbar-l{font-size:6.5px;font-weight:600;text-transform:uppercase;letter-spacing:.7px;color:#9ca3af;margin-bottom:6px}
  .bds-spon .an-pbars{display:flex;align-items:flex-end;gap:5px;height:50px}
  .bds-spon .an-pbc{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px}
  .bds-spon .an-pbf{width:100%;border-radius:2px 2px 0 0}
  .bds-spon .an-pbd{font-size:5px;color:#9ca3af}
  .bds-spon .an-pdc{background:#fff;border-radius:11px;border:1px solid #e5e3dc;padding:11px 7px;text-align:center}
  .bds-spon .an-pdc-v{font-size:16px;font-family:var(--bds-fd);color:var(--bds-gray-900);line-height:1;margin-bottom:2px}
  .bds-spon .an-pdc-a{color:var(--bds-accent)}
  .bds-spon .an-pdc-l{font-size:6px;color:#9ca3af;text-transform:uppercase;letter-spacing:.5px;font-weight:600}
  .bds-spon .an-pdw{background:var(--bds-navy);border-radius:11px;padding:12px 13px;display:flex;align-items:center;gap:8px}
  .bds-spon .an-pdw-i{width:30px;height:30px;background:var(--bds-accent);border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;color:#fff}
  .bds-spon .an-pdw-v{font-size:17px;font-family:var(--bds-fd);color:#fff}
  .bds-spon .an-pdw-l{font-size:7px;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.5px}
  .bds-spon .an-pdw-p{margin-left:auto;font-size:5.5px;color:rgba(255,255,255,.3);text-align:right;line-height:1.5}
  @media(max-width:900px){
    .bds-spon .an-wrap{padding:56px 22px}
    .bds-spon .an-grid{grid-template-columns:1fr;gap:40px}
    .bds-spon .an-sub{margin-bottom:34px}
  }

  /* ── Testimonials ── */
  /* Desktop: STATIC 3-up grid (no scrolling). Mobile (≤768px): horizontal swipe carousel. */
  .bds-spon .bds-testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .bds-spon .bds-testi-wrap{position:relative}
  /* Arrows belong to the mobile carousel only; hidden on the static desktop grid */
  .bds-spon .bds-testi-nav{display:none}
  @media(max-width:768px){
    .bds-spon .bds-testi-grid{display:flex;grid-template-columns:none;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;padding:4px 4px 18px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.35) transparent}
    .bds-spon .bds-testi-grid::-webkit-scrollbar{height:8px}
    .bds-spon .bds-testi-grid::-webkit-scrollbar-thumb{background:rgba(255,255,255,.3);border-radius:99px}
    .bds-spon .bds-testi-grid::-webkit-scrollbar-track{background:transparent}
    .bds-spon .bds-testi{flex:0 0 360px;max-width:88vw;scroll-snap-align:start}
  }
  /* Testimonials sit on a full-width BLUE band; the cards stay white */
  .bds-spon .bds-testi-sec{background:var(--bds-navy)}
  .bds-spon .bds-testi-sec .bds-title{color:#fff}
  .bds-spon .bds-testi-sec .bds-sub{color:rgba(255,255,255,.6)}
  .bds-spon .bds-testi-sec .bds-label{color:var(--bds-accent-light)}
  /* FAQ sits on a light beige band (wireframe); cards stay white */
  .bds-spon .bds-faq-sec{background:var(--bds-gray-100)}
  .bds-spon .bds-testi{background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:var(--bds-r-lg);padding:24px;transition:box-shadow .2s,transform .2s;display:flex;flex-direction:column;min-height:360px}
  .bds-spon .bds-testi:hover{box-shadow:0 10px 30px rgba(0,0,0,.18);transform:translateY(-3px)}
  .bds-spon .bds-tag{display:inline-block;font-size:10px;font-weight:600;padding:3px 10px;border-radius:10px;margin-bottom:10px;letter-spacing:.02em;background:#E6F1FB;color:#185FA5}
  .bds-spon .bds-stars{color:var(--bds-accent);font-size:13px;margin-bottom:10px;letter-spacing:2px}
  .bds-spon .bds-quote{font-size:13px;color:var(--bds-gray-700);line-height:1.65;margin-bottom:16px;font-style:italic}
  .bds-spon .bds-author{display:flex;align-items:center;gap:10px;margin-top:auto}
  .bds-spon .bds-avatar{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;flex-shrink:0;background:#E6F1FB;color:#185FA5}
  .bds-spon .bds-author-name{font-size:13px;font-weight:600;color:var(--bds-gray-900)}
  .bds-spon .bds-author-meta{font-size:11px;color:var(--bds-gray-500);margin-top:1px}
  /* ── Testimonials "blue" variant: navy band + glass cards (light text) ── */
  .bds-spon .bds-testi-blue{background:var(--bds-navy)}
  .bds-spon .bds-testi-blue .bds-title{color:#fff}
  .bds-spon .bds-testi-blue .bds-sub{color:rgba(255,255,255,.6)}
  .bds-spon .bds-testi-blue .bds-label{color:var(--bds-accent-light)}
  /* Glass cards: translucent panels on the navy band */
  .bds-spon .bds-testi-blue .bds-testi{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);box-shadow:none}
  .bds-spon .bds-testi-blue .bds-testi:hover{box-shadow:0 24px 48px -28px rgba(0,0,0,.7);transform:translateY(-3px);border-color:rgba(255,255,255,.2)}
  /* Industry tag → plain uppercase light text (override the per-block chip colours) */
  .bds-spon .bds-testi-blue .bds-tag{background:transparent!important;color:rgba(255,255,255,.5)!important;padding:0;margin-bottom:14px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
  .bds-spon .bds-testi-blue .bds-stars{color:#E0A82E;letter-spacing:3px}
  .bds-spon .bds-testi-blue .bds-quote{color:rgba(255,255,255,.82);font-size:15px;font-style:normal}
  .bds-spon .bds-testi-blue .bds-author{border-top:1px solid rgba(255,255,255,.1);padding-top:18px;margin-top:18px}
  .bds-spon .bds-testi-blue .bds-avatar{width:44px;height:44px;font-size:15px}
  .bds-spon .bds-testi-blue .bds-author-name{color:#fff;font-size:15px}
  .bds-spon .bds-testi-blue .bds-author-meta{color:rgba(255,255,255,.5)}

  /* ── Sponsor logo marquee ── */
  .bds-spon .bds-marquee{overflow:hidden;position:relative}
  .bds-spon .bds-marquee::before,.bds-spon .bds-marquee::after{content:'';position:absolute;top:0;width:80px;height:100%;z-index:2;pointer-events:none}
  .bds-spon .bds-marquee::before{left:0;background:linear-gradient(to right,var(--bds-off-white),transparent)}
  .bds-spon .bds-marquee::after{right:0;background:linear-gradient(to left,var(--bds-off-white),transparent)}
  .bds-spon .bds-marquee-track{display:flex;gap:12px;width:max-content;animation:bdsMarquee 28s linear infinite}
  .bds-spon .bds-marquee:hover .bds-marquee-track{animation-play-state:paused}
  @keyframes bdsMarquee{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
  .bds-spon .bds-logo{background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:var(--bds-r-md);padding:14px 18px;display:flex;align-items:center;gap:10px;flex-shrink:0;min-width:150px;transition:border-color .2s,transform .2s}
  .bds-spon .bds-logo:hover{border-color:rgba(0,0,0,.18);transform:translateY(-2px)}
  .bds-spon .bds-logo-ic{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0}
  .bds-spon .bds-logo-ic img{width:32px;height:32px;border-radius:8px;object-fit:contain}
  .bds-spon .bds-logo-text{font-size:12px;font-weight:600;color:var(--bds-gray-500);white-space:nowrap}

  /* ── Backdrop pattern overlay (shared by Before/After stages) ── */
  .bds-spon .bds-gpattern{position:absolute;inset:0;opacity:.04;background-image:repeating-linear-gradient(0deg,transparent,transparent 30px,#fff 30px,#fff 31px),repeating-linear-gradient(90deg,transparent,transparent 30px,#fff 30px,#fff 31px)}

  /* ── Before / After comparison ── */
  /* Uploaded comparison image (replaces the built-in CSS mockup when set) */
  .bds-spon .bds-ba-photo{margin:0 auto;max-width:1120px}
  .bds-spon .bds-ba-photo img{width:100%;height:auto;display:block;border-radius:var(--bds-r-lg);box-shadow:0 24px 60px -30px rgba(13,31,60,.5)}
  .bds-spon .bds-ba{display:grid;grid-template-columns:1fr auto 1fr;gap:24px;align-items:center}
  .bds-spon .bds-ba-card{display:flex;flex-direction:column;gap:14px;min-width:0}
  .bds-spon .bds-ba-tag{align-self:flex-start;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--bds-gray-500);background:var(--bds-gray-100);padding:5px 13px;border-radius:20px}
  .bds-spon .bds-ba-tag--after{color:#fff;background:var(--bds-accent)}
  .bds-spon .bds-ba-stage{position:relative;border-radius:var(--bds-r-lg);overflow:hidden;background:linear-gradient(135deg,var(--bds-navy),var(--bds-navy-mid) 55%,var(--bds-navy-deep));border:1px solid rgba(0,0,0,.1);min-height:440px;display:flex;flex-direction:column;justify-content:space-between;padding:34px 30px}
  .bds-spon .bds-ba-mock{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:18px;flex:1;justify-content:center;text-align:center}
  .bds-spon .bds-ba-logo{width:54%;min-width:160px;height:104px;border:1.5px solid rgba(255,255,255,.2);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:14px;font-style:italic;color:rgba(255,255,255,.45)}
  .bds-spon .bds-ba-tagline{font-size:14px;font-style:italic;color:rgba(255,255,255,.35)}
  .bds-spon .bds-ba-visual{width:88%;height:84px;border:1px solid rgba(255,255,255,.1);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:13px;font-style:italic;color:rgba(255,255,255,.3)}
  .bds-spon .bds-ba-strip{position:relative;z-index:1;margin-top:20px;border-radius:8px}
  .bds-spon .bds-ba-strip--empty{border:2px dashed rgba(255,255,255,.22);min-height:88px;display:flex;align-items:center;justify-content:center;font-size:13px;font-style:italic;color:rgba(255,255,255,.4);text-align:center;padding:12px}
  .bds-spon .bds-ba-strip--full{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:8px;background:var(--bds-accent);padding:9px;border-radius:8px}
  .bds-spon .bds-ba-slot{background:#fff;border-radius:5px;min-height:66px;min-width:0;display:flex;align-items:center;justify-content:center;padding:5px;text-align:center;overflow:hidden}
  .bds-spon .bds-ba-slot span{font-size:9px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--bds-gray-500);line-height:1.2;word-break:break-word}
  .bds-spon .bds-ba-cap{display:flex;align-items:center;gap:6px;font-size:13px;font-weight:600;line-height:1.4}
  .bds-spon .bds-ba-cap svg{width:14px;height:14px;flex-shrink:0}
  .bds-spon .bds-ba-cap--bad{color:var(--bds-gray-500)}
  .bds-spon .bds-ba-cap--good{color:var(--bds-green)}
  .bds-spon .bds-ba-vs{width:50px;height:50px;border-radius:50%;background:var(--bds-navy);color:#fff;display:flex;align-items:center;justify-content:center;font-family:var(--bds-fd);font-size:16px;flex-shrink:0;box-shadow:0 6px 18px rgba(0,0,0,.18)}
  .bds-spon .bds-midcta{margin-top:32px;text-align:center;background:var(--bds-navy);border-radius:var(--bds-r-lg);padding:36px 24px}
  .bds-spon .bds-midcta-title{font-family:var(--bds-fd);font-size:clamp(22px,3vw,30px);color:#fff;margin-bottom:10px;line-height:1.2}
  .bds-spon .bds-midcta-sub{font-size:15px;color:rgba(255,255,255,.6);max-width:520px;margin:0 auto 22px;line-height:1.6}

  /* ── Video ── */
  .bds-spon .bds-video{background:#0A1628;border-radius:var(--bds-r-lg);overflow:hidden;border:1px solid rgba(255,255,255,.06);position:relative;max-width:700px;margin:0 auto;aspect-ratio:16/6;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:18px;cursor:pointer;transition:transform .2s}
  .bds-spon .bds-video:hover{transform:scale(1.01)}
  .bds-spon .bds-video-badge{position:absolute;top:16px;right:16px;background:rgba(192,57,91,.9);color:#fff;font-size:10px;font-weight:600;padding:4px 12px;border-radius:10px;letter-spacing:.04em;z-index:2}
  .bds-spon .bds-video-ic{width:88px;height:88px;border-radius:20px;background:rgba(192,57,91,.12);border:1px solid rgba(192,57,91,.2);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;color:var(--bds-accent)}
  .bds-spon .bds-video-ic svg{width:40px;height:40px}
  .bds-spon .bds-video-title{font-size:16px;color:rgba(255,255,255,.75);font-weight:500;margin-bottom:6px;text-align:center}
  .bds-spon .bds-video-desc{font-size:14px;color:rgba(255,255,255,.55);text-align:center;max-width:380px;line-height:1.5;margin:0 auto}
  .bds-spon .bds-play{width:60px;height:60px;border-radius:50%;background:var(--bds-accent);display:flex;align-items:center;justify-content:center;border:none;transition:transform .2s}
  .bds-spon .bds-play:hover{transform:scale(1.08)}
  .bds-spon .bds-play svg{width:22px;height:22px;color:#fff;margin-left:3px}
  .bds-spon .bds-video-embed{position:absolute;inset:0;width:100%;height:100%;border:0}
  .bds-spon .bds-video-overlay{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;width:100%}
  .bds-spon .bds-video.is-playing{cursor:default}
  .bds-spon .bds-video.is-playing:hover{transform:none}
  .bds-spon .bds-video.is-playing .bds-video-overlay{display:none}
  .bds-spon .bds-video-holder{position:absolute;inset:0}
  .bds-spon .bds-video-holder[hidden]{display:none}
  .bds-spon .bds-video-holder video{width:100%;height:100%;object-fit:cover;background:#000;display:block}

  /* ── CTA footer ── */
  .bds-spon .bds-ctaf{background:var(--bds-navy);padding:56px 48px;text-align:center}
  .bds-spon .bds-ctaf h2{font-family:var(--bds-fd);font-size:clamp(28px,4vw,38px);color:#fff;margin-bottom:14px}
  .bds-spon .bds-ctaf p{font-size:15px;color:rgba(255,255,255,.5);margin-bottom:32px}
  .bds-spon .bds-ctaf-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
  .bds-spon .bds-ctaf-copy{margin-top:32px;font-size:12px;color:rgba(255,255,255,.25)}

  /* ── Lead modal ── */
  .bds-spon .bds-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);backdrop-filter:blur(4px);z-index:9999;align-items:center;justify-content:center;padding:20px 16px;overflow-y:auto}
  .bds-spon .bds-modal.open{display:flex}
  .bds-spon .bds-modal-box{background:#fff;border-radius:var(--bds-r-lg);padding:22px 24px;max-width:376px;width:100%;position:relative;box-shadow:0 20px 60px rgba(0,0,0,.2);max-height:calc(100vh - 40px);overflow-y:auto;margin:auto}
  .bds-spon .bds-modal-close{position:absolute;top:12px;right:14px;background:none;border:none;font-size:22px;color:var(--bds-gray-500);line-height:1}
  .bds-spon .bds-modal-close:hover{color:var(--bds-gray-900)}
  .bds-spon .bds-modal-eyebrow{font-size:10.5px;font-weight:600;color:var(--bds-accent);text-transform:uppercase;letter-spacing:.1em;margin-bottom:5px}
  .bds-spon .bds-modal-title{font-family:var(--bds-fd);font-size:19px;color:var(--bds-gray-900);margin-bottom:4px;line-height:1.15}
  .bds-spon .bds-modal-sub{font-size:12px;color:var(--bds-gray-500);margin-bottom:14px;line-height:1.4}
  .bds-spon .bds-field{margin-bottom:9px}
  .bds-spon .bds-field label{display:block;font-size:11.5px;font-weight:600;color:var(--bds-gray-700);margin-bottom:3px}
  .bds-spon .bds-req{color:var(--bds-accent);font-weight:700}
  .bds-spon .bds-field input{width:100%;padding:8px 12px;border:1px solid rgba(0,0,0,.15);border-radius:var(--bds-r-sm);font-size:14px;font-family:var(--bds-fb);color:var(--bds-gray-900);transition:border-color .2s;outline:none}
  .bds-spon .bds-field input:focus{border-color:var(--bds-accent)}
  .bds-spon .bds-field input.err{border-color:var(--bds-accent)}
  .bds-spon .bds-form-submit{width:100%;background:var(--bds-accent);color:#fff;border:none;padding:11px;border-radius:var(--bds-r-sm);font-size:14px;font-weight:600;margin-top:4px;transition:background .2s}
  .bds-spon .bds-form-submit:hover{background:var(--bds-accent-dark)}
  .bds-spon .bds-form-submit[disabled]{opacity:.6;cursor:default}
  .bds-spon .bds-form-note{font-size:11px;color:var(--bds-gray-500);text-align:center;margin-top:8px}
  .bds-spon .bds-modal .bdsf-msg{margin-top:3px}
  .bds-spon .bds-form-success{display:none;text-align:center;padding:20px 0}
  .bds-spon .bds-form-success .ic{font-size:48px;margin-bottom:12px}
  .bds-spon .bds-form-success h3{font-family:var(--bds-fd);font-size:22px;color:var(--bds-gray-900);margin-bottom:8px}
  .bds-spon .bds-form-success p{font-size:13px;color:var(--bds-gray-500)}

  /* ── FAQ ── */
  .bds-spon .bds-faq-list{display:flex;flex-direction:column;gap:12px;max-width:820px;margin:0 auto}
  .bds-spon .bds-faq-item{background:#fff;border:1px solid rgba(0,0,0,.1);border-radius:var(--bds-r-md);overflow:hidden;transition:border-color .2s,box-shadow .2s}
  .bds-spon .bds-faq-item.open{border-color:rgba(192,57,91,.4);box-shadow:0 4px 20px rgba(0,0,0,.05)}
  .bds-spon .bds-faq-q{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 22px;background:none;border:none;text-align:left;font-family:var(--bds-fb);font-size:15px;font-weight:600;color:var(--bds-gray-900);line-height:1.4}
  .bds-spon .bds-faq-ic{flex-shrink:0;width:30px;height:30px;border-radius:9px;background:#ece9e1;position:relative;transition:background .25s,transform .25s}
  .bds-spon .bds-faq-ic::before,.bds-spon .bds-faq-ic::after{content:'';position:absolute;background:var(--bds-gray-500);border-radius:2px;transition:background .25s}
  .bds-spon .bds-faq-ic::before{top:50%;left:9px;right:9px;height:2px;transform:translateY(-50%)}
  .bds-spon .bds-faq-ic::after{left:50%;top:9px;bottom:9px;width:2px;transform:translateX(-50%)}
  /* Open → red rounded square rotated 45° (the + becomes an ✕), per wireframe */
  .bds-spon .bds-faq-item.open .bds-faq-ic{background:var(--bds-accent);transform:rotate(45deg)}
  .bds-spon .bds-faq-item.open .bds-faq-ic::before,.bds-spon .bds-faq-item.open .bds-faq-ic::after{background:#fff}
  .bds-spon .bds-faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease}
  .bds-spon .bds-faq-a-inner{padding:0 22px 20px;font-size:14px;color:var(--bds-gray-700);line-height:1.7}
  .bds-spon .bds-faq-a-inner p{margin:0 0 10px}
  .bds-spon .bds-faq-a-inner p:last-child{margin-bottom:0}
  .bds-spon .bds-faq-a-inner a{color:var(--bds-accent);text-decoration:underline}

  /* ── Responsive ── */
  @media (max-width:768px){
    .bds-spon .bds-nav{padding:12px 20px}
    .bds-spon .bds-nav-links{display:none}
    .bds-spon .bds-trust{padding:16px 20px;gap:18px}
    .bds-spon .bds-stats{grid-template-columns:repeat(2,1fr)}
    .bds-spon .bds-stat:nth-child(2n){border-right:none}
    .bds-spon .bds-section{padding:40px 20px}
    .bds-spon .an-wrap{padding:52px 22px}
    .bds-spon .bds-ctaf{padding:48px 20px}
    .bds-spon .bds-roi,.bds-spon .bds-ba{grid-template-columns:1fr}
    /* Before/After stages shorter when stacked on phones */
    .bds-spon .bds-ba-stage{min-height:360px}
    /* Sponsor-slot strip: keep all 5 slots inside the red box on narrow screens */
    .bds-spon .bds-ba-strip--full{gap:5px;padding:7px}
    .bds-spon .bds-ba-slot{min-height:54px;padding:3px}
    .bds-spon .bds-ba-slot span{font-size:7.5px;letter-spacing:0}
    .bds-spon .bds-ba-vs{margin:4px auto}
    .bds-spon .bds-modal-box{padding:22px 18px}
  }
  /* Phone refinements */
  @media (max-width:560px){
    /* Hero copy sizing (layout itself is handled by the stacked rules above) */
    .bds-spon .bds-hero h1{font-size:clamp(24px,7vw,31px);margin-bottom:10px}
    .bds-spon .bds-hero-sub{font-size:14px;margin-bottom:14px}
    /* Counters band → noticeably smaller than the hero */
    .bds-spon .bds-herobar .bds-stat{padding:13px 10px}
    .bds-spon .bds-herobar .bds-stat-num{font-size:19px;gap:5px}
    .bds-spon .bds-herobar .bds-stat-label{font-size:10px}
    .bds-spon .bds-herobar .bds-stat-badge{font-size:9px;padding:1px 6px}
    /* Trust points → compact 2-column strip, smallest of the three */
    .bds-spon .bds-trust{display:grid;grid-template-columns:1fr 1fr;gap:9px 12px;justify-items:start;padding:14px 16px}
    .bds-spon .bds-trust-item{font-size:11px;gap:5px}
    .bds-spon .bds-trust-item svg{width:13px;height:13px}
    /* Testimonials: one card per swipe */
    .bds-spon .bds-testi{flex-basis:84vw}
  }
  @media (prefers-reduced-motion:reduce){
    .bds-spon .bds-marquee-track{animation:none}
    .bds-spon .bds-pulse{animation:none}
  }

  /* ════════════════════════════════════════════════════════════════════
     V2 — CREATIVE OVERRIDES (scoped to .bds-v2)
     Redesigns 4 sections only: ROI · Before/After · FAQ · Testimonials.
     Everything else inherits the base look. Higher source-order + matching
     specificity → these win over the base rules within .bds-v2 only.
     ════════════════════════════════════════════════════════════════════ */

  /* ── Shared: a little gradient flourish under the 4 section titles ── */
  .bds-v2 .bds-roi-wrap2 .bds-title::after,
  .bds-v2 .bds-faq-sec .bds-title::after,
  .bds-v2 .bds-testi-blue .bds-title::after,
  .bds-v2 .bds-ba-sec2 .bds-title::after{content:'';display:block;width:64px;height:4px;margin:16px auto 0;border-radius:99px;background:linear-gradient(90deg,var(--bds-accent),var(--bds-accent-light))}

  /* ──────────── 1 · ROI CALCULATOR ──────────── */
  .bds-v2 .bds-roi-wrap2{background:radial-gradient(120% 90% at 50% -10%, #fbeef1 0%, var(--bds-off-white) 55%)}
  .bds-v2 .bds-roi{gap:28px}
  .bds-v2 .bds-roi-controls{border:none;border-radius:22px;box-shadow:0 24px 60px -34px rgba(13,31,60,.45),0 2px 0 rgba(255,255,255,.6) inset;background:linear-gradient(180deg,#fff,#fcfbf9)}
  .bds-v2 .bds-roi-ctrl-eyebrow{color:var(--bds-accent);letter-spacing:.16em}
  .bds-v2 .bds-roi-slider-bump{}
  .bds-v2 .bds-roi-results{border-radius:22px;overflow:hidden;position:relative;background:linear-gradient(160deg,#19356f 0%,var(--bds-navy) 42%,var(--bds-navy-deep) 100%);box-shadow:0 36px 80px -36px rgba(13,31,60,.85)}
  .bds-v2 .bds-roi-results::before{content:'';position:absolute;top:-30%;right:-18%;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle,rgba(192,57,91,.4),transparent 68%);pointer-events:none;z-index:0}
  .bds-v2 .bds-roi-results::after{content:'';position:absolute;bottom:-28%;left:-16%;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(93,202,138,.28),transparent 70%);pointer-events:none;z-index:0}
  .bds-v2 .bds-roi-results > *{position:relative;z-index:1}
  .bds-v2 .bds-roi-top-l{color:rgba(255,255,255,.62);letter-spacing:.12em}
  .bds-v2 .bds-roi-top-v{font-size:18px}
  .bds-v2 .bds-roi-gauge{height:180px}
  .bds-v2 .bds-roi-gauge [data-gauge]{filter:drop-shadow(0 0 7px rgba(111,191,151,.65))}
  .bds-v2 .bds-roi-gauge-c .v{font-size:60px;background:linear-gradient(92deg,#8DF0B8 0%,#48B07F 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;filter:drop-shadow(0 3px 14px rgba(111,227,166,.45))}
  .bds-v2 .bds-roi-gauge-c .l{color:rgba(255,255,255,.55)}
  .bds-v2 .bds-roi-card{background:rgba(255,255,255,.07);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.16);border-radius:16px;transition:transform .18s,border-color .2s,background .2s}
  .bds-v2 .bds-roi-card:hover{transform:translateY(-3px);border-color:rgba(255,255,255,.3);background:rgba(255,255,255,.1)}
  .bds-v2 .bds-roi-card-v.is-green{filter:drop-shadow(0 3px 12px rgba(93,202,138,.45))}
  .bds-v2 .bds-roi-cta{background:linear-gradient(92deg,var(--bds-accent),#e0557a);box-shadow:0 16px 34px -12px rgba(192,57,91,.75);font-weight:600;letter-spacing:.02em;border-radius:12px;transition:transform .15s,box-shadow .2s,filter .2s}
  .bds-v2 .bds-roi-cta:hover{transform:translateY(-2px);box-shadow:0 22px 46px -12px rgba(192,57,91,.9);filter:brightness(1.05)}
  /* punchier sliders */
  .bds-v2 .bds-roi input[type=range]{height:9px}
  .bds-v2 .bds-slider-val{background:linear-gradient(92deg,rgba(192,57,91,.12),rgba(192,57,91,.05));color:var(--bds-accent);border:1px solid rgba(192,57,91,.2)}

  /* ──────────── 2 · BEFORE / AFTER ──────────── */
  .bds-v2 .bds-ba-sec2{background:radial-gradient(120% 80% at 50% 0%, #0e2147 0%, var(--bds-navy-deep) 70%);position:relative;overflow:hidden}
  .bds-v2 .bds-ba-sec2 .bds-label{color:var(--bds-accent-light)}
  .bds-v2 .bds-ba-sec2 .bds-title{color:#fff}
  .bds-v2 .bds-ba-sec2 .bds-sub{color:rgba(255,255,255,.6)}
  /* glowing gradient frame around the uploaded comparison image */
  .bds-v2 .bds-ba-photo{position:relative;padding:12px;border-radius:26px;background:linear-gradient(135deg,rgba(192,57,91,.85),rgba(26,58,122,.85) 55%,rgba(93,202,138,.7));box-shadow:0 50px 90px -44px rgba(0,0,0,.8)}
  .bds-v2 .bds-ba-photo::before{content:'';position:absolute;inset:-2px;border-radius:28px;background:linear-gradient(135deg,var(--bds-accent),transparent 60%);filter:blur(22px);opacity:.55;z-index:-1}
  .bds-v2 .bds-ba-photo img{border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,.4)}
  /* if the built-in mockup is used instead, give the stages extra punch */
  .bds-v2 .bds-ba-stage{border-radius:18px;box-shadow:0 30px 60px -34px rgba(0,0,0,.7)}
  .bds-v2 .bds-ba-tag--after{box-shadow:0 8px 20px -6px rgba(192,57,91,.7)}
  .bds-v2 .bds-ba-vs{background:linear-gradient(135deg,var(--bds-accent),#e0557a);box-shadow:0 10px 26px -6px rgba(192,57,91,.7)}

  /* ──────────── 3 · FAQ — dark "support desk" (2-col, sticky aside + lead CTA) ──────────── */
  .bds-v2 .bds-faqx{background:radial-gradient(120% 85% at 82% 0%, #16356f 0%, var(--bds-navy) 45%, var(--bds-navy-deep) 100%)}
  .bds-v2 .bds-faqx-grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:48px;align-items:start}
  .bds-v2 .bds-faqx-aside{position:sticky;top:92px}
  .bds-v2 .bds-faqx .bds-label{text-align:left;color:var(--bds-accent-light)}
