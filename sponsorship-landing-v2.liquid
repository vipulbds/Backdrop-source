      var cards = [].slice.call(grid.children);
      if(!cards.length) return;
      cards.forEach(function(c){ var clone=c.cloneNode(true); clone.setAttribute('aria-hidden','true'); grid.appendChild(clone); });
      grid.classList.add('is-marquee');
    })();
  })();
