    /* ---- Owner Analytics: live animated background (pauses off-screen, skips on reduced-motion) ---- */
    (function(){
      var canvas = document.getElementById('bds-an-canvas-{{ uid }}');
      if(!canvas) return;
      if(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return; // CSS gradient stays as the backdrop
      var ctx = canvas.getContext('2d'); if(!ctx) return;
      var W=0, H=0, raf=null, running=false, t=0;
      var ORANGE='#C0395B', NAVY='#1a3a7a';
      function resize(){ W=canvas.width=canvas.offsetWidth; H=canvas.height=canvas.offsetHeight; }
      function hexAlpha(hex,a){ var r=parseInt(hex.slice(1,3),16),g=parseInt(hex.slice(3,5),16),b=parseInt(hex.slice(5,7),16); return 'rgba('+r+','+g+','+b+','+a+')'; }
      if(!ctx.roundRect){ ctx.roundRect=function(x,y,w,h,r){ this.beginPath();this.moveTo(x+r,y);this.lineTo(x+w-r,y);this.quadraticCurveTo(x+w,y,x+w,y+r);this.lineTo(x+w,y+h-r);this.quadraticCurveTo(x+w,y+h,x+w-r,y+h);this.lineTo(x+r,y+h);this.quadraticCurveTo(x,y+h,x,y+h-r);this.lineTo(x,y+r);this.quadraticCurveTo(x,y,x+r,y);this.closePath(); }; }
      resize(); window.addEventListener('resize', resize, {passive:true});

      var LABELS=['Footfall','Attention','Dwell Time','Return Rate','Look-to-Stop','Impressions','Age 25–34','Gender Split'];
      var VALUES=['14.2K','73%','4.7s','31%','1 in 4','8,741','Top Seg','58/42'];
      var seed=1; function rnd(){ seed=(seed*16807)%2147483647; return (seed-1)/2147483646; } // deterministic (no Math.random reliance)
      var cards=[]; for(var i=0;i<7;i++){ cards.push({x:rnd()*1.2-.1,y:rnd()*1.2-.1,w:120,h:50,vx:(rnd()-.5)*.00018,vy:(rnd()-.5)*.00014,alpha:rnd()*.16+.06,idx:i%LABELS.length,pulse:rnd()*6.28}); }
      var lines=[]; for(var j=0;j<5;j++){ lines.push({color:j%2===0?ORANGE:NAVY,alpha:.1+rnd()*.1,offset:rnd()*200,speed:.0004+rnd()*.0003,yBase:.1+(j*.16),amp:.04+rnd()*.06}); }
      var parts=[]; function newP(){ return {x:rnd(),y:1+rnd()*.1,r:rnd()*1.8+.4,speed:.00025+rnd()*.0004,alpha:rnd()*.32+.08,orange:rnd()>.6}; }
      for(var k=0;k<34;k++){ parts.push(newP()); }
      var bars=[.42,.68,.31,.85,.73,.56,.90,.44,.62,.78].map(function(v){ return {cur:0,target:v,speed:.008+rnd()*.006}; });

      function draw(){
        if(!running) return;
        ctx.clearRect(0,0,W,H); t++;
        ctx.strokeStyle='rgba(255,255,255,.025)'; ctx.lineWidth=1;
        for(var x=0;x<W;x+=60){ ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke(); }
        for(var y=0;y<H;y+=60){ ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke(); }
        lines.forEach(function(l){
          var pts=[]; for(var i=0;i<60;i++){ var px=i/59; pts.push({px:px*W,py:(l.yBase+Math.sin(px*4+t*l.speed+l.offset)*l.amp)*H}); }
          ctx.beginPath(); ctx.moveTo(pts[0].px,pts[0].py);
          for(var n=1;n<pts.length-2;n++){ var cx=(pts[n].px+pts[n+1].px)/2, cy=(pts[n].py+pts[n+1].py)/2; ctx.quadraticCurveTo(pts[n].px,pts[n].py,cx,cy); }
          ctx.strokeStyle=hexAlpha(l.color,l.alpha); ctx.lineWidth=1.5; ctx.stroke();
          ctx.lineTo(W,H); ctx.lineTo(0,H); ctx.closePath(); ctx.fillStyle=hexAlpha(l.color,l.alpha*.3); ctx.fill();
        });
        var bx=.05*W, by=.62*H, bw=.12*W, bh=.22*H;
        bars.forEach(function(b,i){ b.cur+=(b.target-b.cur)*b.speed; var bxi=bx+i*(bw/bars.length+4), hh=b.cur*bh;
          var g=ctx.createLinearGradient(0,by+bh-hh,0,by+bh); g.addColorStop(0,hexAlpha(ORANGE,.26)); g.addColorStop(1,hexAlpha(ORANGE,.06));
          ctx.fillStyle=g; ctx.beginPath(); ctx.roundRect(bxi,by+bh-hh,bw/bars.length-2,hh,2); ctx.fill(); });
        cards.forEach(function(c){ c.x+=c.vx;c.y+=c.vy;c.pulse+=.012;
          if(c.x<-.25)c.x=1.1; if(c.x>1.1)c.x=-.25; if(c.y<-.25)c.y=1.1; if(c.y>1.1)c.y=-.25;
          var cx=c.x*W, cy=c.y*H; ctx.save(); ctx.globalAlpha=c.alpha+Math.sin(c.pulse)*.025;
          ctx.fillStyle='rgba(255,255,255,.04)'; ctx.strokeStyle='rgba(255,255,255,.09)'; ctx.lineWidth=.8;
          ctx.beginPath(); ctx.roundRect(cx,cy,c.w,c.h,8); ctx.fill(); ctx.stroke();
          ctx.fillStyle=hexAlpha(ORANGE,.7); ctx.font='600 8px DM Sans,sans-serif'; ctx.fillText(LABELS[c.idx],cx+10,cy+16);
          ctx.fillStyle='rgba(255,255,255,.85)'; ctx.font='400 19px DM Serif Display,serif'; ctx.fillText(VALUES[c.idx],cx+10,cy+38); ctx.restore(); });
        parts.forEach(function(p,i){ p.y-=p.speed; if(p.y<-.02) parts[i]=newP();
          ctx.save(); ctx.globalAlpha=p.alpha; ctx.fillStyle=p.orange?ORANGE:'rgba(255,255,255,.6)';
          ctx.beginPath(); ctx.arc(p.x*W,p.y*H,p.r,0,6.2832); ctx.fill(); ctx.restore(); });
        raf=requestAnimationFrame(draw);
      }
      function start(){ if(running) return; running=true; raf=requestAnimationFrame(draw); }
      function stop(){ running=false; if(raf) cancelAnimationFrame(raf); }
      if('IntersectionObserver' in window){
        new IntersectionObserver(function(es){ es.forEach(function(e){ e.isIntersecting ? start() : stop(); }); },{threshold:.01}).observe(canvas);
      } else { start(); }
    })();

