    /* Before/After drag-to-reveal slider */
    [].forEach.call(SECT.querySelectorAll('[data-baslider]'), function(sl){
      function setPos(clientX){
        var r = sl.getBoundingClientRect();
        var p = ((clientX - r.left) / r.width) * 100;
        p = Math.max(0, Math.min(100, p));
        sl.style.setProperty('--bapos', p + '%');
      }
      var dragging = false;
      sl.addEventListener('pointerdown', function(e){ dragging = true; sl.classList.add('is-touched'); try{ sl.setPointerCapture(e.pointerId); }catch(_){} setPos(e.clientX); });
      sl.addEventListener('pointermove', function(e){ if(dragging) setPos(e.clientX); });
      sl.addEventListener('pointerup',   function(){ dragging = false; });
      sl.addEventListener('pointercancel', function(){ dragging = false; });
    });

    /* Testimonials — auto-scrolling marquee: clone the card set once so the -50% loop is seamless */
    (function(){
      var grid = SECT.querySelector('[data-testi-grid]');
