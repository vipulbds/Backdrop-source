    {%- comment -%} ── ROI CALCULATOR ── {%- endcomment -%}
    {%- if sp.show_roi -%}
    <section class="bds-section--alt bds-roi-wrap2" id="bds-calc-{{ uid }}">
      <div class="bds-sec-inner bds-section">
        {%- if sp.roi_label != blank -%}<div class="bds-label">{{ sp.roi_label }}</div>{%- endif -%}
        {%- if sp.roi_title != blank -%}<div class="bds-title">{{ sp.roi_title }}</div>{%- endif -%}
        {%- if sp.roi_sub != blank -%}<div class="bds-sub">{{ sp.roi_sub }}</div>{%- endif -%}
        <div class="bds-roi" id="bds-roi-{{ uid }}">
          <div class="bds-roi-controls">
            <div class="bds-roi-ctrl-eyebrow">{{ sp.roi_ctrl_eyebrow | default: 'Your scenario' }}</div>
            <div class="bds-slider">
              <div class="bds-slider-lbl"><span>{{ sp.roi_l_cost | default: 'Backdrop cost' }}</span><span class="bds-slider-val" data-out="cost">${{ sp.roi_cost_default | default: 500 }}</span></div>
              <input type="range" min="{{ sp.roi_cost_min | default: 50 }}" max="{{ sp.roi_cost_max | default: 14000 }}" step="50" value="{{ sp.roi_cost_default | default: 500 }}" data-in="cost">
            </div>
            <div class="bds-slider">
              <div class="bds-slider-lbl"><span>{{ sp.roi_l_sponsors | default: 'No. of sponsors' }}</span><span class="bds-slider-val" data-out="sponsors">{{ sp.roi_sponsors_default | default: 1 }}</span></div>
              <input type="range" min="1" max="{{ sp.roi_sponsors_max | default: 6 }}" step="1" value="{{ sp.roi_sponsors_default | default: 1 }}" data-in="sponsors">
            </div>
            <div class="bds-slider">
              <div class="bds-slider-lbl"><span>{{ sp.roi_l_fee | default: 'Average sponsor fee' }}</span><span class="bds-slider-val" data-out="fee">${{ sp.roi_fee_default | default: 200 }}</span></div>
              <input type="range" min="{{ sp.roi_fee_min | default: 10 }}" max="{{ sp.roi_fee_max | default: 2000 }}" step="10" value="{{ sp.roi_fee_default | default: 200 }}" data-in="fee">
            </div>
            <div class="bds-roi-ctrl-foot"><i></i>{{ sp.roi_foot_note | default: 'Estimates update live as you drag.' }}</div>
          </div>
          <div class="bds-roi-results">
            <div class="bds-roi-top"><span class="bds-roi-top-l">{{ sp.roi_invest_label | default: 'Total backdrop investment' }}</span><span class="bds-roi-top-sep">·</span><span class="bds-roi-top-v" data-out="invest">${{ sp.roi_cost_default | default: 500 }}</span></div>
            <div class="bds-roi-speedo" data-speedo>
              <svg viewBox="0 0 220 150" aria-hidden="true">
                <defs>
                  <linearGradient id="bds-spd-amber-{{ uid }}" x1="0" y1="1" x2="1" y2="0"><stop offset="0%" stop-color="#E2574C"/><stop offset="100%" stop-color="#E8A33D"/></linearGradient>
                  <linearGradient id="bds-spd-green-{{ uid }}" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#6FCF97"/><stop offset="100%" stop-color="#34A06B"/></linearGradient>
                </defs>
                <path class="bds-spd-track" d="M22 120 A 88 88 0 0 1 198 120"/>
                <path class="bds-spd-zone" stroke="url(#bds-spd-amber-{{ uid }})" d="M22 120 A 88 88 0 0 1 110 32"/>
                <path class="bds-spd-zone" stroke="url(#bds-spd-green-{{ uid }})" d="M110 32 A 88 88 0 0 1 198 120"/>
                <g data-ticks></g>
                <g data-nums></g>
                <g data-needle transform="rotate(-90 110 120)"><polygon class="bds-spd-needle" points="106,118 110,34 114,118"/></g>
                <circle class="bds-spd-hub" cx="110" cy="120" r="10"/>
                <circle class="bds-spd-hub2" cx="110" cy="120" r="4.5"/>
              </svg>
              <div class="bds-roi-speedo-read"><div class="v" data-out="coverpct">0%</div><div class="l">of your cost covered by sponsors</div></div>
            </div>
            <div class="bds-roi-cards">
              <div class="bds-roi-card">
                <div class="bds-roi-card-l">{{ sp.roi_r_eff | default: 'Effective cost' }}</div>
                <div class="bds-roi-card-v is-amber" data-out="effcost">$0</div>
                <div class="bds-roi-card-s" data-out="effsub">partially covered</div>
              </div>
              <div class="bds-roi-card">
                <div class="bds-roi-card-l">{{ sp.roi_r_earn | default: 'You earn' }}</div>
                <div class="bds-roi-card-v is-green" data-out="earn">$0</div>
                <div class="bds-roi-card-s" data-out="earnsub">{{ sp.roi_earn_sub | default: 'from sponsors' }}</div>
              </div>
            </div>
            {%- assign roi_cta_label = sp.roi_cta2 | default: sp.roi_cta -%}
            {%- if roi_cta_label != blank -%}<div class="bds-roi-cta-wrap"><button class="bds-roi-cta" type="button" data-open-modal>{{ roi_cta_label }}</button></div>{%- endif -%}
          </div>
        </div>
      </div>
    </section>
    {%- endif -%}

    {%- comment -%} ── GALLERY: Before / After backdrop comparison ── {%- endcomment -%}
    {%- if sp.show_gallery -%}
    {%- assign ba_slots = sp.ba_slots | default: 5 -%}
    <section class="bds-section--alt bds-ba-sec2">
      <div class="bds-sec-inner bds-section bds-ba-grid">
      <div class="bds-ba-copy">
      {%- if sp.gallery_label != blank -%}<div class="bds-label">{{ sp.gallery_label }}</div>{%- endif -%}
      {%- if sp.gallery_title != blank -%}<div class="bds-title">{{ sp.gallery_title }}</div>{%- endif -%}
      {%- if sp.gallery_sub != blank -%}<div class="bds-sub">{{ sp.gallery_sub }}</div>{%- endif -%}
      {%- assign ba_cta = sp.midcta_btn2 | default: 'Get my backdrop sponsored →' -%}
      {%- if ba_cta != blank -%}<button class="bds-roi-cta bds-ba-cta" type="button" data-open-modal>{{ ba_cta }}</button>{%- endif -%}
      </div>
      <div class="bds-ba-media">
      {%- if sp.ba_before_img != blank and sp.ba_after_img != blank -%}
      <div class="bds-baslider" data-baslider style="--bapos:50%">
        <img class="bds-baslider-after" src="{{ sp.ba_after_img | image_url: width: 2200 }}" alt="{{ sp.ba_after_label | default: 'After' | escape }}" width="{{ sp.ba_after_img.width }}" height="{{ sp.ba_after_img.height }}" loading="lazy">
        <div class="bds-baslider-before"><img src="{{ sp.ba_before_img | image_url: width: 2200 }}" alt="{{ sp.ba_before_label | default: 'Before' | escape }}" loading="lazy"></div>
        <span class="bds-baslider-tag bds-baslider-tagb">{{ sp.ba_before_label | default: 'Before' }}</span>
        <span class="bds-baslider-tag bds-baslider-taga">{{ sp.ba_after_label | default: 'After' }}</span>
        <div class="bds-baslider-handle" data-baslider-handle><span class="bds-baslider-line"></span><span class="bds-baslider-knob" aria-hidden="true">⟷</span></div>
        <div class="bds-baslider-hint" data-baslider-hint>{{ sp.ba_hint | default: '← Drag to compare →' }}</div>
      </div>
      {%- elsif sp.ba_image != blank -%}
      <div class="bds-ba-photo"><img src="{{ sp.ba_image | image_url: width: 2200 }}" alt="{{ sp.gallery_title | default: 'Before and after backdrop comparison' | strip_html | escape }}" width="{{ sp.ba_image.width }}" height="{{ sp.ba_image.height }}" loading="lazy"></div>
      {%- else -%}
      <div class="bds-ba">
        {%- comment -%} BEFORE {%- endcomment -%}
        <div class="bds-ba-card">
          <div class="bds-ba-tag">{{ sp.ba_before_label | default: 'Before' }}</div>
          <div class="bds-ba-stage">
            <div class="bds-gpattern"></div>
            <div class="bds-ba-mock">
              <div class="bds-ba-logo">{{ sp.ba_logo_text | default: 'Company Logo' }}</div>
              <div class="bds-ba-tagline">{{ sp.ba_tagline_text | default: 'Your Brand Tagline Here' }}</div>
              <div class="bds-ba-visual">{{ sp.ba_visual_text | default: 'Product / Event Visuals' }}</div>
            </div>
            <div class="bds-ba-strip bds-ba-strip--empty">{{ sp.ba_before_strip | default: 'This space is unused' }}</div>
          </div>
          <div class="bds-ba-cap bds-ba-cap--bad">{{ sp.ba_before_cap | default: 'Empty space — no revenue, no value' }}</div>
        </div>

        <div class="bds-ba-vs">{{ sp.ba_vs_text | default: 'VS' }}</div>

        {%- comment -%} AFTER {%- endcomment -%}
        <div class="bds-ba-card">
          <div class="bds-ba-tag bds-ba-tag--after">{{ sp.ba_after_label | default: 'After' }}</div>
          <div class="bds-ba-stage">
            <div class="bds-gpattern"></div>
            <div class="bds-ba-mock">
              <div class="bds-ba-logo">{{ sp.ba_logo_text | default: 'Company Logo' }}</div>
              <div class="bds-ba-tagline">{{ sp.ba_tagline_text | default: 'Your Brand Tagline Here' }}</div>
              <div class="bds-ba-visual">{{ sp.ba_visual_text | default: 'Product / Event Visuals' }}</div>
            </div>
            <div class="bds-ba-strip bds-ba-strip--full">
              {%- for i in (1..ba_slots) -%}
              <div class="bds-ba-slot"><span>{{ sp.ba_slot_label | default: 'Sponsor space' }}</span></div>
              {%- endfor -%}
            </div>
          </div>
          <div class="bds-ba-cap bds-ba-cap--good">{{ ic_trend }} {{ sp.ba_after_cap | default: 'Sponsor slots — you earn every event' }}</div>
        </div>
      </div>
      {%- endif -%}
      </div>
      </div>
    </section>
    {%- endif -%}

    {%- comment -%} ── SPONSOR LOGO MARQUEE ── {%- endcomment -%}
    {%- assign logo_blocks = section.blocks | where: 'type', 'logo' -%}
    {%- if sp.show_logos != false and logo_blocks.size > 0 -%}
    <section class="bds-section--alt" id="bds-sponsors-{{ uid }}">
      <div class="bds-sec-inner bds-section" style="padding-bottom:20px">
        {%- if sp.logos_label != blank -%}<div class="bds-label">{{ sp.logos_label }}</div>{%- endif -%}
        {%- if sp.logos_title != blank -%}<div class="bds-title">{{ sp.logos_title }}</div>{%- endif -%}
        {%- if sp.logos_sub != blank -%}<div class="bds-sub" style="margin-bottom:0">{{ sp.logos_sub }}</div>{%- endif -%}
      </div>
      <div class="bds-marquee" style="padding-bottom:48px">
        <div class="bds-marquee-track">
          {%- for pass in (1..2) -%}
            {%- for block in logo_blocks -%}
            <div class="bds-logo"{% if pass == 1 %} {{ block.shopify_attributes }}{% else %} aria-hidden="true"{% endif %}>
              <div class="bds-logo-ic" style="background:{{ block.settings.bg | default: '#dbeafe' }};color:{{ block.settings.fg | default: '#185FA5' }}">
                {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 64 }}" alt="{{ block.settings.name | escape }}" width="32" height="32" loading="lazy">{%- else -%}{{ block.settings.name | slice: 0 | upcase }}{%- endif -%}
              </div>
              <div class="bds-logo-text">{{ block.settings.name }}</div>
            </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
    {%- endif -%}

    {%- comment -%} ── FAQ ── {%- endcomment -%}
    {%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
    {%- if faq_blocks.size > 0 -%}
    <section class="bds-section--alt bds-faq-sec bds-faqx" id="bds-faq-{{ uid }}">
      <div class="bds-sec-inner bds-section">
      <div class="bds-faqx-grid">
        <aside class="bds-faqx-aside">
          {%- if sp.faq_label != blank -%}<div class="bds-label">{{ sp.faq_label }}</div>{%- endif -%}
          {%- if sp.faq_title != blank -%}<div class="bds-title">{{ sp.faq_title }}</div>{%- endif -%}
          {%- if sp.faq_sub != blank -%}<div class="bds-sub">{{ sp.faq_sub }}</div>{%- endif -%}
          <div class="bds-faqx-help">
            <div class="bds-faqx-help-t">{{ sp.faq_help_title | default: 'Ready to earn from your backdrop?' }}</div>
            <div class="bds-faqx-help-s">{{ sp.faq_help_sub | default: 'Tell us about your events and get a personalised earnings plan — in your inbox within 24 hours.' }}</div>
            <button class="bds-faqx-help-btn" type="button" data-open-modal>{{ sp.faq_help_btn | default: 'Get my backdrop sponsored →' }}</button>
          </div>
        </aside>
        <div class="bds-faq-list">
          {%- for block in faq_blocks -%}
          <div class="bds-faq-item{% if block.settings.open_default %} open{% endif %}" {{ block.shopify_attributes }}>
            <button class="bds-faq-q" type="button" aria-expanded="{% if block.settings.open_default %}true{% else %}false{% endif %}">
              <span>{{ block.settings.question }}</span>
              <span class="bds-faq-ic" aria-hidden="true"></span>
            </button>
            <div class="bds-faq-a"><div class="bds-faq-a-inner">{{ block.settings.answer }}</div></div>
          </div>
          {%- endfor -%}
        </div>
      </div>
      </div>
    </section>
    {%- endif -%}

    {%- comment -%} ── VIDEO ── {%- endcomment -%}
    {%- if sp.show_video -%}
    <section class="bds-section--alt">
      <div class="bds-sec-inner bds-section">
        {%- if sp.video_label != blank -%}<div class="bds-label">{{ sp.video_label }}</div>{%- endif -%}
        {%- if sp.video_title != blank -%}<div class="bds-title" style="margin-bottom:24px">{{ sp.video_title }}</div>{%- endif -%}
        {%- if sp.video_sub != blank -%}<div class="bds-sub">{{ sp.video_sub }}</div>{%- endif -%}
        {%- assign poster_url = '' -%}
        {%- if sp.video_poster != blank -%}
          {%- assign poster_url = sp.video_poster | image_url: width: 1200 -%}
        {%- elsif sp.video_file != blank and sp.video_file.preview_image != blank -%}
          {%- assign poster_url = sp.video_file.preview_image | image_url: width: 1200 -%}
        {%- endif -%}
        <div class="bds-video{% if poster_url != blank %} has-poster{% endif %}" id="bds-video-{{ uid }}"
            data-type="{% if sp.video_file != blank %}shopify{% elsif sp.video_url != blank %}embed{% else %}none{% endif %}"
            data-embed="{{ sp.video_url | escape }}"
            {% if poster_url != blank %}style="background-image:linear-gradient(rgba(10,22,40,.55),rgba(10,22,40,.72)),url('{{ poster_url }}');background-size:cover;background-position:center"{% endif %}>
          {%- if sp.video_badge != blank -%}<div class="bds-video-badge">{{ sp.video_badge }}</div>{%- endif -%}
          <div class="bds-video-overlay">
            <div style="text-align:center">
              <div class="bds-video-ic">{{ ic_cube }}</div>
              {%- if sp.video_inner_title != blank -%}<div class="bds-video-title">{{ sp.video_inner_title }}</div>{%- endif -%}
              {%- if sp.video_desc != blank -%}<div class="bds-video-desc">{{ sp.video_desc }}</div>{%- endif -%}
            </div>
            <button class="bds-play" type="button" aria-label="Play video">{{ ic_play }}</button>
          </div>
          {%- if sp.video_file != blank -%}
          <div class="bds-video-holder" hidden>{{ sp.video_file | video_tag: controls: true, preload: 'none', image_size: '1100x' }}</div>
          {%- endif -%}
        </div>
      </div>
    </section>
    {%- endif -%}

    {%- comment -%} ── TESTIMONIALS ── {%- endcomment -%}
    {%- assign testi_blocks = section.blocks | where: 'type', 'testimonial' -%}
    {%- if testi_blocks.size > 0 -%}
    <section class="bds-section--alt bds-testi-blue" id="bds-testi-{{ uid }}">
      <div class="bds-sec-inner bds-section">
      {%- if sp.testi_label != blank -%}<div class="bds-label">{{ sp.testi_label }}</div>{%- endif -%}
      {%- if sp.testi_title != blank -%}<div class="bds-title">{{ sp.testi_title }}</div>{%- endif -%}
      {%- if sp.testi_sub != blank -%}<div class="bds-sub">{{ sp.testi_sub }}</div>{%- endif -%}
      <div class="bds-testi-wrap" data-testi-wrap>
      <button type="button" class="bds-testi-nav bds-testi-prev" data-testi-prev aria-label="Previous testimonials"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></button>
      <button type="button" class="bds-testi-nav bds-testi-next" data-testi-next aria-label="Next testimonials"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></button>
      <div class="bds-testi-grid" data-testi-grid>
        {%- for block in testi_blocks -%}
        <div class="bds-testi" style="--bds-tc:{{ block.settings.tag_color | default: '#185FA5' }}" {{ block.shopify_attributes }}>
          {%- if block.settings.tag != blank -%}<div class="bds-tag" {% if block.settings.tag_bg != blank %}style="background:{{ block.settings.tag_bg }};color:{{ block.settings.tag_color }}"{% endif %}>{{ block.settings.tag }}</div>{%- endif -%}
          <div class="bds-stars">{% assign r = block.settings.stars | default: 5 %}{% for i in (1..r) %}★{% endfor %}{% assign empty = 5 | minus: r %}{% if empty > 0 %}{% for i in (1..empty) %}<span style="color:#d8d5cc">★</span>{% endfor %}{% endif %}</div>
          <div class="bds-quote">{{ block.settings.quote }}</div>
          <div class="bds-author">
            <div class="bds-avatar" {% if block.settings.tag_bg != blank %}style="background:{{ block.settings.tag_bg }};color:{{ block.settings.tag_color }}"{% endif %}>{{ block.settings.initials }}</div>
            <div><div class="bds-author-name">{{ block.settings.name }}</div><div class="bds-author-meta">{{ block.settings.meta }}</div></div>
          </div>
        </div>
        {%- endfor -%}
      </div>
      </div>
      </div>
    </section>
    {%- endif -%}

    {%- comment -%} ── CTA FOOTER ── {%- endcomment -%}
    {%- if sp.show_cta_footer -%}
    <section class="bds-ctaf">
      {%- if sp.ctaf_title != blank -%}<h2>{{ sp.ctaf_title }}</h2>{%- endif -%}
      {%- if sp.ctaf_sub != blank -%}<p>{{ sp.ctaf_sub }}</p>{%- endif -%}
      <div class="bds-ctaf-btns">
        {%- assign ctaf_owner_label = sp.ctaf_owner_btn | default: sp.owner_btn | default: "I'm a Backdrop Owner" -%}
        {%- if sp.owner_mode == 'lead' -%}
        <button type="button" class="bds-btn bds-btn--white" data-open-modal data-modal-kind="owner">{{ ic_camera }} {{ ctaf_owner_label }}</button>
        {%- else -%}
        <a class="bds-btn bds-btn--white" href="{{ sp.ctaf_owner_link | default: sp.owner_btn_link | default: '#' }}">{{ ic_camera }} {{ ctaf_owner_label }}</a>
        {%- endif -%}
        {%- if sp.show_sponsor -%}
          {%- assign ctaf_sponsor_label = sp.ctaf_sponsor_btn | default: sp.sponsor_btn | default: 'Brand / Sponsor' -%}
          {%- if sp.sponsor_mode == 'lead' -%}
          <button type="button" class="bds-btn bds-btn--ghost" data-open-modal data-modal-kind="sponsor">{{ ic_store }} {{ ctaf_sponsor_label }}</button>
          {%- else -%}
          <a class="bds-btn bds-btn--ghost" href="{{ sp.ctaf_sponsor_link | default: sp.sponsor_btn_link | default: '#' }}">{{ ic_store }} {{ ctaf_sponsor_label }}</a>
          {%- endif -%}
        {%- endif -%}
      </div>
      {%- if sp.ctaf_copyright != blank -%}<div class="bds-ctaf-copy">{{ sp.ctaf_copyright }}</div>{%- endif -%}
    </section>
    {%- endif -%}

    {%- comment -%} ── LEAD MODAL ── {%- endcomment -%}
    <div class="bds-modal" id="bds-modal-{{ uid }}" data-endpoint="{{ sp.lead_endpoint | default: 'https://script.google.com/macros/s/AKfycbywLpmVWHgSfGympZY5OyGWYAYIXhbrZh1E9yB9stWp56ZpSpZpfuSFDb2fQ0T4KVS8kA/exec' | escape }}" role="dialog" aria-modal="true">
      <div class="bds-modal-box">
        <button class="bds-modal-close" type="button" data-close-modal aria-label="Close">&times;</button>
        <div data-form-content>
          <div class="bds-modal-eyebrow" data-modal-eyebrow{% if sp.modal_eyebrow == blank %} style="display:none"{% endif %}>{{ sp.modal_eyebrow }}</div>
          <div class="bds-modal-title" data-modal-title>{{ sp.modal_title | default: 'Get your personalised earnings plan' }}</div>
          <div class="bds-modal-sub" data-modal-sub{% if sp.modal_sub == blank %} style="display:none"{% endif %}>{{ sp.modal_sub }}</div>
          <div class="bds-field"><label for="bds-name-{{ uid }}">{{ sp.lead_name_label | default: 'Full name' }} <span class="bds-req">*</span></label><input type="text" id="bds-name-{{ uid }}" data-f="name" placeholder="e.g. Sarah Mitchell" autocomplete="name"></div>
          <div class="bds-field"><label for="bds-email-{{ uid }}">{{ sp.lead_email_label | default: 'Email address' }} <span class="bds-req">*</span></label><input type="email" id="bds-email-{{ uid }}" data-f="email" data-bds-email data-required placeholder="you@example.com" autocomplete="email"></div>
          <div class="bds-field"><label for="bds-phone-{{ uid }}">{{ sp.lead_phone_label | default: 'Phone number' }} <span class="bds-req">*</span></label><input type="tel" id="bds-phone-{{ uid }}" data-f="phone" data-bds-phone placeholder="+1 (555) 000-0000" autocomplete="tel"></div>
          <button class="bds-form-submit" type="button" data-submit-lead>{{ sp.submit_label2 | default: sp.submit_label | default: 'Get my backdrop sponsored →' }}</button>
          {%- if sp.form_note != blank -%}<div class="bds-form-note">{{ sp.form_note }}</div>{%- endif -%}
        </div>
        <div class="bds-form-success" data-form-success>
          <div class="ic">🎉</div>
          <h3>Thanks for reaching out!</h3>
          <p>We'll connect with you soon.</p>
        </div>
      </div>
    </div>

  </div>

  <script>
  (function(){
    var SECT = document.getElementById('bds-spon-{{ uid }}');
    if(!SECT) return;
    var modal = document.getElementById('bds-modal-{{ uid }}');
    /* The lead modal is shared: the ROI CTA opens it as-is; the Analytics CTA opens it
      with "Get early access" copy and tags the lead so it lands in its own sheet tab. */
    var mTitle  = modal && modal.querySelector('[data-modal-title]');
    var mEye    = modal && modal.querySelector('[data-modal-eyebrow]');
    var mSub    = modal && modal.querySelector('[data-modal-sub]');
    var mSubmit = modal && modal.querySelector('[data-submit-lead]');
    var DEF_TITLE  = mTitle ? mTitle.textContent : '';
    var DEF_EYE    = mEye ? mEye.textContent : '';
    var DEF_EYE_SHOWN = mEye ? (mEye.style.display !== 'none') : false;
    var DEF_SUB_SHOWN = mSub ? (mSub.style.display !== 'none') : false;
    var DEF_SUBMIT = mSubmit ? mSubmit.textContent : '';
    var mSucT = modal && modal.querySelector('[data-form-success] h3');
    var mSucP = modal && modal.querySelector('[data-form-success] p');
    var DEF_SUC_T = mSucT ? mSucT.textContent : '';
    var DEF_SUC_P = mSucP ? mSucP.textContent : '';
    /* Per-CTA pop-up copy + the sheet tab each lead routes to (dynamic Apps Script auto-creates tabs). */
    var KINDS = {
      owner:     { title: {{ sp.owner_lead_title | default: 'Become a Backdrop Owner' | json }}, eyebrow: 'Backdrop Owner', submit: {{ sp.owner_lead_submit | default: 'Get started →' | json }}, source: 'backdrop-owner', role: 'backdrop-owner', form: {{ sp.owner_lead_tab | default: 'Owner Leads' | json }} },
      sponsor:   { title: {{ sp.sponsor_lead_title | default: 'Become a Sponsor' | json }}, eyebrow: 'For Brands & Sponsors', submit: {{ sp.sponsor_lead_submit | default: 'Become a Sponsor →' | json }}, source: 'sponsor', role: 'sponsor', form: {{ sp.sponsor_lead_tab | default: 'Sponsor Leads' | json }} },
      analytics: { title: {{ sp.analytics_modal_title | default: 'Get early access' | json }}, eyebrow: {{ sp.analytics_modal_eyebrow | default: 'BackdropSource Analytics · Waitlist' | json }}, submit: {{ sp.analytics_submit | default: 'Get early access →' | json }}, source: 'analytics-waitlist', role: 'analytics-waitlist', form: 'Analytics Waitlist', successTitle: {{ sp.analytics_success_title | default: "You're on the list!" | json }}, successText: {{ sp.analytics_success_text | default: 'Your personalised earnings plan is on its way. Check your inbox within 24 hours.' | json }} }
    };
    var leadSource = 'sponsorship-landing', leadRole = 'backdrop-owner', leadForm = '';
    function openModal(kind){
      if(!modal) return;
      /* Reset to a FRESH form every time — the modal is shared by every CTA, so after one
         submission it must not stay stuck on the "thank you" view for the next form. */
      var fcEl=modal.querySelector('[data-form-content]'); if(fcEl) fcEl.style.display='';
      var fsEl=modal.querySelector('[data-form-success]'); if(fsEl) fsEl.style.display='none';
      if(mSubmit) mSubmit.disabled=false;
      [].forEach.call(modal.querySelectorAll('[data-f]'), function(el){ el.value=''; el.classList.remove('err'); });
      var k = KINDS[kind];
      if(k){
        leadSource=k.source; leadRole=k.role; leadForm=k.form;
        if(mTitle)  mTitle.textContent  = k.title;
        if(mSubmit) mSubmit.textContent = k.submit;
        if(mEye){ mEye.textContent = k.eyebrow; mEye.style.display = k.eyebrow ? '' : 'none'; }
        if(mSub) mSub.style.display = 'none';   // lead-capture pop-ups have no sub-paragraph
        if(mSucT) mSucT.textContent = k.successTitle || DEF_SUC_T;
        if(mSucP) mSucP.textContent = k.successText || DEF_SUC_P;
      } else { /* ROI calculator / generic */
        leadSource='sponsorship-landing'; leadRole='backdrop-owner'; leadForm='';
        if(mTitle)  mTitle.textContent  = DEF_TITLE;
        if(mSubmit) mSubmit.textContent = DEF_SUBMIT;
        if(mEye){ mEye.textContent = DEF_EYE; mEye.style.display = DEF_EYE_SHOWN ? '' : 'none'; }
        if(mSub) mSub.style.display = DEF_SUB_SHOWN ? '' : 'none';
        if(mSucT) mSucT.textContent = DEF_SUC_T;
        if(mSucP) mSucP.textContent = DEF_SUC_P;
      }
      modal.classList.add('open'); document.body.style.overflow='hidden';
    }
    function closeModal(){ if(modal){ modal.classList.remove('open'); document.body.style.overflow=''; } }

    /* ---- Hero background video: autoplay, muted, looped (library video OR YouTube/Vimeo) ----
       Supports a separate desktop and mobile background (both kept in the DOM, CSS
       shows whichever matches the viewport). Each gets its own player; the sound
       toggle only acts on the one currently visible so audio never doubles up. */
    (function(){
      var bgs = SECT.querySelectorAll('[data-hero-bg]');
      if(!bgs.length) return;
      var players = [];
      [].forEach.call(bgs, function(bg){
        var p = { bg: bg, heroVid: null, ytFrame: null, vimeoFrame: null };
        var type = bg.getAttribute('data-type');
        if(type==='shopify'){
          p.heroVid = bg.querySelector('video');
          if(p.heroVid){
            p.heroVid.muted = true; p.heroVid.defaultMuted = true; p.heroVid.setAttribute('muted','');
            p.heroVid.setAttribute('playsinline',''); p.heroVid.setAttribute('webkit-playsinline',''); p.heroVid.loop = true; p.heroVid.controls = false;
            var pr = p.heroVid.play(); if(pr && pr.catch) pr.catch(function(){});
          }
        } else if(type==='embed'){
          var raw = bg.getAttribute('data-embed') || '';
          if(/<iframe/i.test(raw)){ var sm = raw.match(/src\s*=\s*["']([^"']+)["']/i); if(sm) raw = sm[1]; }
          var url = '', kind = '';
          var yt = raw.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/|live\/)|youtu\.be\/)([\w-]{11})/);
          if(yt){ var id = yt[1]; kind='yt'; url = 'https://www.youtube.com/embed/'+id+'?autoplay=1&mute=1&loop=1&playlist='+id+'&controls=0&showinfo=0&modestbranding=1&rel=0&playsinline=1&iv_load_policy=3&enablejsapi=1'; }
          else { var vm = raw.match(/vimeo\.com\/(?:video\/)?(\d+)/); if(vm){ kind='vimeo'; url = 'https://player.vimeo.com/video/'+vm[1]+'?background=1&autoplay=1&muted=1&loop=1'; } }
          if(url){
            var f = document.createElement('iframe');
            f.setAttribute('allow','autoplay; encrypted-media; picture-in-picture');
            f.setAttribute('frameborder','0'); f.setAttribute('aria-hidden','true'); f.setAttribute('tabindex','-1');
            f.src = url; bg.classList.add('is-embed'); bg.appendChild(f);
            if(kind==='yt') p.ytFrame = f; else if(kind==='vimeo') p.vimeoFrame = f;
          }
        }
        players.push(p);
      });

      function setMuted(p, muted){
        if(p.heroVid){ p.heroVid.muted = muted; if(!muted){ try{ p.heroVid.volume = 1; }catch(e){} var pp=p.heroVid.play(); if(pp&&pp.catch) pp.catch(function(){}); } }
        if(p.ytFrame && p.ytFrame.contentWindow){ p.ytFrame.contentWindow.postMessage(JSON.stringify({event:'command',func: muted?'mute':'unMute',args:[]}),'*'); if(!muted) p.ytFrame.contentWindow.postMessage(JSON.stringify({event:'command',func:'setVolume',args:[100]}),'*'); }
        if(p.vimeoFrame && p.vimeoFrame.contentWindow){ p.vimeoFrame.contentWindow.postMessage(JSON.stringify({method:'setMuted',value:muted}),'*'); if(!muted) p.vimeoFrame.contentWindow.postMessage(JSON.stringify({method:'setVolume',value:1}),'*'); }
      }

      /* Turn-on-sound toggle — unmutes only the visible background video */
      var audioBtn = SECT.querySelector('[data-hero-audio]');
      if(audioBtn){
        var lbl = audioBtn.querySelector('[data-audio-label]');
        var onTxt = {{ sp.hero_audio_on_label | default: 'Mute' | json }}, offTxt = {{ sp.hero_audio_label | default: 'Turn on sound' | json }};
        audioBtn.addEventListener('click', function(){
          var willOn = audioBtn.getAttribute('aria-pressed') !== 'true';
          players.forEach(function(p){
            var visible = p.bg.offsetParent !== null; /* the one CSS is currently showing */
            setMuted(p, willOn ? !visible : true);
          });
          audioBtn.setAttribute('aria-pressed', willOn?'true':'false');
          if(lbl) lbl.textContent = willOn ? onTxt : offTxt;
        });
      }
    })();

    /* ---- Testimonials carousel: arrows + drag-to-scroll (so desktop/mouse users can scroll too) ---- */
    (function(){
      var grid = SECT.querySelector('[data-testi-grid]');
      if(!grid) return;
      if(SECT.classList.contains('bds-v2')) return; /* v2 uses the spotlight rotator below */
      var prev = SECT.querySelector('[data-testi-prev]'), next = SECT.querySelector('[data-testi-next]');
      function step(){
        var card = grid.querySelector('.bds-testi');
        var w = card ? card.getBoundingClientRect().width : grid.clientWidth*0.8;
        return Math.max(w + 20, grid.clientWidth*0.85); /* ~one card + gap */
      }
      function sync(){
        var max = grid.scrollWidth - grid.clientWidth - 2;
        if(prev) prev.disabled = grid.scrollLeft <= 2;
        if(next) next.disabled = grid.scrollLeft >= max;
      }
      if(prev) prev.addEventListener('click', function(){ grid.scrollBy({left:-step(),behavior:'smooth'}); });
      if(next) next.addEventListener('click', function(){ grid.scrollBy({left: step(),behavior:'smooth'}); });
      grid.addEventListener('scroll', sync, {passive:true});
      window.addEventListener('resize', sync);
      sync();

      /* click-and-drag to scroll with a mouse */
      var down=false, startX=0, startScroll=0, moved=0;
      grid.addEventListener('mousedown', function(e){ down=true; moved=0; startX=e.pageX; startScroll=grid.scrollLeft; });
      window.addEventListener('mousemove', function(e){
        if(!down) return;
        var dx = e.pageX - startX; moved += Math.abs(dx);
        if(moved>4) grid.classList.add('is-dragging');
        grid.scrollLeft = startScroll - dx;
      });
      window.addEventListener('mouseup', function(){ down=false; setTimeout(function(){ grid.classList.remove('is-dragging'); },0); });
      /* convert vertical wheel to horizontal scroll ONLY when the strip actually scrolls
         (mobile carousel). On the static desktop grid there's no overflow, so leave the
         page's normal vertical scroll alone. */
      grid.addEventListener('wheel', function(e){
        if(grid.classList.contains('bds-testi-marquee')) return; /* v2 marquee owns the motion */
        if(grid.scrollWidth <= grid.clientWidth + 2) return;
        if(Math.abs(e.deltaY) > Math.abs(e.deltaX)){ grid.scrollLeft += e.deltaY; e.preventDefault(); }
      }, {passive:false});
    })();

    /* ---- Animated stat counters (count up to the final value when scrolled into view) ---- */
    (function(){
      var stats = SECT.querySelector('.bds-stats');
      if(!stats) return;
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function run(){
        [].forEach.call(stats.querySelectorAll('.bds-stat-figure'), function(el){
          if(el.dataset.counted) return;
          var rawv = (el.textContent || '').trim();
          var m = rawv.match(/^([^\d]*)([\d.,]+)(.*)$/);   // optional prefix ($) · number · suffix (M/%/+/K)
          if(!m){ return; }
          var pre = m[1], numStr = m[2], suf = m[3];
          var target = parseFloat(numStr.replace(/,/g,''));
          if(isNaN(target)){ return; }
          var dec = (numStr.split('.')[1] || '').length;
          el.dataset.counted = '1';
          function fmt(v){ return pre + v.toLocaleString('en-US',{minimumFractionDigits:dec,maximumFractionDigits:dec}) + suf; }
          if(reduce){ el.textContent = fmt(target); return; }
          var dur = 1700, t0 = null;
          function step(ts){ if(t0===null) t0=ts; var p=Math.min((ts-t0)/dur,1); var e=1-Math.pow(1-p,3); el.textContent=fmt(target*e); if(p<1){ requestAnimationFrame(step); } else { el.textContent=fmt(target); } }
          el.textContent = fmt(0);
          requestAnimationFrame(step);
        });
      }
      if('IntersectionObserver' in window){
        var io = new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ run(); io.disconnect(); } }); }, {threshold:.3});
        io.observe(stats);
      } else { run(); }
    })();

    /* ---- Header: transparent over the hero video on load, navy background once scrolled ---- */
    var nav = SECT.querySelector('.bds-nav');
    if(nav){
      function onNavScroll(){ nav.classList.toggle('is-scrolled', window.pageYOffset > 30); }
      onNavScroll();
      window.addEventListener('scroll', onNavScroll, {passive:true});
    }

    /* ---- smooth-scroll + modal triggers ---- */
    SECT.addEventListener('click', function(e){
      var s = e.target.closest('[data-scroll]');
      if(s){ var t = document.getElementById(s.getAttribute('data-scroll')); if(t){ e.preventDefault(); t.scrollIntoView({behavior:'smooth',block:'start'}); } return; }
      var trg = e.target.closest('[data-open-modal]');
      if(trg){ openModal(trg.getAttribute('data-modal-kind')); }
    });

    /* ---- ROI calculator (3 sliders: backdrop cost / no. of sponsors / avg fee) ---- */
    var root = document.getElementById('bds-roi-{{ uid }}');
    if(root){
      var ins={}; root.querySelectorAll('[data-in]').forEach(function(el){ ins[el.dataset.in]=el; });
      function out(k){ return root.querySelector('[data-out="'+k+'"]'); }
      function fmt(n){ return Math.abs(Math.round(n)).toLocaleString('en-US'); }
      /* v2 speedometer: build the dial (ticks + % numbers) once, then drive the needle */
      var SPD_MAX=200, SPD_CX=110, SPD_CY=120, needleG=root.querySelector('[data-needle]');
      function spdPolar(v,r){ var a=(180-(Math.min(Math.max(v,0),SPD_MAX)/SPD_MAX)*180)*Math.PI/180; return {x:SPD_CX+r*Math.cos(a), y:SPD_CY-r*Math.sin(a)}; }
      (function buildSpeedo(){
        var ticks=root.querySelector('[data-ticks]'), nums=root.querySelector('[data-nums]'), NS='http://www.w3.org/2000/svg';
        if(!ticks||!nums) return;
        for(var v=0; v<=SPD_MAX; v+=12.5){
          var major=(v%25===0), o=spdPolar(v,88), i=spdPolar(v, major?74:80);
          var ln=document.createElementNS(NS,'line');
          ln.setAttribute('x1',i.x.toFixed(1)); ln.setAttribute('y1',i.y.toFixed(1));
          ln.setAttribute('x2',o.x.toFixed(1)); ln.setAttribute('y2',o.y.toFixed(1));
          ln.setAttribute('stroke-width', major?'2':'1'); ln.setAttribute('stroke-linecap','round');
          ln.setAttribute('class','bds-spd-tick'+(major?' bds-spd-tick--major':''));
          ticks.appendChild(ln);
        }
        [0,50,100,150,200].forEach(function(v){
          var p=spdPolar(v,60), tx=document.createElementNS(NS,'text');
          tx.setAttribute('x',p.x.toFixed(1)); tx.setAttribute('y',p.y.toFixed(1));
          tx.setAttribute('class','bds-spd-num'); tx.textContent=v+'%';
          nums.appendChild(tx);
        });
      })();
      function setNeedle(pct){ if(!needleG) return; var v=Math.min(Math.max(pct,0),SPD_MAX), deg=-90+(v/SPD_MAX)*180; needleG.setAttribute('transform','rotate('+deg.toFixed(2)+' '+SPD_CX+' '+SPD_CY+')'); }
      /* Fill the track up to the thumb (WebKit/Safari have no native progress fill) so the
        coloured line always reaches the handle — no empty gap at the end. */
      function fillSlider(el){
        var min=+el.min||0, max=+el.max||100, val=+el.value;
        var pct = max>min ? ((val-min)/(max-min))*100 : 0;
        el.style.background='linear-gradient(90deg,var(--bds-accent) '+pct+'%,var(--bds-gray-200) '+pct+'%)';
      }
      function update(){
        var cost=+ins.cost.value, sponsors=+ins.sponsors.value, fee=+ins.fee.value;
        Object.keys(ins).forEach(function(k){ fillSlider(ins[k]); });
        if(out('cost')) out('cost').textContent='$'+fmt(cost);
        if(out('sponsors')) out('sponsors').textContent=sponsors;
        if(out('fee')) out('fee').textContent='$'+fmt(fee);
        var revenue=Math.round(sponsors*fee);     // what the owner earns from sponsors
        var effCost=Math.max(0, cost-revenue);     // their net cost after sponsor income (never below 0)
        if(out('invest')) out('invest').textContent='$'+fmt(cost);
        if(out('earn')) out('earn').textContent='$'+fmt(revenue);
        // Semicircular gauge: % of backdrop cost covered by sponsor revenue.
        var coverRaw = cost>0 ? revenue/cost : 0;
        var coverPct = Math.round(coverRaw*100);
        setNeedle(coverPct);
        if(out('coverpct')) out('coverpct').textContent=coverPct+'%';
        var ee=out('effcost'), se=out('effsub');
        if(ee){
          ee.textContent='$'+fmt(effCost);
          ee.className = effCost>0 ? 'bds-roi-card-v is-amber' : 'bds-roi-card-v is-green';
        }
        if(se){
          if(revenue>=cost && cost>0) se.textContent='+$'+fmt(revenue-cost)+' profit';
          else if(revenue===0) se.textContent='no coverage yet';
          else se.textContent='partially covered';
        }
        if(out('earnsub')) out('earnsub').textContent='from '+sponsors+' sponsor'+(sponsors==1?'':'s');
      }
      Object.keys(ins).forEach(function(k){ ins[k].addEventListener('input',update); });
      update();
      /* v2: count the figures + gauge up from 0 the first time the calculator scrolls into view */
      if('IntersectionObserver' in window && !(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches)){
        var cuDone=false;
        function cfmt(n){ return Math.abs(Math.round(n)).toLocaleString('en-US'); }
        function czero(){ if(needleG) needleG.style.transition='none'; setNeedle(0); if(out('invest'))out('invest').textContent='$0'; if(out('earn'))out('earn').textContent='$0'; if(out('effcost'))out('effcost').textContent='$0'; if(out('coverpct'))out('coverpct').textContent='0%'; }
        function countUp(){
          var cost=+ins.cost.value, sponsors=+ins.sponsors.value, fee=+ins.fee.value;
          var revenue=Math.round(sponsors*fee), effCost=Math.max(0,cost-revenue);
          var coverRaw=cost>0?revenue/cost:0, coverPct=Math.round(coverRaw*100);
          var dur=1500, t0=null;
          function fr(ts){ if(t0===null)t0=ts; var p=Math.min((ts-t0)/dur,1), e=1-Math.pow(1-p,3);
            if(out('invest'))out('invest').textContent='$'+cfmt(cost*e);
            if(out('earn'))out('earn').textContent='$'+cfmt(revenue*e);
            if(out('effcost'))out('effcost').textContent='$'+cfmt(effCost*e);
            if(out('coverpct'))out('coverpct').textContent=Math.round(coverPct*e)+'%';
            setNeedle(coverPct*e);
            if(p<1) requestAnimationFrame(fr); else { if(needleG) needleG.style.transition=''; update(); }
          }
          requestAnimationFrame(fr);
        }
        czero();
        var cio=new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting && !cuDone){ cuDone=true; countUp(); cio.disconnect(); } }); },{threshold:.35});
        cio.observe(root);
      }
    }

    /* ---- FAQ accordion ---- */
    var faq = document.getElementById('bds-faq-{{ uid }}');
    if(faq){
      function setH(item){
        var a=item.querySelector('.bds-faq-a');
        a.style.maxHeight = item.classList.contains('open') ? a.scrollHeight+'px' : '0px';
      }
      faq.querySelectorAll('.bds-faq-item.open').forEach(setH);
      faq.addEventListener('click',function(e){
        var btn=e.target.closest('.bds-faq-q'); if(!btn) return;
        var item=btn.closest('.bds-faq-item');
        var isOpen=item.classList.toggle('open');
        btn.setAttribute('aria-expanded', isOpen?'true':'false');
        setH(item);
      });
      window.addEventListener('resize',function(){ faq.querySelectorAll('.bds-faq-item.open').forEach(setH); });
    }

    /* ---- Lazy video (library video OR YouTube/Vimeo URL/embed code) — wires EVERY .bds-video (hero + section) ---- */
    function bdsExtractSrc(c){ var m=c.match(/src\s*=\s*["']([^"']+)["']/i); return m?m[1]:''; }
    function bdsYtId(u){ var m=u.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/|live\/)|youtu\.be\/)([\w-]{11})/); return m?m[1]:''; }
    function bdsNormalize(u){
      if(!u) return ''; u=u.trim();
      if(/<iframe/i.test(u)){ var s=bdsExtractSrc(u); if(s) u=s; }
      var id=bdsYtId(u); if(id) return 'https://www.youtube.com/embed/'+id+'?autoplay=1&rel=0';
      var vm=u.match(/vimeo\.com\/(?:video\/)?(\d+)/); if(vm) return 'https://player.vimeo.com/video/'+vm[1]+'?autoplay=1';
      if(u.indexOf('http')===0) return u+(u.indexOf('?')>-1?'&':'?')+'autoplay=1';
      return '';
    }
    [].forEach.call(SECT.querySelectorAll('.bds-video'), function(v){
      if(!v.classList.contains('has-poster') && v.getAttribute('data-type')==='embed'){
