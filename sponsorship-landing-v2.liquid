  .bds-v2 .bds-ba-media .bds-ba-photo img{max-height:none}
  @media(max-width:860px){
    .bds-v2 .bds-ba-grid{grid-template-columns:1fr;gap:26px}
    .bds-v2 .bds-ba-cta{margin-top:18px}
  }
  /* "Drag to compare" hint — pulses to invite interaction, fades once dragged */
  .bds-v2 .bds-baslider-hint{position:absolute;left:50%;bottom:16px;transform:translateX(-50%);z-index:4;display:inline-flex;align-items:center;gap:6px;background:rgba(8,15,30,.74);color:#fff;font-size:12px;font-weight:600;letter-spacing:.04em;padding:8px 16px;border-radius:99px;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);box-shadow:0 8px 20px rgba(0,0,0,.45);pointer-events:none;white-space:nowrap;animation:bdsBaHint 2.4s ease-in-out infinite}
  @keyframes bdsBaHint{0%,100%{transform:translateX(-50%) translateY(0);opacity:.9}50%{transform:translateX(-50%) translateY(-4px);opacity:1}}
  .bds-v2 .bds-baslider.is-touched .bds-baslider-hint{opacity:0;animation:none;transition:opacity .3s}
  .bds-v2 .bds-baslider-knob{animation:bdsBaKnob 2.4s ease-in-out infinite}
  .bds-v2 .bds-baslider.is-touched .bds-baslider-knob{animation:none}
  @keyframes bdsBaKnob{0%,100%{box-shadow:0 8px 22px rgba(0,0,0,.45),0 0 0 0 rgba(255,255,255,.5)}50%{box-shadow:0 8px 22px rgba(0,0,0,.45),0 0 0 10px rgba(255,255,255,0)}}
  @media(prefers-reduced-motion:reduce){ .bds-v2 .bds-baslider-hint,.bds-v2 .bds-baslider-knob{animation:none} }
  @media(max-width:560px){ .bds-v2 .bds-baslider-hint{font-size:11px;padding:7px 13px;bottom:12px} }

  /* ════ v2 — ROI compact on mobile (sliders + meter fit one screen) ════ */
  @media(max-width:768px){
    .bds-v2 .bds-roi-wrap2 .bds-section{padding-top:30px;padding-bottom:30px}
    .bds-v2 .bds-roi{gap:16px}
    .bds-v2 .bds-roi-controls,.bds-v2 .bds-roi-results{padding:18px}
    .bds-v2 .bds-roi-ctrl-eyebrow{margin-bottom:14px}
    .bds-v2 .bds-roi .bds-slider{margin-bottom:13px}
    .bds-v2 .bds-roi .bds-slider input[type=range]{margin:8px 0}
    .bds-v2 .bds-roi-ctrl-foot{padding-top:12px;margin-top:2px}
    .bds-v2 .bds-roi-top{margin-bottom:0}
    .bds-v2 .bds-roi-speedo{width:228px;margin-top:0}
    .bds-v2 .bds-roi-speedo-read{margin-top:0}
    .bds-v2 .bds-roi-speedo-read .v{font-size:38px}
    .bds-v2 .bds-roi-speedo-read .l{font-size:11px;margin-top:3px}
    .bds-v2 .bds-roi-cards{gap:10px;margin-top:10px}
    .bds-v2 .bds-roi-card{padding:13px}
    .bds-v2 .bds-roi-card-l{margin-bottom:6px}
    .bds-v2 .bds-roi-cta-wrap{padding-top:14px}
  }
  @media(max-width:480px){
    .bds-v2 .bds-roi .bds-slider-lbl{margin-bottom:4px}
    .bds-v2 .bds-roi-speedo{width:200px}
    .bds-v2 .bds-roi-speedo-read .v{font-size:34px}
  }

  /* ════ v2 — FAQ toggle → chevron: V (closed) flips to ^ (open) ════ */
  .bds-v2 .bds-faqx .bds-faq-ic{border-radius:50%;background:rgba(255,255,255,.12);transition:background .25s ease}
  /* single caret built from a box with right+bottom borders → points down (V) */
  .bds-v2 .bds-faqx .bds-faq-ic::before{content:'';position:absolute;left:50%;top:43%;width:9px;height:9px;background:none;border:0;border-right:2px solid #fff;border-bottom:2px solid #fff;border-radius:1px;transform:translate(-50%,-50%) rotate(45deg);transition:transform .3s ease,top .3s ease}
  .bds-v2 .bds-faqx .bds-faq-ic::after{display:none}
  /* open → flip to point up (^) + accent fill */
  .bds-v2 .bds-faqx .bds-faq-item.open .bds-faq-ic{background:var(--bds-accent);transform:none}
  .bds-v2 .bds-faqx .bds-faq-item.open .bds-faq-ic::before{top:57%;border-color:#fff;transform:translate(-50%,-50%) rotate(-135deg)}
  </style>

  {%- comment -%} ── Inline SVG icons ── {%- endcomment -%}
  {%- capture ic_shield -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>{%- endcapture -%}
  {%- capture ic_camera -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3.5"/></svg>{%- endcapture -%}
  {%- capture ic_store -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9 4.5 4h15L21 9"/><path d="M4 9v10a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9"/><path d="M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"/></svg>{%- endcapture -%}
  {%- capture ic_play -%}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>{%- endcapture -%}
  {%- capture ic_cube -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 3 7v10l9 5 9-5V7z"/><path d="m3 7 9 5 9-5"/><path d="M12 12v10"/></svg>{%- endcapture -%}
  {%- capture ic_trend -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 17 6-6 4 4 8-8"/><path d="M17 7h4v4"/></svg>{%- endcapture -%}
  {%- capture ic_vol -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M19 5a8 8 0 0 1 0 14"/></svg>{%- endcapture -%}

  {%- if sp.hide_theme_header -%}
  <style>
    .shopify-section-group-header-group,.header-section,#shopify-section-header,.announcement-bar,.announcement-bar-section,.utility-bar,.section-header{display:none!important}
  </style>
  <script>
    (function(){
      function hide(el){ if(el&&el.style) el.style.setProperty('display','none','important'); }
      function run(){
        var main=document.getElementById('MainContent');
        /* 1) hide every header-group section (the siblings rendered before the main content) */
        if(main){ var el=main.previousElementSibling; while(el){ if(el.tagName!=='SCRIPT'&&el.tagName!=='STYLE') hide(el); el=el.previousElementSibling; } }
        /* 2) hide any <header> landmark that is not part of this page's content (covers themes without the group wrapper) */
        var hs=document.getElementsByTagName('header'); for(var i=0;i<hs.length;i++){ if(!main||!main.contains(hs[i])) hide(hs[i]); }
        /* 3) hide known header / announcement-bar wrappers by class */
        var sel=document.querySelectorAll('.shopify-section-group-header-group,.header-section,#shopify-section-header,.announcement-bar,.announcement-bar-section,.utility-bar,.section-header');
        for(var j=0;j<sel.length;j++) hide(sel[j]);
      }
      if(document.readyState!=='loading'){ run(); } else { document.addEventListener('DOMContentLoaded',run); }
      setTimeout(run,250);
    })();
  </script>
  {%- endif -%}

  <div class="bds-spon bds-v2" id="bds-spon-{{ uid }}">

    {%- comment -%} ── SUB-NAV (optional) ── {%- endcomment -%}
    {%- if sp.show_nav -%}
    <nav class="bds-nav">
      <a class="bds-nav-logo" href="{{ sp.nav_logo_link | default: '#' }}">
        {%- if sp.nav_logo_image != blank -%}
          <img class="bds-nav-logo-img" src="{{ sp.nav_logo_image | image_url: width: 480 }}" alt="{{ sp.nav_logo_text | default: shop.name | escape }}" width="{{ sp.nav_logo_image.width }}" height="{{ sp.nav_logo_image.height }}" loading="eager">
        {%- else -%}
          {{ ic_camera }} <span class="pre">{{ sp.nav_logo_pre | default: 'Ads by' }}</span> {{ sp.nav_logo_text | default: 'Backdrop' }}<span class="ac">{{ sp.nav_logo_accent | default: 'Source' }}</span>
        {%- endif -%}
      </a>
      <div class="bds-nav-right">
        <div class="bds-nav-links">
          {%- if sp.nav_link1 != blank -%}<a data-scroll="bds-how-{{ uid }}">{{ sp.nav_link1 }}</a>{%- endif -%}
          {%- if sp.nav_link2 != blank -%}<a data-scroll="bds-calc-{{ uid }}">{{ sp.nav_link2 }}</a>{%- endif -%}
          {%- if sp.nav_link_analytics != blank and sp.show_analytics -%}<a data-scroll="bds-an-{{ uid }}">{{ sp.nav_link_analytics }}</a>{%- endif -%}
          {%- if sp.nav_link3 != blank -%}<a data-scroll="bds-faq-{{ uid }}">{{ sp.nav_link3 }}</a>{%- endif -%}
        </div>
        {%- if sp.nav_cta_label != blank -%}
          {%- if sp.owner_mode == 'lead' -%}
          <button type="button" class="bds-nav-cta" data-open-modal data-modal-kind="owner">{{ ic_camera }} {{ sp.nav_cta_label }}</button>
          {%- else -%}
          <a class="bds-nav-cta" href="{{ sp.nav_cta_link | default: sp.owner_btn_link | default: '#' }}">{{ ic_camera }} {{ sp.nav_cta_label }}</a>
          {%- endif -%}
        {%- endif -%}
      </div>
    </nav>
    {%- endif -%}

    {%- comment -%} ── HERO (full-bleed background video + overlaid copy/CTA) ── {%- endcomment -%}
    {%- assign has_hero_video = false -%}
    {%- if sp.hero_video_file != blank or sp.hero_video_url != blank -%}{%- assign has_hero_video = true -%}{%- endif -%}
    {%- assign has_mob_video = false -%}
    {%- if sp.hero_video_file_mobile != blank or sp.hero_video_url_mobile != blank -%}{%- assign has_mob_video = true -%}{%- endif -%}
    {%- assign hv_poster = '' -%}
    {%- if sp.hero_video_poster != blank -%}{%- assign hv_poster = sp.hero_video_poster | image_url: width: 1800 -%}
    {%- elsif sp.hero_video_file != blank and sp.hero_video_file.preview_image != blank -%}{%- assign hv_poster = sp.hero_video_file.preview_image | image_url: width: 1800 -%}{%- endif -%}
    {%- assign hv_poster_mob = hv_poster -%}
    {%- if sp.hero_video_poster_mobile != blank -%}{%- assign hv_poster_mob = sp.hero_video_poster_mobile | image_url: width: 1200 -%}
    {%- elsif sp.hero_video_file_mobile != blank and sp.hero_video_file_mobile.preview_image != blank -%}{%- assign hv_poster_mob = sp.hero_video_file_mobile.preview_image | image_url: width: 1200 -%}{%- endif -%}
    <section class="bds-hero{% if has_mob_video %} has-mobvid{% endif %}">
      {%- if has_hero_video -%}
      <div class="bds-hero-bg bds-hero-bg--desk{% if sp.hero_video_file == blank and sp.hero_video_url != blank %} is-embed{% endif %}" data-hero-bg
          data-type="{% if sp.hero_video_file != blank %}shopify{% elsif sp.hero_video_url != blank %}embed{% else %}none{% endif %}"
          data-embed="{{ sp.hero_video_url | escape }}"
          {% if hv_poster != blank %}style="background-image:url('{{ hv_poster }}')"{% endif %}>
        {%- if sp.hero_video_file != blank -%}{{ sp.hero_video_file | video_tag: autoplay: true, loop: true, muted: true, controls: false, preload: 'auto', image_size: '1600x' }}{%- endif -%}
      </div>
      {%- endif -%}
      {%- if has_mob_video -%}
      <div class="bds-hero-bg bds-hero-bg--mob{% if sp.hero_video_file_mobile == blank and sp.hero_video_url_mobile != blank %} is-embed{% endif %}" data-hero-bg
          data-type="{% if sp.hero_video_file_mobile != blank %}shopify{% elsif sp.hero_video_url_mobile != blank %}embed{% else %}none{% endif %}"
          data-embed="{{ sp.hero_video_url_mobile | escape }}"
          {% if hv_poster_mob != blank %}style="background-image:url('{{ hv_poster_mob }}')"{% endif %}>
        {%- if sp.hero_video_file_mobile != blank -%}{{ sp.hero_video_file_mobile | video_tag: autoplay: true, loop: true, muted: true, controls: false, preload: 'auto', image_size: '1000x' }}{%- endif -%}
      </div>
      {%- endif -%}
      <div class="bds-hero-scrim"></div>
      <div class="bds-hero-inner">
        <div class="bds-hero-content">
          {%- if sp.hero_eyebrow != blank -%}<div class="bds-eyebrow"><div class="bds-pulse"></div><span>{{ sp.hero_eyebrow }}</span></div>{%- endif -%}
          <h1>{{ sp.hero_heading }}</h1>
          {%- if sp.hero_sub != blank -%}<p class="bds-hero-sub">{{ sp.hero_sub }}</p>{%- endif -%}
        </div>

        {%- comment -%} CTA stays on the hero, pinned to the end (bottom) of the video {%- endcomment -%}
        <div class="bds-hero-cta">
          {%- if sp.hero_iam_label != blank and sp.show_sponsor -%}<p class="bds-iam">{{ sp.hero_iam_label }}</p>{%- endif -%}
          {%- capture owner_inner -%}<span class="bds-btn-ic" style="background:rgba(255,255,255,.15)">{{ ic_camera }}</span>{{ sp.owner_btn | default: "I'm a Backdrop Owner" }}{% if sp.owner_btn_tag != blank %}<span class="bds-btn-tag">— {{ sp.owner_btn_tag }}</span>{% endif %}{%- endcapture -%}
          {%- capture sponsor_inner -%}<span class="bds-btn-ic" style="background:rgba(15,37,84,.08);color:var(--bds-navy)">{{ ic_store }}</span>{{ sp.sponsor_btn | default: 'Brand / Sponsor' }}{% if sp.sponsor_btn_tag != blank %}<span class="bds-btn-tag">— {{ sp.sponsor_btn_tag }}</span>{% endif %}{%- endcapture -%}
          <div class="bds-hero-btns">
            {%- if sp.owner_mode == 'lead' -%}
            <button type="button" class="bds-btn bds-btn--primary" data-open-modal data-modal-kind="owner">{{ owner_inner }}</button>
            {%- else -%}
            <a class="bds-btn bds-btn--primary" href="{{ sp.owner_btn_link | default: '#' }}">{{ owner_inner }}</a>
            {%- endif -%}
            {%- if sp.show_sponsor -%}
              {%- if sp.sponsor_mode == 'lead' -%}
              <button type="button" class="bds-btn bds-btn--white" data-open-modal data-modal-kind="sponsor">{{ sponsor_inner }}</button>
              {%- else -%}
              <a class="bds-btn bds-btn--white" href="{{ sp.sponsor_btn_link | default: '#' }}">{{ sponsor_inner }}</a>
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- if has_hero_video or has_mob_video -%}
      <button type="button" class="bds-hero-audio" data-hero-audio aria-pressed="false" aria-label="Turn on video sound">{{ ic_vol }}<span data-audio-label>{{ sp.hero_audio_label | default: 'Turn on sound' }}</span></button>
      {%- endif -%}
    </section>

    {%- comment -%} ── HERO BAR: full-width counters below the video ── {%- endcomment -%}
    {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
    {%- if stat_blocks.size > 0 -%}
    <section class="bds-herobar">
      <div class="bds-stats">
        {%- for block in stat_blocks -%}
        <div class="bds-stat" {{ block.shopify_attributes }}>
          <div class="bds-stat-num"><span class="bds-stat-figure">{{ block.settings.value }}</span>{% if block.settings.badge2 != blank %}<span class="bds-stat-badge">{{ block.settings.badge2 }}</span>{% endif %}</div>
          <div class="bds-stat-label">{{ block.settings.label }}</div>
        </div>
        {%- endfor -%}
      </div>
    </section>
    {%- endif -%}

    {%- comment -%} ── TRUST BAR ── {%- endcomment -%}
    {%- assign trust_blocks = section.blocks | where: 'type', 'trust' -%}
    {%- if trust_blocks.size > 0 -%}
    <div class="bds-trust bds-trustmq">
      <div class="bds-trustmq-track">
        {%- for pass in (1..2) -%}
          {%- for block in trust_blocks -%}<div class="bds-trust-item"{% if pass == 1 %} {{ block.shopify_attributes }}{% else %} aria-hidden="true"{% endif %}>{{ ic_shield }} {{ block.settings.text }}</div>{%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
    {%- endif -%}

    {%- comment -%} ── HOW IT WORKS (6 steps, from settings) ── {%- endcomment -%}
    {%- if sp.step1_t != blank or sp.step2_t != blank or sp.step3_t != blank -%}
    <section class="bds-section" id="bds-how-{{ uid }}">
      {%- if sp.how_label != blank -%}<div class="bds-label">{{ sp.how_label }}</div>{%- endif -%}
      {%- if sp.how_title_v2 != blank -%}<div class="bds-title">{{ sp.how_title_v2 }}</div>{%- endif -%}
      {%- if sp.how_sub_v2 != blank -%}<div class="bds-sub">{{ sp.how_sub_v2 }}</div>{%- endif -%}
      <div class="bds-steps">
        {%- assign n = 0 -%}
        {%- if sp.step1_t != blank -%}{%- assign n = n | plus: 1 -%}<div class="bds-step"><div class="bds-step-num">{{ n }}</div><div class="bds-step-title">{{ sp.step1_t }}</div><div class="bds-step-body">{{ sp.step1_b }}</div></div>{%- endif -%}
        {%- if sp.step2_t != blank -%}{%- assign n = n | plus: 1 -%}<div class="bds-step"><div class="bds-step-num">{{ n }}</div><div class="bds-step-title">{{ sp.step2_t }}</div><div class="bds-step-body">{{ sp.step2_b2 | default: sp.step2_b }}</div></div>{%- endif -%}
        {%- if sp.step3_t != blank -%}{%- assign n = n | plus: 1 -%}<div class="bds-step"><div class="bds-step-num">{{ n }}</div><div class="bds-step-title">{{ sp.step3_t }}</div><div class="bds-step-body">{{ sp.step3_b }}</div></div>{%- endif -%}
        {%- if sp.step4_t != blank -%}{%- assign n = n | plus: 1 -%}<div class="bds-step"><div class="bds-step-num">{{ n }}</div><div class="bds-step-title">{{ sp.step4_t }}</div><div class="bds-step-body">{{ sp.step4_b }}</div></div>{%- endif -%}
        {%- if sp.step5_t != blank -%}{%- assign n = n | plus: 1 -%}<div class="bds-step"><div class="bds-step-num">{{ n }}</div><div class="bds-step-title">{{ sp.step5_t }}</div><div class="bds-step-body">{{ sp.step5_b }}</div></div>{%- endif -%}
        {%- if sp.step6_t != blank -%}{%- assign n = n | plus: 1 -%}<div class="bds-step"><div class="bds-step-num">{{ n }}</div><div class="bds-step-title">{{ sp.step6_t }}</div><div class="bds-step-body">{{ sp.step6_b2 | default: sp.step6_b }}</div></div>{%- endif -%}
      </div>
    </section>
    {%- endif -%}

    {%- comment -%} ── OWNER ANALYTICS (live data + phone mockup) ── {%- endcomment -%}
    {%- if sp.show_analytics -%}
    <section class="an-wrap" id="bds-an-{{ uid }}">
      <canvas class="an-canvas" id="bds-an-canvas-{{ uid }}"></canvas>
      <div class="an-inner">
        {%- if sp.an_label != blank -%}<div class="an-label">{{ sp.an_label }}</div>{%- endif -%}
        {%- assign an_title_v = sp.an_title2 | default: sp.an_title -%}
        {%- if an_title_v != blank -%}<h2 class="an-title">{{ an_title_v }}</h2>{%- endif -%}
        {%- if sp.an_sub != blank -%}<p class="an-sub">{{ sp.an_sub }}</p>{%- endif -%}

        <div class="an-grid">
          {%- comment -%} LEFT: copy + CTA {%- endcomment -%}
          <div class="an-content">
            {%- if sp.an_flag != blank -%}<div class="an-flag"><div class="an-pulse"></div><span>{{ sp.an_flag }}</span></div>{%- endif -%}
            {%- if sp.an_h != blank -%}<h3 class="an-h">{{ sp.an_h }}</h3>{%- endif -%}
            {%- if sp.an_p != blank -%}<p class="an-p">{{ sp.an_p }}</p>{%- endif -%}
            {%- if sp.an_tag != blank -%}<div class="an-tag">{{ sp.an_tag }}</div>{%- endif -%}
            {%- if sp.an_bullets != blank -%}
            <ul class="an-list">
              {%- assign an_items = sp.an_bullets | newline_to_br | strip_newlines | split: '<br />' -%}
              {%- for it in an_items -%}{%- assign li = it | strip -%}{%- if li != blank -%}<li>{{ li }}</li>{%- endif -%}{%- endfor -%}
            </ul>
            {%- endif -%}
            <button class="an-cta" type="button" data-open-modal data-modal-kind="analytics">{{ sp.an_cta | default: 'Get early access →' }}</button>
          </div>

          {%- comment -%} RIGHT: phone dashboard (decorative) {%- endcomment -%}
          <div class="an-phone-col">
            <div class="an-phone-glow">
              {%- if sp.an_phone_image != blank -%}
              <img class="an-phone-img" src="{{ sp.an_phone_image | image_url: width: 900 }}" alt="{{ sp.an_title | default: 'Owner Analytics' | strip_html | escape }}" width="400" loading="lazy">
              {%- else -%}
              <div class="an-phone">
                <div class="an-screen">
                  <div class="an-glare"></div>
                  <div class="an-island"></div>
                  <div class="an-ph">
                    <div><div class="an-ph-t">BS Analytics</div><div class="an-ph-s">{{ sp.an_phone_event | default: 'Live · Summer Gala 2025' }}</div></div>
                    <div class="an-ph-logo">BS</div>
                  </div>
                  <div class="an-pb">
                    <div class="an-pg2">
                      <div class="an-pc"><div class="an-pc-l">Total Footfall</div><div class="an-pc-v">14.2K</div><div class="an-pc-u">↑ 18% this week</div></div>
                      <div class="an-pc"><div class="an-pc-l">Unique Views</div><div class="an-pc-v">8,741</div><div class="an-pc-u">↑ 11% this week</div></div>
                    </div>
                    <div class="an-pg2">
                      <div class="an-pc"><div class="an-pc-l">Attention Rate</div><div class="an-pc-v">73%</div><div class="an-pc-u">↑ 6% vs last</div></div>
