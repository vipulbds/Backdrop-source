{% comment %}
  SEG Comparison Section
  Fully customizable from Shopify Admin — Theme Editor
{% endcomment %}

<section
  class="seg-comparison"
  style="
    --bg-color: {{ section.settings.bg_color }};
    --left-bg-color: {{ section.settings.left_bg_color }};
    --accent-color: {{ section.settings.accent_color }};
    --text-primary: {{ section.settings.text_primary }};
    --text-secondary: {{ section.settings.text_secondary }};
    --text-muted: {{ section.settings.text_muted }};
    --table-bg: {{ section.settings.table_bg }};
    --table-border: {{ section.settings.table_border_color }};
    --highlight-bg: {{ section.settings.highlight_bg }};
    --highlight-text: {{ section.settings.highlight_text }};
    --positive-color: {{ section.settings.positive_color }};
    --negative-color: {{ section.settings.negative_color }};
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="seg-comparison__inner">

    {%- comment -%} LEFT PANEL {%- endcomment -%}
    <div class="seg-comparison__left">
      {% if section.settings.eyebrow != blank %}
        <p class="seg-comparison__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      <h2 class="seg-comparison__headline">
        {% if section.settings.headline_line1 != blank %}
          <span class="seg-comparison__headline-line">{{ section.settings.headline_line1 }}</span>
        {% endif %}
        {% if section.settings.headline_line2 != blank %}
          <span class="seg-comparison__headline-line">{{ section.settings.headline_line2 }}</span>
        {% endif %}
        {% if section.settings.headline_line3 != blank %}
          <span class="seg-comparison__headline-line seg-comparison__headline-line--italic">{{ section.settings.headline_line3 }}</span>
        {% endif %}
      </h2>

      {% if section.settings.body_text != blank %}
        <p class="seg-comparison__body">{{ section.settings.body_text }}</p>
      {% endif %}

      {% if section.settings.show_cta and section.settings.cta_label != blank %}
        <a
          href="{{ section.settings.cta_url }}"
          class="seg-comparison__cta"
          style="background-color: {{ section.settings.accent_color }}; color: {{ section.settings.cta_text_color }};"
        >
          {{ section.settings.cta_label }}
        </a>
      {% endif %}
    </div>

    {%- comment -%} RIGHT PANEL — TABLE {%- endcomment -%}
    <div class="seg-comparison__right">
      <div class="seg-comparison__table-wrap">
        <table class="seg-comparison__table" role="table">

          {%- comment -%} HEADER ROW {%- endcomment -%}
          <thead>
            <tr class="seg-comparison__header-row">
              <th class="seg-comparison__th seg-comparison__th--label" scope="col">
                {{ section.settings.product_label }}
              </th>
              <th class="seg-comparison__th seg-comparison__th--us" scope="col">
                <span class="seg-comparison__badge">{{ section.settings.col_us }}</span>
              </th>
              <th class="seg-comparison__th" scope="col">{{ section.settings.col_a }}</th>
              <th class="seg-comparison__th" scope="col">{{ section.settings.col_b }}</th>
              <th class="seg-comparison__th" scope="col">{{ section.settings.col_c }}</th>
            </tr>
          </thead>

          {%- comment -%} DATA ROWS {%- endcomment -%}
          <tbody>
            {% for block in section.blocks %}
              {% case block.type %}

                {% when 'row' %}
                  <tr class="seg-comparison__row" {{ block.shopify_attributes }}>
                    <td class="seg-comparison__td seg-comparison__td--label">{{ block.settings.row_label }}</td>

                    {%- comment -%} US Column {%- endcomment -%}
                    <td class="seg-comparison__td seg-comparison__td--us">
                      {% if block.settings.us_icon == 'check' %}
                        <span class="seg-comparison__icon seg-comparison__icon--check" aria-label="Yes">
                          {% if block.settings.us_value != blank %}
                            <svg width="12" height="10" viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 5L4.5 8.5L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            {{ block.settings.us_value }}
                          {% else %}
                            <svg width="12" height="10" viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 5L4.5 8.5L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          {% endif %}
                        </span>
                      {% elsif block.settings.us_icon == 'cross' %}
                        <span class="seg-comparison__icon seg-comparison__icon--cross" aria-label="No">✕</span>
                      {% else %}
                        <span class="seg-comparison__value {% if block.settings.us_bold %}seg-comparison__value--bold{% endif %}">{{ block.settings.us_value }}</span>
                      {% endif %}
                    </td>

                    {%- comment -%} Comp A Column {%- endcomment -%}
                    <td class="seg-comparison__td">
                      {% if block.settings.a_icon == 'check' %}
                        <span class="seg-comparison__icon seg-comparison__icon--check" aria-label="Yes">
                          {% if block.settings.a_value != blank %}
                            <svg width="12" height="10" viewBox="0 0 12 10" fill="none"><path d="M1 5L4.5 8.5L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            {{ block.settings.a_value }}
                          {% else %}
                            <svg width="12" height="10" viewBox="0 0 12 10" fill="none"><path d="M1 5L4.5 8.5L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          {% endif %}
                        </span>
                      {% elsif block.settings.a_icon == 'cross' %}
                        <span class="seg-comparison__icon seg-comparison__icon--cross" aria-label="No">✕</span>
                      {% elsif block.settings.a_color == 'negative' %}
                        <span class="seg-comparison__value seg-comparison__value--negative">{{ block.settings.a_value }}</span>
                      {% else %}
                        <span class="seg-comparison__value">{{ block.settings.a_value }}</span>
                      {% endif %}
                    </td>

                    {%- comment -%} Comp B Column {%- endcomment -%}
                    <td class="seg-comparison__td">
                      {% if block.settings.b_icon == 'check' %}
                        <span class="seg-comparison__icon seg-comparison__icon--check">
                          {% if block.settings.b_value != blank %}
                            <svg width="12" height="10" viewBox="0 0 12 10" fill="none"><path d="M1 5L4.5 8.5L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            {{ block.settings.b_value }}
                          {% else %}
                            <svg width="12" height="10" viewBox="0 0 12 10" fill="none"><path d="M1 5L4.5 8.5L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          {% endif %}
                        </span>
                      {% elsif block.settings.b_icon == 'cross' %}
                        <span class="seg-comparison__icon seg-comparison__icon--cross">✕</span>
                      {% elsif block.settings.b_color == 'negative' %}
                        <span class="seg-comparison__value seg-comparison__value--negative">{{ block.settings.b_value }}</span>
                      {% else %}
                        <span class="seg-comparison__value">{{ block.settings.b_value }}</span>
                      {% endif %}
                    </td>

                    {%- comment -%} Comp C Column {%- endcomment -%}
                    <td class="seg-comparison__td">
                      {% if block.settings.c_icon == 'check' %}
                        <span class="seg-comparison__icon seg-comparison__icon--check">
                          {% if block.settings.c_value != blank %}
                            <svg width="12" height="10" viewBox="0 0 12 10" fill="none"><path d="M1 5L4.5 8.5L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            {{ block.settings.c_value }}
                          {% else %}
                            <svg width="12" height="10" viewBox="0 0 12 10" fill="none"><path d="M1 5L4.5 8.5L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          {% endif %}
                        </span>
                      {% elsif block.settings.c_icon == 'cross' %}
                        <span class="seg-comparison__icon seg-comparison__icon--cross">✕</span>
                      {% elsif block.settings.c_color == 'negative' %}
                        <span class="seg-comparison__value seg-comparison__value--negative">{{ block.settings.c_value }}</span>
                      {% else %}
                        <span class="seg-comparison__value">{{ block.settings.c_value }}</span>
                      {% endif %}
                    </td>
                  </tr>

              {% endcase %}
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>

<style>
  /* =========================================================
     SEG COMPARISON SECTION — SCOPED STYLES
  ========================================================= */
  .seg-comparison {
    background-color: var(--bg-color, #131313);
    padding-top: var(--section-padding-top, 72px);
    padding-bottom: var(--section-padding-bottom, 72px);
    font-family: inherit;
    color: var(--text-primary, #ffffff);
    overflow: hidden;
  }

  .seg-comparison__inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 48px;
    align-items: center;
  }

  /* ---- LEFT PANEL ---- */
  .seg-comparison__eyebrow {
    font-family: inherit;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent-color, #e03c31);
    margin: 0 0 18px;
    font-style: normal;
    font-weight: 400;
  }

  .seg-comparison__headline {
    font-size: clamp(36px, 4.5vw, 58px);
    line-height: 1.08;
    margin: 0 0 20px;
    font-weight: 400;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .seg-comparison__headline-line {
    display: block;
    color: var(--text-primary, #ffffff);
  }

  .seg-comparison__headline-line--italic {
    font-style: italic;
    color: var(--accent-color, #e03c31);
  }

  .seg-comparison__body {
    font-family: inherit;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted, #999999);
    margin: 0 0 28px;
    max-width: 380px;
  }

  .seg-comparison__cta {
    display: inline-block;
    padding: 12px 28px;
    border-radius: 4px;
    font-family: inherit;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .seg-comparison__cta:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  /* ---- RIGHT PANEL — TABLE ---- */
  .seg-comparison__right {
    overflow: hidden;
  }

  .seg-comparison__table-wrap {
    background: var(--table-bg, #1e1e1e);
    border-radius: 12px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--table-border, #2a2a2a);
  }

  .seg-comparison__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    min-width: 480px;
  }

  /* ---- HEADER ---- */
  .seg-comparison__header-row {
    border-bottom: 1px solid var(--table-border, #2a2a2a);
  }

  .seg-comparison__th {
    padding: 16px 14px;
    font-family: inherit;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted, #888);
    font-weight: 400;
    text-align: center;
  }

  .seg-comparison__th--label {
    text-align: left;
    width: 30%;
  }

  .seg-comparison__th--us {
    text-align: center;
  }

  .seg-comparison__badge {
    display: inline-block;
    background-color: var(--accent-color, #e03c31);
    color: var(--highlight-text, #ffffff);
    padding: 4px 18px;
    border-radius: 4px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
  }

  /* ---- DATA ROWS ---- */
  .seg-comparison__row {
    border-bottom: 1px solid var(--table-border, #2a2a2a);
    transition: background-color 0.15s ease;
  }

  .seg-comparison__row:last-child {
    border-bottom: none;
  }

  .seg-comparison__row:hover {
    background-color: rgba(255,255,255,0.03);
  }

  .seg-comparison__td {
    padding: 18px 14px;
    text-align: center;
    font-family: inherit;
    font-size: 13px;
    color: var(--text-secondary, #cccccc);
    vertical-align: middle;
  }

  .seg-comparison__td--label {
    text-align: left;
    color: var(--text-secondary, #bbbbbb);
    font-size: 13px;
  }

  .seg-comparison__td--us {
    text-align: center;
  }

  /* ---- VALUES ---- */
  .seg-comparison__value {
    display: inline-block;
  }

  .seg-comparison__value--bold {
    font-weight: 700;
    font-size: 15px;
    color: var(--text-primary, #ffffff);
  }

  .seg-comparison__value--negative {
    color: var(--negative-color, #e03c31);
  }

  /* ---- ICONS ---- */
  .seg-comparison__icon {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
  }

  .seg-comparison__icon--check {
    color: var(--positive-color, #4caf7a);
  }

  .seg-comparison__icon--cross {
    color: var(--negative-color, #e03c31);
    font-size: 12px;
  }

  /* =========================================================
     RESPONSIVE
  ========================================================= */
  @media screen and (max-width: 1024px) {
    .seg-comparison__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .seg-comparison__headline {
      font-size: clamp(32px, 5vw, 48px);
    }

    .seg-comparison__body {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 600px) {
    .seg-comparison {
      padding-top: calc(var(--section-padding-top, 72px) * 0.65);
      padding-bottom: calc(var(--section-padding-bottom, 72px) * 0.65);
    }

    .seg-comparison__inner {
      padding: 0 16px;
      gap: 32px;
    }

    .seg-comparison__headline {
      font-size: clamp(28px, 8vw, 40px);
    }

    .seg-comparison__th,
    .seg-comparison__td {
      padding: 14px 10px;
      font-size: 11px;
    }

    .seg-comparison__td--label {
      font-size: 12px;
    }

    .seg-comparison__value--bold {
      font-size: 13px;
    }
  }

  @media screen and (max-width: 420px) {
    .seg-comparison__table {
      min-width: 380px;
    }
  }
</style>


{% schema %}
