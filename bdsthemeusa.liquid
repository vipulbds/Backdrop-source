  <script>

  /* Modal Pop Up */
  const openEls = document.querySelectorAll("[data-open]");
  const closeEls = document.querySelectorAll("[data-close]");
  const isVisible = "is-visible";

  function resetModalAfterSubmit(modal) {
    if (!modal || modal.getAttribute("data-reset-on-open") !== "1") return;

    modal.querySelectorAll("form").forEach(form => form.reset());
    modal.querySelectorAll("input[type='hidden']").forEach(input => {
      if (input.id === "g-recaptcha-response" || input.id === "g-recaptcha-response-bulk-enq" || input.id === "requestfileinput") {
        input.value = "";
      }
    });

    modal.dispatchEvent(new CustomEvent("modal:reset-after-submit"));
    modal.removeAttribute("data-reset-on-open");
  }

  function showModal(modal) {
    if (!modal) return;
    resetModalAfterSubmit(modal);
    modal.style.display = "";
    modal.classList.add(isVisible);
  }

  function hideModal(modal) {
    if (!modal) return;
    modal.classList.remove(isVisible);
    modal.style.display = "";
  }

  for (const el of openEls) {
    el.addEventListener("click", function(e) {
      const modalId = this.dataset.open;
      const modal = document.getElementById(modalId);
      if (!modal) return;
      e.preventDefault();
      showModal(modal);
    });
  }

  for (const el of closeEls) {
    el.addEventListener("click", function() {
      hideModal(this.closest(".modal"));
    });
  }

  document.addEventListener("click", e => {
    const visibleModal = document.querySelector(".modal.is-visible");
    if (e.target === visibleModal) {
      hideModal(visibleModal);
    }
  });

  document.addEventListener("keyup", e => {
    const visibleModal = document.querySelector(".modal.is-visible");
    if (e.key === "Escape" && visibleModal) {
      hideModal(visibleModal);
    }
  });
    
    
    
