}
#psb-{{ block.id }} .psb-option-control {
  width: 100%;
}
@container psb-cnt (max-width: 360px) {
  #psb-{{ block.id }} .psb-option-row {
    grid-template-columns: 1fr;
    gap: 4px;
  }
}
@media (max-width: 400px) {
  #psb-{{ block.id }} .psb-option-row {
