/* ═══ ADD TO CART ═══ */
#psb-{{ block.id }} .psb-cart-block {
  margin: 16px 0 12px;
}
#psb-{{ block.id }} .psb-cart-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 16px 20px;
