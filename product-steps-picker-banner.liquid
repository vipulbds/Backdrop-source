var SURLS = [
  'https://script.google.com/macros/s/AKfycbyr8HLOBRhWEVINMGSPgJXwMAP638vg5Lni2tpwsSVHAvUSXPJ2kqABi0pRb2br0j20/exec',
  'https://script.google.com/macros/s/AKfycbxNU0RTh63GR5v1woeu8I_r2MAVLqrTJ8GFT8O1qs2gBjW0CcgD62ON2oQgAKYOhQcj/exec'
];
var CURL = 'https://script.google.com/macros/s/AKfycbysdhq2w-U1_HhSkCQceMuwEDMGjL5lJUMtZWQ7LQIYaXe0E50vhOTebHLp6jr4v1Ofuw/exec';
var ESVC = 'service_t2nlztf';
var ejP = null;
function ensEJ(){
  if (window.emailjs) return Promise.resolve();
  if (ejP) return ejP;
  ejP = new Promise(function(res, rej){
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/emailjs-com@3/dist/email.min.js';
    s.async = true;
    s.onload = res; s.onerror = rej;
    document.head.appendChild(s);
  });
  return ejP;
}
async function getCtr(ft){
  try {
    var d = await re('ctr', async function(){
      var r = await fetch(CURL + '?country=USA&formType=' + ft, { method: 'GET', redirect: 'follow' });
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    }, 3, 700);
    return d.counter || '0';
  } catch(e){ return '0'; }
}
async function subSheets(p){
  await Promise.all(SURLS.map(function(u){
    return re('sh', async function(){
      await fetch(u, { method: 'POST', mode: 'no-cors', headers: {'Content-Type':'application/x-www-form-urlencoded'}, body: p });
    }, 3, 700);
  }));
}
function mkP(tok, d, tgt){
  return new URLSearchParams({
    requestId: tok, country: 'USA', customerName: d.n, emailId: d.e, phoneNumber: d.ph || '',
    customerCity: d.gc || '', customerState: d.gs || '', customerTimezone: d.gz || '',
    customerTime: d.gt || '', target: tgt, origin: window.location.origin, token: tok
  });
}
function showSt(k, st){
  ['ld','sc','er'].forEach(function(s){
    var el = $i('psb-' + k + '-' + s + '-' + B);
    if (el) el.classList.toggle('psb-state-on', s === st);
  });
  var f = $i('psb-' + k + '-f-' + B);
  if (f) f.style.display = (st === 'sc' || st === 'ld') ? 'none' : '';
}

