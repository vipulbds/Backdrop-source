/* ═══════════════════════════════════════════════════════════════
   UPLOAD ARTWORK MODAL — sidebar-tabs design
═══════════════════════════════════════════════════════════════ */

.psb-up-modal-box { max-width: 920px; }
.psb-up-modal-body { padding: 0 !important; }

.psb-up-layout {
  display: grid;
  grid-template-columns: 220px 1fr;
  min-height: 460px;
  background: #fff;
}

/* Vertical tab rail (desktop) — FIXED-HEIGHT buttons with absolutely-positioned
   icon and label. The button is a 110px-tall box; icon pins to the top, label
   pins to the bottom. Overlap is mathematically impossible regardless of any
   inherited host theme CSS, because the icon's max bottom is well above the
   label's max top inside a fixed container. */
.psb-up-tabs-v {
  background: #0A3161 !important;
  padding: 16px 12px !important;
  display: block !important;
}
.psb-up-tab2 {
  position: relative !important;
  display: block !important;
  width: 100% !important;
  height: 110px !important;
  background: transparent !important;
  border: 0 !important;
  border-radius: 8px !important;
  padding: 0 !important;
  margin: 0 0 12px 0 !important;
  cursor: pointer !important;
  color: #fff !important;
  font-family: inherit !important;
  text-align: center !important;
  box-sizing: border-box !important;
  overflow: visible !important;
}
.psb-up-tab2:last-child { margin-bottom: 0 !important; }
.psb-up-tab2:hover { background: rgba(255,255,255,.05) !important; }
.psb-up-tab2-on { background: rgba(255,255,255,.06) !important; }
.psb-up-tab2:focus-visible {
  outline: 2px solid {{ accent_color }} !important;
  outline-offset: 2px !important;
}

/* Active-tab maroon indicator on the left edge of the sidebar */
.psb-up-tab2-on::before {
  content: '' !important;
  position: absolute !important;
  left: -12px !important;
  top: 10px !important;
  bottom: 10px !important;
  width: 3px !important;
  background: {{ accent_color }} !important;
  border-radius: 0 2px 2px 0 !important;
}

/* Icon tile — pinned to the top, horizontally centered */
.psb-up-tab2-icon {
  position: absolute !important;
  top: 6px !important;
  left: 50% !important;
  transform: translateX(-50%) !important;
  width: 56px !important;
  height: 56px !important;
  border-radius: 12px !important;
  background: rgba(255,255,255,.06) !important;
  border: 1px solid rgba(255,255,255,.16) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 !important;
  margin: 0 !important;
  box-sizing: border-box !important;
  transition: background .2s, border-color .2s !important;
}
.psb-up-tab2-icon svg {
  width: 24px !important;
  height: 24px !important;
  color: #fff !important;
  display: block !important;
}
.psb-up-tab2-on .psb-up-tab2-icon {
  background: {{ accent_color }} !important;
  border-color: {{ accent_color }} !important;
  box-shadow: 0 6px 14px rgba(131,34,69,.4) !important;
}

/* Label — pinned to the bottom of the 110px button, full width */
.psb-up-tab2-label {
  position: absolute !important;
  bottom: 10px !important;
  left: 0 !important;
  right: 0 !important;
  display: block !important;
  font-size: 13px !important;
  font-weight: 600 !important;
  color: #fff !important;
  line-height: 1.2 !important;
  letter-spacing: .01em !important;
  text-align: center !important;
  margin: 0 !important;
  padding: 0 4px !important;
  box-sizing: border-box !important;
}

/* Content area */
.psb-up-content {
  background: #fff;
  padding: 22px;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

/* Per-panel banner header */
.psb-up-banner {
  display: flex;
  align-items: center;
  gap: 14px;
  background: #0A3161;
  color: #fff;
  padding: 14px 18px;
  border-radius: 10px;
  margin-bottom: 18px;
}
.psb-up-banner-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: rgba(255,255,255,.12);
  flex-shrink: 0;
}
.psb-up-banner-icon svg {
  width: 22px;
  height: 22px;
  color: #fff;
  display: block;
}
.psb-up-banner-text { min-width: 0; }
.psb-up-banner-text strong {
  display: block;
  font-size: 16px;
  font-weight: 700;
  line-height: 1.2;
  margin: 0 0 2px;
}
.psb-up-banner-text p {
  margin: 0;
  font-size: 13px;
  opacity: .85;
  line-height: 1.35;
}

/* Drag-drop zone — clean gray dashed border + light gray background (matches image 2) */
.psb-up-content .psb-up-dz {
  border: 2px dashed #C8CEDC;
  border-radius: 12px;
  padding: 36px 16px;
  background: #FAFBFD;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  min-height: 220px;
  cursor: pointer;
  margin-bottom: 0;
  transition: border-color .2s, background .2s;
}
.psb-up-content .psb-up-dz:hover,
.psb-up-content .psb-up-dz:focus-visible,
.psb-up-content .psb-up-dz.psb-dragover {
  border-color: var(--psb-navy);
  background: #F1F5FB;
  outline: none;
}
.psb-up-content .psb-up-dz-icon { width: 48px; height: 48px; color: #94a3b8; }
.psb-up-content .psb-up-dz-title { font-size: 16px; color: var(--psb-text); }
.psb-up-content .psb-up-or { font-size: 12px; font-weight: 600; color: #94a3b8; letter-spacing: .08em; }
/* Browse Files — solid navy (matches image 2 reference) */
.psb-up-content .psb-cta-dark {
  background: var(--psb-navy);
  color: #fff;
  border: 0;
  border-radius: 10px;
  padding: 12px 28px;
  font-family: inherit;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  transition: background .2s, transform .15s;
}
.psb-up-content .psb-cta-dark:hover { background: #052852; transform: translateY(-1px); }

/* Footer with note + save button (sits in content column) */
.psb-up-content .psb-up-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  margin-top: 22px;
  padding-top: 16px;
  border-top: 1.5px solid #E8ECF4;
  flex-wrap: wrap;
}
.psb-up-content .psb-up-foot-note {
  font-size: 12px;
  color: #94a3b8;
  flex: 1 1 220px;
  min-width: 0;
}
.psb-up-content .psb-up-save {
  width: auto;
  min-width: 180px;
  margin-top: 0;
  flex: 0 0 auto;
}

/* Mobile / narrow: tabs go horizontal across the top — undo the fixed-height
   absolute layout from desktop and switch to flex row */
@media (max-width: 720px) {
  .psb-up-layout { grid-template-columns: 1fr !important; min-height: auto !important; }
  .psb-up-tabs-v {
    display: flex !important;
    flex-direction: row !important;
    justify-content: stretch !important;
    gap: 8px !important;
    padding: 12px !important;
  }
  .psb-up-tab2 {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    flex: 1 1 0 !important;
    height: auto !important;
    margin: 0 !important;
    padding: 10px 4px !important;
  }
  .psb-up-tab2-icon {
    position: static !important;
    transform: none !important;
    top: auto !important;
    left: auto !important;
    width: 44px !important;
    height: 44px !important;
    border-radius: 10px !important;
    margin: 0 0 8px 0 !important;
  }
  .psb-up-tab2-icon svg { width: 20px !important; height: 20px !important; }
  .psb-up-tab2-label {
    position: static !important;
    bottom: auto !important;
    left: auto !important;
    right: auto !important;
    font-size: 12px !important;
  }
  .psb-up-tab2-on::before {
    /* On mobile, indicator goes on the bottom edge instead of the left */
    left: 12px !important;
    right: 12px !important;
    top: auto !important;
    bottom: -6px !important;
    width: auto !important;
    height: 3px !important;
    border-radius: 2px !important;
  }
  .psb-up-content { padding: 16px; }
  .psb-up-banner { padding: 12px 14px; border-radius: 8px; margin-bottom: 14px; }
  .psb-up-banner-icon { width: 38px; height: 38px; }
  .psb-up-banner-text strong { font-size: 15px; }
  .psb-up-banner-text p { font-size: 12px; }
  .psb-up-content .psb-up-dz { padding: 26px 14px; min-height: 180px; }
  .psb-up-content .psb-up-foot { flex-direction: column; align-items: stretch; gap: 10px; }
  .psb-up-content .psb-up-save { width: 100%; min-width: 0; }
  .psb-up-content .psb-up-foot-note { flex: 0 0 auto; text-align: center; }
}
@media (max-width: 420px) {
  .psb-up-tab2-label { font-size: 11px !important; letter-spacing: 0 !important; }
  .psb-up-tab2-icon { width: 38px !important; height: 38px !important; }
  .psb-up-tab2-icon svg { width: 18px !important; height: 18px !important; }
}
</style>

<script>
(function(){
'use strict';

var B    = {{ block.id | json }};
var SID  = {{ section.id | json }};
var PROD = {{ product.title | json }};
var PURL = {{ shop.domain | json }} + {{ product.url | json }};
var PROD_DEFAULT_VID = {{ product.selected_or_first_available_variant.id | json }};
var MONEY_FMT = {{ shop.money_format | json }};

var COLLECTION = {{ product.metafields.custom.pricing_collection | default: '' | json }};
var DEFAULT_PRICE = parseFloat({{ product.metafields.custom.default_price | default: 0 | json }}) || 0;
var MAX_AREA = parseFloat({{ product.metafields.custom.max_area_ft | default: 300 | json }}) || 300;
var DELIVERY_DAYS = parseInt({{ block.settings.delivery_days | default: 7 | json }}, 10);

/* ─────────── PRODUCT VARIANTS ───────────
   Pre-built from product.variants so the picker can look up the matching variant
   from ANY combination of option selections (Color / Size / Material / …).
   Each entry: { id, price, available, option1, option2, option3, title } */
var VARIANTS = [
  {%- for v in product.variants -%}
    {
      id: {{ v.id | json }},
      price: parseFloat({{ v.price | money_without_currency | json }}) || 0,
      available: {{ v.available | json }},
      option1: {{ v.option1 | json }},
      option2: {{ v.option2 | json }},
      option3: {{ v.option3 | json }},
      title: {{ v.title | json }}
    }{%- unless forloop.last %},{% endunless -%}
  {%- endfor -%}
];
var currentVariant = null;

/* ─────────── PER-UNIT RATES (overrides TIERS when > 0) ───────────
   When the customer picks a unit, price = (raw area in that unit) × rate.
   Leave the matching block setting at 0 to fall back to TIERS (ft-based). */
var UNIT_RATES = {
  ft:   parseFloat({{ block.settings.rate_ft   | default: 0 | json }}) || 0,
  m:    parseFloat({{ block.settings.rate_m    | default: 0 | json }}) || 0,
  cm:   parseFloat({{ block.settings.rate_cm   | default: 0 | json }}) || 0,
  mm:   parseFloat({{ block.settings.rate_mm   | default: 0 | json }}) || 0,
  inch: parseFloat({{ block.settings.rate_inch | default: 0 | json }}) || 0
};

/* ─────────── PRICING TIERS ───────────
   Built from BOTH 'pricing_tier' blocks (legacy) AND 'width_range' blocks (new).
   Each tier shape: { min, max, rate, shipping, flat, label }
   - pricing_tier: min_ft, max_ft, rate, shipping, flat
   - width_range:  min_width, max_width, amount, shipping, is_default_price, title
*/
var TIERS = [];

{%- if parent_section -%}
  {%- for sb in parent_section.blocks -%}
    {%- if sb.type == 'pricing_tier' -%}
      TIERS.push({
        min: parseFloat({{ sb.settings.min_ft | default: 0 | json }}) || 0,
        max: parseFloat({{ sb.settings.max_ft | default: 0 | json }}) || 0,
        rate: parseFloat({{ sb.settings.rate | default: 0 | json }}) || 0,
        shipping: parseFloat({{ sb.settings.shipping | default: 0 | json }}) || 0,
        flat: {{ sb.settings.flat | default: false | json }},
        label: ''
      });
    {%- endif -%}
    {%- if sb.type == 'width_range' -%}
      TIERS.push({
        min: parseFloat({{ sb.settings.min_width | default: 0 | json }}) || 0,
        max: parseFloat({{ sb.settings.max_width | default: 0 | json }}) || 0,
        rate: parseFloat({{ sb.settings.amount | default: 0 | json }}) || 0,
        shipping: parseFloat({{ sb.settings.shipping | default: 0 | json }}) || 0,
        flat: {{ sb.settings.is_default_price | default: false | json }},
        label: {{ sb.settings.title | default: '' | json }}
      });
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

if (!TIERS.length) {
  TIERS = [
    {min: 0, max: 300, rate: 1.2, shipping: 0, flat: false, label: ''}
  ];
}

/* Sort tiers by min so the lookup always matches the lowest applicable slab first */
TIERS.sort(function(a, b){ return a.min - b.min; });

function $i(id){return document.getElementById(id);}
function gv(id){var e=$i(id);return e?e.value:'';}
function fmt(n){
  // Shopify's money_format uses `${{amount}}` — strip ALL braces, not just one of each
  return MONEY_FMT
    .replace(/\{/g, '').replace(/\}/g, '')
    .replace('amount', parseFloat(n).toFixed(2))
    .replace('amount_no_decimals', Math.round(parseFloat(n)));
}
function between(v,a,b){var lo=Math.min(a,b),hi=Math.max(a,b);return v>=lo && v<=hi;}
function toFt(v,u){if(u==='m')return v*3.28084;if(u==='cm')return v*0.0328084;if(u==='mm')return v*0.00328084;return v;}
function wt(ms){return new Promise(function(r){setTimeout(r,ms);});}
async function re(nm,fn,n,d){var er=null;for(var i=1;i<=n;i++){try{return await fn();}catch(e){er=e;if(i<n)await wt(d);} }throw er||new Error(nm);}

/* ─────────── ELEMENT REFS ─────────── */
var wEl     = $i('psb-w-' + B);
var hEl     = $i('psb-h-' + B);
var uEl     = $i('psb-wu-' + B);
var huEl    = $i('psb-hu-' + B);
var priceEl = $i('psb-price-' + B);
var noteEl  = $i('psb-pricenote-' + B);
var areaEl  = $i('psb-area-' + B);
var errEl   = $i('psb-err-' + B);
var w10El   = $i('psb-w10-' + B);
var w20El   = $i('psb-w20-' + B);
var vidEl   = $i('psb-vid-' + B);
var cartBtn = $i('psb-cart-' + B);
var cartPriceEl = $i('psb-cart-price-' + B);
var qtyEl   = $i('psb-qty-' + B);

/* ─────────── LOAD HIDDEN PRICING COLLECTION ─────────── */
var allCollProducts = [];
if (COLLECTION) {
  fetch('/collections/' + COLLECTION + '/products.json?limit=250')
    .then(function(r){ return r.json(); })
    .then(function(d){ allCollProducts = d.products || []; calc(); })
    .catch(function(){});
}

/* ─────────── CART ENABLED STATE ─────────── */
function setCartState(enabled, price){
  if (!cartBtn) return;
  if (enabled) {
    cartBtn.removeAttribute('disabled');
    if (cartPriceEl && price !== undefined && price !== null) {
      cartPriceEl.textContent = '— ' + fmt(price);
    }
  } else {
    cartBtn.setAttribute('disabled', 'disabled');
    if (cartPriceEl) cartPriceEl.textContent = '';
  }
}
setCartState(false);

/* ─────────── OPTION ADD-ONS (from finishing-option selects) ─────────── */
function getOptionAddons(){
  var sum = 0;
  document.querySelectorAll('#psb-' + B + ' select[data-psb-opt]').forEach(function(sel){
    var opt = sel.options[sel.selectedIndex];
    if (!opt) return;
    var a = parseFloat(opt.getAttribute('data-amount'));
    if (!isNaN(a)) sum += a;
  });
  return sum;
}

/* ─────────── MAIN CALC ─────────── */
function calc(){
  // Custom size mode is driven by the checkbox toggle now, NOT by the dropdown value.
  // When the toggle is OFF and a variant is selected, base price comes from the variant
  // plus any option add-ons. When the toggle is ON, fall through to W/H × Width-Range math.
  var customOn = (typeof customToggle !== 'undefined' && customToggle && customToggle.checked);

  if (!customOn) {
    // Variant pricing path — uses the matched variant from applyVariantChoice()
    if (currentVariant) {
      var totalPre = (parseFloat(currentVariant.price) || 0) + getOptionAddons();
      totalPre = Math.round(totalPre * 100) / 100;
      if (priceEl) priceEl.textContent = fmt(totalPre);
      if (noteEl) {
        if (currentVariant.available === false) {
          noteEl.textContent = 'Sold out — choose a different option';
        } else {
          noteEl.textContent = '✓ Variant selected — ready to add to cart';
        }
      }
      setCartState(currentVariant.available !== false, totalPre);
      return;
    } else {
      // No variant chosen yet — disable cart, show dash
      if (priceEl) priceEl.textContent = '—';
      if (noteEl) noteEl.textContent = 'Choose an option to see your price';
      setCartState(false);
      return;
    }
  }

  if (!wEl || !hEl) return;
  var w = parseFloat(wEl.value) || 0;
  var h = parseFloat(hEl.value) || 0;
  var u = uEl ? uEl.value : 'ft';
  if (huEl) huEl.value = u;

  var rawArea = w * h;
  var wFt = toFt(w, u);
  var hFt = toFt(h, u);
  var areaFt = wFt * hFt;

  // Area info
  if (areaEl) {
    if (w > 0 && h > 0) {
      areaEl.style.display = '';
      areaEl.textContent = 'Area: ' + (Math.round(rawArea*100)/100) + ' ' + u + '² (' + (Math.round(areaFt*100)/100) + ' ft²)';
    } else {
      areaEl.style.display = 'none';
    }
  }

  // Out of range
  if (areaFt > MAX_AREA) {
    if (errEl) errEl.style.display = '';
    setCartState(false);
    if (priceEl) priceEl.textContent = '—';
    if (noteEl) noteEl.textContent = 'Size too large — please request a custom quote';
    if (vidEl) vidEl.value = '';
    return;
  }
  if (errEl) errEl.style.display = 'none';

  // Threshold warnings
  if ((wFt > 15 && hFt >= 15) || (hFt > 15 && wFt >= 15)) {
    if (w20El) w20El.style.display = ''; if (w10El) w10El.style.display = 'none';
  } else if (wFt > 10 && hFt > 10) {
    if (w10El) w10El.style.display = ''; if (w20El) w20El.style.display = 'none';
  } else {
    if (w10El) w10El.style.display = 'none'; if (w20El) w20El.style.display = 'none';
  }

  // Empty
  if (w === 0 || h === 0) {
    if (priceEl) priceEl.textContent = '—';
    if (noteEl) noteEl.textContent = 'Enter width & height to see your price';
    setCartState(false);
    return;
  }

  // Per-unit rate takes priority over TIERS when configured (> 0)
  var unitRate = UNIT_RATES[u] || 0;
  var matched = null;
  var matchedTier = null;       // remembers which tier was applied
  var appliedShipping = 0;       // remembers shipping added on top of base
  if (unitRate > 0) {
    var pu = (rawArea * unitRate) + getOptionAddons();
    matched = Math.round(pu * 100) / 100;
  } else {
    // Fall back to ft-based tier matching
    for (var i = 0; i < TIERS.length; i++) {
      var t = TIERS[i];
      if (between(areaFt, t.min, t.max)) {
        var basePrice = t.flat ? t.rate : (areaFt * t.rate);
        appliedShipping = t.shipping || 0;
        var p = basePrice + appliedShipping + getOptionAddons();
        matched = Math.round(p * 100) / 100;
        matchedTier = t;
        break;
      }
    }
    if (matched === null) {
      matched = Math.round((DEFAULT_PRICE + getOptionAddons()) * 100) / 100;
    }
  }

  if (priceEl) priceEl.textContent = fmt(matched);
  if (noteEl) {
    // When a matching width range / tier has a shipping add-on, surface it
    if (appliedShipping > 0) {
      noteEl.textContent = '✓ Ready — includes ' + fmt(appliedShipping) + ' shipping';
    } else {
      noteEl.textContent = '✓ Ready — click Add to Cart';
    }
  }

  // Match variant in hidden collection
  var matchedVid = null;
  if (allCollProducts.length > 0) {
    var rounded = Math.round(matched);
    outer: for (var p = 0; p < allCollProducts.length; p++) {
      var vs = allCollProducts[p].variants || [];
      for (var v = 0; v < vs.length; v++) {
        if (parseFloat(vs[v].option1) === rounded) {
          matchedVid = vs[v].id;
          break outer;
        }
      }
    }
  }
  if (vidEl) vidEl.value = matchedVid || PROD_DEFAULT_VID;
  setCartState(true, matched);
}

if (wEl) wEl.addEventListener('input', calc);
if (hEl) hEl.addEventListener('input', calc);
if (uEl) uEl.addEventListener('change', calc);
document.querySelectorAll('#psb-' + B + ' select[data-psb-opt]').forEach(function(s){
  s.addEventListener('change', calc);
});

/* ─────────── VARIANT DROPDOWNS (one per product option) ─────────── */
var variantOpts = document.querySelectorAll('#psb-' + B + ' .psb-variant-opt');
var customWrap = $i('psb-custom-' + B);
var customToggle = $i('psb-customtoggle-' + B);

function applyVariantChoice(){
  // Collect the current value from every variant-opt dropdown in document order.
  // Each dropdown's data-opt-position maps to the variant's option1/option2/option3.
  var values = [];
  variantOpts.forEach(function(dd){ values.push(dd.value); });

  if (values.length === 0) {
    // Product has only the default variant — no dropdowns rendered. Use the only variant.
    currentVariant = VARIANTS.length ? VARIANTS[0] : null;
  } else {
    // All dropdowns must have a selected value to match a real variant.
    var allSelected = values.every(function(v){ return v && v !== ''; });
    if (!allSelected) {
      currentVariant = null;
    } else {
      currentVariant = null;
      for (var i = 0; i < VARIANTS.length; i++) {
        var v = VARIANTS[i];
        var match = true;
        if (values[0] !== undefined && v.option1 !== values[0]) match = false;
        if (values[1] !== undefined && v.option2 !== values[1]) match = false;
        if (values[2] !== undefined && v.option3 !== values[2]) match = false;
        if (match) { currentVariant = v; break; }
      }
    }
  }

  if (currentVariant) {
    if (vidEl) vidEl.value = currentVariant.id;
    // If the variant title encodes ft dimensions (e.g. "2.4ft W x 7.2ft H"), pre-fill W/H
    var tMatches = (currentVariant.title || '').match(/(\d+\.?\d*)\s*ft/gi);
    if (tMatches && tMatches.length >= 2) {
      if (wEl && !wEl.value) wEl.value = parseFloat(tMatches[0]);
      if (hEl && !hEl.value) hEl.value = parseFloat(tMatches[1]);
      if (uEl) uEl.value = 'ft';
    }
  } else {
    if (vidEl) vidEl.value = PROD_DEFAULT_VID;
  }

  calc();
}

/* ─────────── CUSTOM SIZE TOGGLE ─────────── */
function applyCustomToggle(){
  if (!customToggle) return;
  if (customWrap) customWrap.style.display = customToggle.checked ? '' : 'none';
  calc();
}

variantOpts.forEach(function(dd){
  dd.addEventListener('change', applyVariantChoice);
});
applyVariantChoice();   // run once on load to pick up any preselected variant values

if (customToggle) {
  customToggle.addEventListener('change', applyCustomToggle);
  applyCustomToggle();  // honour a pre-checked toggle from the JSON
}

/* ─────────── QUANTITY STEPPERS ─────────── */
document.querySelectorAll('#psb-' + B + ' [data-psb-qty]').forEach(function(btn){
  btn.addEventListener('click', function(){
    if (!qtyEl) return;
    var delta = parseInt(btn.getAttribute('data-psb-qty'), 10) || 0;
    var newVal = (parseInt(qtyEl.value, 10) || 1) + delta;
    if (newVal < 1) newVal = 1;
    qtyEl.value = newVal;
    qtyEl.dispatchEvent(new Event('input', {bubbles: true}));
    qtyEl.dispatchEvent(new Event('change', {bubbles: true}));
  });
});

/* ─────────── ESTIMATED DELIVERY ─────────── */
function setDelivery(){
  if (!DELIVERY_DAYS) return;
  var el = $i('psb-delivery-date-' + B);
  if (!el) return;
  var start = new Date();
  start.setDate(start.getDate() + DELIVERY_DAYS);
  var end = new Date(start);
  end.setDate(end.getDate() + 2);
  var fmtD = function(d){
    return d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
  };
  el.textContent = fmtD(start) + ' – ' + fmtD(end);
}
setDelivery();

/* ─────────── MODAL OPEN/CLOSE ─────────── */
function openModal(key){
  var m = $i('psb-m-' + key + '-' + B);
  if (!m) return;
  if (m.parentElement !== document.body) document.body.appendChild(m);
  m.classList.add('psb-modal-open');
  m.scrollTop = 0;
  document.body.style.overflow = 'hidden';
  document.documentElement.style.overflow = 'hidden';
  ['cs','dh','be'].forEach(function(k){
    if (key === k) {
      var s = $i('psb-' + k + '-st-' + B); if (s) s.value = String(Date.now());
      fetchGeo(k);
    }
  });
}
function closeAllModals(){
  document.querySelectorAll('.psb-modal.psb-modal-open').forEach(function(m){ m.classList.remove('psb-modal-open'); });
  document.body.style.overflow = '';
  document.documentElement.style.overflow = '';
}
document.addEventListener('click', function(e){
  var opener = e.target.closest('[data-psb-open]');
  if (opener) { e.preventDefault(); openModal(opener.getAttribute('data-psb-open')); return; }
  var closer = e.target.closest('[data-psb-close]');
  if (closer) { closeAllModals(); }
});
document.addEventListener('keydown', function(e){
  if (e.key === 'Escape') { closeAllModals(); return; }
  // Enter/Space on a div-button (role="button") should trigger its click
  if ((e.key === 'Enter' || e.key === ' ') && e.target && e.target.matches && e.target.matches('[role="button"][data-psb-open]')) {
    e.preventDefault();
    e.target.click();
  }
});

['cs','dh','be'].forEach(function(k){
  var mo = $i('psb-m-' + k + '-' + B); if (!mo) return;
  new MutationObserver(function(){
    if (!mo.classList.contains('psb-modal-open')) {
      setTimeout(function(){
        ['ld','sc','er'].forEach(function(s){ var el = $i('psb-' + k + '-' + s + '-' + B); if (el) el.classList.remove('psb-state-on'); });
        var f = $i('psb-' + k + '-f-' + B); if (f) { f.style.display = ''; f.reset(); }
        var st = $i('psb-' + k + '-st-' + B); if (st) st.value = String(Date.now());
      }, 300);
    }
  }).observe(mo, {attributes: true, attributeFilter: ['class']});
});

/* ─────────── GEO ─────────── */
var geoCache = {};
function fetchGeo(k){
  if (geoCache[k]) return;
  geoCache[k] = true;
  fetch('https://api.ipgeolocation.io/ipgeo?apiKey=d8219c97f06142f1b715280e15e42214')
    .then(function(r){ return r.json(); })
    .then(function(d){
      var s = function(f, v){ var el = $i('psb-' + k + '-' + f + '-' + B); if (el) el.value = v || ''; };
      s('gi', d.ip); s('gc', d.city); s('gs', d.state_prov);
      s('gz', d.time_zone && d.time_zone.name);
      s('gt', d.time_zone && d.time_zone.current_time);
    }).catch(function(){});
}

/* ─────────── UPLOADCARE LAZY LOADER ─────────── */
var ucP = null, ucW = {};
function ensUC(){
  if (window.uploadcare && typeof window.uploadcare.Widget === 'function') return Promise.resolve();
  if (ucP) return ucP;
  ucP = new Promise(function(res, rej){
    var s = document.createElement('script');
    s.src = 'https://ucarecdn.com/libs/widget/3.x/uploadcare.full.min.js';
    s.async = true; s.defer = true;
    s.onload = res; s.onerror = rej;
    document.head.appendChild(s);
  }).catch(function(e){ ucP = null; throw e; });
  return ucP;
}
function initUC(inputId, cb){
  if (ucW[inputId]) return Promise.resolve(ucW[inputId]);
  var inp = $i(inputId);
  if (!inp) return Promise.resolve(null);
  return ensUC().then(function(){
    if (!window.uploadcare) return null;
    var w = window.uploadcare.Widget(inp);
    w.onUploadComplete(function(info){
      var url = (info && (info.cdnUrl || info.originalUrl)) || '';
      if (url) cb(url);
    });
    ucW[inputId] = w;
    return w;
  });
}

/* ─────────── UPLOAD ARTWORK MODAL ─────────── */
var fp = $i('psb-fp-' + B);
var uploadTag = $i('psb-upload-tag-' + B);
function setFileUpload(val, msg){
  if (fp) fp.value = val;
  if (uploadTag) {
    if (val) { uploadTag.style.display = ''; uploadTag.textContent = msg || 'Saved ✓'; }
    else uploadTag.style.display = 'none';
  }
}
var uovm = $i('psb-m-up-' + B);
var footNoteEl = $i('psb-up-foot-note-' + B);
var FOOT_NOTES = {
  direct: 'For files over 500 MB, please use Link Upload instead.',
  link:   'Use a shared folder link to send multiple files at once.',
  email:  "We'll reply to the email you used at checkout."
};
function syncUpTab(key){
  if (!footNoteEl || !FOOT_NOTES[key]) return;
  footNoteEl.textContent = FOOT_NOTES[key];
}
if (uovm) {
  uovm.querySelectorAll('[data-psb-uptab]').forEach(function(t){
    t.addEventListener('click', function(){
      var key = t.getAttribute('data-psb-uptab');
      uovm.querySelectorAll('[data-psb-uptab]').forEach(function(x){
        var on = (x === t);
        x.classList.toggle('psb-up-tab2-on', on);
        x.classList.toggle('psb-up-tab-on', on); // legacy class kept for compat
        x.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      uovm.querySelectorAll('[data-psb-uppanel]').forEach(function(p){
        p.classList.toggle('psb-up-panel-on', p.getAttribute('data-psb-uppanel') === key);
      });
      syncUpTab(key);
    });
  });
}
var dz = $i('psb-dz-' + B);
var br = $i('psb-br-' + B);
function trigUC(){
  initUC('psb-uc-' + B, function(url){ setFileUpload(url, 'Saved ✓'); }).then(function(w){
    if (w && typeof w.openDialog === 'function') w.openDialog();
  });
}
if (br) br.addEventListener('click', function(e){ e.stopPropagation(); trigUC(); });
if (dz) {
  dz.addEventListener('click', trigUC);
  dz.addEventListener('keydown', function(e){
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); trigUC(); }
  });
  dz.addEventListener('dragover', function(e){ e.preventDefault(); dz.classList.add('psb-dragover'); });
  dz.addEventListener('dragleave', function(){ dz.classList.remove('psb-dragover'); });
  dz.addEventListener('drop', function(e){ e.preventDefault(); dz.classList.remove('psb-dragover'); trigUC(); });
}
var lkInp = $i('psb-lk-' + B);
if (lkInp) lkInp.addEventListener('input', function(){ var v = lkInp.value.trim(); if (v) setFileUpload(v, 'Saved ✓'); });

/* Single Save & Continue button — picks the action by the currently active panel */
var svBtn = $i('psb-sv-' + B);
if (svBtn) svBtn.addEventListener('click', function(){
  var activePanel = uovm ? uovm.querySelector('.psb-up-panel-on') : null;
  var tab = activePanel ? activePanel.getAttribute('data-psb-uppanel') : 'direct';

  if (tab === 'direct') {
    var v = fp ? fp.value : '';
    if (!v) {
      var st = $i('psb-up-st-' + B);
      if (st) { st.textContent = '⚠ Please upload a file first.'; st.style.color = '#c0392b'; }
      return;
    }
    setFileUpload(v, 'Saved ✓');
    closeAllModals();
  } else if (tab === 'link') {
    var lv = lkInp ? lkInp.value.trim() : '';
    if (!lv) {
      var lst = $i('psb-lk-st-' + B);
      if (lst) { lst.textContent = '⚠ Paste a link first.'; lst.style.color = '#c0392b'; }
      return;
    }
    setFileUpload(lv, 'Saved ✓');
    closeAllModals();
  } else if (tab === 'email') {
    setFileUpload('Customer will email files later', 'Will email after order');
    closeAllModals();
  }
});

initUC('psb-uc-' + B, function(url){ setFileUpload(url, 'Saved ✓'); });

/* ─────────── 2D MODAL UPLOAD TABS ─────────── */
var dhm = $i('psb-m-dh-' + B);
var dhFl = $i('psb-dh-fl-' + B);
var dhUst = $i('psb-dh-ust-' + B);
if (dhm) {
  dhm.querySelectorAll('[data-psb-dhtab]').forEach(function(tab){
    tab.addEventListener('click', function(){
      dhm.querySelectorAll('[data-psb-dhtab]').forEach(function(t){ t.classList.toggle('psb-uptab-on', t === tab); });
