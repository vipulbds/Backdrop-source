  align-items: center;
  gap: 4px;
}

/* ═══ MODALS — floating popup that's always centered with breathing room ═══ */
.psb-modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 999999;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.psb-modal-open {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 4vh 12px;
}
@media (max-width: 600px) {
  .psb-modal-open { padding: 24px 8px; }
}
.psb-modal-bg { position: fixed; inset: 0; background: rgba(0,0,0,.6); z-index: 0; }
.psb-modal-box {
  position: relative; z-index: 1; background: #fff;
  border-radius: 12px;
  width: 100%;
  max-width: 720px;
  margin: 0;
  box-shadow: 0 32px 80px rgba(0,0,0,.28);
  overflow: hidden;
  display: flex; flex-direction: column;
}
.psb-modal-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16px 20px; border-bottom: 1.5px solid #E8ECF4; background: #fff;
}
.psb-modal-head h3 {
  font-family: 'Inter', sans-serif; font-size: 18px; font-weight: 700;
  color: #0A3161; margin: 0; text-transform: uppercase;
}
.psb-modal-x { background: none; border: none; font-size: 1.25rem; cursor: pointer; color: #aaa; padding: 6px 8px; border-radius: 6px; }
.psb-modal-x:hover { background: #f0f2f6; color: #333; }
.psb-modal-body { padding: 20px; }
.psb-modal-2col { display: grid; grid-template-columns: 220px 1fr; padding: 0; }
@media (max-width: 600px) {
  .psb-modal-2col { grid-template-columns: 1fr; }
  .psb-modal-aside { display: none !important; }
}
.psb-modal-aside { background: #0A3161; color: #fff; padding: 24px 20px; }
.psb-aside-badge {
  display: flex; align-items: center; justify-content: center; flex-direction: column;
  width: 68px; height: 68px; border-radius: 50%; background: {{ accent_color }};
  margin-bottom: 16px;
}
.psb-aside-num { font-size: 22px; font-weight: 800; line-height: 1; }
.psb-aside-yrs { font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; margin-top: 2px; }
.psb-aside-list { display: flex; flex-direction: column; gap: 8px; font-size: 13px; font-weight: 400; margin-bottom: 16px; }
.psb-aside-divider { height: 1px; background: rgba(255,255,255,.18); margin: 8px 0; }
.psb-aside-sub { font-size: 13px; font-weight: 700; margin-bottom: 10px; }
.psb-aside-steps { display: flex; flex-direction: column; gap: 6px; font-size: 12px; }
.psb-aside-steps span {
  display: inline-flex; width: 20px; height: 20px; border-radius: 50%;
  background: {{ accent_color }}; align-items: center; justify-content: center;
  font-weight: 700; font-size: 11px; margin-right: 6px;
}
.psb-modal-main { padding: 24px; position: relative; }
.psb-modal-form { display: flex; flex-direction: column; gap: 12px; }
.psb-modal-form .psb-field label {
  font-size: 13px; font-weight: 600; color: #0A3161; display: block; margin-bottom: 4px;
}
.psb-modal-form .psb-field label span { color: {{ accent_color }}; }
.psb-modal-form .psb-field input,
.psb-modal-form .psb-field select,
.psb-modal-form .psb-field textarea {
  width: 100%; border: 1.5px solid #D8DCE8; border-radius: 8px;
  padding: 11px 13px; font-family: inherit; font-size: 14px;
  background: #fff; box-sizing: border-box;
}
.psb-modal-form .psb-field textarea { resize: vertical; min-height: 80px; }
.psb-row3 { display: grid; grid-template-columns: 1fr 1fr 80px; gap: 10px; }
@media (max-width: 400px) {
  .psb-row3 { grid-template-columns: 1fr 1fr; }
  .psb-row3 > :last-child { grid-column: 1 / -1; }
}
.psb-modal-submit {
  width: 100%; background: {{ accent_color }}; color: #fff; border: 0;
  border-radius: 8px; padding: 14px; font-family: inherit; font-size: 14px;
  font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
  cursor: pointer; min-height: 50px; margin-top: 4px;
}
.psb-modal-submit:hover { background: #8f0f2e; }

.psb-upbox { border: 1.5px dashed #C8CEDC; border-radius: 8px; padding: 12px; background: #F8F9FC; }
.psb-upbox-title { font-size: 12px; font-weight: 700; margin-bottom: 10px; }
.psb-upbox-tabs { display: flex; gap: 6px; margin-bottom: 10px; }
.psb-uptab { padding: 6px 12px; border: 1px solid #D0D5E0; border-radius: 6px; background: #fff; font-size: 12px; cursor: pointer; color: #555; }
.psb-uptab-on { background: {{ accent_color }}; border-color: {{ accent_color }}; color: #fff; }
.psb-uppan { display: none; }
.psb-uppan-on { display: block; }
.psb-uf-btn { background: {{ accent_color }}; color: #fff; border: 0; border-radius: 7px; padding: 8px 14px; font-size: 13px; font-weight: 600; cursor: pointer; }
.psb-uf-hint { font-size: 12px; color: #777; margin-left: 8px; }
.psb-link-lbl { font-size: 13px; font-weight: 600; display: block; margin-bottom: 6px; }
.psb-link-inp { width: 100%; border: 1.5px solid #D8DCE8; border-radius: 7px; padding: 9px 12px; font-size: 14px; box-sizing: border-box; }
.psb-eml-card { background: #EFF4FF; border-radius: 8px; padding: 14px; font-size: 13px; color: #444; line-height: 1.5; }
.psb-up-st { font-size: 13px; color: {{ accent_color }}; margin-top: 6px; min-height: 1.2em; font-weight: 600; }

.psb-up-tabs { display: flex; gap: 6px; margin-bottom: 14px; flex-wrap: wrap; }
.psb-up-tab { flex: 1; min-width: 120px; padding: 10px 14px; border: 1.5px solid #D0D5E0; border-radius: 7px; background: #fff; font-size: 13px; font-weight: 600; cursor: pointer; color: #555; }
.psb-up-tab-on { background: #0A3161; border-color: #0A3161; color: #fff; }
.psb-up-panel { display: none; }
.psb-up-panel-on { display: block; }
.psb-up-dz {
  border: 2px dashed #C8CEDC; border-radius: 12px; padding: 28px 16px;
  text-align: center; background: #FAFBFD; display: flex;
  flex-direction: column; align-items: center; gap: 10px; cursor: pointer; margin-bottom: 14px;
}
.psb-up-dz.psb-dragover { border-color: {{ accent_color }}; background: #FFF5F7; }
.psb-up-or { font-size: 12px; font-weight: 600; color: #aaa; text-transform: uppercase; letter-spacing: .08em; }
.psb-cta-dark {
  background: #0A3161; color: #fff; border: 0; border-radius: 8px;
  padding: 12px 24px; font-family: inherit; font-size: 14px; font-weight: 600; cursor: pointer;
}
.psb-up-foot {
  display: flex; justify-content: space-between; align-items: center;
  padding-top: 14px; border-top: 1.5px solid #E8ECF4; margin-top: 14px;
  gap: 12px; flex-wrap: wrap;
}
.psb-up-foot-note { font-size: 12px; color: #aaa; flex: 1; }
.psb-up-foot .psb-modal-submit { width: auto; min-width: 180px; }

.psb-state { display: none; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 40px 20px; text-align: center; }
.psb-state-on { display: flex; }
.psb-loading p, .psb-success p { font-size: 15px; color: #0A3161; margin: 0; }
.psb-spinner {
  width: 38px; height: 38px; border: 4px solid #f0f0f0;
  border-top: 4px solid {{ accent_color }}; border-radius: 50%;
  animation: psbSpin 1s linear infinite;
}
@keyframes psbSpin { to { transform: rotate(360deg); } }
.psb-tick {
  width: 60px; height: 60px; border-radius: 50%; background: {{ accent_color }};
  color: #fff; font-size: 28px; display: flex; align-items: center; justify-content: center;
}
.psb-error { color: #c0392b; font-size: 14px; text-align: center; padding: 20px; }

.psb-honeypot {
  position: absolute !important; left: -9999px !important;
  width: 1px !important; height: 1px !important; overflow: hidden !important;
}

/* Hide Uploadcare widget UI */
.uploadcare-widget, .uploadcare-widget-button,
.uploadcare--widget, .uploadcare--widget__button {
  display: none !important;
}

/* Container queries for narrow layout */
#psb-{{ block.id }} {
  container-type: inline-size;
  container-name: psb-cnt;
}
@container psb-cnt (max-width: 360px) {
  #psb-{{ block.id }} .psb-size-grid {
    grid-template-columns: 1fr;
    gap: 8px;
  }
  #psb-{{ block.id }} .psb-price-val { font-size: 24px; }
}

/* ═══════════════════════════════════════════════════════════════
   STEP-CARD LAYOUT (Image 2 design)
   Overrides earlier ATC / qty / quick-pick rules above.
═══════════════════════════════════════════════════════════════ */

/* ── Step card shell ── */
#psb-{{ block.id }} .psb-stepcard {
  border: 1.5px solid #B5C3DC;
  border-radius: 10px;
  background: #fff;
  margin-bottom: 14px;
  overflow: hidden;
}
#psb-{{ block.id }} .psb-step-head {
  background: #EFF3FB;
  color: var(--psb-navy);
  font-weight: 700;
  font-size: 14px;
  padding: 12px 16px;
  border-bottom: 1px solid #DFE5F0;
}
#psb-{{ block.id }} .psb-step-body {
  display: grid;
  grid-template-columns: 1fr 1px 1fr;
  align-items: stretch;
}
#psb-{{ block.id }} .psb-step-body::before {
  content: '';
  grid-column: 2;
  background: var(--psb-border);
  margin: 14px 0;
}
#psb-{{ block.id }} .psb-step-left {
  padding: 16px;
  min-width: 0;
}
#psb-{{ block.id }} .psb-step-aside {
  padding: 16px;
  background: #F5F7FB;
  display: flex;
  flex-direction: column;
  gap: 10px;
  justify-content: space-between;
}
#psb-{{ block.id }} .psb-aside-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--psb-navy);
  margin: 0;
}
#psb-{{ block.id }} .psb-aside-text {
  font-size: 13px;
  color: var(--psb-muted);
  margin: 0;
  line-height: 1.5;
}
#psb-{{ block.id }} .psb-aside-btn {
  background: var(--psb-crimson);
  color: #fff;
  border: 0;
  border-radius: 8px;
  padding: 12px 16px;
  font-family: inherit;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .03em;
  text-transform: uppercase;
  cursor: pointer;
  margin-top: auto;
  transition: background .2s, transform .15s;
  line-height: 1.3;
}
#psb-{{ block.id }} .psb-aside-btn:hover { background: #8f0f2e; transform: translateY(-1px); }

/* Collapse to single column when the picker's container is narrow.
   Container queries beat viewport @media here because the picker sits in the
   right column of the product layout — actual width != viewport width. */
@container psb-cnt (max-width: 520px) {
  #psb-{{ block.id }} .psb-step-body { grid-template-columns: 1fr; }
  #psb-{{ block.id }} .psb-step-body::before { display: none; }
  #psb-{{ block.id }} .psb-step-aside { border-top: 1px solid var(--psb-border); }
}
@container psb-cnt (max-width: 420px) {
  #psb-{{ block.id }} .psb-stepcard { border-radius: 8px; }
  #psb-{{ block.id }} .psb-step-head { padding: 10px 12px; font-size: 13px; }
  #psb-{{ block.id }} .psb-step-left,
  #psb-{{ block.id }} .psb-step-aside { padding: 12px; }
  #psb-{{ block.id }} .psb-aside-title { font-size: 15px; }
  #psb-{{ block.id }} .psb-aside-text { font-size: 12px; }
