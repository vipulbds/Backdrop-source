}

/* ═══ QUALITY BADGES (bottom) ═══ */
#psb-{{ block.id }} .psb-quality-badges {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px 12px;
  margin-top: 12px;
  padding: 14px;
  background: var(--psb-off);
  border-radius: 10px;
}
@media (max-width: 400px) {
  #psb-{{ block.id }} .psb-quality-badges {
    grid-template-columns: 1fr;
  }
}
#psb-{{ block.id }} .psb-quality-badge {
  font-size: 12px;
  font-weight: 600;
  color: var(--psb-text);
