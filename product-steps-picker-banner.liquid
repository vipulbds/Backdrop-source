{%- comment -%}
  ═══════════════════════════════════════════════════════════════
  PRODUCT STEPS PICKER — BANNER VERSION (LINEAR FLOW)
  ═══════════════════════════════════════════════════════════════
  Inspired by the old theme's clean user-friendly linear layout.
  Renders inside the right column of main-product-banner section.

  Flow (top to bottom):
    1. Rate display ($X/sq.ft)
    2. Trust badges (free delivery, warranty)
    3. SIZE section: Predefined quick-pick buttons + Custom W×H inputs
    4. Live Calculated Price (updates as customer types)
    5. OPTIONS section: Finishing dropdowns (Pole Pocket, Eyelets, etc.)
    6. Quantity + Bulk Enquiry
    7. Estimated delivery
    8. Upload Artwork + Request Proof Image buttons
    9. ADD TO CART (disabled until W+H entered)
    10. Material/quality badges

  Receives: block, parent_section
  Zero {% include %}. No external snippet dependencies.
  All CSS scoped to .psb-* / #psb-{block.id}
  Modals: same as v4 (Custom Size, 2D Mockup, Bulk Enquiry, Upload Artwork)
{%- endcomment -%}

{%- liquid
  assign accent_color   = block.settings.accent_color   | default: '#832245'
  assign label_color    = block.settings.label_color    | default: '#0A3161'

  assign quickpick_intro    = block.settings.quickpick_intro    | default: 'Choose a standard size'
  assign size_title         = block.settings.size_title         | default: 'Or enter custom size'
  assign options_title      = block.settings.options_title      | default: 'Finishing Options'
  assign upload_cta         = block.settings.upload_cta         | default: 'CLICK HERE TO UPLOAD ARTWORK'
  assign proof_cta          = block.settings.proof_cta          | default: 'REQUEST PROOF IMAGE'
  assign bulk_cta           = block.settings.bulk_cta           | default: 'BULK ENQUIRY'
  assign add_to_cart_label  = block.settings.add_to_cart_label  | default: 'ADD TO CART'

  assign delivery_days     = block.settings.delivery_days | default: 7
  assign delivery_label    = block.settings.delivery_label | default: 'Estimated delivery:'
  assign quality_badges    = block.settings.quality_badges
  assign show_reviews_row  = block.settings.show_reviews_row | default: true

  assign first_tier_rate = 0
  if parent_section
    for sb in parent_section.blocks
      if sb.type == 'pricing_tier'
        assign first_tier_rate = sb.settings.rate
        break
      endif
    endfor
  endif
-%}

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" media="print" onload="this.media='all'">

<div id="psb-{{ block.id }}" class="psb" {{ block.shopify_attributes }}>

  {% comment %} ═════════════ TOP — RATE + SKU ═════════════
    Rate display priority:
    1. If block.settings.rate_display_text is filled, use it verbatim
    2. Else if rate_show is true AND first pricing tier exists, build "$X/sq.ft" from tier 1
    3. Else hide
  {% endcomment %}
  {%- assign rate_show       = block.settings.rate_show -%}
  {%- assign rate_text       = block.settings.rate_display_text -%}
  {%- assign rate_unit_label = block.settings.rate_unit_label | default: '/sq.ft' -%}
  {%- assign rate_prefix     = block.settings.rate_prefix | default: '$' -%}

  <div class="psb-toprow">
    {%- if rate_text != blank -%}
      <div class="psb-rate">
        <span class="psb-rate-val">{{ rate_text }}</span>
      </div>
    {%- elsif rate_show and first_tier_rate != blank and first_tier_rate != 0 -%}
      <div class="psb-rate">
        <span class="psb-rate-val">{{ rate_prefix }}{{ first_tier_rate }}</span><span class="psb-rate-unit">{{ rate_unit_label }}</span>
      </div>
    {%- endif -%}
    {%- if show_reviews_row -%}
      <div class="psb-sku">SKU: {{ product.selected_or_first_available_variant.sku | default: product.id }}</div>
    {%- endif -%}
  </div>

  {%- if block.settings.show_free_delivery -%}
    <div class="psb-trust">
      <span class="psb-trust-icon">🚚</span>
      <strong>{{ block.settings.free_delivery_text | default: 'FREE DELIVERY' }}</strong>
      <span class="psb-trust-sub">({{ delivery_days }} Working Days)</span>
    </div>
  {%- endif -%}

  {%- comment -%} Detect whether finishing options exist {%- endcomment -%}
  {%- assign show_options = false -%}
  {%- if block.settings.opt1_label != blank or block.settings.opt2_label != blank or block.settings.opt3_label != blank or block.settings.opt4_label != blank or block.settings.opt5_label != blank or block.settings.opt6_label != blank or block.settings.opt7_label != blank -%}
    {%- assign show_options = true -%}
  {%- endif -%}

  {% comment %} ═════════════ STEP 1 — FRAME SIZE & OPTIONS ═════════════ {% endcomment %}
  <div class="psb-stepcard">
    <div class="psb-step-head">{{ block.settings.step1_title | default: 'Step 1: Select frame size & options' }}</div>
    <div class="psb-step-body">
      <div class="psb-step-left">

        {% comment %} Variant dropdowns — ONE dropdown per product option.
          A product with options [Color, Size] gets two dropdowns. The combined selection
          is looked up against product.variants in JS to find the matching variant id + price. {% endcomment %}
        {%- unless product.has_only_default_variant -%}
          {%- for opt in product.options_with_values -%}
            <div class="psb-field psb-field-block">
              <label for="psb-opt-{{ forloop.index }}-{{ block.id }}">{{ opt.name }}</label>
              <select
                id="psb-opt-{{ forloop.index }}-{{ block.id }}"
                class="psb-size-select psb-variant-opt"
                data-opt-position="{{ forloop.index }}"
                aria-label="{{ opt.name | escape }}"
              >
                <option value="">Select {{ opt.name | escape }}…</option>
                {%- for value in opt.values -%}
                  <option value="{{ value | escape }}" {% if opt.selected_value == value %}selected{% endif %}>{{ value }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        {% comment %} Custom Size toggle — independent of the variant dropdown.
          When checked, reveals the W/H/Unit inputs and switches pricing to the
          Width Range / Pricing Tier slabs configured by the merchant. {% endcomment %}
        <div class="psb-custom-toggle-row">
          <label class="psb-custom-toggle-label" for="psb-customtoggle-{{ block.id }}">
            <input type="checkbox" id="psb-customtoggle-{{ block.id }}" class="psb-custom-toggle-input">
            <span class="psb-custom-toggle-text">📐 {{ block.settings.custom_size_toggle | default: 'Need custom size?' }}</span>
          </label>
        </div>

        {% comment %} Custom W/H wrapper — revealed only when the toggle above is ON {% endcomment %}
        <div class="psb-custom-wrap" id="psb-custom-{{ block.id }}" style="display:none;">
          <div class="psb-size-row">
            <div class="psb-field">
              <label for="psb-w-{{ block.id }}">Width</label>
              <input type="number" id="psb-w-{{ block.id }}" name="properties[Width]" step="0.01" min="0.01" placeholder="0" inputmode="decimal" autocomplete="off">
            </div>
            <div class="psb-field">
              <label for="psb-h-{{ block.id }}">Height</label>
              <input type="number" id="psb-h-{{ block.id }}" name="properties[Height]" step="0.01" min="0.01" placeholder="0" inputmode="decimal" autocomplete="off">
            </div>
            <div class="psb-field psb-field-unit">
              <label for="psb-wu-{{ block.id }}">Unit</label>
              <select id="psb-wu-{{ block.id }}" name="properties[Unit]" aria-label="Measurement unit">
                <option value="ft" selected>ft</option>
                <option value="m">m</option>
                <option value="cm">cm</option>
                <option value="mm">mm</option>
                <option value="inch">in</option>
              </select>
              <input type="hidden" id="psb-hu-{{ block.id }}" value="ft">
            </div>
          </div>

          <p class="psb-area-info" id="psb-area-{{ block.id }}" style="display:none;"></p>

          <div class="psb-msg psb-msg-err" id="psb-err-{{ block.id }}" style="display:none;">
            ⚠ This size exceeds our maximum. Please <a data-psb-open="cs">request a custom quote</a>.
          </div>
          <div class="psb-msg psb-msg-warn" id="psb-w10-{{ block.id }}" style="display:none;">
            ⚠ A seam line is required when both sides exceed 10 ft.
          </div>
          <div class="psb-msg psb-msg-rep" id="psb-w20-{{ block.id }}" style="display:none;">
            For sizes larger than 20 × 15 ft, please <a data-psb-open="cs">contact our Sales Representative</a>.
          </div>

          <div class="psb-price-box">
            <span class="psb-price-lbl">YOUR PRICE</span>
            <span class="psb-price-val" id="psb-price-{{ block.id }}">—</span>
          </div>
          <div class="psb-price-note" id="psb-pricenote-{{ block.id }}">Enter width &amp; height to see your price</div>
        </div>

        {% comment %} Hidden refs needed by JS when a predefined size is selected {% endcomment %}
        {%- unless show_options -%}
          {%- comment -%} If options block is shown later it won't include these — render here as safety {%- endcomment -%}
        {%- endunless -%}

        {% comment %} Stacked finishing options under "Choose Options" {% endcomment %}
        {%- if show_options -%}
          <div class="psb-options-stack">
            <div class="psb-options-stack-title">{{ block.settings.options_label | default: 'Choose Options' }}</div>
            {%- for n in (1..7) -%}
              {%- assign label_key = 'opt' | append: n | append: '_label' -%}
              {%- assign values_key = 'opt' | append: n | append: '_values' -%}
              {%- assign label = block.settings[label_key] -%}
              {%- assign values_str = block.settings[values_key] -%}
              {%- if label != blank -%}
                <div class="psb-option-row">
                  <label class="psb-option-label" for="psb-opt{{ n }}-{{ block.id }}">{{ label }}</label>
                  <div class="psb-option-control">
                    <select id="psb-opt{{ n }}-{{ block.id }}" class="psb-option-select" name="properties[{{ label }}]" data-psb-opt="{{ n }}">
                      {%- assign values_arr = values_str | split: ',' -%}
                      {%- if values_arr.size == 0 -%}
                        <option value="None" data-amount="0">None</option>
                      {%- else -%}
                        {%- for raw in values_arr -%}
                          {%- assign trimmed = raw | strip -%}
                          {%- assign parts = trimmed | split: '|' -%}
                          {%- assign val_name = parts[0] | default: trimmed -%}
                          {%- assign val_amt  = parts[1] | default: '0' | strip -%}
                          <option value="{{ val_name | escape }}" data-amount="{{ val_amt }}">{{ val_name }}{% if val_amt != '0' and val_amt != blank %} (+${{ val_amt }}){% endif %}</option>
                        {%- endfor -%}
                      {%- endif -%}
                    </select>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <aside class="psb-step-aside">
        <h4 class="psb-aside-title">{{ block.settings.custom_size_title | default: 'Need custom size?' }}</h4>
        <p class="psb-aside-text">{{ block.settings.custom_size_desc | default: "Don't see your size? Request a custom quote — we ship custom in the same 48 hours." }}</p>
        <button type="button" class="psb-aside-btn" data-psb-open="cs">{{ block.settings.custom_size_btn | default: 'REQUEST CUSTOM SIZE QUOTE' }}</button>
      </aside>
    </div>
  </div>

  {% comment %} ═════════════ STEP 2 — UPLOAD ARTWORK & CHECKOUT ═════════════ {% endcomment %}
  {%- if block.settings.show_step2 != false -%}
    <div class="psb-stepcard">
      <div class="psb-step-head">{{ block.settings.step2_title | default: 'Step 2: Upload artwork & checkout' }}</div>
      <div class="psb-step-body">
        <div class="psb-step-left">
          <div class="psb-upload-title">↑ {{ block.settings.upload_label | default: 'Upload Your Design' }}</div>
          <div class="psb-upload-zone" role="button" tabindex="0" data-psb-open="up" aria-label="Upload artwork">
            <svg class="psb-upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            <span class="psb-upload-sub">{{ block.settings.upload_sub | default: 'UPLOAD NOW OR LATER' }}</span>
            <span class="psb-upload-cta-pill">{{ block.settings.upload_cta | default: 'CLICK TO UPLOAD ARTWORK (OPTIONAL)' }}</span>
            <span class="psb-upload-hint">{{ block.settings.upload_hint | default: 'AI, PSD, PDF — up to 200MB' }}</span>
            <span class="psb-upload-tag" id="psb-upload-tag-{{ block.id }}" style="display:none;">Saved ✓</span>
          </div>
          <input type="hidden" id="psb-fp-{{ block.id }}" name="properties[File Upload]" value="" form="product-form-{{ section.id }}">
          <button type="button" class="psb-bulk-btn" data-psb-open="be">{{ bulk_cta }}</button>
        </div>

        <aside class="psb-step-aside">
          <h4 class="psb-aside-title">{{ block.settings.design_title | default: 'Need design help?' }}</h4>
          <p class="psb-aside-text">{{ block.settings.design_desc | default: 'Request a free 2D mockup preview before printing. Delivered in 4 hours. No commitment.' }}</p>
          <button type="button" class="psb-aside-btn" data-psb-open="dh">{{ block.settings.design_btn | default: 'REQUEST FREE 2D DESIGN PREVIEW' }}</button>
        </aside>
      </div>
    </div>
  {%- endif -%}

  {% comment %} ═════════════ DELIVERY ESTIMATE ═════════════ {% endcomment %}
  {%- if delivery_days != blank and delivery_days != 0 -%}
    <div class="psb-delivery" id="psb-delivery-{{ block.id }}" data-days="{{ delivery_days }}">
      <span class="psb-delivery-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13" rx="1"/>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
          <circle cx="5.5" cy="18.5" r="2.5"/>
          <circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
      </span>
      <div class="psb-delivery-text">
        <span class="psb-delivery-label">{{ delivery_label }}</span>
        <span class="psb-delivery-date" id="psb-delivery-date-{{ block.id }}"></span>
      </div>
    </div>
  {%- endif -%}

  {% comment %} ═════════════ ATC ROW (Qty stepper + ADD TO CART) ═════════════ {% endcomment %}
  <div class="psb-atc-row">
    <div class="psb-qty-stepper">
      <button type="button" class="psb-qty-btn" data-psb-qty="-1" aria-label="Decrease quantity">−</button>
      <input type="number" id="psb-qty-{{ block.id }}" name="quantity" value="1" min="1" inputmode="numeric" form="product-form-{{ section.id }}">
      <button type="button" class="psb-qty-btn" data-psb-qty="+1" aria-label="Increase quantity">+</button>
    </div>
    <button type="submit" id="psb-cart-{{ block.id }}" class="psb-cart-btn" form="product-form-{{ section.id }}" disabled>
      <span class="psb-cart-label">{{ add_to_cart_label }}</span>
      <span class="psb-cart-price" id="psb-cart-price-{{ block.id }}"></span>
    </button>
    <input type="hidden" id="psb-vid-{{ block.id }}" name="id" form="product-form-{{ section.id }}" value="{{ product.selected_or_first_available_variant.id }}">
  </div>

  {% comment %} ═════════════ QUALITY BADGES ═════════════ {% endcomment %}
  {%- if quality_badges != blank -%}
    <div class="psb-quality-badges">
      {%- assign badges_arr = quality_badges | newline_to_br | split: '<br />' -%}
      {%- for b in badges_arr -%}
        {%- assign btxt = b | strip -%}
        {%- if btxt != blank -%}
          <div class="psb-quality-badge">✓ {{ btxt }}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

</div>

{% comment %} ═══════════════════════════════════════════════════════════════
   MODALS
═══════════════════════════════════════════════════════════════ {% endcomment %}

<!-- ═══ MODAL: CUSTOM SIZE QUOTE ═══ -->
<div class="psb-modal" id="psb-m-cs-{{ block.id }}" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="psb-modal-bg" data-psb-close></div>
  <div class="psb-modal-box">
    <div class="psb-modal-head">
      <h3>Custom Size Quote</h3>
      <button class="psb-modal-x" type="button" data-psb-close aria-label="Close">&#x2715;</button>
    </div>
    <div class="psb-modal-body psb-modal-2col">
      <aside class="psb-modal-aside">
        <div class="psb-aside-badge"><div class="psb-aside-num">22</div><div class="psb-aside-yrs">Years</div></div>
        <div class="psb-aside-list">
          <div>✓ Free Shipping</div>
          <div>✓ 1-Year Warranty</div>
          <div>✓ Best Price Guarantee</div>
          <div>✓ Eco-Friendly Materials</div>
        </div>
        <div class="psb-aside-divider"></div>
        <div class="psb-aside-sub">How to Order</div>
        <div class="psb-aside-steps">
          <div><span>1</span> Submit your size request</div>
          <div><span>2</span> Receive quote &amp; approve artwork</div>
          <div><span>3</span> We print &amp; ship to your door</div>
        </div>
      </aside>
      <main class="psb-modal-main">
        <div class="psb-state psb-loading" id="psb-cs-ld-{{ block.id }}"><div class="psb-spinner"></div><p>Sending your request…</p></div>
        <div class="psb-state psb-success" id="psb-cs-sc-{{ block.id }}"><div class="psb-tick">✓</div><p>Got it! Your request has been received. We'll be in touch shortly.</p></div>
        <div class="psb-state psb-error" id="psb-cs-er-{{ block.id }}">Something went wrong. Please email us at {{ shop.email }}.</div>

        <form id="psb-cs-f-{{ block.id }}" class="psb-modal-form" novalidate>
          <div class="psb-field"><label>Name <span>*</span></label><input type="text" id="psb-cs-n-{{ block.id }}" placeholder="Your full name" required></div>
          <div class="psb-field"><label>Email <span>*</span></label><input type="email" id="psb-cs-e-{{ block.id }}" placeholder="your@email.com" required></div>
          <div class="psb-field"><label>Phone <span>*</span></label><input type="tel" id="psb-cs-p-{{ block.id }}" placeholder="+1 (555) 000-0000" required></div>
          <div class="psb-row3">
            <div class="psb-field"><label>Width *</label><input type="number" id="psb-cs-w2-{{ block.id }}" min="1" step="0.1"></div>
            <div class="psb-field"><label>Height *</label><input type="number" id="psb-cs-h-{{ block.id }}" min="1" step="0.1"></div>
            <div class="psb-field"><label>Unit</label><select id="psb-cs-u-{{ block.id }}"><option>ft</option><option>m</option><option>cm</option><option>mm</option><option>inch</option></select></div>
          </div>
          <div class="psb-field"><label>Message</label><textarea id="psb-cs-m-{{ block.id }}" rows="4" placeholder="Tell us about your design"></textarea></div>
          <input type="hidden" id="psb-cs-gi-{{ block.id }}"><input type="hidden" id="psb-cs-gc-{{ block.id }}"><input type="hidden" id="psb-cs-gs-{{ block.id }}"><input type="hidden" id="psb-cs-gz-{{ block.id }}"><input type="hidden" id="psb-cs-gt-{{ block.id }}"><input type="hidden" id="psb-cs-st-{{ block.id }}">
          <div class="psb-honeypot" aria-hidden="true"><input type="text" id="psb-cs-hp-{{ block.id }}" tabindex="-1" autocomplete="off"></div>
          <button type="submit" class="psb-modal-submit">Send Request</button>
        </form>
      </main>
    </div>
  </div>
</div>

<!-- ═══ MODAL: REQUEST 2D MOCKUP / PROOF IMAGE ═══ -->
<div class="psb-modal" id="psb-m-dh-{{ block.id }}" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="psb-modal-bg" data-psb-close></div>
  <div class="psb-modal-box">
    <div class="psb-modal-head">
      <h3>Request Proof Image</h3>
      <button class="psb-modal-x" type="button" data-psb-close aria-label="Close">&#x2715;</button>
    </div>
    <div class="psb-modal-body psb-modal-2col">
      <aside class="psb-modal-aside">
        <div class="psb-aside-badge"><div class="psb-aside-num">22</div><div class="psb-aside-yrs">Years</div></div>
        <div class="psb-aside-list">
          <div>✓ Free Shipping</div>
          <div>✓ 1-Year Warranty</div>
          <div>✓ Best Price Guarantee</div>
          <div>✓ Eco-Friendly Materials</div>
        </div>
      </aside>
      <main class="psb-modal-main">
        <div class="psb-state psb-loading" id="psb-dh-ld-{{ block.id }}"><div class="psb-spinner"></div><p>Sending your request…</p></div>
        <div class="psb-state psb-success" id="psb-dh-sc-{{ block.id }}"><div class="psb-tick">✓</div><p>Got it! We'll send your proof within 4 hours.</p></div>
        <div class="psb-state psb-error" id="psb-dh-er-{{ block.id }}">Something went wrong. Please email us at {{ shop.email }}.</div>

        <form id="psb-dh-f-{{ block.id }}" class="psb-modal-form" novalidate>
          <div class="psb-field"><label>Name <span>*</span></label><input type="text" id="psb-dh-n-{{ block.id }}" required></div>
          <div class="psb-field"><label>Email <span>*</span></label><input type="email" id="psb-dh-e-{{ block.id }}" required></div>
          <div class="psb-field"><label>Phone <span>*</span></label><input type="tel" id="psb-dh-p-{{ block.id }}" required></div>
          <div class="psb-row3">
            <div class="psb-field"><label>Width *</label><input type="number" id="psb-dh-w2-{{ block.id }}" min="1" step="0.1"></div>
            <div class="psb-field"><label>Height *</label><input type="number" id="psb-dh-h-{{ block.id }}" min="1" step="0.1"></div>
            <div class="psb-field"><label>Unit</label><select id="psb-dh-u-{{ block.id }}"><option>ft</option><option>m</option><option>cm</option><option>mm</option><option>inch</option></select></div>
          </div>
          <div class="psb-field"><label>Message</label><textarea id="psb-dh-m-{{ block.id }}" rows="3" placeholder="Describe your design"></textarea></div>

          <div class="psb-upbox">
            <div class="psb-upbox-title">Upload Your Design (optional)</div>
            <div class="psb-upbox-tabs">
              <button type="button" class="psb-uptab psb-uptab-on" data-psb-dhtab="direct">Direct</button>
              <button type="button" class="psb-uptab" data-psb-dhtab="link">Link</button>
              <button type="button" class="psb-uptab" data-psb-dhtab="email">Email Later</button>
            </div>
            <div class="psb-uppan psb-uppan-on" data-psb-dhpanel="direct">
              <button type="button" class="psb-uf-btn" id="psb-dh-uco-{{ block.id }}">Upload a File</button>
              <span class="psb-uf-hint">JPG/PNG/PDF/AI/PSD</span>
