  height: 20px;
  flex-shrink: 0;
}
#psb-{{ block.id }} .psb-cart-price {
  margin-left: 6px;
  padding-left: 10px;
  border-left: 1.5px solid rgba(255,255,255,.4);
  font-weight: 800;
}
#psb-{{ block.id }} .psb-cart-price:empty {
