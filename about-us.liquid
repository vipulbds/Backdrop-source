{% comment %}
  BACKDROPSOURCE — ABOUT US SECTION (rebuilt to match aboutnew.html)
  File: sections/about-us.liquid
  Shopify 2.0 compatible | Fully customisable from Theme Editor

  Hero LEFT  = aboutnew.html design (breadcrumb, live pill, headline w/ thin/bold/accent,
                rule, sub, CTAs, stats row)
  Hero RIGHT = ORIGINAL D3 WORLD MAP preserved (do not touch)
  Other sections = aboutnew.html style (intro, offer, impact, timeline, values, CTA)
  about-us.css still loads — it styles the world map (.bds-hero__right, .bds-map-*).
{% endcomment %}

{{ 'about-us.css' | asset_url | stylesheet_tag }}

<style id="bds-about-aboutnew-styles">
  /* ═══════════════════════════════════════════════════════════════
     ABOUT-US — aboutnew.html style system, scoped to .bds-about
     ═══════════════════════════════════════════════════════════════ */
  .bds-about{
    --crimson:#C8102E; --crimson-dark:#A50D25; --crimson-mid:#E8284A;
    --crimson-soft:rgba(200,16,46,0.08); --crimson-xs:rgba(200,16,46,0.04);
    --navy:#1B2A4A; --navy-mid:#243560; --navy-deep:#0D1525;
    --navy-soft:rgba(27,42,74,0.06);
    --gold:#D4AF37; --gold-lt:#F3E5AB;
    --white:#FFFFFF; --off-white:#F8F9FC; --surface:#F2F4F9;
    --border:#E2E6EF; --border-lt:#EEF0F7;
    --text-1:#0F1C35; --text-2:#3A4A6B; --text-3:#6B7A9A; --text-4:#9AAABF;
    --font-b:'Inter','Google Sans',system-ui,sans-serif;
    --r-sm:6px; --r-md:14px; --r-lg:22px; --r-xl:32px;
    --tr:0.28s cubic-bezier(0.4,0,0.2,1);
  }

  .bds-about *,.bds-about *::before,.bds-about *::after{box-sizing:border-box}
  .bds-about .container{max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,40px)}
  .bds-about a{text-decoration:none;color:inherit}
  .bds-about img{max-width:100%;display:block}
  .bds-about button{font-family:inherit;cursor:pointer}

  /* Buttons (aboutnew.html spec) */
  .bds-about .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:10px;
    padding:14px 32px;border-radius:var(--r-sm);
    font-family:var(--font-b);font-size:15px;font-weight:500;letter-spacing:0.01em;
    transition:all var(--tr);border:2px solid transparent;cursor:pointer;
  }
  .bds-about a.btn-primary,
  .bds-about button.btn-primary,
  .bds-about .btn.btn-primary,
  .bds-about .btn-primary{
    background:#9A1E45 !important;
    background-color:#9A1E45 !important;
    background-image:none !important;
    color:#fff !important;
    border-color:transparent !important;
    box-shadow:0 4px 20px rgba(154,30,69,0.28) !important;
  }
  .bds-about a.btn-primary:hover,
  .bds-about button.btn-primary:hover,
  .bds-about .btn.btn-primary:hover,
  .bds-about .btn-primary:hover{
    background:#0A3161 !important;
    background-color:#0A3161 !important;
    background-image:none !important;
    color:#fff !important;
    border-color:transparent !important;
    transform:translateY(-2px);
    box-shadow:0 8px 28px rgba(10,49,97,0.42) !important;
  }
  .bds-about .btn-outline{background:transparent;color:var(--navy);border-color:var(--border)}
  .bds-about .btn-outline:hover{border-color:var(--navy);background:var(--navy-soft)}
  .bds-about .btn-outline-lt{background:transparent;color:#fff;border-color:rgba(255,255,255,0.3)}
  .bds-about .btn-outline-lt:hover{border-color:#fff;background:rgba(255,255,255,0.1)}

  /* Section tag + h2 */
  .bds-about .section-tag{
    display:inline-flex;align-items:center;gap:10px;font-family:var(--font-b);
    font-size:13px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;
    color:var(--crimson);margin-bottom:20px
  }
  .bds-about .section-tag::before{content:'';width:32px;height:2px;background:var(--crimson)}
  .bds-about .section-tag-lt{color:rgba(255,255,255,0.6)}
  .bds-about .section-tag-lt::before{background:rgba(255,255,255,0.4)}
  .bds-about .section-tag-gold{color:var(--gold)}
  .bds-about .section-tag-gold::before{background:var(--gold)}

  .bds-about .sh2{font-family:var(--font-b);font-size:clamp(26px,3.2vw,38px);font-weight:600;line-height:1.2;color:var(--navy);letter-spacing:-0.02em;margin:0}
  .bds-about .sh2 em{font-style:normal;color:var(--crimson)}
  .bds-about .sh2-lt{color:#fff}
  .bds-about .sh2-lt em{color:#FF6B7A}

  /* ── HERO ─────────────────────────────────────────────────────── */
  /* Original .bds-hero / .bds-hero__left / .bds-hero__right layout from
     about-us.css is INTENTIONALLY untouched here so the world map column
     (its size, dark navy background, and country labels) stays exactly
     as before. The aboutnew.html-style elements below are scoped to
     .bds-hero__left only — they never touch .bds-hero__right. */

  /* Hero left column content */
  .bds-about .hero-bc{display:flex;align-items:center;gap:8px;font-size:11px;font-weight:500;letter-spacing:0.2em;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-bottom:28px}
  .bds-about .hero-bc a{color:rgba(200,16,46,0.75);transition:color var(--tr)}
  .bds-about .hero-bc a:hover{color:#fff}
  .bds-about .hero-bc-sep{opacity:0.2}

  .bds-about .hero-live{display:inline-flex;align-self:flex-start;width:fit-content;max-width:100%;align-items:center;gap:10px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:100px;padding:7px 18px 7px 10px;margin-bottom:30px;backdrop-filter:blur(10px)}
  .bds-about .live-ring{position:relative;width:10px;height:10px;flex-shrink:0}
  .bds-about .live-ring::before{content:'';position:absolute;inset:0;border-radius:50%;background:var(--crimson);animation:bdsPulse 2.5s ease infinite}
  .bds-about .live-ring::after{content:'';position:absolute;inset:2px;border-radius:50%;background:#FF3355}
  .bds-about .live-txt{font-size:13px;font-weight:500;letter-spacing:0.06em;text-transform:uppercase;color:rgba(255,255,255,0.65)}
  .bds-about .live-txt strong{color:#fff;margin-left:4px;font-weight:700}
  /* Mobile: the badge text can wrap to 2 lines — switch from a full stadium to a
     rounded rectangle and align the dot to the first line so the border stays even. */
  @media(max-width:600px){
    .bds-about .hero-live{align-items:flex-start;border-radius:14px;padding:8px 14px 8px 12px}
    .bds-about .hero-live .live-ring{margin-top:4px}
    .bds-about .live-txt{line-height:1.4}
  }
  @keyframes bdsPulse{0%{box-shadow:0 0 0 0 rgba(200,16,46,0.7)}70%{box-shadow:0 0 0 12px rgba(200,16,46,0)}100%{box-shadow:0 0 0 0 rgba(200,16,46,0)}}

  .bds-about .hero-h1{
    font-family:var(--font-b);
    font-size:clamp(40px,5.5vw,64px);
    font-weight:600;line-height:1.08;letter-spacing:-0.03em;
    color:#fff;margin:0 0 28px;
  }
  .bds-about .hero-h1 .line-thin{font-weight:300;display:block;color:rgba(255,255,255,0.92)}
  .bds-about .hero-h1 .line-bold{font-weight:700;display:block}
  .bds-about .hero-h1 .line-accent{
    display:block;font-weight:700;
    background:linear-gradient(120deg,#C8102E 0%,#E8284A 30%,#FF7080 60%,#E8284A 80%,#C8102E 100%);
    background-size:300% 300%;
    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  }

  .bds-about .hero-rule{display:flex;align-items:center;gap:14px;margin:0 0 26px}
  .bds-about .hero-rule-line{height:2px;width:90px;background:linear-gradient(90deg,var(--crimson),transparent);border-radius:2px}
  .bds-about .hero-rule-dot{width:6px;height:6px;border-radius:50%;background:var(--crimson);flex-shrink:0}

  .bds-about .hero-sub{font-size:15px;font-weight:400;color:rgba(255,255,255,0.7);max-width:520px;line-height:1.75;margin:0 0 38px}

  .bds-about .hero-ctas{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:48px}

  /* Stats row inside hero */
  .bds-about .hero-stats-row{
    display:flex;align-items:stretch;gap:0;
    border-top:1px solid rgba(255,255,255,0.07);
    padding-top:32px;
  }
  .bds-about .hstat{flex:1;padding:0 20px;border-right:1px solid rgba(255,255,255,0.07);position:relative}
  .bds-about .hstat:first-child{padding-left:0}
  .bds-about .hstat:last-child{border-right:none}
  .bds-about .hstat::before{content:'';position:absolute;top:-1px;left:0;height:2px;width:0;background:var(--crimson);transition:width 0.5s ease}
  .bds-about .hstat:hover::before{width:100%}
  .bds-about .hstat-val{font-family:var(--font-b);font-size:30px;font-weight:600;color:#fff;letter-spacing:-0.02em;line-height:1;margin-bottom:6px}
  .bds-about .hstat-val em{color:var(--crimson);font-style:normal;font-weight:600}
  .bds-about .hstat-lbl{font-size:11px;font-weight:500;letter-spacing:0.06em;text-transform:uppercase;color:rgba(255,255,255,0.55);line-height:1.4}

  /* ── INTRO / STORY (matches aboutnew.html s-intro) ─────────────── */
  .bds-about .s-intro{padding:clamp(80px,10vw,130px) 0;background:#fff}
  .bds-about .intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(60px,8vw,120px);align-items:center}
  .bds-about .intro-frame{
    position:relative;
    background:linear-gradient(160deg,#FFFFFF 0%,var(--surface) 100%);
    border-radius:var(--r-xl);
    padding:clamp(40px,5vw,56px);
    border:1px solid var(--border);overflow:hidden;
    box-shadow:0 24px 60px -20px rgba(15,25,50,0.18),0 8px 20px -8px rgba(15,25,50,0.08);
  }
  .bds-about .intro-frame::before{
    content:'';position:absolute;top:0;left:0;right:0;height:5px;
    background:linear-gradient(90deg,var(--navy) 0%,var(--navy) 40%,var(--crimson) 60%,var(--crimson) 100%);z-index:3;
  }
  .bds-about .intro-quote-mark{
    position:absolute;top:32px;left:clamp(20px,3vw,40px);
    font-family:Georgia,'Times New Roman',serif;
    font-size:clamp(140px,16vw,200px);font-weight:700;line-height:0.7;
    color:var(--crimson);opacity:0.08;pointer-events:none;z-index:1;user-select:none;
  }
  .bds-about .intro-quote{
    position:relative;z-index:2;font-family:var(--font-b);
    font-size:clamp(22px,2.4vw,30px);font-weight:600;line-height:1.35;
    color:var(--navy);letter-spacing:-0.015em;margin-bottom:24px;
  }
  .bds-about .intro-quote em{
    font-style:normal;font-weight:700;
    background:linear-gradient(135deg,#C8102E 0%,#E8284A 50%,#FF6B7A 100%);
    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  }
  .bds-about .intro-quote-attr{
    position:relative;z-index:2;display:flex;align-items:center;gap:12px;
    padding:14px 0 28px;border-bottom:1px solid var(--border);margin-bottom:28px;
  }
  .bds-about .attr-avatar{
    width:42px;height:42px;border-radius:50%;
    background:linear-gradient(135deg,var(--navy),#2A3F6A);
    display:flex;align-items:center;justify-content:center;
    color:#fff;font-family:var(--font-b);font-size:13px;font-weight:800;
    letter-spacing:0.05em;flex-shrink:0;
    box-shadow:0 4px 12px rgba(15,25,50,0.2),inset 0 1px 0 rgba(255,255,255,0.15);position:relative;
  }
  .bds-about .attr-avatar::after{content:'';position:absolute;bottom:-1px;right:-1px;width:12px;height:12px;border-radius:50%;background:#4CAF57;border:2px solid #fff}
  .bds-about .attr-info{display:flex;flex-direction:column;gap:2px;min-width:0}
  .bds-about .attr-name{font-family:var(--font-b);font-size:14px;font-weight:700;color:var(--navy)}
  .bds-about .attr-role{font-family:var(--font-b);font-size:12px;font-weight:400;color:var(--text-3)}

  .bds-about .intro-minis{position:relative;z-index:2;display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .bds-about .mini-stat{
    position:relative;background:#fff;border:1px solid var(--border);
    border-radius:14px;padding:18px 16px;overflow:hidden;
    transition:transform 0.3s ease,border-color 0.3s ease,box-shadow 0.3s ease;
  }
  .bds-about .mini-stat::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--navy),var(--crimson));transform:scaleX(0);transform-origin:left;transition:transform 0.35s ease}
  .bds-about .mini-stat:hover{transform:translateY(-3px);border-color:rgba(200,16,46,0.3);box-shadow:0 12px 28px -8px rgba(200,16,46,0.18),0 4px 10px -2px rgba(15,25,50,0.08)}
  .bds-about .mini-stat:hover::before{transform:scaleX(1)}
  .bds-about .mini-stat-val{font-family:var(--font-b);font-size:clamp(24px,2.4vw,28px);font-weight:800;color:var(--navy);letter-spacing:-0.03em;line-height:1;margin-bottom:4px}
  .bds-about .mini-stat-lbl{font-family:var(--font-b);font-size:11px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-3)}

  .bds-about .intro-text .section-tag{margin-bottom:16px}
  .bds-about .intro-text .sh2{margin-bottom:24px}
  .bds-about .intro-text p{font-size:15px;font-weight:400;color:var(--text-2);line-height:1.75;margin-bottom:18px}
  .bds-about .intro-text strong{color:var(--navy);font-weight:600}

  /* ── OFFER / FEATURES (matches aboutnew.html s-offer) ─────────── */
  .bds-about .s-offer{background:var(--navy-deep);padding:clamp(80px,10vw,130px) 0;position:relative;overflow:hidden}
  .bds-about .s-offer::before{
    content:'';position:absolute;inset:0;
    background:
      radial-gradient(ellipse 60% 70% at 90% 50%,rgba(200,16,46,0.12) 0%,transparent 60%),
      radial-gradient(ellipse 50% 40% at 10% 20%,rgba(27,42,74,0.8) 0%,transparent 55%);
  }
  .bds-about .offer-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:clamp(48px,6vw,72px);position:relative;z-index:2;gap:24px;flex-wrap:wrap}
  .bds-about .offer-head .sh2{margin-bottom:0}
  .bds-about .offer-head p{max-width:340px;color:rgba(255,255,255,0.55);font-size:15px;line-height:1.7;margin:0}

  .bds-about .offer-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 80px;position:relative;z-index:2;border-top:1px solid rgba(255,255,255,0.08)}
  .bds-about .offer-card{
    position:relative;display:grid;grid-template-columns:64px 1fr;gap:24px;
    padding:32px 0 30px;border-bottom:1px solid rgba(255,255,255,0.08);
    background:transparent;transition:padding-left 0.4s cubic-bezier(0.22,1,0.36,1);
  }
  .bds-about .offer-card::before{
    content:'';position:absolute;left:-16px;top:32px;bottom:30px;width:3px;border-radius:2px;
    background:linear-gradient(180deg,var(--crimson),var(--crimson-mid));
    transform:scaleY(0);transform-origin:top;transition:transform 0.4s cubic-bezier(0.22,1,0.36,1);
  }
  .bds-about .offer-card:hover{padding-left:18px}
  .bds-about .offer-card:hover::before{transform:scaleY(1)}
  .bds-about .offer-card:hover .offer-num{color:#FF6B7A}
  .bds-about .offer-card:hover .offer-title{color:#fff}
  .bds-about .offer-num{
    font-family:Georgia,'Times New Roman',serif;font-style:italic;font-weight:400;
    font-size:38px;line-height:1;letter-spacing:-0.04em;
    color:rgba(255,255,255,0.32);align-self:center;
    transition:color 0.35s ease;
  }
  .bds-about .offer-title{font-family:var(--font-b);font-size:20px;font-weight:600;color:rgba(255,255,255,0.92);letter-spacing:-0.015em;line-height:1.25;margin:0 0 6px;transition:color 0.3s ease;align-self:center;grid-row:1;grid-column:2}
  .bds-about .offer-desc{font-family:var(--font-b);font-size:14px;font-weight:400;color:rgba(255,255,255,0.55);line-height:1.6;margin:0;grid-row:2;grid-column:2;max-width:420px}

  /* ── IMPACT (matches aboutnew.html s-impact) ───────────────────── */
  .bds-about .s-impact{padding:clamp(80px,10vw,130px) 0;background:#fff}
  .bds-about .impact-head{text-align:center;margin-bottom:40px}
  .bds-about .impact-head .section-tag{justify-content:center}
  .bds-about .impact-head .sh2{max-width:600px;margin:0 auto;text-align:center}
  .bds-about .impact-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:var(--r-xl);overflow:hidden;margin-top:60px}
  .bds-about .impact-card{background:#fff;padding:clamp(32px,4vw,48px);text-align:center;position:relative;transition:all var(--tr)}
  .bds-about .impact-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--crimson),var(--crimson-mid));transform:scaleX(0);transition:transform 0.4s ease}
  .bds-about .impact-card:hover{background:var(--off-white)}
  .bds-about .impact-card:hover::before{transform:scaleX(1)}
  .bds-about .impact-ico{font-size:32px;margin-bottom:16px;display:block}
  .bds-about .impact-val{font-family:var(--font-b);font-size:45px;font-weight:600;color:var(--navy);letter-spacing:-0.03em;line-height:1;margin-bottom:8px}
  .bds-about .impact-val em{color:var(--crimson);font-style:normal;font-weight:700}
  .bds-about .impact-lbl{font-size:13px;font-weight:500;letter-spacing:0.06em;text-transform:uppercase;color:var(--text-3)}

  /* ── TIMELINE (matches aboutnew.html s-timeline) ───────────────── */
  .bds-about .s-timeline{background:var(--navy);padding:clamp(80px,10vw,130px) 0;position:relative;overflow:hidden}
  .bds-about .s-timeline::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 70% 60% at 50% 0%,rgba(200,16,46,0.08) 0%,transparent 60%),radial-gradient(ellipse 100% 40% at 50% 100%,rgba(13,21,37,0.6) 0%,transparent 60%)}
  .bds-about .tl-head{text-align:center;margin-bottom:clamp(48px,7vw,80px);position:relative;z-index:2}
  .bds-about .tl-head .section-tag{justify-content:center}
  .bds-about .tl-head .sh2{text-align:center}
  .bds-about .tl-scroll{position:relative;z-index:2;overflow-x:auto;overflow-y:visible;padding:20px 0 40px;scrollbar-width:none}
  .bds-about .tl-scroll::-webkit-scrollbar{display:none}
  .bds-about .tl-track{display:flex;gap:0;padding:0 5%;min-width:max-content;position:relative}
  .bds-about .tl-track::before{content:'';position:absolute;top:50px;left:0;right:0;height:2px;background:rgba(255,255,255,0.08)}
  /* Red progress line — width driven by JS (--tl-prog) as the timeline scrolls */
  .bds-about .tl-track::after{content:'';position:absolute;top:50px;left:0;height:2px;width:var(--tl-prog,0);max-width:100%;background:var(--crimson);border-radius:2px;z-index:1;transition:width 0.12s linear}
  .bds-about .tl-item{flex-shrink:0;width:240px;padding:0 24px;position:relative;cursor:pointer}
  .bds-about .tl-dot-wrap{position:relative;height:20px;margin:40px 0 28px;display:flex;align-items:center;justify-content:center}
  .bds-about .tl-dot{width:16px;height:16px;border-radius:50%;background:rgba(255,255,255,0.15);border:2px solid rgba(255,255,255,0.2);transition:all 0.3s ease;position:relative;z-index:2}
  .bds-about .tl-item:hover .tl-dot,
  .bds-about .tl-item.is-active .tl-dot{background:var(--crimson);border-color:var(--crimson);transform:scale(1.4);box-shadow:0 0 0 6px rgba(200,16,46,0.2)}
  .bds-about .tl-year{font-family:var(--font-b);font-size:45px;font-weight:600;color:rgba(255,255,255,0.1);line-height:1;margin-bottom:8px;transition:color 0.3s ease;text-align:center}
  .bds-about .tl-item:hover .tl-year,
  .bds-about .tl-item.is-active .tl-year{color:var(--crimson)}
  .bds-about .tl-title{font-family:var(--font-b);font-size:20px;font-weight:600;color:#fff;margin-bottom:8px;text-align:center;transition:color 0.3s}
  .bds-about .tl-desc{font-size:14px;font-weight:400;color:rgba(255,255,255,0.55);line-height:1.7;text-align:center}
  .bds-about .tl-hint{display:flex;align-items:center;justify-content:center;gap:10px;margin-top:24px;color:rgba(255,255,255,0.4);font-size:12px;font-weight:500;letter-spacing:0.08em;text-transform:uppercase;position:relative;z-index:2}

  /* ── VALUES (matches aboutnew.html s-values) ───────────────────── */
  .bds-about .s-values{padding:clamp(80px,10vw,130px) 0;background:var(--off-white);position:relative;overflow:hidden}
  .bds-about .s-values::before{
    content:'';position:absolute;inset:0;pointer-events:none;
    background-image:radial-gradient(circle,rgba(10,49,97,0.08) 1px,transparent 1px);
    background-size:34px 34px;
    -webkit-mask-image:radial-gradient(ellipse 80% 60% at 50% 50%,#000 0%,transparent 70%);
    mask-image:radial-gradient(ellipse 80% 60% at 50% 50%,#000 0%,transparent 70%);
  }
  .bds-about .val-head{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:end;margin-bottom:clamp(48px,6vw,72px);position:relative;z-index:1}
  .bds-about .val-head p{font-size:15px;font-weight:400;color:var(--text-2);line-height:1.7;max-width:440px;margin:0}
  .bds-about .val-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative;z-index:1;border-top:1px solid rgba(10,49,97,0.12);border-bottom:1px solid rgba(10,49,97,0.12)}
  .bds-about .val-card{position:relative;background:transparent;border-right:1px solid rgba(10,49,97,0.12);padding:48px 32px 44px;transition:background 0.4s ease;overflow:visible}
  .bds-about .val-card:last-child{border-right:none}
  .bds-about .val-card::before{content:'';position:absolute;top:0;left:24px;right:24px;height:2px;background:var(--crimson);transform:scaleX(0);transform-origin:left;transition:transform 0.5s cubic-bezier(0.22,1,0.36,1)}
  .bds-about .val-card:hover{background:rgba(255,255,255,0.5)}
  .bds-about .val-card:hover::before{transform:scaleX(1)}
  .bds-about .val-card:hover .val-num{color:var(--crimson)}
  .bds-about .val-num{display:inline-block;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-weight:400;font-size:14px;color:rgba(10,49,97,0.45);letter-spacing:0.06em;margin-bottom:24px;transition:color 0.35s ease}
  .bds-about .val-ico-wrap{height:48px;display:block;color:var(--navy);margin:0 0 24px;font-size:38px;line-height:1}
  .bds-about .val-title{font-family:var(--font-b);font-size:22px;font-weight:700;color:var(--navy);letter-spacing:-0.02em;line-height:1.15;margin-bottom:14px}
  .bds-about .val-desc{font-family:var(--font-b);font-size:14px;font-weight:400;color:var(--text-3);line-height:1.65}

  /* ── CTA (matches aboutnew.html s-cta) ─────────────────────────── */
  .bds-about .s-cta{padding:clamp(80px,10vw,120px) 0;background:#fff}
  .bds-about .cta-card{
    background:var(--navy);border-radius:var(--r-xl);
    padding:clamp(48px,7vw,90px);text-align:center;position:relative;overflow:hidden;
  }
  .bds-about .cta-card::before{
    content:'';position:absolute;inset:0;
    background:
      radial-gradient(ellipse 70% 80% at 100% 100%,rgba(200,16,46,0.18) 0%,transparent 55%),
      radial-gradient(ellipse 50% 60% at 0% 0%,rgba(36,53,96,0.8) 0%,transparent 55%);
  }
  .bds-about .cta-card::after{
    content:'';position:absolute;inset:0;
    background-image:radial-gradient(circle,rgba(255,255,255,0.08) 1px,transparent 1px);
    background-size:28px 28px;
    -webkit-mask-image:radial-gradient(ellipse 80% 80% at 50% 50%,rgba(0,0,0,0.15) 0%,transparent 70%);
    mask-image:radial-gradient(ellipse 80% 80% at 50% 50%,rgba(0,0,0,0.15) 0%,transparent 70%);
  }
  .bds-about .cta-inner{position:relative;z-index:2}
  .bds-about .cta-card .section-tag{justify-content:center}
  .bds-about .cta-card .sh2{margin:16px 0 20px;color:#fff}
  .bds-about .cta-card .sh2 em{color:#FF6B7A}
  .bds-about .cta-desc{font-size:15px;font-weight:400;color:rgba(255,255,255,0.65);max-width:560px;margin:0 auto 44px;line-height:1.8}
  .bds-about .cta-actions{display:flex;justify-content:center;gap:16px;flex-wrap:wrap}

  /* ── RESPONSIVE ────────────────────────────────────────────────── */
  /* NOTE: .bds-hero responsive behaviour (left col / map col stacking)
     is owned by about-us.css — intentionally NOT overridden here so the
     world map keeps its original mobile/tablet/desktop sizing. */
  @media(max-width:1100px){
    .bds-about .intro-grid{grid-template-columns:1fr}
    .bds-about .offer-grid{grid-template-columns:1fr}
    .bds-about .offer-head{flex-direction:column;align-items:flex-start;gap:16px}
    .bds-about .impact-grid{grid-template-columns:repeat(2,1fr)}
    .bds-about .val-head{grid-template-columns:1fr;gap:24px}
    .bds-about .val-grid{grid-template-columns:repeat(2,1fr)}
    .bds-about .val-card{border-right:none;border-bottom:1px solid rgba(10,49,97,0.12)}
    .bds-about .val-card:nth-child(odd){border-right:1px solid rgba(10,49,97,0.12)}
    .bds-about .val-card:nth-child(n+3){border-bottom:none}
  }
  @media(max-width:768px){
    .bds-about .hero-stats-row{flex-wrap:wrap;gap:0}
    .bds-about .hstat{width:50%;border-bottom:1px solid rgba(255,255,255,0.07);padding:16px 14px}
    .bds-about .hstat:nth-child(2){border-right:none}
    .bds-about .hstat:nth-child(3),
    .bds-about .hstat:nth-child(4){border-bottom:none}
    .bds-about .impact-grid{grid-template-columns:1fr 1fr}
    .bds-about .val-grid{grid-template-columns:1fr}
    .bds-about .val-card{border-right:none !important;border-bottom:1px solid rgba(10,49,97,0.12)}
    .bds-about .val-card:last-child{border-bottom:none}
    .bds-about .cta-actions{flex-direction:column;align-items:stretch}
    .bds-about .cta-actions .btn{width:100%}
  }
  @media(max-width:480px){
    .bds-about .hero-ctas{flex-direction:column;align-items:stretch}
    .bds-about .hero-ctas .btn{width:100%}
    .bds-about .impact-grid{grid-template-columns:1fr}
  }
</style>


<section
  class="bds-about"
  style="
    --bds-crimson: {{ section.settings.color_crimson }};
    --bds-navy:    {{ section.settings.color_navy }};
    --bds-bg:      {{ section.settings.color_bg }};
  "
  aria-label="{{ section.settings.aria_label | default: 'About BackdropSource' | escape }}"
>

<!-- ══════════════════════════════════════
     HERO — uses original .bds-hero wrapper from about-us.css.
     Right side (world map + country labels) is UNTOUCHED.
     Only the LEFT column gets aboutnew.html-style elements.
══════════════════════════════════════ -->
<div class="bds-hero">

  <!-- LEFT TEXT (aboutnew.html structure, rendered inside the original .bds-hero__left) -->
  <div class="bds-hero__left">
    <nav class="hero-bc">
      <a href="/">Home</a><span class="hero-bc-sep">›</span><span>About Us</span>
    </nav>

    <div class="hero-live">
      <div class="live-ring" aria-hidden="true"></div>
      <span class="live-txt">
        {{ section.settings.badge_text }}{% if section.settings.badge_bold != blank %} <strong>{{ section.settings.badge_bold }}</strong>{% endif %}
      </span>
    </div>

    <h1 class="hero-h1">
      <span class="line-thin">{{ section.settings.headline_line1 }}</span>
      <span class="line-bold">{{ section.settings.headline_line2 }}</span>
      <span class="line-accent">{{ section.settings.headline_line3 }}</span>
    </h1>

    <div class="hero-rule" aria-hidden="true">
      <span class="hero-rule-line"></span>
      <span class="hero-rule-dot"></span>
    </div>

    <p class="hero-sub">{{ section.settings.body_text }}</p>

    {% if section.settings.btn1_label != blank or section.settings.btn2_label != blank %}
    <div class="hero-ctas">
      {% if section.settings.btn1_label != blank %}
      <a href="{{ section.settings.btn1_url }}" class="btn btn-primary">
        {{ section.settings.btn1_label }}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      {% endif %}
      {% if section.settings.btn2_label != blank %}
      <a href="{{ section.settings.btn2_url }}" class="btn btn-outline-lt">{{ section.settings.btn2_label }}</a>
      {% endif %}
    </div>
    {% endif %}

    <!-- Stats row inside hero (aboutnew style, fed by section blocks) -->
    <div class="hero-stats-row" role="list">
      {% for block in section.blocks %}
        {% if block.type == 'stat' %}
        <div class="hstat" role="listitem" {{ block.shopify_attributes }}>
          <div class="hstat-val">{{ block.settings.stat_value }}<em>{{ block.settings.stat_suffix }}</em></div>
          <div class="hstat-lbl">{{ block.settings.stat_label }}</div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- RIGHT: D3 WORLD MAP — EXACT same markup as the ORIGINAL about-us.liquid.
       The map's layout, dark-navy background, country labels and behavior
       are owned entirely by about-us.css + the D3 script below. Do not edit. -->
  <div class="bds-hero__right">
    <div class="bds-map__horizon" aria-hidden="true"></div>
    <div id="bds-map-container-{{ section.id }}" class="bds-map-container" aria-hidden="true">
      <svg id="bds-map-svg-{{ section.id }}" class="bds-map-svg"></svg>
    </div>
  </div>

</div>

<!-- ══════════════════════════════════════
     STORY / INTRO (aboutnew.html s-intro)
══════════════════════════════════════ -->
{% if section.settings.show_story %}
<div class="s-intro">
  <div class="container intro-grid">
    <!-- Visual col -->
    <div class="intro-visual-col">
      <div class="intro-frame">
        <span class="intro-quote-mark" aria-hidden="true">&ldquo;</span>

