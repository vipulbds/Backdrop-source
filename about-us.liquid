<!-- ══════════════════════════════════════
     D3 WORLD MAP SCRIPT (preserved verbatim — do not edit)
     Real Natural Earth TopoJSON (110m)
     NaturalEarth1 projection · Collision-free labels
══════════════════════════════════════ -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/topojson/3.0.2/topojson.min.js"></script>
<script>
(function() {
  var SECTION_ID = '{{ section.id }}';

  /* ── Locations (lon, lat) ── */
  var LOCS = [
    { id:'usa',    name:'USA',                  since:'Present',    lon:-74.0,   lat:40.7   },
    { id:'canada', name:'Canada',               since:'Since 2012', lon:-79.4,   lat:43.7   },
    { id:'uk',     name:'United Kingdom',       since:'Since 2008', lon:-0.13,   lat:51.51  },
    { id:'france', name:'France',               since:'Present',    lon:2.35,    lat:48.85  },
    { id:'germany',name:'Germany',              since:'Present',    lon:13.4,    lat:52.52  },
    { id:'spain',  name:'Spain',                since:'Present',    lon:-3.7,    lat:40.42  },
    { id:'uae',    name:'United Arab Emirates', since:'Present',    lon:55.3,    lat:25.2   },
    { id:'india',  name:'India',                since:'Since 2004', lon:72.88,   lat:19.07  },
    { id:'aus',    name:'Australia',            since:'Since 2008', lon:151.21,  lat:-33.87 },
    { id:'nz',     name:'New Zealand',          since:'Since 2012', lon:174.76,  lat:-36.85 }
  ];

  /* ── Arc connections ── */
  var ARCS = [
    ['usa','uk'],['usa','canada'],['usa','spain'],
    ['uk','france'],['uk','germany'],
    ['germany','uae'],['uae','india'],
    ['india','aus'],['aus','nz']
  ];

  /* ── Preferred label offsets ── */
  var OFFSETS = {
    usa:    { dx:-55, dy:-46 },
    canada: { dx:-58, dy:-46 },
    uk:     { dx:  4, dy:-48 },
    france: { dx: 10, dy:-48 },
    germany:{ dx: 14, dy:-48 },
    spain:  { dx:-55, dy: 14 },
    uae:    { dx:  8, dy: 14 },
    india:  { dx: 10, dy:-48 },
    aus:    { dx:  6, dy: 14 },
    nz:     { dx:  6, dy: 14 }
  };

  var _world = null;
  var PAD = 6;

  function init() {
    var container = document.getElementById('bds-map-container-' + SECTION_ID);
    var svgEl     = document.getElementById('bds-map-svg-' + SECTION_ID);
    if (!container || !svgEl || typeof d3 === 'undefined' || typeof topojson === 'undefined') {
      setTimeout(init, 200); return;
    }

    var svg = d3.select(svgEl);

    function draw(world) {
      /* Read brand colour from the section's inline style (set by Shopify settings) */
      var sectionEl = document.querySelector('.bds-about');
      var CRIMSON = (sectionEl
        ? getComputedStyle(sectionEl).getPropertyValue('--bds-crimson').trim()
        : '') || '#C8102E';
      var W = container.clientWidth;
      var H = container.clientHeight;
      if (!W || !H) { setTimeout(function(){ draw(world); }, 60); return; }

      svg.selectAll('*').remove();
      svg.attr('width', W).attr('height', H);

      var proj = d3.geoNaturalEarth1()
        .scale(Math.min(W / 5.6, H / 3.1))
        .translate([W * 0.52, H * 0.52]);

      var geoPath = d3.geoPath().projection(proj);
      var defs    = svg.append('defs');

      /* Dot pattern */
      var dp = defs.append('pattern').attr('id','bds-dp-'+SECTION_ID)
        .attr('x',0).attr('y',0).attr('width',7).attr('height',7).attr('patternUnits','userSpaceOnUse');
      dp.append('circle').attr('cx',1).attr('cy',1).attr('r',0.82).attr('fill','rgba(110,150,210,0.17)');

      /* Edge fade mask */
      var rg = defs.append('radialGradient').attr('id','bds-rfg-'+SECTION_ID).attr('cx','50%').attr('cy','46%').attr('r','52%');
      rg.append('stop').attr('offset','0%').attr('stop-color','#fff').attr('stop-opacity',1);
      rg.append('stop').attr('offset','66%').attr('stop-color','#fff').attr('stop-opacity',0.86);
      rg.append('stop').attr('offset','100%').attr('stop-color','#fff').attr('stop-opacity',0);
      defs.append('mask').attr('id','bds-mm-'+SECTION_ID)
        .append('rect').attr('width',W).attr('height',H).attr('fill','url(#bds-rfg-'+SECTION_ID+')');

      /* Horizon gradient */
      var hg = defs.append('radialGradient').attr('id','bds-hg-'+SECTION_ID).attr('cx','50%').attr('cy','100%').attr('r','52%');
      hg.append('stop').attr('offset','0%').attr('stop-color',CRIMSON).attr('stop-opacity',0.4);
      hg.append('stop').attr('offset','48%').attr('stop-color',CRIMSON).attr('stop-opacity',0.1);
      hg.append('stop').attr('offset','100%').attr('stop-color',CRIMSON).attr('stop-opacity',0);

      /* Node glow filter */
      var nf = defs.append('filter').attr('id','bds-ng-'+SECTION_ID).attr('x','-100%').attr('y','-100%').attr('width','300%').attr('height','300%');
      nf.append('feGaussianBlur').attr('in','SourceGraphic').attr('stdDeviation',4).attr('result','b');
      nf.append('feColorMatrix').attr('in','b').attr('type','matrix').attr('values','1 0 0 0 0.78  0 0 0 0 0.04  0 0 0 0 0.05  0 0 0 0.8 0').attr('result','r');
      var nfm = nf.append('feMerge'); nfm.append('feMergeNode').attr('in','r'); nfm.append('feMergeNode').attr('in','SourceGraphic');

      /* Arc glow filter */
      var af = defs.append('filter').attr('id','bds-ag-'+SECTION_ID).attr('x','-20%').attr('y','-20%').attr('width','140%').attr('height','140%');
      af.append('feGaussianBlur').attr('in','SourceGraphic').attr('stdDeviation',2).attr('result','b');
      af.append('feColorMatrix').attr('in','b').attr('type','matrix').attr('values','1 0 0 0 0.78  0 0 0 0 0.03  0 0 0 0 0.04  0 0 0 0.65 0').attr('result','r');
      var afm = af.append('feMerge'); afm.append('feMergeNode').attr('in','r'); afm.append('feMergeNode').attr('in','SourceGraphic');

      /* Map group */
      var mapG = svg.append('g').attr('mask','url(#bds-mm-'+SECTION_ID+')');

      /* Dot background */
      mapG.append('rect').attr('width',W).attr('height',H).attr('fill','url(#bds-dp-'+SECTION_ID+')');

      /* Graticule */
      var grat = d3.geoGraticule().step([20,20]);
      mapG.append('path').datum(grat()).attr('fill','none').attr('stroke','rgba(255,255,255,0.04)').attr('stroke-width',0.35).attr('d',geoPath);

      /* Countries */
      if (world) {
        var feat = topojson.feature(world, world.objects.countries);
        mapG.append('g').selectAll('path').data(feat.features).join('path')
          .attr('fill','rgba(38,62,114,0.54)').attr('stroke','rgba(82,126,200,0.24)').attr('stroke-width',0.42).attr('d',geoPath);
        mapG.append('path')
          .datum(topojson.mesh(world, world.objects.countries, function(a,b){ return a!==b; }))
          .attr('fill','none').attr('stroke','rgba(88,136,210,0.16)').attr('stroke-width',0.32).attr('d',geoPath);
      }

      /* Horizon */
      mapG.append('rect').attr('x',0).attr('y',H*0.68).attr('width',W).attr('height',H*0.32).attr('fill','url(#bds-hg-'+SECTION_ID+')');

      /* Project locations */
      var pts = {};
      LOCS.forEach(function(loc) {
        var p = proj([loc.lon, loc.lat]);
        if (p) pts[loc.id] = { x:p[0], y:p[1] };
      });

      /* Arcs */
      var arcG = svg.append('g').attr('filter','url(#bds-ag-'+SECTION_ID+')').attr('opacity',0.9);
      ARCS.forEach(function(pair, i) {
        var a = LOCS.find(function(l){ return l.id===pair[0]; });
        var b = LOCS.find(function(l){ return l.id===pair[1]; });
        if (!a || !b) return;
        arcG.append('path')
          .datum({ type:'Feature', geometry:{ type:'LineString', coordinates:[[a.lon,a.lat],[b.lon,b.lat]] } })
          .attr('class','bds-arc d'+ ((i%9)+1))
          .attr('fill','none').attr('stroke',CRIMSON).attr('stroke-width',1.6)
          .attr('d', geoPath);
      });

      /* Node dots */
      var nodeG = svg.append('g').attr('filter','url(#bds-ng-'+SECTION_ID+')');
      LOCS.forEach(function(loc, i) {
        var p = pts[loc.id]; if (!p) return;
        nodeG.append('circle').attr('class','bds-np p'+((i%9)+1)).attr('cx',p.x).attr('cy',p.y).attr('r',4).attr('stroke-width',1.2);
        nodeG.append('circle').attr('cx',p.x).attr('cy',p.y).attr('r',5).attr('fill',CRIMSON).attr('opacity',0.95);
      });

      /* ── Labels: desktop only. Mobile gets dot-only map + legend below ── */
      var isMobile = W < 600;

      /* Always remove stale legend first */
      var existingLegend = document.getElementById('bds-map-legend-' + SECTION_ID);
      if (existingLegend) existingLegend.remove();

      if (isMobile) {
        /* ── MOBILE LEGEND: clean 2-col grid injected BELOW the right panel ── */
        var legend = document.createElement('div');
        legend.id = 'bds-map-legend-' + SECTION_ID;
        legend.style.cssText = [
          'display:grid',
          'grid-template-columns:1fr 1fr',
          'gap:10px 20px',
          'padding:18px 20px',
          'background:rgba(5,11,24,0.85)',
          'border-top:1px solid rgba(255,255,255,0.07)'
        ].join(';');

        LOCS.forEach(function(loc) {
          var item = document.createElement('div');
          item.style.cssText = 'display:flex;align-items:flex-start;gap:8px;';
          item.innerHTML =
            '<span style="width:8px;height:8px;border-radius:50%;background:' + CRIMSON +
            ';flex-shrink:0;display:inline-block;margin-top:3px;' +
            'box-shadow:0 0 7px ' + CRIMSON + '55;"></span>' +
            '<span style="font-family:Inter,sans-serif;font-size:12px;font-weight:600;' +
            'color:#fff;line-height:1.3;letter-spacing:-0.01em;">' + loc.name +
            '<span style="display:block;font-size:10px;font-weight:300;' +
            'color:rgba(255,255,255,0.42);margin-top:1px;">' + loc.since + '</span></span>';
          legend.appendChild(item);
        });

        /* Append legend INSIDE bds-hero__right, after map container */
        var mapCont = document.getElementById('bds-map-container-' + SECTION_ID);
        var heroRight = mapCont ? mapCont.closest('.bds-hero__right') : null;
        if (heroRight) {
          heroRight.appendChild(legend);
          /* Make the right panel a flex column so legend stacks naturally */
          heroRight.style.cssText += ';display:flex;flex-direction:column;height:auto;min-height:auto;';
          mapCont.style.cssText += ';position:relative;flex:0 0 280px;height:280px;';
        }
        /* Skip label cards on mobile — map + dots already drawn above */
        return;
      }

      /* ── DESKTOP: collision-free floating label cards ── */
      var boxes = [];
      LOCS.forEach(function(loc) {
        var p   = pts[loc.id]; if (!p) return;
        var off = OFFSETS[loc.id] || { dx:0, dy:-46 };
        var cw  = Math.max(loc.name.length * 7.0 + 22, 84);
        var ch  = 36;
        var bx  = Math.max(PAD, Math.min(W - cw - PAD, p.x + off.dx));
        var by  = Math.max(PAD, Math.min(H - ch - PAD, p.y + off.dy));
        boxes.push({ id:loc.id, name:loc.name, since:loc.since, x:bx, y:by, w:cw, h:ch, px:p.x, py:p.y });
      });

      function overlaps(a,b) {
        return !(a.x+a.w+PAD<=b.x || b.x+b.w+PAD<=a.x || a.y+a.h+PAD<=b.y || b.y+b.h+PAD<=a.y);
      }
      for (var pass=0; pass<80; pass++) {
        var moved=false;
        for (var ai=0; ai<boxes.length; ai++) {
          for (var bi=ai+1; bi<boxes.length; bi++) {
            var a=boxes[ai], b=boxes[bi];
            if (!overlaps(a,b)) continue;
            moved=true;
            var ox=(a.x+a.w/2)-(b.x+b.w/2), oy=(a.y+a.h/2)-(b.y+b.h/2);
            var shift=2.5;
            if (Math.abs(ox)>Math.abs(oy)) { var sx=ox>0?shift:-shift; a.x+=sx; b.x-=sx; }
            else { var sy=oy>0?shift:-shift; a.y+=sy; b.y-=sy; }
            a.x=Math.max(PAD,Math.min(W-a.w-PAD,a.x)); a.y=Math.max(PAD,Math.min(H-a.h-PAD,a.y));
            b.x=Math.max(PAD,Math.min(W-b.w-PAD,b.x)); b.y=Math.max(PAD,Math.min(H-b.h-PAD,b.y));
          }
        }
        if (!moved) break;
      }

      /* Connector lines */
      var lineG = svg.append('g');
      boxes.forEach(function(box) {
        var cx=box.x+box.w/2, cy=box.y+box.h/2;
        var ex=cx, ey=(box.py<box.y)?box.y:box.y+box.h;
        if (Math.abs(box.px-cx)>box.w*0.4) { ex=box.px<cx?box.x:box.x+box.w; ey=box.y+box.h/2; }
        lineG.append('line')
          .attr('x1',box.px).attr('y1',box.py).attr('x2',ex).attr('y2',ey)
          .attr('stroke',CRIMSON).attr('stroke-opacity',0.4).attr('stroke-width',0.8).attr('stroke-dasharray','3 3');
      });

      /* Label cards */
      var labelG = svg.append('g');
      boxes.forEach(function(box) {
        var g = labelG.append('g');
        g.append('rect').attr('x',box.x).attr('y',box.y).attr('width',box.w).attr('height',box.h)
          .attr('rx',5).attr('fill','rgba(7,14,30,0.94)').attr('stroke',CRIMSON).attr('stroke-width',0.9);
        g.append('text').attr('x',box.x+box.w/2).attr('y',box.y+13.5).attr('text-anchor','middle')
          .attr('font-family','Inter,sans-serif').attr('font-size',10.5).attr('font-weight',700).attr('fill','#fff').text(box.name);
        g.append('text').attr('x',box.x+box.w/2).attr('y',box.y+26).attr('text-anchor','middle')
          .attr('font-family','Inter,sans-serif').attr('font-size',9).attr('font-weight',300).attr('fill','rgba(255,255,255,0.5)').text(box.since);
      });
    }

    /* Fetch world data once */
    d3.json('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json')
      .then(function(world) {
        _world = world;
        draw(world);
        var ro = new ResizeObserver(function(){ draw(_world); });
        ro.observe(container);
      })
      .catch(function() {
        draw(null);
        var ro = new ResizeObserver(function(){ draw(null); });
        ro.observe(container);
      });
  }

  /* Wait for D3 + TopoJSON scripts to load */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

{%- comment -%} TIMELINE — red progress line that tracks horizontal scroll {%- endcomment -%}
<script>
(function(){
  var scroller = document.querySelector('.bds-about .tl-scroll');
  if(!scroller) return;
  var track = scroller.querySelector('.tl-track');
  if(!track) return;
  var items = Array.prototype.slice.call(track.querySelectorAll('.tl-item'));
  var ticking = false;

  function update(){
    ticking = false;
    // Playhead = centre of the visible viewport, expressed in track coordinates.
    var playhead = scroller.scrollLeft + (scroller.clientWidth / 2);
    var maxW = track.scrollWidth;
    var w = Math.max(0, Math.min(playhead, maxW));
    track.style.setProperty('--tl-prog', w + 'px');

    // Highlight the item whose centre is nearest the playhead.
    var activeIdx = -1, best = Infinity;
    for(var i=0;i<items.length;i++){
      var c = items[i].offsetLeft + (items[i].offsetWidth / 2);
      var d = Math.abs(c - playhead);
      if(d < best){ best = d; activeIdx = i; }
    }
    for(var j=0;j<items.length;j++){
      items[j].classList.toggle('is-active', j === activeIdx);
    }
  }

  function onScroll(){
    if(!ticking){ ticking = true; requestAnimationFrame(update); }
  }

  scroller.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  // Initial paint (after layout settles)
  requestAnimationFrame(update);
  setTimeout(update, 300);
})();
</script>

