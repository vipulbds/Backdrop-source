        <div class="intro-minis">
          <div class="mini-stat"><div class="mini-stat-val">{{ section.settings.mini1_val }}</div><div class="mini-stat-lbl">{{ section.settings.mini1_lbl }}</div></div>
          <div class="mini-stat"><div class="mini-stat-val">{{ section.settings.mini2_val }}</div><div class="mini-stat-lbl">{{ section.settings.mini2_lbl }}</div></div>
          <div class="mini-stat"><div class="mini-stat-val">{{ section.settings.mini3_val }}</div><div class="mini-stat-lbl">{{ section.settings.mini3_lbl }}</div></div>
          <div class="mini-stat"><div class="mini-stat-val">{{ section.settings.mini4_val }}</div><div class="mini-stat-lbl">{{ section.settings.mini4_lbl }}</div></div>
        </div>
