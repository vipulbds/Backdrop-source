<style>
  .how-to-order-section {
    width: 100%;
    padding: 40px 0 60px;
    box-sizing: border-box;
    background: #FFFFFF;
  }

  .how-to-order-title {
    text-align: center;
    margin-bottom: 35px;
    text-transform: uppercase;
    font-weight: 800;
    font-size: 32px;
    letter-spacing: 1.5px;
    color: #0A3161;
  }

  .how-to-order-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 24px;
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .how-to-order-item {
    position: relative;
    background: #E0E4EE;
    text-align: center;
    padding: 40px 20px 30px;
    border-radius: 20px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid rgba(10, 49, 97, 0.12);
    box-shadow: 0 10px 25px rgba(10, 49, 97, 0.1);
  }

  .how-to-order-item:hover {
    background: #0A3161;
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(10, 49, 97, 0.25);
    border-color: #B31942;
  }

  .how-to-order-item:hover h4 {
    color: #FFFFFF;
  }

  .how-to-order-item:hover p {
    color: #E0E4EE;
  }

  /* Step Number Badge */
  .how-to-order-step {
    position: absolute;
    top: -15px;
    left: 50%;
    transform: translateX(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #B31942;
    color: #FFFFFF;
    font-weight: 800;
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    border: 3px solid #FFFFFF;
    box-shadow: 0 4px 10px rgba(179, 25, 66, 0.4);
  }

  /* Icon Wrapper */
  .how-to-order-icon {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px auto;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(10, 49, 97, 0.15);
  }

  .how-to-order-item:hover .how-to-order-icon {
    transform: scale(1.1) rotate(5deg);
    box-shadow: 0 6px 16px rgba(10, 49, 97, 0.3);
  }

  .how-to-order-icon img {
    width: 55px;
    height: 55px;
    object-fit: contain;
  }

  .how-to-order-item h4 {
    font-size: 20px;
    font-weight: 800;
    margin: 0;
    color: #0A3161;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: color 0.3s ease;
  }

  .how-to-order-item p {
    margin: 12px 0 0;
    font-size: 14px;
    color: #4a5878;
    line-height: 1.5;
    transition: color 0.3s ease;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1200px) {
    .how-to-order-grid {
      grid-template-columns: repeat(3, 1fr);
      row-gap: 40px;
    }
  }

  @media (max-width: 768px) {
    .how-to-order-section { padding: 30px 0 50px; }
    .how-to-order-title { font-size: 24px; margin-bottom: 40px; }
    .how-to-order-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px 16px;
    }
    .how-to-order-icon { width: 80px; height: 80px; }
    .how-to-order-icon img { width: 45px; height: 45px; }
    .how-to-order-item h4 { font-size: 18px; }
    .how-to-order-item p { font-size: 13px; }
  }

  @media (max-width: 480px) {
    .how-to-order-grid {
      grid-template-columns: 1fr;
      row-gap: 50px;
    }
    .how-to-order-item { padding: 45px 20px 35px; }
  }
</style>

