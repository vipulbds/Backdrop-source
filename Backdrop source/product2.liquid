        }
        
       var blockarray = {{products_list | split:'::' | json}};
       
       function changePrice(){
        setOptions();
         if($('#width').val() == 0){
           $('#width').val();
         }
         if($('#height').val() == 0){
           $('#height').val();
         }
         
        $('#heightMes').val($('#widthMes').val());   
        var windowSize = $('#width').val() * $('#height').val();
        
       if($('#widthMes').val() == 'm'){
        var windowSize = windowSize* 3.28 * 3.28;
