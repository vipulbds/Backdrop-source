            }
               
               
               
            if(maxsize.between(jsonData.min, jsonData.max, true)) {
            var dispMaxPrice = (maxsize * jsonData.amount)+jsonData.shipping;
            var dispMaxp = (dispMaxPrice/(maxsize*convp));
            $('#productPrice').append('-' + ' ' +'{{ currencySymbol }}'+ dispMaxp.toFixed(digideci) + meas);
               }
     
           }
              
          
            if($('#widthMes').val() == 'ft'){
           displayMinMaxprice(minWindowSizeft, maxWindowSizeft, '/sq.ft',1,2)
            }
            
            if($('#widthMes').val() == 'm'){
             displayMinMaxprice(minWindowSizem, maxWindowSizem, '/sq.m',0.092,2) 
            }
                                    
            if($('#widthMes').val() == 'cm'){
            displayMinMaxprice(minWindowSizecm, maxWindowSizecm, '/sq.cm',929.03,4)
            }
                                    
            if($('#widthMes').val() == 'mm'){ 
            displayMinMaxprice(minWindowSizemm, maxWindowSizemm, '/sq.mm',92903,6)
           }                        
                                    
                  }                     
                                         
                                          
