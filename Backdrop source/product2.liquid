             function displayMinMaxprice(minsize, maxsize, meas,convp,digideci){
             if(minsize.between(jsonData.min, jsonData.max, true)) {
            var dispMinPrice = (minsize * jsonData.amount)+jsonData.shipping;
            var dispMinp = (dispMinPrice/(minsize*convp));
