    {%- comment -%} ── BEFORE / AFTER (split · drag-to-reveal slider) ── {%- endcomment -%}
    {%- if sp.show_gallery -%}
    {%- assign ba_slots = sp.ba_slots | default: 5 -%}
    <section class="bds-ba2">
      <div class="bds-wrap bds-ba-grid">
        <div class="bds-ba-copy">
          {%- if sp.gallery_label != blank -%}<div class="bds-kicker">{{ sp.gallery_label }}</div>{%- endif -%}
          {%- if sp.gallery_title != blank -%}<h2 class="bds-h2">{{ sp.gallery_title }}</h2>{%- endif -%}
          {%- if sp.gallery_sub != blank -%}<p class="bds-lead">{{ sp.gallery_sub }}</p>{%- endif -%}
          {%- assign ba_cta = sp.midcta_btn2 | default: 'Get my backdrop sponsored →' -%}
          {%- if ba_cta != blank -%}
            {%- comment -%} Before/After CTA opens the default "personalised earnings plan" lead form (no kind → uses the modal's default title/eyebrow). {%- endcomment -%}
            <button type="button" class="bds-btn bds-btn--primary" data-open-modal>{{ ba_cta }}</button>
          {%- endif -%}
        </div>
        <div class="bds-ba-media">
          {%- if sp.ba_video != blank -%}
          {%- comment -%} Uploaded video (plays muted + looped like a GIF) — replaces the slider. {%- endcomment -%}
          <div class="bds-ba-photo is-video{% if sp.ba_fit == 'cover' %} is-cover{% endif %}"><video class="bds-ba-video" autoplay muted loop playsinline preload="metadata"{% if sp.ba_after_img != blank %} poster="{{ sp.ba_after_img | image_url: width: 1600 }}"{% elsif sp.ba_image != blank %} poster="{{ sp.ba_image | image_url: width: 1600 }}"{% endif %}>{%- for s in sp.ba_video.sources -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endfor -%}</video></div>
          {%- elsif sp.ba_video_url != blank -%}
          {%- comment -%} YouTube/Vimeo embed — built muted + looped by JS. {%- endcomment -%}
          <div class="bds-ba-photo"><div class="bds-ba-embed" data-ba-embed="{{ sp.ba_video_url | escape }}"></div></div>
          {%- elsif sp.ba_before_img != blank and sp.ba_after_img != blank -%}
          <div class="bds-ba-photo">
          <div class="bds-baslider" data-baslider style="--bapos:50%">
            <img class="bds-baslider-after" src="{{ sp.ba_after_img | image_url: width: 2200 }}" alt="{{ sp.ba_after_label | default: 'After' | escape }}" width="{{ sp.ba_after_img.width }}" height="{{ sp.ba_after_img.height }}" loading="lazy">
            <div class="bds-baslider-before"><img src="{{ sp.ba_before_img | image_url: width: 2200 }}" alt="{{ sp.ba_before_label | default: 'Before' | escape }}" loading="lazy"></div>
            <span class="bds-baslider-tag bds-baslider-tagb">{{ sp.ba_before_label | default: 'Before' }}</span>
            <span class="bds-baslider-tag bds-baslider-taga">{{ sp.ba_after_label | default: 'After' }}</span>
            <div class="bds-baslider-handle"><span class="bds-baslider-line"></span><span class="bds-baslider-knob" aria-hidden="true">⟷</span></div>
            <div class="bds-baslider-hint">{{ sp.ba_hint | default: '← Move to compare →' }}</div>
          </div>
          </div>
          {%- elsif sp.ba_image != blank -%}
          <div class="bds-ba-photo"><img src="{{ sp.ba_image | image_url: width: 2200 }}" alt="{{ sp.gallery_title | default: 'Before and after backdrop comparison' | strip_html | escape }}" width="{{ sp.ba_image.width }}" height="{{ sp.ba_image.height }}" loading="lazy"></div>
          {%- else -%}
          <div class="bds-ba">
            <div class="bds-ba-card">
              <div class="bds-ba-tag2">{{ sp.ba_before_label | default: 'Before' }}</div>
              <div class="bds-ba-stage">
                <div class="bds-ba-mock">
                  <div class="bds-ba-logo">{{ sp.ba_logo_text | default: 'Company Logo' }}</div>
                  <div class="bds-ba-visual">{{ sp.ba_visual_text | default: 'Product / Event Visuals' }}</div>
                </div>
                <div class="bds-ba-strip bds-ba-strip--empty">{{ sp.ba_before_strip | default: 'This space is unused' }}</div>
              </div>
              <div class="bds-ba-cap bds-ba-cap--bad">{{ sp.ba_before_cap | default: 'Empty space — no revenue' }}</div>
            </div>
            <div class="bds-ba-vs">{{ sp.ba_vs_text | default: 'VS' }}</div>
            <div class="bds-ba-card">
              <div class="bds-ba-tag2 bds-ba-tag2--after">{{ sp.ba_after_label | default: 'After' }}</div>
              <div class="bds-ba-stage">
                <div class="bds-ba-mock">
                  <div class="bds-ba-logo">{{ sp.ba_logo_text | default: 'Company Logo' }}</div>
                  <div class="bds-ba-visual">{{ sp.ba_visual_text | default: 'Product / Event Visuals' }}</div>
                </div>
                <div class="bds-ba-strip bds-ba-strip--full">
                  {%- for i in (1..ba_slots) -%}<div class="bds-ba-slot"><span>{{ sp.ba_slot_label | default: 'Sponsor space' }}</span></div>{%- endfor -%}
                </div>
              </div>
              <div class="bds-ba-cap bds-ba-cap--good">{{ ic_trend }} {{ sp.ba_after_cap | default: 'Sponsor slots — you earn every event' }}</div>
            </div>
          </div>
          {%- endif -%}
        </div>
      </div>
    </section>
    {%- endif -%}

    {%- comment -%} ── ROI CALCULATOR (hidden by default — enable in editor) ── {%- endcomment -%}
    {%- if sp.show_roi -%}
    <section class="bds-roi-sec" id="bds-calc-{{ uid }}">
      <div class="bds-wrap bds-center">
        {%- if sp.roi_label != blank -%}<div class="bds-kicker">{{ sp.roi_label }}</div>{%- endif -%}
        {%- if sp.roi_title != blank -%}<h2 class="bds-h2">{{ sp.roi_title }}</h2>{%- endif -%}
        {%- if sp.roi_sub != blank -%}<p class="bds-lead">{{ sp.roi_sub }}</p>{%- endif -%}
      </div>
      <div class="bds-wrap">
        <div class="bds-roi" id="bds-roi-{{ uid }}">
          <div class="bds-roi-controls">
            <div class="bds-roi-ctrl-eyebrow">{{ sp.roi_ctrl_eyebrow | default: 'Your scenario' }}</div>
            <div class="bds-slider">
              <div class="bds-slider-lbl"><span>{{ sp.roi_l_cost | default: 'Backdrop cost' }}</span><span class="bds-slider-val" data-out="cost">₹{{ sp.roi_cost_default | default: 40000 }}</span></div>
              <input type="range" min="{{ sp.roi_cost_min | default: 5000 }}" max="{{ sp.roi_cost_max | default: 1000000 }}" step="{{ sp.roi_cost_step | default: 5000 }}" value="{{ sp.roi_cost_default | default: 40000 }}" data-in="cost">
            </div>
            <div class="bds-slider">
              <div class="bds-slider-lbl"><span>{{ sp.roi_l_sponsors | default: 'No. of sponsors' }}</span><span class="bds-slider-val" data-out="sponsors">{{ sp.roi_sponsors_default | default: 1 }}</span></div>
              <input type="range" min="1" max="{{ sp.roi_sponsors_max | default: 6 }}" step="1" value="{{ sp.roi_sponsors_default | default: 1 }}" data-in="sponsors">
            </div>
            <div class="bds-slider">
              <div class="bds-slider-lbl"><span>{{ sp.roi_l_fee | default: 'Average sponsor fee' }}</span><span class="bds-slider-val" data-out="fee">₹{{ sp.roi_fee_default | default: 15000 }}</span></div>
              <input type="range" min="{{ sp.roi_fee_min | default: 1000 }}" max="{{ sp.roi_fee_max | default: 200000 }}" step="{{ sp.roi_fee_step | default: 1000 }}" value="{{ sp.roi_fee_default | default: 15000 }}" data-in="fee">
            </div>
            <div class="bds-roi-ctrl-foot"><i></i>{{ sp.roi_foot_note | default: 'Estimates update live as you drag.' }}</div>
          </div>
          <div class="bds-roi-results">
            <div class="bds-roi-top"><span class="bds-roi-top-l">{{ sp.roi_invest_label | default: 'Total backdrop investment' }}</span><span class="bds-roi-top-sep">·</span><span class="bds-roi-top-v" data-out="invest">₹{{ sp.roi_cost_default | default: 40000 }}</span></div>
            <div class="bds-roi-gauge">
              <svg viewBox="0 0 200 116" aria-hidden="true">
                <defs><linearGradient id="bds-gauge-{{ uid }}" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#6FBF97"/><stop offset="100%" stop-color="#3E8E6E"/></linearGradient></defs>
                <path d="M16 104 A 84 84 0 0 1 184 104" fill="none" stroke="rgba(255,255,255,.12)" stroke-width="15" stroke-linecap="round"/>
                <path data-gauge d="M16 104 A 84 84 0 0 1 184 104" fill="none" stroke="url(#bds-gauge-{{ uid }})" stroke-width="15" stroke-linecap="round" pathLength="100" stroke-dasharray="0 100"/>
              </svg>
              <div class="bds-roi-gauge-c"><div class="v" data-out="coverpct">0%</div><div class="l">of your cost covered by sponsors</div></div>
            </div>
            <div class="bds-roi-cards">
              <div class="bds-roi-card"><div class="bds-roi-card-l">{{ sp.roi_r_eff | default: 'Effective cost' }}</div><div class="bds-roi-card-v" data-out="effcost">₹0</div><div class="bds-roi-card-s" data-out="effsub">partially covered</div></div>
              <div class="bds-roi-card"><div class="bds-roi-card-l">{{ sp.roi_r_earn | default: 'You earn' }}</div><div class="bds-roi-card-v is-green" data-out="earn">₹0</div><div class="bds-roi-card-s" data-out="earnsub">{{ sp.roi_earn_sub | default: 'from sponsors' }}</div></div>
            </div>
            {%- assign roi_cta_label = sp.roi_cta2 | default: sp.roi_cta -%}
            {%- if roi_cta_label != blank -%}<div class="bds-roi-cta-wrap"><button class="bds-roi-cta" type="button" data-open-modal>{{ roi_cta_label }}</button></div>{%- endif -%}
          </div>
        </div>
      </div>
    </section>
    {%- endif -%}

    {%- comment -%} ── TESTIMONIALS (marquee · falls back to built-in India quotes when no blocks) ── {%- endcomment -%}
    {%- unless testi_blocks.size > 0 -%}
      {%- assign f_tq = "BackdropSource matched us with a logistics firm paying ₹75,000 per booking — completely hands-off. Best thing we signed up for.|A fintech brand pays ₹35,000 per event. That's an extra ₹4.5L a month, passively. We didn't change a thing about how we operate.|They closed ₹2.3Cr in sponsorships for our forum. One team handled everything — proposals, backdrops, activation. Nothing like it.|Never thought a sponsor would pay for backdrop space — but a hardware brand now covers my full rental costs every single time.|Every local sponsor wants visibility. This platform makes the connection automatic — we're fully funded at every tournament.|Two national sponsors cover all our costs. We now run trade show backdrops at zero overhead — and still pocket the profit." | split: '|' -%}
      {%- assign f_tn = "Karthik Rajendhran|Priya Subramaniam|Arvind Muthukumar|Neha Kulkarni|Rahul Menon|Ananya Iyer" | split: '|' -%}
      {%- assign f_ti = "KR|PS|AM|NK|RM|AI" | split: '|' -%}
      {%- assign f_tm = "Director · Kovai TechVentures|Head of Marketing · SRM Capitals|Founder · Nilgiris Event Studio|Tech launches · Pune|Sports · Kochi|Trade shows · Bengaluru" | split: '|' -%}
      {%- assign f_tt = "Corporate · Coimbatore|Events · Chennai|Summits · Nilgiris|Tech launches · Pune|Sports · Kochi|Trade shows · Bengaluru" | split: '|' -%}
    {%- endunless -%}
    <section class="bds-testi-sec" id="bds-testi-{{ uid }}">
      <div class="bds-wrap bds-center bds-testi-head">
        {%- if sp.testi_label != blank -%}<div class="bds-kicker">{{ sp.testi_label }}</div>{%- endif -%}
        {%- if sp.testi_title != blank -%}<h2 class="bds-h2">{{ sp.testi_title }}</h2>{%- endif -%}
        {%- if sp.testi_sub != blank -%}<p class="bds-lead">{{ sp.testi_sub }}</p>{%- endif -%}
      </div>
      <div class="bds-testi-marquee">
        <div class="bds-testi-track">
          {%- for pass in (1..2) -%}
          <div class="bds-testi-set"{% if pass == 2 %} aria-hidden="true"{% endif %}>
            {%- if testi_blocks.size > 0 -%}
              {%- for block in testi_blocks -%}
              {%- assign is_navy = forloop.index0 | modulo: 2 -%}
              {%- assign meta_txt = block.settings.meta | default: block.settings.tag -%}
              {%- assign tag_txt = block.settings.tag -%}
              <div class="bds-tcard{% if is_navy == 1 %} is-navy{% endif %}"{% if pass == 1 %} {{ block.shopify_attributes }}{% endif %}>
                <div>
                  <div class="bds-tcard-stars">{% assign r = block.settings.stars | default: 5 %}{% for i in (1..r) %}★{% endfor %}</div>
                  <p class="bds-tcard-q">“{{ block.settings.quote | strip_html }}”</p>
                </div>
                <div class="bds-tcard-foot">
                  <div class="bds-tcard-who">
                    <div class="bds-tcard-av">{{ block.settings.initials }}</div>
                    <div><div class="bds-tcard-nm">{{ block.settings.name }}</div><div class="bds-tcard-mt">{{ meta_txt }}</div></div>
                  </div>
                  {%- if tag_txt != blank -%}<div class="bds-tcard-tag">{{ tag_txt }}</div>{%- endif -%}
                </div>
              </div>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (0..5) -%}
              {%- assign is_navy = i | modulo: 2 -%}
              <div class="bds-tcard{% if is_navy == 1 %} is-navy{% endif %}">
                <div>
                  <div class="bds-tcard-stars">★★★★★</div>
                  <p class="bds-tcard-q">“{{ f_tq[i] }}”</p>
                </div>
                <div class="bds-tcard-foot">
                  <div class="bds-tcard-who">
                    <div class="bds-tcard-av">{{ f_ti[i] }}</div>
                    <div><div class="bds-tcard-nm">{{ f_tn[i] }}</div><div class="bds-tcard-mt">{{ f_tm[i] }}</div></div>
                  </div>
                  <div class="bds-tcard-tag">{{ f_tt[i] }}</div>
                </div>
              </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
          {%- endfor -%}
        </div>
      </div>
    </section>

    {%- comment -%} ── SPONSOR LOGOS (optional) ── {%- endcomment -%}
    {%- if sp.show_logos and logo_blocks.size > 0 -%}
    <section class="bds-logos" id="bds-sponsors-{{ uid }}">
