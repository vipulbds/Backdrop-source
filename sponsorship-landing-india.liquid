    .shopify-section-group-header-group,.header-section,#shopify-section-header,
    .announcement-bar,.announcement-bar-section,.utility-bar,.section-header,
    .bds-header,.ext-new-header,.bds-nav-bar,.header.section--padding,
    #shopify-section-sticky-atc-bar{display:none!important}
  </style>
  <script>
    (function(){
      function hide(el){ if(el&&el.style) el.style.setProperty('display','none','important'); }
      function run(){
        var main=document.getElementById('MainContent');
        /* 0) STRUCTURE-AGNOSTIC: walk up from THIS section to <body>; at every level
              hide all siblings that come BEFORE us (removes header-group whatever the theme layout is). */
        var wrap=document.querySelector('.section-sponsorship-landing-india');
        if(wrap){ var node=wrap; while(node && node!==document.body){ var s=node.previousElementSibling; while(s){ if(s.tagName!=='SCRIPT'&&s.tagName!=='STYLE') hide(s); s=s.previousElementSibling; } node=node.parentElement; } }
        /* 1) hide every sibling rendered before #MainContent (themes that use it) */
        if(main){ var el=main.previousElementSibling; while(el){ if(el.tagName!=='SCRIPT'&&el.tagName!=='STYLE') hide(el); el=el.previousElementSibling; } }
        /* 2) hide any <header> landmark outside this page's content */
        var hs=document.getElementsByTagName('header'); for(var i=0;i<hs.length;i++){ if(!main||!main.contains(hs[i])) hide(hs[i]); }
        /* 3) hide known header / announcement wrappers by class */
        var sel=document.querySelectorAll('.shopify-section-group-header-group,.header-section,#shopify-section-header,.announcement-bar,.announcement-bar-section,.utility-bar,.section-header,.bds-header,.ext-new-header,.bds-nav-bar,.header.section--padding,#shopify-section-sticky-atc-bar');
        for(var j=0;j<sel.length;j++) hide(sel[j]);
        /* 4) hide any leftover full-width bar pinned at the very top (sticky announcement apps) */
        var spec=document.querySelector('.section-sponsorship-landing-india'); var all=document.body.getElementsByTagName('*');
        for(var k=0;k<all.length;k++){ var e=all[k]; if(!e||(spec&&(spec===e||spec.contains(e)))||(main&&main.contains(e))) continue;
          var cs=getComputedStyle(e); if((cs.position==='fixed'||cs.position==='sticky')){ var r=e.getBoundingClientRect(); if(r.top<=1&&r.width>=window.innerWidth*0.7&&r.height<window.innerHeight*0.5) hide(e); } }
      }
      if(document.readyState!=='loading'){ run(); } else { document.addEventListener('DOMContentLoaded',run); }
      [120,400,1000].forEach(function(d){ setTimeout(run,d); });
      document.addEventListener('shopify:section:load',run);
    })();
  </script>
  {%- endif -%}

  {%- if sp.hide_theme_footer -%}
  {%- comment -%} Hides the theme's big multi-column footer on this page only, leaving just this
    section's slim phone/email bar. Only elements whose id/class contains "footer" are hidden,
    so the floating chat widget is left untouched. {%- endcomment -%}
  <style>
    .shopify-section-group-footer-group,.footer-section,#shopify-section-footer,.section-footer{display:none!important}
  </style>
  <script>
    (function(){
      function hide(el){ if(el&&el.style) el.style.setProperty('display','none','important'); }
      function isFooter(el){ var s=((el.id||'')+' '+(''+(el.className||''))).toLowerCase(); return s.indexOf('footer')>-1; }
      function run(){
        var sel=document.querySelectorAll('.shopify-section-group-footer-group,.footer-section,#shopify-section-footer,.section-footer');
        for(var j=0;j<sel.length;j++) hide(sel[j]);
        /* Structure-agnostic: walk up from THIS section; at every level hide following siblings that look like a footer. */
        var wrap=document.querySelector('.section-sponsorship-landing-india');
        if(wrap){ var node=wrap; while(node && node!==document.body){ var s=node.nextElementSibling; while(s){ if(s.tagName!=='SCRIPT'&&s.tagName!=='STYLE'&&isFooter(s)) hide(s); s=s.nextElementSibling; } node=node.parentElement; } }
        var main=document.getElementById('MainContent');
        if(main){ var el=main.nextElementSibling; while(el){ if(el.tagName!=='SCRIPT'&&el.tagName!=='STYLE'&&isFooter(el)) hide(el); el=el.nextElementSibling; } }
      }
      if(document.readyState!=='loading'){ run(); } else { document.addEventListener('DOMContentLoaded',run); }
      [120,400,1000].forEach(function(d){ setTimeout(run,d); });
      document.addEventListener('shopify:section:load',run);
    })();
  </script>
  {%- endif -%}

  {%- assign testi_blocks = section.blocks | where: 'type', 'testimonial' -%}
  {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
  {%- assign trust_blocks = section.blocks | where: 'type', 'trust' -%}
  {%- assign logo_blocks = section.blocks | where: 'type', 'logo' -%}
  {%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}

  <div class="bds-spon" id="bds-spon-{{ uid }}">

    {%- comment -%} ── NAV ── {%- endcomment -%}
    {%- if sp.show_nav -%}
    <nav class="bds-nav">
      <div class="bds-nav-in">
        <a class="bds-nav-logo" href="{{ sp.nav_logo_link | default: '#' }}">
          {%- if sp.nav_logo_image != blank -%}
            <img class="bds-nav-logo-img" src="{{ sp.nav_logo_image | image_url: width: 480 }}" alt="{{ sp.nav_logo_text | default: shop.name | escape }}" width="{{ sp.nav_logo_image.width }}" height="{{ sp.nav_logo_image.height }}" loading="eager">
          {%- else -%}
            <span class="pre">{{ sp.nav_logo_pre | default: 'Ads by' }}</span>{{ sp.nav_logo_text | default: 'Backdrop' }}<span class="ac">{{ sp.nav_logo_accent | default: 'Source' }}</span>
          {%- endif -%}
        </a>
        <div class="bds-nav-right">
          {%- if sp.nav_link1 != blank -%}<a data-scroll="{% if sp.show_video %}bds-video-sec-{{ uid }}{% else %}bds-how-{{ uid }}{% endif %}">{{ sp.nav_link1 }}</a>{%- endif -%}
          {%- if sp.nav_link_analytics != blank and sp.show_analytics -%}<a data-scroll="bds-an-{{ uid }}">{{ sp.nav_link_analytics }}</a>{%- endif -%}
          {%- if sp.nav_link3 != blank -%}<a data-scroll="bds-faq-{{ uid }}">{{ sp.nav_link3 }}</a>{%- endif -%}
          {%- if sp.nav_cta_label != blank -%}<button type="button" class="bds-nav-cta" data-open-modal data-role="owner">{{ sp.nav_cta_label }}</button>{%- endif -%}
        </div>
      </div>
    </nav>
    <div class="bds-nav-spacer"></div>
    {%- endif -%}

    {%- comment -%} ── HERO ── {%- endcomment -%}
    <section class="bds-hero">
      {%- liquid
        assign d_vid = sp.hero_bg_video
        assign d_url = sp.hero_bg_video_url
        assign d_img = sp.hero_bg_image
        assign m_vid = sp.hero_bg_video_mobile
        assign m_url = sp.hero_bg_video_url_mobile
        assign m_img = sp.hero_bg_image_mobile
        assign has_mobile = false
        if m_vid != blank or m_url != blank or m_img != blank
          assign has_mobile = true
        endif
      -%}
      {%- comment -%} Hero background: per-device image / uploaded video / YouTube-Vimeo embed.
        Priority per device: uploaded video → embed URL → image. JS renders only the layer for the
        current breakpoint (so only one media loads). Mobile falls back to desktop when left blank. {%- endcomment -%}
      <div class="bds-hero-bg" data-hero-bg>
        <template data-tpl="d">
          {%- if d_vid != blank -%}
            <video class="bds-hero-vid" autoplay muted loop playsinline preload="auto"{% if d_img != blank %} poster="{{ d_img | image_url: width: 1600 }}"{% endif %}>{%- for s in d_vid.sources -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endfor -%}</video>
          {%- elsif d_url != blank -%}
            <div class="bds-hero-embed-wrap" data-embed="{{ d_url | escape }}"></div>
          {%- elsif d_img != blank -%}
            <img class="bds-hero-img" src="{{ d_img | image_url: width: 2200 }}" alt="" loading="eager">
          {%- endif -%}
        </template>
        {%- if has_mobile -%}
        <template data-tpl="m">
          {%- if m_vid != blank -%}
            <video class="bds-hero-vid" autoplay muted loop playsinline preload="auto"{% if m_img != blank %} poster="{{ m_img | image_url: width: 1000 }}"{% endif %}>{%- for s in m_vid.sources -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endfor -%}</video>
          {%- elsif m_url != blank -%}
            <div class="bds-hero-embed-wrap" data-embed="{{ m_url | escape }}"></div>
          {%- elsif m_img != blank -%}
            <img class="bds-hero-img" src="{{ m_img | image_url: width: 1400 }}" alt="" loading="eager">
          {%- endif -%}
        </template>
        {%- endif -%}
      </div>
      <div class="bds-wrap bds-hero-grid{% if sp.hero_center %} is-center{% endif %}">
        <div class="bds-hero-copy">
          {%- if sp.hero_pill != blank -%}<div class="bds-hero-pill">{{ sp.hero_pill }}</div>{%- endif -%}
          <h1 class="bds-hero-h1">
            {%- if ccount > 0 and cyc.first != blank -%}
              {{ sp.hero_heading_lead | default: 'Brands pay to reach your' }}<br>
              <span class="bds-cycle">
                {%- for w in cyc -%}<span class="bds-cycle-word" style="animation-delay:{{ forloop.index0 | times: cyc_dur | divided_by: ccount }}s">{{ w | strip }}</span>{%- endfor -%}
              </span>
            {%- else -%}
              {{ sp.hero_heading }}
            {%- endif -%}
          </h1>
          {%- if sp.hero_sub != blank -%}<p class="bds-hero-sub">{{ sp.hero_sub }}</p>{%- endif -%}
          <div class="bds-hero-btns">
            {%- comment -%} Both hero CTAs open the dual-role lead pop-up (Owner / Sponsor). Set a button link to override with a page instead. {%- endcomment -%}
            {%- if sp.owner_btn_link != blank -%}
            <a class="bds-btn bds-btn--primary" href="{{ sp.owner_btn_link }}">{{ sp.owner_btn | default: "I'm a Backdrop Owner" }} →</a>
            {%- else -%}
            <button type="button" class="bds-btn bds-btn--primary" data-open-modal data-role="owner">{{ sp.owner_btn | default: "I'm a Backdrop Owner" }} →</button>
            {%- endif -%}
            {%- if sp.sponsor_btn_link != blank -%}
            <a class="bds-btn bds-btn--ghost" href="{{ sp.sponsor_btn_link }}">{{ sp.sponsor_btn | default: 'Become a Sponsor' }} →</a>
            {%- else -%}
            <button type="button" class="bds-btn bds-btn--ghost" data-open-modal data-role="sponsor">{{ sp.sponsor_btn | default: 'Become a Sponsor' }} →</button>
            {%- endif -%}
          </div>
          {%- if sp.hero_note != blank -%}<p class="bds-hero-note">{{ sp.hero_note }}</p>{%- endif -%}
        </div>

        {%- comment -%} Hero bubbles use their own "Hero bubble" blocks; if none are added, fall back to the first 3 Testimonial blocks. {%- endcomment -%}
        {%- assign hero_blocks = section.blocks | where: 'type', 'hero_quote' -%}
        {%- assign bubble_use_hero = false -%}
        {%- if hero_blocks.size > 0 -%}
          {%- assign bubble_blocks = hero_blocks -%}
          {%- assign bubble_use_hero = true -%}
        {%- else -%}
          {%- assign bubble_blocks = testi_blocks -%}
        {%- endif -%}
        {%- if sp.hero_show_bubbles and bubble_blocks.size > 0 -%}
        <div class="bds-bubbles" aria-hidden="true">
          {%- assign bubble_pos = 'b1,b2,b3' | split: ',' -%}
          {%- for block in bubble_blocks limit: 3 -%}
          {%- assign short_q = block.settings.quote | strip_html -%}
          {%- if bubble_use_hero -%}
            {%- assign loc = block.settings.location -%}
          {%- else -%}
            {%- assign loc = block.settings.meta | split: '·' | last | strip -%}
          {%- endif -%}
          <div class="bds-bubble {{ bubble_pos[forloop.index0] }}"{% if bubble_use_hero %} {{ block.shopify_attributes }}{% endif %}>
            <p>“{{ short_q }}”</p>
            <div class="bds-bubble-who">
              <div class="bds-bubble-av">{{ block.settings.initials }}</div>
              <div><div class="bds-bubble-nm">{{ block.settings.name }}</div><div class="bds-bubble-lo">{{ loc }}</div></div>
            </div>
          </div>
          {%- endfor -%}
        </div>
        {%- endif -%}
      </div>
    </section>

    {%- comment -%} ── STATS BAR + TICKER (falls back to built-in India figures when no blocks) ── {%- endcomment -%}
    <div class="bds-statsbar" id="bds-stats-{{ uid }}">
      <div class="bds-stats">
        {%- if stat_blocks.size > 0 -%}
          {%- for block in stat_blocks -%}
          <div class="bds-stat" {{ block.shopify_attributes }}>
            <div class="bds-stat-top"><span class="bds-stat-figure">{{ block.settings.value }}</span>{% if block.settings.badge2 != blank %}<span class="bds-stat-badge">{{ block.settings.badge2 }}</span>{% endif %}</div>
            <div class="bds-stat-label">{{ block.settings.label }}</div>
          </div>
          {%- endfor -%}
        {%- else -%}
          <div class="bds-stat"><div class="bds-stat-top"><span class="bds-stat-figure">2,841</span><span class="bds-stat-badge">+47 today</span></div><div class="bds-stat-label">Owners enrolled this week</div></div>
          <div class="bds-stat"><div class="bds-stat-top"><span class="bds-stat-figure">₹1.2Cr</span></div><div class="bds-stat-label">Paid to owners this month</div></div>
          <div class="bds-stat"><div class="bds-stat-top"><span class="bds-stat-figure">94%</span></div><div class="bds-stat-label">Sponsor match rate</div></div>
          <div class="bds-stat"><div class="bds-stat-top"><span class="bds-stat-figure">6,400+</span></div><div class="bds-stat-label">Brands on platform</div></div>
        {%- endif -%}
      </div>
      <div class="bds-ticker">
        <div class="bds-ticker-track">
          {%- for pass in (1..2) -%}
          <div class="bds-ticker-set"{% if pass == 2 %} aria-hidden="true"{% endif %}>
            {%- if trust_blocks.size > 0 -%}
              {%- for block in trust_blocks -%}<div class="bds-ticker-item"{% if pass == 1 %} {{ block.shopify_attributes }}{% endif %}>{{ block.settings.text }}</div>{%- endfor -%}
            {%- else -%}
              <div class="bds-ticker-item">No contracts or lock-ins</div>
              <div class="bds-ticker-item">Free to join as an owner</div>
              <div class="bds-ticker-item">94% sponsor match rate</div>
              <div class="bds-ticker-item">6,400+ brands ready to sponsor</div>
              <div class="bds-ticker-item">₹1.2Cr paid to owners this month</div>
              <div class="bds-ticker-item">Zero overhead model</div>
            {%- endif -%}
          </div>
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- comment -%} ── HOW IT WORKS (timeline) ── {%- endcomment -%}
    {%- if sp.step1_t != blank or sp.step2_t != blank or sp.step3_t != blank -%}
    <section class="bds-section" id="bds-how-{{ uid }}">
      <div class="bds-wrap">
        <div class="bds-how-head">
          {%- if sp.how_label != blank -%}<div class="bds-kicker">{{ sp.how_label }}</div>{%- endif -%}
          {%- if sp.how_title_v2 != blank -%}<h2 class="bds-h2">{{ sp.how_title_v2 }}</h2>{%- endif -%}
          {%- if sp.how_sub_v2 != blank -%}<p class="bds-lead">{{ sp.how_sub_v2 }}</p>{%- endif -%}
        </div>
        <div class="bds-tl">
          <div class="bds-tl-line"></div>
          <div class="bds-tl-fill" data-tl-fill></div>
          {%- assign step_t = 'step1_t,step2_t,step3_t,step4_t,step5_t,step6_t' | split: ',' -%}
          {%- assign step_b = 'step1_b,step2_b2,step3_b,step4_b,step5_b,step6_b2' | split: ',' -%}
          {%- assign n = 0 -%}
          {%- for key in step_t -%}
            {%- assign title = sp[key] -%}
            {%- if title != blank -%}
              {%- assign n = n | plus: 1 -%}
              {%- assign bkey = step_b[forloop.index0] -%}
              {%- assign body = sp[bkey] -%}
              {%- if bkey == 'step2_b2' and body == blank -%}{%- assign body = sp.step2_b -%}{%- endif -%}
              {%- if bkey == 'step6_b2' and body == blank -%}{%- assign body = sp.step6_b -%}{%- endif -%}
              <div class="bds-tl-row"{% if n == 6 %} data-tl-last{% endif %}>
                <div class="bds-tl-marker"><div class="bds-tl-circle"><span class="bds-tl-num">{% if n < 10 %}0{% endif %}{{ n }}</span></div></div>
                <div class="bds-tl-card"><div class="bds-tl-label">{{ title }}</div><div class="bds-tl-body">{{ body }}</div></div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
    {%- endif -%}

    {%- comment -%} ── VIDEO ── {%- endcomment -%}
    {%- if sp.show_video -%}
    {%- assign poster_url = '' -%}
    {%- if sp.video_poster != blank -%}
      {%- assign poster_url = sp.video_poster | image_url: width: 2000 -%}
    {%- elsif sp.video_file != blank and sp.video_file.preview_image != blank -%}
      {%- assign poster_url = sp.video_file.preview_image | image_url: width: 2000 -%}
    {%- endif -%}
    <section class="bds-video-sec" id="bds-video-sec-{{ uid }}">
      <div class="bds-wrap bds-center bds-video-head">
        {%- if sp.video_label != blank -%}<div class="bds-kicker">{{ sp.video_label }}</div>{%- endif -%}
        {%- if sp.video_title != blank -%}<h2 class="bds-h2">{{ sp.video_title }}</h2>{%- endif -%}
        {%- if sp.video_sub != blank -%}<p class="bds-lead">{{ sp.video_sub }}</p>{%- endif -%}
      </div>
      <div class="bds-video" id="bds-video-{{ uid }}"
          data-type="{% if sp.video_file != blank %}shopify{% elsif sp.video_url != blank %}embed{% else %}none{% endif %}"
          data-embed="{{ sp.video_url | escape }}">
        {%- if poster_url != blank -%}
          <img src="{{ poster_url }}" alt="{{ sp.video_title | default: 'Watch how it works' | strip_html | escape }}" loading="lazy">
        {%- else -%}
          <div class="bds-video-fallback"></div>
        {%- endif -%}
        <div class="bds-video-ov"><div class="bds-video-play">{{ ic_play }}</div></div>
        {%- if sp.video_file != blank -%}
        <div class="bds-video-holder" hidden>{{ sp.video_file | video_tag: controls: true, preload: 'none', image_size: '1600x' }}</div>
        {%- endif -%}
      </div>
    </section>
    {%- endif -%}

    {%- comment -%} ── OWNER ANALYTICS ── {%- endcomment -%}
    {%- if sp.show_analytics -%}
    <section class="bds-an" id="bds-an-{{ uid }}">
      <div class="bds-wrap bds-an-grid">
        <div class="bds-an-copy">
          {%- if sp.an_flag != blank -%}<div class="bds-an-pill"><i>↗</i>{{ sp.an_flag }}</div>{%- endif -%}
          {%- assign an_title_v = sp.an_title2 | default: sp.an_title -%}
          {%- if an_title_v != blank -%}<h2 class="bds-h2">{{ an_title_v }}</h2>{%- endif -%}
          {%- if sp.an_sub != blank -%}<p class="bds-lead" style="margin-top:0">{{ sp.an_sub }}</p>{%- endif -%}
          {%- if sp.an_bullets != blank -%}
          <div class="bds-an-list">
            {%- assign an_items = sp.an_bullets | newline_to_br | strip_newlines | split: '<br />' -%}
            {%- for it in an_items -%}{%- assign li = it | strip -%}{%- if li != blank -%}<div><i></i><span>{{ li }}</span></div>{%- endif -%}{%- endfor -%}
          </div>
          {%- endif -%}
          <div><button class="bds-btn bds-btn--navy" type="button" data-open-modal data-role="owner">{{ sp.an_cta | default: 'Get Early Access →' }}</button></div>
        </div>
        <div class="bds-an-media">
          {%- if sp.an_bg_image != blank -%}<img class="bds-an-bg" src="{{ sp.an_bg_image | image_url: width: 1200 }}" alt="">{%- endif -%}
          <div class="bds-an-phonewrap">
            {%- if sp.an_phone_image != blank -%}
            <img class="bds-an-phone-img" src="{{ sp.an_phone_image | image_url: width: 900 }}" alt="{{ an_title_v | default: 'Owner Analytics' | strip_html | escape }}" width="300" loading="lazy">
            {%- else -%}
            {%- comment -%} Built-in phone dashboard mockup (wireframe-faithful) {%- endcomment -%}
            <div style="width:260px;background:#1A1A1A;border-radius:48px;padding:12px;box-shadow:0 32px 80px rgba(0,0,0,.5),inset 0 0 0 1px rgba(255,255,255,.08);">
              <div style="background:#fff;border-radius:38px;overflow:hidden;position:relative;">
                <div style="background:#F8F9FC;padding:12px 20px 8px;display:flex;justify-content:space-between;align-items:center;">
                  <span style="font-size:11px;font-weight:700;color:#1B2D55;letter-spacing:-.3px;">9:41</span>
                  <div style="width:72px;height:24px;background:#1A1A1A;border-radius:20px;position:absolute;left:50%;transform:translateX(-50%);top:8px;"></div>
                  <svg width="14" height="10" viewBox="0 0 14 10"><rect x="0" y="3" width="2" height="7" rx="1" fill="#1B2D55" opacity=".4"/><rect x="3" y="2" width="2" height="8" rx="1" fill="#1B2D55" opacity=".6"/><rect x="6" y="0" width="2" height="10" rx="1" fill="#1B2D55"/><rect x="9" y="0" width="4" height="10" rx="2" fill="none" stroke="#1B2D55" stroke-width="1.2"/><rect x="10" y="1.5" width="2" height="7" rx="1" fill="#1B2D55"/></svg>
                </div>
                <div style="background:#1B2D55;padding:14px 16px 16px;">
                  <div style="font-size:10px;color:#8AAFD4;margin-bottom:4px;letter-spacing:.06em;text-transform:uppercase;">BackdropSource</div>
                  <div style="font-size:14px;font-weight:700;color:#fff;letter-spacing:-.3px;">Event Overview</div>
                  <div style="font-size:10px;color:#DC143C;margin-top:2px;font-weight:600;">{{ sp.an_phone_event | default: 'Live · Tech Summit Bengaluru' }}</div>
                </div>
                <div style="background:#F8F9FC;padding:12px 12px 4px;">
                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px;">
                    <div style="background:#fff;border-radius:12px;padding:10px 12px;box-shadow:0 1px 4px rgba(0,0,0,.06);"><div style="font-size:8px;color:#9AA5BB;margin-bottom:3px;">IMPRESSIONS</div><div style="font-size:18px;font-weight:800;color:#1B2D55;letter-spacing:-.5px;line-height:1;">12,846</div><div style="font-size:8px;color:#059669;font-weight:700;margin-top:3px;">↑ 18%</div></div>
