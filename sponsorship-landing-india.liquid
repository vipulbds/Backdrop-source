    {%- comment -%} ── LEAD MODAL (dual role · Owner / Sponsor · self-contained validation) ── {%- endcomment -%}
    <div class="bds-modalwrap" id="bds-modal-{{ uid }}" data-endpoint="{{ sp.lead_endpoint | default: 'https://script.google.com/macros/s/AKfycbwauFxU-anjFSM-6bD4nnH8c5dL6Qt6j2DRatcgc1hyVpL5aJ7NP33DwehwhaxGrKCzcA/exec' | escape }}" role="dialog" aria-modal="true" aria-hidden="true">
      <div class="modal-box">
