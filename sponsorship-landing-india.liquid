  {% comment %}
    ════════════════════════════════════════════════════════════════════
    BACKDROPSOURCE — SPONSORSHIP LANDING  (Shopify 2.0 section)
    File: sections/sponsorship-landing.liquid
    ────────────────────────────────────────────────────────────────────
    Faithful conversion of the "Ads by Backdropsource — New" wireframe.

    - Sticky white nav
    - Hero: dark spotlight image · animated cycling headline · floating
      testimonial bubbles · dual CTAs
    - Stats band (count-up) + trust ticker marquee
    - How it works — 6-step vertical timeline (scroll-highlight)
    - Video section (navy) with click-to-play poster
    - Owner Analytics — copy + phone dashboard over a faded backdrop photo
    - Before / After image comparison
    - ROI calculator (kept, hidden by default — enable in the editor)
    - Testimonials — single-row infinite marquee
    - Sponsor logos marquee (hidden by default)
    - FAQ accordion · Closing CTA (inline lead form) · Footer
    - Shared lead-capture MODAL (name / email / phone)

    LEAD FORM
    - The modal + closing CTA form POST to the "Lead form endpoint"
      (a Google Apps Script Web App URL). Leave blank to just show the
      success message (demo).
    ════════════════════════════════════════════════════════════════════
  {% endcomment %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">

  {%- liquid
    assign sp = section.settings
    assign uid = section.id
    assign cyc = sp.hero_cycle_words | split: ','
    assign ccount = cyc.size
    assign slotp = 100.0 | divided_by: ccount
    assign cyc_show = slotp | times: 0.9
    assign cyc_hide = slotp
    assign cyc_dur = ccount | times: 1.7
  -%}

  <style>
  #shopify-section-{{ uid }} .bds-spon{
    --bds-accent: {{ sp.color_accent | default: '#DC143C' }};
    --bds-accent-dark: {{ sp.color_accent_dark | default: '#b3102f' }};
    --bds-accent-light: {{ sp.color_accent_light | default: '#e8506e' }};
    --bds-navy: {{ sp.color_navy | default: '#1B2D55' }};
    --bds-navy-mid: {{ sp.color_navy_mid | default: '#24386b' }};
    --bds-navy-deep: {{ sp.color_navy_deep | default: '#131F3C' }};
    --bds-green: {{ sp.color_green | default: '#16A34A' }};
    --bds-hero:#0a0c14;
    --bds-light:#F5F7FC;
    --bds-muted:#6B7B9A; --bds-muted2:#4A5A78; --bds-faint:#9AA5BB;
    --bds-blue:#8AAFD4;
    --bds-line:#E4E8F2; --bds-line2:#EBEBEB; --bds-line3:#F0F2F8;
    --bds-white:#fff;
    /* neutral greys used by the ported lead pop-up (fields / phone / dropdown) */
    --bds-off-white:#f8f7f4; --bds-g100:#f1efe8; --bds-g200:#e5e3dc;
    --bds-g500:#888780; --bds-g700:#444441; --bds-g900:#2c2c2a;
    --bds-r-sm:8px; --bds-r-md:12px; --bds-r-lg:16px; --bds-r-xl:20px;
    --bds-fd:'DM Serif Display', Georgia, serif;
    --bds-fb:'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  }
  .bds-spon,.bds-spon *,.bds-spon *::before,.bds-spon *::after{box-sizing:border-box}
  .bds-spon{font-family:var(--bds-fb);color:var(--bds-navy);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;background:#fff;overflow-x:clip;
    /* Full-bleed: break out of the theme's centred page container */
    width:auto;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw)}
  .bds-spon p{margin:0}
  .bds-spon h1,.bds-spon h2,.bds-spon h3,.bds-spon h4{margin:0;font-weight:400}
  .bds-spon a{text-decoration:none;color:inherit}
  .bds-spon button{font-family:inherit;cursor:pointer}
  .bds-spon img{max-width:100%;display:block}
  .bds-spon .bds-wrap{max-width:1200px;margin:0 auto}
  .bds-spon section{scroll-margin-top:72px}

  /* ── Shared headings ── */
  .bds-spon .bds-kicker{font-size:11px;font-weight:700;color:var(--bds-accent);letter-spacing:.14em;text-transform:uppercase;margin-bottom:12px}
  .bds-spon .bds-h2{font-family:var(--bds-fd);font-size:clamp(26px,3vw,40px);letter-spacing:-.8px;color:var(--bds-navy);line-height:1.15}
  .bds-spon .bds-lead{font-size:15px;color:var(--bds-muted);line-height:1.65;margin-top:12px}
  .bds-spon .bds-center{text-align:center}
  .bds-spon .bds-center .bds-lead{margin-left:auto;margin-right:auto}

  /* ── Buttons ── */
  .bds-spon .bds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:none;padding:14px 28px;border-radius:var(--bds-r-sm);font-size:15px;font-weight:600;letter-spacing:-.2px;line-height:1.2;transition:background .2s,transform .15s,border-color .2s,box-shadow .2s}
  .bds-spon .bds-btn--primary{background:var(--bds-accent);color:#fff}
  .bds-spon .bds-btn--primary:hover{background:var(--bds-accent-dark);transform:translateY(-1px)}
  .bds-spon .bds-btn--navy{background:var(--bds-navy);color:#fff}
  .bds-spon .bds-btn--navy:hover{background:var(--bds-navy-deep);transform:translateY(-1px)}
  .bds-spon .bds-btn--ghost{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.3);font-weight:500}
  .bds-spon .bds-btn--ghost:hover{border-color:rgba(255,255,255,.6)}
  .bds-spon .bds-btn--white{background:#fff;color:var(--bds-navy)}
  .bds-spon .bds-btn--white:hover{background:#fff;color:var(--bds-accent);transform:translateY(-1px)}

  /* ── NAV ── */
  .bds-spon .bds-nav{position:fixed;top:0;left:0;right:0;z-index:1000;background:rgba(255,255,255,.96);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border-bottom:1px solid var(--bds-line2);padding:0 5vw;transition:box-shadow .25s}
  .bds-spon .bds-nav-spacer{height:60px}
  .bds-spon .bds-nav.is-scrolled{box-shadow:0 4px 20px rgba(27,45,85,.07)}
  .bds-spon .bds-nav-in{max-width:1200px;margin:0 auto;display:flex;align-items:center;height:60px;gap:32px}
  .bds-spon .bds-nav-logo{display:flex;align-items:center;flex-shrink:0;font-family:var(--bds-fd);font-size:20px;color:var(--bds-navy)}
  .bds-spon .bds-nav-logo .pre{font-family:var(--bds-fb);font-size:12px;font-weight:600;color:var(--bds-muted);margin-right:5px}
  .bds-spon .bds-nav-logo .ac{color:var(--bds-accent)}
  .bds-spon .bds-nav-logo-img{height:{{ sp.logo_img_h | default: 36 }}px;width:auto;max-width:240px;object-fit:contain;display:block}
  .bds-spon .bds-nav-right{display:flex;gap:24px;margin-left:auto;align-items:center}
  .bds-spon .bds-nav-right a[data-scroll]{font-size:13px;color:var(--bds-muted);font-weight:500;cursor:pointer;transition:color .2s}
  .bds-spon .bds-nav-right a[data-scroll]:hover{color:var(--bds-navy)}
  .bds-spon .bds-nav-cta{font-size:13px;font-weight:600;color:#fff;background:var(--bds-navy);padding:8px 18px;border-radius:6px;border:none;cursor:pointer;transition:background .2s}
  .bds-spon .bds-nav-cta:hover{background:var(--bds-accent)}

  /* ── HERO ── */
  /* Hero is capped below the viewport so the stats band is visible on first paint
     (nav ~60 + stats ~112 + ticker ~48 ≈ 220px reserved). */
  /* Full-screen hero: fills the viewport minus the fixed nav (60px) so nav + hero = one screen. */
  .bds-spon .bds-hero{position:relative;overflow:hidden;background:var(--bds-hero);min-height:calc(100svh - 60px);display:flex;flex-direction:column;justify-content:center;padding:48px 5vw}
  .bds-spon .bds-hero-bg{position:absolute;inset:0;pointer-events:none;z-index:0;overflow:hidden}
  .bds-spon .bds-hero-media{position:absolute;inset:0}
  .bds-spon .bds-hero-bg img,.bds-spon .bds-hero-bg video{width:100%;height:100%;object-fit:cover;object-position:center center;opacity:.7}
  .bds-spon .bds-hero-embed-wrap{position:absolute;inset:0;overflow:hidden}
  /* Scale a 16:9 embed (YouTube/Vimeo) to fully COVER the hero, no letterboxing */
  .bds-spon .bds-hero-embed{position:absolute;top:50%;left:50%;width:100vw;height:56.25vw;min-height:100%;min-width:177.78vh;transform:translate(-50%,-50%);border:0;pointer-events:none;opacity:.7}
  .bds-spon .bds-hero-bg::after{content:'';position:absolute;inset:0;background:linear-gradient(105deg,rgba(4,6,20,.9) 0%,rgba(4,6,20,.66) 55%,rgba(4,6,20,.28) 100%)}
  .bds-spon .bds-hero-grid{position:relative;z-index:1;display:flex;align-items:center;gap:64px}
  /* Left-aligned hero: don't centre the 1200px block on wide screens — keep it at the hero's left padding (5vw). Centred variant keeps margin:0 auto. */
  .bds-spon .bds-hero .bds-hero-grid:not(.is-center){margin-left:0;margin-right:auto}
  .bds-spon .bds-hero-copy{flex:1;min-width:0}
  .bds-spon .bds-hero-h1{font-family:var(--bds-fd);font-size:clamp(38px,5vw,64px);line-height:1.07;color:#fff;letter-spacing:-1.5px;margin-bottom:24px}
  .bds-spon .bds-hero-h1 em{font-style:normal;color:var(--bds-accent)}
  .bds-spon .bds-cycle{position:relative;display:inline-block;min-width:260px;height:1.15em;vertical-align:bottom}
  .bds-spon .bds-cycle-word{position:absolute;left:0;opacity:0;color:var(--bds-accent);white-space:nowrap;animation:bdsCycle-{{ uid }} {{ cyc_dur }}s ease-in-out infinite}
  @keyframes bdsCycle-{{ uid }}{
    0%{opacity:0;transform:translateY(10px)}
    3%,{{ cyc_show }}%{opacity:1;transform:translateY(0)}
    {{ cyc_hide }}%,100%{opacity:0;transform:translateY(-12px)}
  }
  .bds-spon .bds-hero-sub{font-size:17px;color:rgba(255,255,255,.72);line-height:1.65;max-width:480px;margin-bottom:36px}
  .bds-spon .bds-hero-btns{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:20px}
  .bds-spon .bds-hero-note{font-size:12px;color:rgba(255,255,255,.45)}
  /* Pill / badge above the headline */
  .bds-spon .bds-hero-pill{display:inline-flex;align-items:center;gap:8px;padding:6px 15px;border-radius:99px;background:rgba(220,20,60,.14);border:1px solid rgba(220,20,60,.45);color:#fff;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:20px;width:fit-content}
  .bds-spon .bds-hero-pill::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--bds-accent);flex-shrink:0}
  /* Centred hero variant (single column) */
  .bds-spon .bds-hero-grid.is-center{flex-direction:column;align-items:center;text-align:center;gap:0}
  .bds-spon .bds-hero-grid.is-center .bds-hero-copy{max-width:840px;display:flex;flex-direction:column;align-items:center;flex:none}
  .bds-spon .bds-hero-grid.is-center .bds-hero-sub{margin-left:auto;margin-right:auto}
  .bds-spon .bds-hero-grid.is-center .bds-hero-btns{justify-content:center}
  .bds-spon .bds-hero-grid.is-center .bds-bubbles{display:none}
  /* Floating testimonial bubbles */
  .bds-spon .bds-bubbles{flex-shrink:0;width:380px;display:flex;flex-direction:column;gap:10px}
  .bds-spon .bds-bubble{position:relative;border-radius:16px;padding:16px 18px;box-shadow:0 10px 30px rgba(0,0,0,.28)}
  .bds-spon .bds-bubble p{font-size:13px;line-height:1.55;margin-bottom:10px}
  .bds-spon .bds-bubble-who{display:flex;align-items:center;gap:8px}
  .bds-spon .bds-bubble-av{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:9px;font-weight:700;color:#fff}
  .bds-spon .bds-bubble-nm{font-size:11px;font-weight:600}
  .bds-spon .bds-bubble-lo{font-size:10px}
  .bds-spon .bds-bubble.b1{align-self:flex-start;background:#fff;border:1px solid var(--bds-line);max-width:300px;z-index:2}
  .bds-spon .bds-bubble.b1 p{color:var(--bds-muted2)}
  .bds-spon .bds-bubble.b1 .bds-bubble-av{background:var(--bds-navy)}
  .bds-spon .bds-bubble.b1 .bds-bubble-nm{color:var(--bds-navy)}.bds-spon .bds-bubble.b1 .bds-bubble-lo{color:var(--bds-faint)}
  .bds-spon .bds-bubble.b2{align-self:flex-end;background:var(--bds-navy);max-width:300px;z-index:3}
  .bds-spon .bds-bubble.b2 p{color:var(--bds-blue)}
  .bds-spon .bds-bubble.b2 .bds-bubble-av{background:var(--bds-accent)}
  .bds-spon .bds-bubble.b2 .bds-bubble-nm{color:#fff}.bds-spon .bds-bubble.b2 .bds-bubble-lo{color:var(--bds-muted)}
  .bds-spon .bds-bubble.b3{align-self:flex-start;margin-left:16px;background:#fff;border:1px solid var(--bds-line);max-width:300px;z-index:2}
  .bds-spon .bds-bubble.b3 p{color:var(--bds-muted2)}
  .bds-spon .bds-bubble.b3 .bds-bubble-av{background:var(--bds-accent)}
  .bds-spon .bds-bubble.b3 .bds-bubble-nm{color:var(--bds-navy)}.bds-spon .bds-bubble.b3 .bds-bubble-lo{color:var(--bds-faint)}

  /* ── STATS BAR + TICKER ── */
  .bds-spon .bds-statsbar{background:#fff;border-bottom:1px solid var(--bds-line)}
  .bds-spon .bds-stats{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr)}
  .bds-spon .bds-stat{padding:22px 24px;border-right:1px solid var(--bds-line);display:flex;flex-direction:column;align-items:center;text-align:center;gap:5px}
  .bds-spon .bds-stat:last-child{border-right:none}
  .bds-spon .bds-stat-top{display:flex;align-items:center;justify-content:center;gap:8px}
  .bds-spon .bds-stat-figure{font-size:30px;font-weight:800;color:var(--bds-navy);letter-spacing:-1.5px;font-family:var(--bds-fd)}
  .bds-spon .bds-stat-badge{font-size:11px;font-weight:700;background:#DCFCE7;color:var(--bds-green);border-radius:20px;padding:3px 9px;white-space:nowrap}
  .bds-spon .bds-stat-label{font-size:13px;color:var(--bds-muted)}
  .bds-spon .bds-ticker{border-top:1px solid var(--bds-line3);overflow:hidden;position:relative}
  .bds-spon .bds-ticker::before,.bds-spon .bds-ticker::after{content:'';position:absolute;top:0;bottom:0;width:48px;z-index:2;pointer-events:none}
  .bds-spon .bds-ticker::before{left:0;background:linear-gradient(to right,#fff,transparent)}
  .bds-spon .bds-ticker::after{right:0;background:linear-gradient(to left,#fff,transparent)}
  .bds-spon .bds-ticker-track{display:flex;width:max-content;animation:bdsTicker 22s linear infinite;padding:11px 0}
  .bds-spon .bds-ticker:hover .bds-ticker-track{animation-play-state:paused}
  @keyframes bdsTicker{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  .bds-spon .bds-ticker-set{display:flex;flex-shrink:0}
  .bds-spon .bds-ticker-item{display:flex;align-items:center;padding:0 28px;border-right:1px solid var(--bds-line);font-size:12px;font-weight:600;color:var(--bds-navy);white-space:nowrap}

  /* ── SECTION commons ── */
  .bds-spon .bds-section{padding:52px 5vw}

  /* ── HOW IT WORKS (timeline) ── */
  /* Heading is LEFT-aligned and shares the same 760px column as the timeline, so its
     left edge lines up with the numbered circles. It wraps freely (never clipped). */
  /* Left edge sits at the section gutter (NOT a centred 760px block) so it lines up with the
     "Watch how it works" / before-after headings — no extra left indent. */
  .bds-spon .bds-how-head{margin:0 0 40px;max-width:820px;text-align:left}
  .bds-spon .bds-how-head .bds-lead{max-width:none}
  /* Side-align ALL section headings (video · testimonials · sponsor logos) to match How it works.
     Overrides the .bds-center utility on those heads. The closing CTA band stays centred. */
  .bds-spon .bds-video-head,.bds-spon .bds-testi-head,.bds-spon .bds-logos-head{text-align:left}
  .bds-spon .bds-video-head .bds-lead,.bds-spon .bds-testi-head .bds-lead,.bds-spon .bds-logos-head .bds-lead{margin-left:0;margin-right:auto}
  /* Heading stays left; the timeline cards are centred (as before). */
  .bds-spon .bds-tl{position:relative;max-width:760px;margin:0 auto}
  .bds-spon .bds-tl-line{display:none}
  /* Scroll-driven accent line: grows through the circles as you scroll (JS sets top/height). */
  .bds-spon .bds-tl-fill{position:absolute;left:31px;width:2px;background:var(--bds-accent);z-index:1;top:0;height:0;transition:height .12s linear,top .12s linear}
  /* Rows are evenly spaced (equal min-height) and vertically centred, so the numbered
     circles sit at consistent intervals no matter how long each card's text is. */
  .bds-spon .bds-tl-row{display:flex;gap:28px;align-items:center;margin-bottom:0;min-height:104px;position:relative;opacity:0;transform:translateY(26px);transition:opacity .55s ease,transform .55s ease}
  /* Each row fades + slides up once as it scrolls into view. */
  .bds-spon .bds-tl-row.is-in{opacity:1;transform:none}
  /* One continuous connector runs dead-centre through every circle; it's clipped above
     the first circle and below the last so there are no dangling ends. */
  .bds-spon .bds-tl-row::before{content:'';position:absolute;left:31px;top:0;bottom:0;width:2px;background:var(--bds-line);z-index:0}
  .bds-spon .bds-tl-row:first-child::before{top:50%}
  .bds-spon .bds-tl-row:last-child::before{bottom:50%}
  .bds-spon .bds-tl-marker{flex-shrink:0;width:64px;display:flex;justify-content:center;position:relative;z-index:1}
  .bds-spon .bds-tl-circle{width:44px;height:44px;border-radius:50%;background:#fff;border:2px solid var(--bds-navy);display:flex;align-items:center;justify-content:center;transition:background .3s,border-color .3s,transform .3s,box-shadow .3s}
  .bds-spon .bds-tl-num{font-size:13px;font-weight:700;color:var(--bds-navy);transition:color .3s}
  .bds-spon .bds-tl-row.is-active .bds-tl-circle{background:var(--bds-accent);border-color:var(--bds-accent);transform:scale(1.1);box-shadow:0 8px 22px -6px rgba(220,20,60,.6)}
  .bds-spon .bds-tl-row.is-active .bds-tl-num{color:#fff}
  .bds-spon .bds-tl-card{flex:1;background:#fff;border-radius:14px;padding:20px 24px;border:1px solid var(--bds-line);box-shadow:0 2px 12px rgba(0,0,0,.04)}
  .bds-spon .bds-tl-label{font-size:11px;font-weight:700;color:var(--bds-accent);letter-spacing:.1em;text-transform:uppercase;margin-bottom:7px}
  .bds-spon .bds-tl-body{font-size:15px;color:var(--bds-muted2);line-height:1.55}

  /* ── VIDEO ── */
  .bds-spon .bds-video-sec{position:relative;background:var(--bds-navy-deep);overflow:hidden;padding:0 5vw 56px}
  /* Head gutter now comes from the section (above), so its wrap centres exactly like the other
     sections — the heading shares one left edge with How-it-works and Before/After. */
  .bds-spon .bds-video-head{padding:48px 0 24px}
  .bds-spon .bds-video-head .bds-h2{color:#fff}
  .bds-spon .bds-video-head .bds-lead{color:var(--bds-blue)}
  /* 16:9 frame, width derived from remaining viewport height so heading + video fit ONE screen — never cropped */
  .bds-spon .bds-video{position:relative;cursor:pointer;display:block;width:min(100%,calc((100vh - 250px) * 16 / 9));max-width:1080px;margin:0 auto;aspect-ratio:16/9;background:#0A1628;border-radius:16px;overflow:hidden;box-shadow:0 30px 70px -30px rgba(0,0,0,.6)}
  .bds-spon .bds-video img{width:100%;height:100%;object-fit:cover}
  .bds-spon .bds-video-fallback{width:100%;height:100%;background:linear-gradient(135deg,#0f2554,#0a1628);display:flex;align-items:center;justify-content:center}
  .bds-spon .bds-video-ov{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.25);transition:background .2s}
  .bds-spon .bds-video:hover .bds-video-ov{background:rgba(0,0,0,.32)}
  .bds-spon .bds-video-play{width:72px;height:72px;border-radius:50%;background:rgba(255,255,255,.95);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 24px rgba(0,0,0,.3);transition:transform .2s}
  .bds-spon .bds-video:hover .bds-video-play{transform:scale(1.06)}
  .bds-spon .bds-video-play svg{width:24px;height:24px;color:var(--bds-accent);margin-left:3px}
  .bds-spon .bds-video-embed{position:absolute;inset:0;width:100%;height:100%;border:0}
  .bds-spon .bds-video.is-playing{cursor:default}
  .bds-spon .bds-video.is-playing .bds-video-ov{display:none}
  .bds-spon .bds-video-holder{position:absolute;inset:0}
  .bds-spon .bds-video-holder[hidden]{display:none}
  .bds-spon .bds-video-holder video{width:100%;height:100%;object-fit:contain;background:#000;display:block}

  /* ── ANALYTICS ── */
  .bds-spon .bds-an{background:var(--bds-light);overflow:hidden}
  .bds-spon .bds-an-grid{display:flex;gap:0;align-items:stretch;min-height:520px}
  /* Left padding matches other sections' content edge exactly: 5vw gutter until the 1200px
     content column starts centring, then it tucks to the column edge — so the analytics copy
     lines up with the How-it-works / testimonials / FAQ headings at every width. */
  .bds-spon .bds-an-copy{flex:1;padding:52px 56px;padding-left:max(0px, calc(5vw - max(0px, (100vw - 1200px) / 2)));display:flex;flex-direction:column;justify-content:center}
  .bds-spon .bds-an-pill{display:inline-flex;align-items:center;gap:8px;border:1px solid #D8DFF0;border-radius:20px;padding:5px 14px;margin-bottom:24px;width:fit-content;font-size:11px;font-weight:700;color:var(--bds-navy);letter-spacing:.08em;text-transform:uppercase}
  .bds-spon .bds-an-pill i{font-style:normal;color:var(--bds-muted);font-weight:400}
  .bds-spon .bds-an .bds-h2{margin-bottom:16px}
  .bds-spon .bds-an .bds-h2 em{font-style:normal;color:var(--bds-accent)}
  .bds-spon .bds-an-list{display:flex;flex-direction:column;gap:10px;margin:16px 0 36px}
  .bds-spon .bds-an-list div{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--bds-muted2)}
  .bds-spon .bds-an-list i{width:5px;height:5px;border-radius:50%;background:var(--bds-accent);flex-shrink:0}
  .bds-spon .bds-an-media{width:560px;flex-shrink:0;position:relative;overflow:hidden;background:var(--bds-light)}
  .bds-spon .bds-an-media > img.bds-an-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.35}
  .bds-spon .bds-an-media::after{content:'';position:absolute;inset:0;background:linear-gradient(to right,var(--bds-light) 0%,transparent 40%)}
  .bds-spon .bds-an-phonewrap{position:relative;z-index:2;display:flex;justify-content:center;align-items:center;height:100%;padding:32px 0}
  .bds-spon .bds-an-phone-img{position:relative;z-index:2;width:300px;max-width:80%;border-radius:36px}

  /* ── BEFORE / AFTER (dark split: copy left · drag-to-reveal slider right) ── */
  .bds-spon .bds-ba2{background:radial-gradient(120% 80% at 50% 0%,#0e2147 0%,var(--bds-navy-deep) 70%);position:relative;overflow:hidden;padding:60px 5vw}
  .bds-spon .bds-ba-grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:48px;align-items:center}
  .bds-spon .bds-ba-copy .bds-kicker{color:var(--bds-accent-light)}
  .bds-spon .bds-ba-copy .bds-h2{color:#fff}
  .bds-spon .bds-ba-copy .bds-h2::after{content:'';display:block;width:64px;height:4px;margin:16px 0 0;border-radius:99px;background:linear-gradient(90deg,var(--bds-accent),var(--bds-accent-light))}
  .bds-spon .bds-ba-copy .bds-lead{color:rgba(255,255,255,.6)}
  .bds-spon .bds-ba-copy .bds-btn{margin-top:26px}
  /* Eye-catching accent glow behind the media (pops against the navy backdrop). */
  .bds-spon .bds-ba-media{min-width:0;position:relative}
  .bds-spon .bds-ba-media::before{content:'';position:absolute;inset:-10% -8%;z-index:0;pointer-events:none;background:radial-gradient(55% 55% at 72% 38%,rgba(220,20,60,.30),transparent 70%);filter:blur(22px)}
  .bds-spon .bds-ba-media > *{position:relative;z-index:1}
  /* Drag-to-reveal slider (both before + after images set) */
  /* Fixed height capped to the viewport so the whole section fits one screen; images are CONTAINED (never cropped) */
  .bds-spon .bds-baslider{position:relative;width:100%;height:clamp(340px,calc(100vh - 240px),620px);border-radius:18px;overflow:hidden;user-select:none;touch-action:none;cursor:ew-resize;background:#0a0c14;box-shadow:0 50px 90px -44px rgba(0,0,0,.8)}
  .bds-spon .bds-baslider img{display:block;pointer-events:none}
  .bds-spon .bds-baslider-after{width:100%;height:100%;object-fit:contain}
  .bds-spon .bds-baslider-before{position:absolute;top:0;left:0;width:100%;height:100%;clip-path:inset(0 calc(100% - var(--bapos,50%)) 0 0)}
  .bds-spon .bds-baslider-before img{width:100%;height:100%;object-fit:contain}
  .bds-spon .bds-baslider-handle{position:absolute;top:0;bottom:0;left:var(--bapos,50%);transform:translateX(-50%);width:46px;display:flex;align-items:center;justify-content:center;pointer-events:none;z-index:3}
  .bds-spon .bds-baslider-line{position:absolute;top:0;bottom:0;left:50%;width:3px;transform:translateX(-50%);background:#fff;box-shadow:0 0 14px rgba(0,0,0,.55)}
  .bds-spon .bds-baslider-knob{position:relative;width:46px;height:46px;border-radius:50%;background:#fff;color:var(--bds-navy);display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:700;box-shadow:0 8px 22px rgba(0,0,0,.45);animation:bdsBaKnob 2.4s ease-in-out infinite}
  .bds-spon .bds-baslider.is-touched .bds-baslider-knob{animation:none}
  @keyframes bdsBaKnob{0%,100%{box-shadow:0 8px 22px rgba(0,0,0,.45),0 0 0 0 rgba(255,255,255,.5)}50%{box-shadow:0 8px 22px rgba(0,0,0,.45),0 0 0 10px rgba(255,255,255,0)}}
  .bds-spon .bds-baslider-tag{position:absolute;top:16px;z-index:2;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#fff;padding:5px 12px;border-radius:99px;-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
  .bds-spon .bds-baslider-tagb{left:16px;background:rgba(15,37,84,.72)}
  .bds-spon .bds-baslider-taga{right:16px;background:var(--bds-accent)}
  .bds-spon .bds-baslider-hint{position:absolute;left:50%;bottom:16px;transform:translateX(-50%);z-index:4;display:inline-flex;align-items:center;gap:6px;background:rgba(8,15,30,.74);color:#fff;font-size:12px;font-weight:600;letter-spacing:.04em;padding:8px 16px;border-radius:99px;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);box-shadow:0 8px 20px rgba(0,0,0,.45);pointer-events:none;white-space:nowrap;animation:bdsBaHint 2.4s ease-in-out infinite}
  @keyframes bdsBaHint{0%,100%{transform:translateX(-50%) translateY(0);opacity:.9}50%{transform:translateX(-50%) translateY(-4px);opacity:1}}
  .bds-spon .bds-baslider.is-touched .bds-baslider-hint{opacity:0;animation:none;transition:opacity .3s}
  /* Gradient frame (matches the single-image look) — wraps both the slider and combined image */
  .bds-spon .bds-ba-photo{position:relative;padding:12px;border-radius:26px;background:linear-gradient(135deg,var(--bds-accent),#0a0c14);box-shadow:0 50px 90px -44px rgba(0,0,0,.8)}
  .bds-spon .bds-ba-photo > img{width:100%;height:auto;border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,.4)}
  .bds-spon .bds-ba-photo .bds-baslider{border-radius:16px;box-shadow:none}
  /* Before/After VIDEO (uploaded) + EMBED (YouTube/Vimeo) — responsive, framed like the image */
  /* Uploaded GIF/video: drop the chunky accent frame (its rounded border overlapped + clipped the
     video's edges). The GIF shows clean, edge-to-edge, in a simple rounded box — nothing cropped.
     DEFAULT = contain (whole video always visible); .is-cover fills & crops instead. */
  .bds-spon .bds-ba-photo.is-video{padding:0;background:#000;overflow:hidden;border-radius:20px;box-shadow:0 34px 80px -34px rgba(0,0,0,.85),0 0 0 1px rgba(255,255,255,.06)}
  .bds-spon .bds-ba-photo > video{width:100%;height:auto;max-height:min(76vh,600px);object-fit:contain;display:block;border-radius:20px;background:#000}
  .bds-spon .bds-ba-photo.is-cover > video{height:clamp(320px,calc(100vh - 260px),560px);object-fit:cover;object-position:center}
  .bds-spon .bds-ba-embed{position:relative;width:100%;aspect-ratio:16/9;border-radius:16px;overflow:hidden;box-shadow:0 10px 30px rgba(0,0,0,.4);background:#0a0c14}
  .bds-spon .bds-ba-embed iframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:block}
  /* Built-in mockup (fallback when no images set) */
  .bds-spon .bds-ba{display:grid;grid-template-columns:1fr auto 1fr;gap:18px;align-items:center}
  .bds-spon .bds-ba-card{display:flex;flex-direction:column;gap:14px;min-width:0}
  .bds-spon .bds-ba-tag2{align-self:flex-start;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.6);background:rgba(255,255,255,.1);padding:5px 13px;border-radius:20px}
  .bds-spon .bds-ba-tag2--after{color:#fff;background:var(--bds-accent)}
  .bds-spon .bds-ba-stage{position:relative;border-radius:16px;overflow:hidden;background:linear-gradient(135deg,var(--bds-navy),var(--bds-navy-deep));border:1px solid rgba(255,255,255,.1);min-height:340px;display:flex;flex-direction:column;justify-content:space-between;padding:28px 24px;box-shadow:0 30px 60px -34px rgba(0,0,0,.7)}
  .bds-spon .bds-ba-mock{display:flex;flex-direction:column;align-items:center;gap:14px;flex:1;justify-content:center;text-align:center}
  .bds-spon .bds-ba-logo{width:60%;min-width:130px;height:80px;border:1.5px solid rgba(255,255,255,.2);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:13px;font-style:italic;color:rgba(255,255,255,.45)}
  .bds-spon .bds-ba-visual{width:88%;height:60px;border:1px solid rgba(255,255,255,.1);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:12px;font-style:italic;color:rgba(255,255,255,.3)}
  .bds-spon .bds-ba-strip{margin-top:16px;border-radius:8px}
  .bds-spon .bds-ba-strip--empty{border:2px dashed rgba(255,255,255,.22);min-height:70px;display:flex;align-items:center;justify-content:center;font-size:12px;font-style:italic;color:rgba(255,255,255,.4);text-align:center;padding:12px}
  .bds-spon .bds-ba-strip--full{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:6px;background:var(--bds-accent);padding:8px;border-radius:8px}
  .bds-spon .bds-ba-slot{background:#fff;border-radius:5px;min-height:54px;min-width:0;display:flex;align-items:center;justify-content:center;padding:4px;text-align:center;overflow:hidden}
  .bds-spon .bds-ba-slot span{font-size:8px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--bds-muted);line-height:1.2;word-break:break-word}
  .bds-spon .bds-ba-cap{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;line-height:1.4}
  .bds-spon .bds-ba-cap svg{width:14px;height:14px;flex-shrink:0}
  .bds-spon .bds-ba-cap--bad{color:rgba(255,255,255,.55)}
  .bds-spon .bds-ba-cap--good{color:var(--bds-green)}
  .bds-spon .bds-ba-vs{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--bds-accent),var(--bds-accent-light));color:#fff;display:flex;align-items:center;justify-content:center;font-family:var(--bds-fd);font-size:15px;flex-shrink:0;box-shadow:0 10px 26px -6px rgba(220,20,60,.7)}

  /* ── TESTIMONIALS (marquee) ── */
  .bds-spon .bds-testi-sec{padding:40px 5vw 60px}
  .bds-spon .bds-testi-head{margin-bottom:40px}
  .bds-spon .bds-testi-marquee{overflow:hidden;position:relative;padding:8px 0}
  .bds-spon .bds-testi-marquee::before,.bds-spon .bds-testi-marquee::after{content:'';position:absolute;top:0;bottom:0;width:80px;z-index:2;pointer-events:none}
  .bds-spon .bds-testi-marquee::before{left:0;background:linear-gradient(to right,#fff,transparent)}
  .bds-spon .bds-testi-marquee::after{right:0;background:linear-gradient(to left,#fff,transparent)}
  .bds-spon .bds-testi-track{display:flex;gap:20px;width:max-content;animation:bdsMarquee 50s linear infinite;align-items:stretch}
  .bds-spon .bds-testi-set{display:flex;gap:20px;flex-shrink:0;align-items:stretch}
  .bds-spon .bds-testi-marquee:hover .bds-testi-track{animation-play-state:paused}
  @keyframes bdsMarquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  .bds-spon .bds-tcard{width:420px;max-width:82vw;min-height:250px;flex-shrink:0;background:#fff;border-radius:20px;padding:32px 34px 26px;border:1px solid var(--bds-line);display:flex;flex-direction:column;justify-content:space-between;gap:16px;box-shadow:0 4px 20px rgba(0,0,0,.07)}
  .bds-spon .bds-tcard-stars{color:var(--bds-accent);font-size:13px;letter-spacing:2px;margin-bottom:12px}
  .bds-spon .bds-tcard-q{font-size:15px;color:var(--bds-muted2);line-height:1.65;font-style:italic}
  .bds-spon .bds-tcard-foot{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--bds-line3);padding-top:18px;margin-top:18px;gap:12px}
  .bds-spon .bds-tcard-who{display:flex;align-items:center;gap:10px;min-width:0}
  .bds-spon .bds-tcard-av{width:36px;height:36px;border-radius:50%;background:var(--bds-navy);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:11px;font-weight:700;color:#fff}
  .bds-spon .bds-tcard-nm{font-size:12px;font-weight:600;color:var(--bds-navy)}
  .bds-spon .bds-tcard-mt{font-size:10px;color:var(--bds-faint)}
  .bds-spon .bds-tcard-tag{font-size:10px;font-weight:700;color:var(--bds-accent);letter-spacing:.08em;text-transform:uppercase;text-align:right;max-width:120px;line-height:1.4;flex-shrink:0}
  .bds-spon .bds-tcard.is-navy{background:var(--bds-navy);border-color:transparent}
  .bds-spon .bds-tcard.is-navy .bds-tcard-q{color:var(--bds-blue)}
  .bds-spon .bds-tcard.is-navy .bds-tcard-foot{border-top-color:rgba(255,255,255,.1)}
  .bds-spon .bds-tcard.is-navy .bds-tcard-av{background:var(--bds-accent)}
  .bds-spon .bds-tcard.is-navy .bds-tcard-nm{color:#fff}
  .bds-spon .bds-tcard.is-navy .bds-tcard-mt{color:var(--bds-muted)}

  /* ── SPONSOR LOGOS (optional marquee) ── */
  .bds-spon .bds-logos{padding:40px 5vw 60px}
  .bds-spon .bds-logos-head{margin-bottom:28px}
  .bds-spon .bds-marquee{overflow:hidden;position:relative}
  .bds-spon .bds-marquee::before,.bds-spon .bds-marquee::after{content:'';position:absolute;top:0;width:80px;height:100%;z-index:2;pointer-events:none}
  .bds-spon .bds-marquee::before{left:0;background:linear-gradient(to right,#fff,transparent)}
  .bds-spon .bds-marquee::after{right:0;background:linear-gradient(to left,#fff,transparent)}
  .bds-spon .bds-marquee-track{display:flex;gap:12px;width:max-content;animation:bdsMarquee 28s linear infinite}
  .bds-spon .bds-marquee:hover .bds-marquee-track{animation-play-state:paused}
  .bds-spon .bds-logo{background:#fff;border:1px solid var(--bds-line);border-radius:var(--bds-r-md);padding:14px 18px;display:flex;align-items:center;gap:10px;flex-shrink:0;min-width:150px}
  .bds-spon .bds-logo-ic{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0}
  .bds-spon .bds-logo-ic img{width:32px;height:32px;border-radius:8px;object-fit:contain}
  .bds-spon .bds-logo-text{font-size:12px;font-weight:600;color:var(--bds-muted);white-space:nowrap}

  /* ── MATCH / CROSS-SELL (Organiser vs Sponsor · two paths) ── */
  .bds-spon .bds-match{padding:56px 5vw;background:var(--bds-light)}
  .bds-spon .bds-match-head{max-width:760px;margin-bottom:40px}
  .bds-spon .bds-match-head .bds-h2{margin-top:4px}
  .bds-spon .bds-match-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
  .bds-spon .bds-mcard{border-radius:var(--bds-r-xl);padding:44px 44px 40px;display:flex;flex-direction:column;align-items:flex-start;border:1px solid var(--bds-line);transition:background .3s,transform .3s,box-shadow .3s,border-color .3s}
  .bds-spon .bds-mcard-tag{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px;transition:color .3s}
  .bds-spon .bds-mcard-h{font-family:var(--bds-fd);font-size:clamp(23px,2.4vw,32px);line-height:1.15;letter-spacing:-.5px;margin-bottom:14px;transition:color .3s}
  .bds-spon .bds-mcard-sub{font-size:15px;line-height:1.65;margin-bottom:28px;max-width:380px;transition:color .3s}
  .bds-spon .bds-mcard .bds-btn{margin-top:auto}
  /* Organiser card — white by default */
  .bds-spon .bds-mcard--org{background:#fff}
  .bds-spon .bds-mcard--org .bds-mcard-tag{color:var(--bds-accent)}
  .bds-spon .bds-mcard--org .bds-mcard-h{color:var(--bds-navy)}
  .bds-spon .bds-mcard--org .bds-mcard-sub{color:var(--bds-muted)}
  /* Sponsor card — navy/blue by default */
  .bds-spon .bds-mcard--spn{background:var(--bds-navy);border-color:transparent}
  .bds-spon .bds-mcard--spn .bds-mcard-tag{color:var(--bds-blue)}
  .bds-spon .bds-mcard--spn .bds-mcard-h{color:#fff}
  .bds-spon .bds-mcard--spn .bds-mcard-sub{color:rgba(255,255,255,.6)}
  /* Hover — both cards lift; colour turns blue (the white card flips to navy) */
  .bds-spon .bds-mcard:hover{transform:translateY(-6px);box-shadow:0 24px 60px rgba(27,45,85,.28)}
  .bds-spon .bds-mcard--org:hover{background:var(--bds-navy);border-color:transparent}
  .bds-spon .bds-mcard--org:hover .bds-mcard-tag{color:var(--bds-blue)}
  .bds-spon .bds-mcard--org:hover .bds-mcard-h{color:#fff}
  .bds-spon .bds-mcard--org:hover .bds-mcard-sub{color:rgba(255,255,255,.6)}
  .bds-spon .bds-mcard--spn:hover{background:var(--bds-navy-mid)}

  /* ── FAQ ── */
  .bds-spon .bds-faq-sec{padding:52px 5vw}
  .bds-spon .bds-faq-wrap{max-width:800px;margin:0 auto}
  .bds-spon .bds-faq-head{margin-bottom:36px}
  .bds-spon .bds-faq-list{display:flex;flex-direction:column}
  .bds-spon .bds-faq-item{border-top:1px solid var(--bds-line)}
  .bds-spon .bds-faq-item:last-child{border-bottom:1px solid var(--bds-line)}
  .bds-spon .bds-faq-q{width:100%;display:flex;justify-content:space-between;align-items:center;padding:22px 0;background:none;border:none;text-align:left;gap:16px}
  .bds-spon .bds-faq-q span:first-child{font-size:16px;font-weight:600;color:var(--bds-navy);letter-spacing:-.2px}
  .bds-spon .bds-faq-ic{font-size:20px;color:var(--bds-accent);font-weight:300;flex-shrink:0;line-height:1;transition:transform .25s;width:20px;text-align:center}
  .bds-spon .bds-faq-ic::before{content:'+'}
  .bds-spon .bds-faq-item.open .bds-faq-ic::before{content:'\00d7'}
  .bds-spon .bds-faq-a{overflow:hidden;max-height:0;transition:max-height .35s ease}
  .bds-spon .bds-faq-a-inner{font-size:14px;color:var(--bds-muted);line-height:1.7;padding-bottom:20px}
  .bds-spon .bds-faq-a-inner p{margin:0 0 10px}.bds-spon .bds-faq-a-inner p:last-child{margin:0}
  .bds-spon .bds-faq-a-inner strong{color:var(--bds-navy)}
  .bds-spon .bds-faq-a-inner a{color:var(--bds-accent);text-decoration:underline}
  /* India theme adds a navy hover background to buttons/list rows, which hid the FAQ text.
     Force the FAQ rows to stay flat (transparent) so the question text is always readable. */
  .bds-spon .bds-faq-item,.bds-spon .bds-faq-item:hover,.bds-spon .bds-faq-item:focus-within{background:transparent!important}
