  </div>

  <script>
  (function(){
    var SECT = document.getElementById('bds-spon-{{ uid }}');
    if(!SECT) return;

    /* ---- Nav: subtle shadow once scrolled ---- */
    var nav = SECT.querySelector('.bds-nav');
    if(nav){
      function onNavScroll(){ nav.classList.toggle('is-scrolled', window.pageYOffset > 8); }
      onNavScroll();
      window.addEventListener('scroll', onNavScroll, {passive:true});
    }

    /* ---- Smooth-scroll ---- (modal triggers handled by the lead-modal IIFE below) */
    SECT.addEventListener('click', function(e){
      var s = e.target.closest('[data-scroll]');
      if(s){ var t = document.getElementById(s.getAttribute('data-scroll')); if(t){ e.preventDefault(); t.scrollIntoView({behavior:'smooth',block:'start'}); } }
    });

    /* ---- Animated stat counters ---- */
    (function(){
      var stats = SECT.querySelector('.bds-stats');
      if(!stats) return;
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function run(){
        [].forEach.call(stats.querySelectorAll('.bds-stat-figure'), function(el){
          if(el.dataset.counted) return;
          var rawv = (el.textContent || '').trim();
          var m = rawv.match(/^([^\d]*)([\d.,]+)(.*)$/);
          if(!m){ return; }
          var pre = m[1], numStr = m[2], suf = m[3];
          var target = parseFloat(numStr.replace(/,/g,''));
          if(isNaN(target)){ return; }
          var dec = (numStr.split('.')[1] || '').length;
          el.dataset.counted = '1';
          function fmt(v){ return pre + v.toLocaleString('en-IN',{minimumFractionDigits:dec,maximumFractionDigits:dec}) + suf; }
          if(reduce){ el.textContent = fmt(target); return; }
          var dur = 1700, t0 = null;
          function step(ts){ if(t0===null) t0=ts; var p=Math.min((ts-t0)/dur,1); var e=1-Math.pow(1-p,3); el.textContent=fmt(target*e); if(p<1){ requestAnimationFrame(step); } else { el.textContent=fmt(target); } }
          el.textContent = fmt(0);
          requestAnimationFrame(step);
        });
      }
      if('IntersectionObserver' in window){
        var io = new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ run(); io.disconnect(); } }); }, {threshold:.3});
        io.observe(stats);
      } else { run(); }
    })();

    /* ---- Timeline: scroll-reveal rows + progress line grows through the circles ---- */
    (function(){
      var tl = SECT.querySelector('.bds-tl');
      if(!tl) return;
      var rows = [].slice.call(tl.querySelectorAll('.bds-tl-row'));
      if(!rows.length) return;
      var fill = tl.querySelector('[data-tl-fill]');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if(reduce){
        rows.forEach(function(r){ r.classList.add('is-in','is-active'); });
        if(fill){ fill.style.top='0'; fill.style.height='100%'; }
        return;
      }
      /* Reveal each row once as it scrolls into view */
      if('IntersectionObserver' in window){
        var io = new IntersectionObserver(function(es){
          es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, {threshold:.25, rootMargin:'0px 0px -8% 0px'});
        rows.forEach(function(r){ io.observe(r); });
      } else {
        rows.forEach(function(r){ r.classList.add('is-in'); });
      }
      /* Progress line + circle activation follow a trigger line at 58% of the viewport */
      function circleMid(r){ var c=r.querySelector('.bds-tl-circle').getBoundingClientRect(); return c.top + c.height/2; }
      var ticking=false;
      function paint(){
        ticking=false;
        var trigger = window.innerHeight * 0.58;
        var tlTop = tl.getBoundingClientRect().top;
        var startY = circleMid(rows[0]) - tlTop;
        var endY = circleMid(rows[rows.length-1]) - tlTop;
        var y = Math.max(startY, Math.min(endY, trigger - tlTop));
        if(fill){ fill.style.top = startY+'px'; fill.style.height = (y - startY)+'px'; }
        rows.forEach(function(r){ r.classList.toggle('is-active', circleMid(r) <= trigger + 1); });
      }
      function onScroll(){ if(!ticking){ ticking=true; requestAnimationFrame(paint); } }
      window.addEventListener('scroll', onScroll, {passive:true});
      window.addEventListener('resize', onScroll);
      paint();
    })();

    /* ---- FAQ accordion ---- */
    var faq = document.getElementById('bds-faq-{{ uid }}');
    if(faq){
      function setH(item){
        var a=item.querySelector('.bds-faq-a');
        a.style.maxHeight = item.classList.contains('open') ? a.scrollHeight+'px' : '0px';
      }
      faq.querySelectorAll('.bds-faq-item.open').forEach(setH);
      faq.addEventListener('click',function(e){
        var btn=e.target.closest('.bds-faq-q'); if(!btn) return;
        var item=btn.closest('.bds-faq-item');
        var isOpen=item.classList.toggle('open');
        btn.setAttribute('aria-expanded', isOpen?'true':'false');
        setH(item);
      });
      window.addEventListener('resize',function(){ faq.querySelectorAll('.bds-faq-item.open').forEach(setH); });
    }

    /* ---- ROI calculator (only when enabled) ---- */
    var root = document.getElementById('bds-roi-{{ uid }}');
    if(root){
      var ins={}; root.querySelectorAll('[data-in]').forEach(function(el){ ins[el.dataset.in]=el; });
      function out(k){ return root.querySelector('[data-out="'+k+'"]'); }
      function fmt(n){ return Math.abs(Math.round(n)).toLocaleString('en-IN'); }
      function fillSlider(el){
        var min=+el.min||0, max=+el.max||100, val=+el.value;
        var pct = max>min ? ((val-min)/(max-min))*100 : 0;
        el.style.background='linear-gradient(90deg,var(--bds-accent) '+pct+'%,var(--bds-line) '+pct+'%)';
      }
      function update(){
        var cost=+ins.cost.value, sponsors=+ins.sponsors.value, fee=+ins.fee.value;
        Object.keys(ins).forEach(function(k){ fillSlider(ins[k]); });
        if(out('cost')) out('cost').textContent='₹'+fmt(cost);
        if(out('sponsors')) out('sponsors').textContent=sponsors;
        if(out('fee')) out('fee').textContent='₹'+fmt(fee);
        var revenue=Math.round(sponsors*fee);
        var effCost=Math.max(0, cost-revenue);
        if(out('invest')) out('invest').textContent='₹'+fmt(cost);
        if(out('earn')) out('earn').textContent='₹'+fmt(revenue);
        var coverRaw = cost>0 ? revenue/cost : 0;
        var coverPct = Math.round(coverRaw*100);
        var coverCap = Math.min(coverRaw,1)*100;
        var g=root.querySelector('[data-gauge]'); if(g) g.setAttribute('stroke-dasharray', coverCap.toFixed(1)+' 100');
        if(out('coverpct')) out('coverpct').textContent=coverPct+'%';
        var ee=out('effcost'), se=out('effsub');
        if(ee){ ee.textContent='₹'+fmt(effCost); ee.className = effCost>0 ? 'bds-roi-card-v' : 'bds-roi-card-v is-green'; }
        if(se){
          if(revenue>=cost && cost>0) se.textContent='+₹'+fmt(revenue-cost)+' profit';
          else if(revenue===0) se.textContent='no coverage yet';
          else se.textContent='partially covered';
        }
        if(out('earnsub')) out('earnsub').textContent='from '+sponsors+' sponsor'+(sponsors==1?'':'s');
      }
      Object.keys(ins).forEach(function(k){ ins[k].addEventListener('input',update); });
      update();
    }

    /* ---- Hero background media (image / uploaded video / YouTube-Vimeo embed · per-device) ----
       Renders ONLY the layer for the current breakpoint, so a single media loads. Mobile falls
       back to the desktop layer when no mobile media is set. Embeds are built muted+looped. */
    (function(){
      var box = SECT.querySelector('[data-hero-bg]'); if(!box) return;
      function ytId(u){ var m=u.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/|live\/)|youtu\.be\/)([\w-]{11})/); return m?m[1]:''; }
      function srcFromIframe(c){ var m=c.match(/src\s*=\s*["']([^"']+)["']/i); return m?m[1]:''; }
      function embedUrl(u){
        if(!u) return ''; u=(''+u).trim();
        if(/<iframe/i.test(u)){ var s=srcFromIframe(u); if(s) u=s; }
        var id=ytId(u);
        if(id) return 'https://www.youtube.com/embed/'+id+'?autoplay=1&mute=1&loop=1&playlist='+id+'&controls=0&showinfo=0&modestbranding=1&rel=0&playsinline=1&disablekb=1&iv_load_policy=3&fs=0';
        var vm=u.match(/vimeo\.com\/(?:video\/)?(\d+)/);
        if(vm) return 'https://player.vimeo.com/video/'+vm[1]+'?autoplay=1&muted=1&loop=1&background=1';
        return u.indexOf('http')===0 ? u : '';
      }
      var mq = window.matchMedia('(max-width:768px)');
      var cur = '';
      function pickTpl(which){
        var t = box.querySelector('template[data-tpl="'+which+'"]');
        if(which==='m' && (!t || !t.content || !t.content.childNodes.length)) t = box.querySelector('template[data-tpl="d"]');
        return t;
      }
      function render(){
        var which = mq.matches ? 'm' : 'd';
        if(which===cur) return; cur=which;
        var old = box.querySelector('[data-hero-media]'); if(old) old.parentNode.removeChild(old);
        var tpl = pickTpl(which); if(!tpl) return;
        var wrap = document.createElement('div'); wrap.className='bds-hero-media'; wrap.setAttribute('data-hero-media','');
        wrap.appendChild(tpl.content.cloneNode(true));
        var emb = wrap.querySelector('[data-embed]');
        if(emb){ var url=embedUrl(emb.getAttribute('data-embed')); if(url){ var f=document.createElement('iframe'); f.className='bds-hero-embed'; f.setAttribute('allow','autoplay; encrypted-media; picture-in-picture'); f.setAttribute('frameborder','0'); f.src=url; emb.appendChild(f); } }
        box.appendChild(wrap);
        var v = wrap.querySelector('video'); if(v){ v.muted=true; try{ v.play(); }catch(e){} }
      }
      render();
      if(mq.addEventListener) mq.addEventListener('change', render);
      else if(mq.addListener) mq.addListener(render);
    })();

    /* ---- Lazy video (library video OR YouTube/Vimeo URL/embed) ---- */
    function bdsExtractSrc(c){ var m=c.match(/src\s*=\s*["']([^"']+)["']/i); return m?m[1]:''; }
    function bdsYtId(u){ var m=u.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/|live\/)|youtu\.be\/)([\w-]{11})/); return m?m[1]:''; }
    function bdsNormalize(u){
      if(!u) return ''; u=u.trim();
      if(/<iframe/i.test(u)){ var s=bdsExtractSrc(u); if(s) u=s; }
      var id=bdsYtId(u); if(id) return 'https://www.youtube.com/embed/'+id+'?autoplay=1&rel=0';
      var vm=u.match(/vimeo\.com\/(?:video\/)?(\d+)/); if(vm) return 'https://player.vimeo.com/video/'+vm[1]+'?autoplay=1';
      if(u.indexOf('http')===0) return u+(u.indexOf('?')>-1?'&':'?')+'autoplay=1';
      return '';
    }
    [].forEach.call(SECT.querySelectorAll('.bds-video'), function(v){
      v.addEventListener('click',function(){
        if(v.classList.contains('is-playing')) return;
        var type=v.getAttribute('data-type');
        if(type==='shopify'){ var h=v.querySelector('.bds-video-holder'),el=v.querySelector('video'); if(h) h.hidden=false; v.classList.add('is-playing'); if(el){ try{ el.play(); }catch(e){} } }
        else if(type==='embed'){ var url=bdsNormalize(v.getAttribute('data-embed')); if(!url) return; var f=document.createElement('iframe'); f.className='bds-video-embed'; f.setAttribute('allow','autoplay; encrypted-media; fullscreen; picture-in-picture'); f.setAttribute('allowfullscreen',''); f.src=url; v.appendChild(f); v.classList.add('is-playing'); }
      });
    });

    /* ---- Before/After compare slider — divider follows cursor (hover) or touch drag ---- */
    [].forEach.call(SECT.querySelectorAll('[data-baslider]'), function(sl){
      function set(clientX){
        var r = sl.getBoundingClientRect();
        if(!r.width) return;
        var p = Math.max(0, Math.min(100, ((clientX - r.left) / r.width) * 100));
        sl.style.setProperty('--bapos', p + '%');
        sl.classList.add('is-touched');
      }
      /* Desktop: move the mouse across the image to compare (no click needed) */
      sl.addEventListener('mousemove', function(e){ set(e.clientX); });
      /* Touch: drag anywhere on the image */
      var touching = false;
      sl.addEventListener('touchstart', function(e){ touching = true; if(e.touches[0]) set(e.touches[0].clientX); }, {passive:true});
      sl.addEventListener('touchmove',  function(e){ if(touching && e.touches[0]) set(e.touches[0].clientX); }, {passive:true});
      sl.addEventListener('touchend',   function(){ touching = false; });
    });

    /* ---- Before/After video embed (YouTube/Vimeo) → muted, looping, no-controls player ---- */
    [].forEach.call(SECT.querySelectorAll('[data-ba-embed]'), function(box){
      var u=(box.getAttribute('data-ba-embed')||'').trim(); if(!u) return;
      if(/<iframe/i.test(u)){ var s=bdsExtractSrc(u); if(s) u=s; }
      var src='', id=bdsYtId(u);
      if(id){ src='https://www.youtube.com/embed/'+id+'?autoplay=1&mute=1&loop=1&playlist='+id+'&controls=0&modestbranding=1&rel=0&playsinline=1&iv_load_policy=3&fs=0'; }
      else { var vm=u.match(/vimeo\.com\/(?:video\/)?(\d+)/); if(vm){ src='https://player.vimeo.com/video/'+vm[1]+'?autoplay=1&muted=1&loop=1&background=1'; } else if(u.indexOf('http')===0){ src=u; } }
      if(!src) return;
      var f=document.createElement('iframe'); f.setAttribute('allow','autoplay; encrypted-media; picture-in-picture'); f.setAttribute('frameborder','0'); f.src=src; box.appendChild(f);
    });
  })();

  {%- comment -%} ── LEAD MODAL (dual role · self-contained email + intl-phone validation) ── {%- endcomment -%}
  (function(){
    var SECT = document.getElementById('bds-spon-{{ uid }}');
    if(!SECT) return;

    /* ════ Self-contained form validation: email deliverability + intl phone (flag by IP) ════ */
    var Forms = (function(){
      var DEFAULT_ISO = {{ sp.default_country | default: 'IN' | json }};
      var COUNTRIES = ("IN:91:India,US:1:United States,GB:44:United Kingdom,AE:971:United Arab Emirates,CA:1:Canada,AU:61:Australia,SG:65:Singapore,SA:966:Saudi Arabia,QA:974:Qatar,KW:965:Kuwait,BH:973:Bahrain,OM:968:Oman,DE:49:Germany,FR:33:France,NL:31:Netherlands,ES:34:Spain,IT:39:Italy,IE:353:Ireland,ZA:27:South Africa,NG:234:Nigeria,KE:254:Kenya,GH:233:Ghana,EG:20:Egypt,PK:92:Pakistan,BD:880:Bangladesh,LK:94:Sri Lanka,NP:977:Nepal,MY:60:Malaysia,ID:62:Indonesia,TH:66:Thailand,PH:63:Philippines,VN:84:Vietnam,CN:86:China,HK:852:Hong Kong,JP:81:Japan,KR:82:South Korea,NZ:64:New Zealand,BR:55:Brazil,MX:52:Mexico,AR:54:Argentina,CH:41:Switzerland,SE:46:Sweden,NO:47:Norway,DK:45:Denmark,BE:32:Belgium,AT:43:Austria,PT:351:Portugal,PL:48:Poland,TR:90:Turkey,RU:7:Russia,UA:380:Ukraine,IL:972:Israel")
        .split(",").map(function(s){ var a=s.split(":"); return {iso:a[0], dial:a[1], name:a[2]}; });
      function byIso(iso){ for(var i=0;i<COUNTRIES.length;i++){ if(COUNTRIES[i].iso===iso) return COUNTRIES[i]; } return null; }
      /* Real flag IMAGES (emoji flags don't render on Windows) */
      function flag(iso){ iso=(iso||'').toLowerCase(); return '<img class="bds-fl" src="https://flagcdn.com/24x18/'+iso+'.png" srcset="https://flagcdn.com/48x36/'+iso+'.png 2x" width="24" height="18" alt="" loading="lazy">'; }

      /* National-number length rules per country (min,max digits). Fallback 6–15. */
      var LEN = {IN:[10,10],US:[10,10],CA:[10,10],GB:[10,10],AE:[9,9],AU:[9,9],SG:[8,8],SA:[9,9],QA:[8,8],KW:[8,8],BH:[8,8],OM:[8,8],PK:[10,10],BD:[10,11],LK:[9,9],NP:[10,10],MY:[9,10],ID:[9,12],TH:[9,9],PH:[10,10],VN:[9,10],CN:[11,11],HK:[8,8],JP:[10,10],KR:[9,10],NZ:[8,10],DE:[10,11],FR:[9,9],NL:[9,9],ES:[9,9],IT:[9,10],IE:[9,9],ZA:[9,9],NG:[10,10],KE:[9,9],GH:[9,9],EG:[10,10],BR:[10,11],MX:[10,10],AR:[10,10],CH:[9,9],SE:[7,9],NO:[8,8],DK:[8,8],BE:[9,9],AT:[10,11],PT:[9,9],PL:[9,9],TR:[10,10],RU:[10,10],UA:[9,9],IL:[9,9]};
      /* Stricter mobile patterns (leading digit matters) for key markets. Others fall back to LEN. */
      var PAT = {IN:/^[6-9]\d{9}$/,US:/^[2-9]\d{9}$/,CA:/^[2-9]\d{9}$/,GB:/^7\d{9}$/,AE:/^5\d{8}$/,AU:/^4\d{8}$/,SA:/^5\d{8}$/,PK:/^3\d{9}$/,BD:/^1[3-9]\d{8}$/,SG:/^[89]\d{7}$/,NP:/^9\d{9}$/,LK:/^7\d{8}$/,QA:/^[3567]\d{7}$/,KW:/^[569]\d{7}$/,NG:/^[789]\d{9}$/,KE:/^[17]\d{8}$/,ZA:/^[6-8]\d{8}$/,EG:/^1\d{9}$/};

      var DISPOSABLE = {'mailinator.com':1,'guerrillamail.com':1,'10minutemail.com':1,'tempmail.com':1,'temp-mail.org':1,'yopmail.com':1,'trashmail.com':1,'sharklasers.com':1,'getnada.com':1,'dispostable.com':1,'maildrop.cc':1,'fakeinbox.com':1};
      var TYPOS = {'gmial.com':'gmail.com','gmai.com':'gmail.com','gmail.con':'gmail.com','gmail.co':'gmail.com','gmal.com':'gmail.com','gmaill.com':'gmail.com','hotmial.com':'hotmail.com','hotmail.con':'hotmail.com','hotmal.com':'hotmail.com','yahoo.con':'yahoo.com','yaho.com':'yahoo.com','yahooo.com':'yahoo.com','outlook.con':'outlook.com','outlok.com':'outlook.com','rediffmail.con':'rediffmail.com'};
      var EMAIL_RE = /^[a-z0-9!#$%&'*+\/=?^_`{|}~.-]+@[a-z0-9-]+(\.[a-z0-9-]+)*\.[a-z]{2,}$/i;

      var st = {}; // per-input phone state keyed by element id

      function setMsg(el, text, type){ if(!el) return; el.textContent=text||''; el.className='field-msg '+(type||'err')+(text?' show':''); }

      function buildTel(input){
        if(input.dataset.telReady) return;
        input.dataset.telReady='1';
        var wrap=document.createElement('div'); wrap.className='bds-tel';
        input.parentNode.insertBefore(wrap, input);
        var btn=document.createElement('button'); btn.type='button'; btn.className='bds-tel-btn';
        btn.innerHTML='<span class="fl"></span><span class="dc"></span><span class="ar">▼</span>';
        var list=document.createElement('div'); list.className='bds-tel-list';
        var search=document.createElement('input'); search.type='text'; search.className='bds-tel-search'; search.placeholder='Search country…';
        list.appendChild(search);
        var optsWrap=document.createElement('div');
        list.appendChild(optsWrap);
        wrap.appendChild(btn); wrap.appendChild(input); wrap.appendChild(list);

        function render(filter){
          optsWrap.innerHTML='';
          var f=(filter||'').toLowerCase();
          COUNTRIES.forEach(function(c){
            if(f && c.name.toLowerCase().indexOf(f)===-1 && c.dial.indexOf(f)===-1 && c.iso.toLowerCase().indexOf(f)===-1) return;
            var o=document.createElement('div'); o.className='bds-tel-opt';
            o.innerHTML='<span class="fl">'+flag(c.iso)+'</span><span class="nm">'+c.name+'</span><span class="dc">+'+c.dial+'</span>';
            o.addEventListener('click', function(){ select(c.iso); closeList(); input.focus(); });
            optsWrap.appendChild(o);
          });
        }
        function select(iso){ var c=byIso(iso)||byIso(DEFAULT_ISO)||COUNTRIES[0]; st[input.id]=c; btn.querySelector('.fl').innerHTML=flag(c.iso); btn.querySelector('.dc').textContent='+'+c.dial; }
        function openList(){ render(''); search.value=''; list.classList.add('open'); setTimeout(function(){ search.focus(); },30); }
        function closeList(){ list.classList.remove('open'); }
        btn.addEventListener('click', function(e){ e.stopPropagation(); list.classList.contains('open')?closeList():openList(); });
        search.addEventListener('input', function(){ render(search.value); });
        search.addEventListener('click', function(e){ e.stopPropagation(); });
        document.addEventListener('click', function(e){ if(!wrap.contains(e.target)) closeList(); });
        select(DEFAULT_ISO);
        render('');
      }

      function detectCountry(input){
        function trySet(iso){ if(!iso) return; var c=byIso((''+iso).toUpperCase()); if(c && st[input.id] && !input.dataset.userPicked){ st[input.id]=c; var btn=input.parentNode && input.parentNode.querySelector('.bds-tel-btn'); if(btn){ btn.querySelector('.fl').innerHTML=flag(c.iso); btn.querySelector('.dc').textContent='+'+c.dial; } } }
        function safe(url){ try { return fetch(url).then(function(r){ return r.ok ? r.json() : null; })['catch'](function(){ return null; }); } catch(e){ return Promise.resolve(null); } }
        safe('https://ipapi.co/json/').then(function(d){
          if(d && d.country_code){ trySet(d.country_code); return null; }
          return safe('https://get.geojs.io/v1/ip/country.json').then(function(d2){
            if(d2 && d2.country){ trySet(d2.country); return null; }
            return safe('https://api.country.is/').then(function(d3){ if(d3 && d3.country) trySet(d3.country); });
          });
        })['catch'](function(){});
      }

      return {
        initPhone: function(input){ if(input){ buildTel(input); input.addEventListener('input', function(){ input.dataset.userTyped='1'; }); } },
        initCountryPicked: function(input){ var btn=input&&input.parentNode&&input.parentNode.querySelector('.bds-tel-btn'); if(btn){ btn.addEventListener('click', function(){ input.dataset.userPicked='1'; }); } },
        preload: function(input){ if(input) detectCountry(input); },
        getCountry: function(input){ var c=st[input.id]; return c?c.iso:DEFAULT_ISO; },
        getPhone: function(input){ var c=st[input.id]||byIso(DEFAULT_ISO); var nat=(input.value||'').replace(/[^\d]/g,''); return '+'+(c?c.dial:'')+' '+nat; },
        checkPhone: function(input, msgEl){
          var c=st[input.id]||byIso(DEFAULT_ISO);
          var nat=(input.value||'').replace(/[^\d]/g,'');
          var wrap=input.closest('.bds-tel');
          if(!nat){ setMsg(msgEl,'Phone number is required'); if(wrap) wrap.classList.add('err'); return false; }
          var pat = PAT[c.iso], ok;
          if(pat){ ok = pat.test(nat); }                       // strict mobile pattern (e.g. India must start 6–9)
          else { var rule = LEN[c.iso] || [6,15]; ok = (nat.length>=rule[0] && nat.length<=rule[1]); }
          if(!ok){ setMsg(msgEl,'Enter a valid '+c.name+' mobile number'); if(wrap) wrap.classList.add('err'); return false; }
          setMsg(msgEl,'',''); if(wrap) wrap.classList.remove('err'); return true;
        },
        /* Instant, network-free email check (format + typo + disposable). */
        checkEmailSync: function(input, msgEl){
          var v=(input.value||'').trim();
          if(!v || !EMAIL_RE.test(v)){ input.classList.add('err'); setMsg(msgEl,'Enter a valid email address'); return false; }
          var domain=v.split('@')[1].toLowerCase();
          if(TYPOS[domain]){ input.classList.add('err'); setMsg(msgEl,'Did you mean @'+TYPOS[domain]+'?'); return false; }
          if(DISPOSABLE[domain]){ input.classList.add('err'); setMsg(msgEl,'Please use a permanent email address'); return false; }
          input.classList.remove('err'); setMsg(msgEl,'',''); return true;
        },
        checkEmail: function(input, msgEl, checkingEl){
          return new Promise(function(resolve){
            var v=(input.value||'').trim();
            if(!v || !EMAIL_RE.test(v)){ input.classList.add('err'); setMsg(msgEl,'Enter a valid email address'); return resolve(false); }
            var domain=v.split('@')[1].toLowerCase();
            if(TYPOS[domain]){ input.classList.add('err'); setMsg(msgEl,'Did you mean @'+TYPOS[domain]+'?'); return resolve(false); }
            if(DISPOSABLE[domain]){ input.classList.add('err'); setMsg(msgEl,'Please use a permanent email address'); return resolve(false); }
            input.classList.remove('err'); setMsg(msgEl,'','');
            if(checkingEl) checkingEl.classList.add('show');
            function done(ok,text,type){ if(checkingEl) checkingEl.classList.remove('show'); if(!ok){ input.classList.add('err'); setMsg(msgEl,text||'',type||'err'); } else { input.classList.remove('err'); setMsg(msgEl,text||'',type||'ok'); } resolve(ok); }
            var settled=false;
            var ctrl=setTimeout(function(){ if(!settled){ settled=true; done(true,''); } }, 5000); // never block on a slow lookup
            function dohGoogle(){ return fetch('https://dns.google/resolve?name='+encodeURIComponent(domain)+'&type=MX').then(function(r){return r.ok?r.json():null;}); }
            function dohCloudflare(){ return fetch('https://cloudflare-dns.com/dns-query?name='+encodeURIComponent(domain)+'&type=MX',{headers:{accept:'application/dns-json'}}).then(function(r){return r.ok?r.json():null;}); }
            function realMX(d){
              if(!d) return null;                       // no response → unknown (don't block submit)
              if(d.Status===3) return false;            // NXDOMAIN — domain doesn't exist
              if(d.Status===0 && Array.isArray(d.Answer) && d.Answer.length){
                var real=d.Answer.filter(function(a){
                  if(a.type!==15) return false;          // 15 = MX record
                  var ex=String(a.data||'').trim().split(/\s+/).pop().replace(/\.$/,'').toLowerCase();
                  return ex && ex!=='localhost' && ex!=='0.0.0.0' && ex!=='127.0.0.1';
                });
                return real.length>0;                    // has a real mail exchanger?
              }
              if(d.Status===0) return false;            // resolved but NO MX → can't receive mail
              return null;
            }
            dohGoogle().then(function(d){
              var res=realMX(d);
              if(res===null){ return dohCloudflare().then(function(d2){ return realMX(d2); }); } // retry on other provider
              return res;
            })['catch'](function(){ return null; }).then(function(res){
              if(settled) return; settled=true; clearTimeout(ctrl);
              if(res===false){ done(false,"That email domain can't receive mail — please check it"); }
              else if(res===true){ done(true,'Email verified ✓','ok'); }
              else { done(true,''); }                    // both providers blocked → don't trap real users
            });
          });
        }
      };
    })();

    var modal = document.getElementById('bds-modal-{{ uid }}');
    if(!modal) return;
    /* Portal the modal to <body> so a transformed / overflow-clipped theme ancestor
       can never hide it. Copy the section's CSS variables onto the portal so all
       modal styles still resolve. */
    try {
      var portal = document.createElement('div'); portal.className = 'bds-spon'; portal.setAttribute('data-bds-portal','');
      portal.style.margin='0'; portal.style.width='auto'; portal.style.overflow='visible';
      var csv = getComputedStyle(SECT);
      ['--bds-accent','--bds-accent-dark','--bds-accent-light','--bds-navy','--bds-navy-mid','--bds-navy-deep','--bds-green','--bds-white','--bds-off-white','--bds-g100','--bds-g200','--bds-g500','--bds-g700','--bds-g900','--bds-fd','--bds-fb'].forEach(function(v){ portal.style.setProperty(v, csv.getPropertyValue(v)); });
      document.body.appendChild(portal); portal.appendChild(modal);
    } catch(ePortal){}

    var COPY = {
      owner: {
        eyebrow:   {{ sp.modal_eyebrow_owner | default: 'For Backdrop Owners' | json }},
        title:     {{ sp.modal_title_owner | default: 'Become a Backdrop Owner' | json }},
        sub:       {{ sp.modal_sub_owner | default: "Tell us about your event and backdrop. Share a few details below and we'll match you with paying sponsors." | json }},
        form:      {{ sp.owner_sheet_tab | default: 'Owner Leads' | json }},
        company:   {{ sp.lead_company_label_owner | default: 'Company / Organisation name' | json }},
        fieldKey:  'event_name',
        fieldLabel:{{ sp.lead_event_label | default: 'Event name' | json }},
        fieldPh:   {{ sp.lead_event_ph | default: 'e.g. Annual Tech Summit 2026' | json }},
        file:      {{ sp.lead_file_label_owner | default: 'Upload event brief or reference file' | json }}
      },
      sponsor: {
        eyebrow:   {{ sp.modal_eyebrow_sponsor | default: 'For Brands & Sponsors' | json }},
        title:     {{ sp.modal_title_sponsor | default: 'Become a Sponsor' | json }},
        sub:       {{ sp.modal_sub_sponsor | default: 'Share your brand details and campaign goals so we can explore the right sponsorship opportunities for you.' | json }},
        form:      {{ sp.sponsor_sheet_tab | default: 'Sponsor Leads' | json }},
        company:   {{ sp.lead_company_label_sponsor | default: 'Company / Brand name' | json }},
        fieldKey:  'industry',
        fieldLabel:{{ sp.lead_industry_label | default: 'Industry' | json }},
        fieldPh:   {{ sp.lead_industry_ph | default: 'e.g. Fintech, FMCG, Telecom' | json }},
        file:      {{ sp.lead_file_label_sponsor | default: 'Upload brand guidelines or campaign brief' | json }}
      }
    };
    var SUBMIT_LABEL = {{ sp.submit_label | default: 'Send my details →' | json }};
    var MAX_FILE = 10 * 1024 * 1024; // 10 MB
    var role = 'owner';
    var elEyebrow = modal.querySelector('[data-modal-eyebrow]');
    var elTitle   = modal.querySelector('[data-modal-title]');
    var elSub     = modal.querySelector('[data-modal-sub]');
    var elCompany = modal.querySelector('[data-lbl-company]');
    var elRoleLbl = modal.querySelector('[data-lbl-role]');
    var elFileLbl = modal.querySelector('[data-lbl-file]');
    var roleEl    = modal.querySelector('[data-f="rolefield"]');
    var roleSel   = modal.querySelector('[data-f="industry-select"]');
    var content   = modal.querySelector('[data-form-content]');
    var success   = modal.querySelector('[data-form-success]');
    var emailEl   = modal.querySelector('[data-f="email"]');
    var phoneEl   = modal.querySelector('[data-f="phone"]');
    var msgEmail  = modal.querySelector('[data-msg="email"]');
    var msgPhone  = modal.querySelector('[data-msg="phone"]');
    var chkEmail  = modal.querySelector('[data-checking="email"]');

    try { Forms.initPhone(phoneEl); Forms.initCountryPicked(phoneEl); } catch(eInit){}
    /* Replace the native <select> with a custom, in-modal dropdown so the long industry
       list can never overflow the screen. The hidden <select> stays the value source. */
    function buildSelect(sel){
      if(!sel || sel.dataset.selReady) return; sel.dataset.selReady='1';
      sel.style.display='none';
      var wrap=document.createElement('div'); wrap.className='bds-isel';
      sel.parentNode.insertBefore(wrap, sel);
      var btn=document.createElement('button'); btn.type='button'; btn.className='bds-isel-btn';
      btn.innerHTML='<span class="lbl ph"></span><span class="ar">▼</span>';
      var list=document.createElement('div'); list.className='bds-isel-list';
      wrap.appendChild(btn); wrap.appendChild(sel); wrap.appendChild(list);
      var lblEl=btn.querySelector('.lbl');
      function setLabel(){ var o=sel.options[sel.selectedIndex]; lblEl.textContent=o?o.textContent:'Select…'; lblEl.classList.toggle('ph', !sel.value); }
      [].forEach.call(sel.options, function(opt){
        var o=document.createElement('div'); o.className='bds-isel-opt'; o.textContent=opt.textContent;
        if(opt.value==='') o.style.color='var(--bds-g500)';
        o.addEventListener('click', function(){
          sel.value=opt.value; setLabel(); wrap.classList.remove('open','err');
          var ev; try{ ev=new Event('change',{bubbles:true}); }catch(e){ ev=document.createEvent('Event'); ev.initEvent('change',true,true); }
          sel.dispatchEvent(ev);
        });
        list.appendChild(o);
      });
      btn.addEventListener('click', function(e){ e.stopPropagation(); wrap.classList.toggle('open'); });
      document.addEventListener('click', function(e){ if(!wrap.contains(e.target)) wrap.classList.remove('open'); });
      setLabel();
      sel._bdsReset=function(){ setLabel(); wrap.classList.remove('err','open'); };
    }
    try { buildSelect(roleSel); } catch(eSel){}
    /* Verify the email's domain (MX) the moment the user leaves the field. */
    if(emailEl){
      emailEl.addEventListener('blur', function(){
        if(!emailEl.value.trim()) return;
        Forms.checkEmail(emailEl, msgEmail, chkEmail).then(function(okk){ emailEl.dataset.mx = okk ? 'ok' : 'bad'; });
      });
      emailEl.addEventListener('input', function(){ emailEl.dataset.mx=''; emailEl.classList.remove('err'); if(msgEmail){ msgEmail.textContent=''; msgEmail.className='field-msg err'; } if(chkEmail) chkEmail.classList.remove('show'); });
    }
    /* Industry dropdown: when "Other (Please specify)" is picked, reveal the text box. */
    if(roleSel){
      roleSel.addEventListener('change', function(){
        var w=roleSel.closest('.bds-isel'); if(w) w.classList.remove('err');
        if(role==='sponsor'){
          if(roleSel.value==='__other__'){ roleEl.style.display=''; roleEl.value=''; roleEl.placeholder='Please specify your industry'; roleEl.focus(); }
          else { roleEl.style.display='none'; roleEl.value=''; }
        }
      });
    }
    function clearMsgs(){
      [msgEmail, msgPhone].forEach(function(m){ if(m){ m.textContent=''; m.className='field-msg err'; } });
      if(chkEmail) chkEmail.classList.remove('show');
      modal.querySelectorAll('input.err').forEach(function(i){ i.classList.remove('err'); });
      var w=modal.querySelector('.bds-tel'); if(w) w.classList.remove('err');
    }

    function openModal(r){
      role = (r==='sponsor') ? 'sponsor' : 'owner';
      var c = COPY[role];
      if(elEyebrow) elEyebrow.textContent = c.eyebrow;
      if(elTitle)   elTitle.textContent   = c.title;
      if(elSub)     elSub.textContent     = c.sub;
      if(elCompany) elCompany.textContent = c.company + ' *';
      if(elRoleLbl) elRoleLbl.textContent = c.fieldLabel + ' *';
      if(elFileLbl) elFileLbl.textContent = c.file;
      /* Reset every field so reopening the form never shows the previous lead's data. */
      if(content){ content.querySelectorAll('input, select, textarea').forEach(function(el){ if(el.type!=='button' && el.type!=='submit'){ el.value=''; el.classList.remove('err'); } }); }
      if(emailEl) emailEl.dataset.mx='';
      /* Sponsor → Industry dropdown; Owner → free-text Event name. */
      var roleWrap = roleSel && roleSel.closest('.bds-isel');
      if(role==='sponsor'){
        if(roleSel){ roleSel.value=''; if(roleSel._bdsReset) roleSel._bdsReset(); }
        if(roleWrap) roleWrap.style.display='';
        roleEl.style.display='none'; roleEl.placeholder='Please specify your industry';
      } else {
        if(roleSel){ roleSel.value=''; }
        if(roleWrap) roleWrap.style.display='none';
        roleEl.style.display=''; roleEl.placeholder=c.fieldPh;
      }
      clearMsgs();
      if(content) content.style.display='';
      if(success) success.style.display='none';
      var sb = modal.querySelector('[data-submit-lead]'); if(sb){ sb.disabled=false; sb.textContent=SUBMIT_LABEL; }
      modal.classList.add('open'); modal.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden';
      /* Force the visible state inline so NO theme CSS can hide it */
      modal.style.setProperty('display','flex','important');
      modal.style.setProperty('visibility','visible','important');
      modal.style.setProperty('opacity','1','important');
      try { Forms.preload(phoneEl); } catch(ePre){} // lazy-detect country flag by IP
    }
    function closeModal(){ modal.classList.remove('open'); modal.setAttribute('aria-hidden','true'); document.body.style.overflow=''; modal.style.setProperty('display','none','important'); }

    SECT.addEventListener('click', function(e){
      var t = e.target.closest('[data-open-modal]');
      if(t){ e.preventDefault(); openModal(t.getAttribute('data-role')); }
    });
    modal.addEventListener('click', function(e){ if(e.target===modal || e.target.closest('[data-close-modal]')) closeModal(); });
    document.addEventListener('keydown', function(e){ if(e.key==='Escape' && modal.classList.contains('open')) closeModal(); });

    var submitBtn = modal.querySelector('[data-submit-lead]');
    function req(el){ var v=(el.value||'').trim(); if(!v){ el.classList.add('err'); return false; } el.classList.remove('err'); return true; }
    submitBtn && submitBtn.addEventListener('click', function(){
      var nameEl   = modal.querySelector('[data-f="name"]'),
          companyEl= modal.querySelector('[data-f="company"]'),
          fileEl   = modal.querySelector('[data-f="file"]');
      var f = fileEl && fileEl.files && fileEl.files[0];

      // All validation is instant (no network) so submit never stalls.
      var ok = true;
      if(!req(nameEl)) ok=false;
      if(!req(companyEl)) ok=false;
      // Role-specific field: sponsor = Industry dropdown, owner = Event name text.
      var roleVal = '';
      if(role==='sponsor'){
        var roleWrap = roleSel.closest('.bds-isel');
        if(!roleSel.value){ if(roleWrap) roleWrap.classList.add('err'); ok=false; }
        else { if(roleWrap) roleWrap.classList.remove('err');
          if(roleSel.value==='__other__'){ if(!req(roleEl)) ok=false; else roleVal=roleEl.value.trim(); }
          else { roleVal=roleSel.value; }
        }
      } else {
        if(!req(roleEl)) ok=false; else roleVal=roleEl.value.trim();
      }
      var emOk = Forms.checkEmailSync(emailEl, msgEmail);
      if(emOk && emailEl.dataset.mx==='bad'){ emailEl.classList.add('err'); msgEmail.textContent="That email domain can't receive mail — please check it"; msgEmail.className='field-msg err show'; emOk=false; }
      if(!emOk) ok=false;
      if(!Forms.checkPhone(phoneEl, msgPhone)) ok=false;
      if(f && f.size > MAX_FILE){ fileEl.classList.add('err'); alert('That file is larger than 10 MB. Please attach a smaller file or send it later.'); ok=false; } else if(fileEl) fileEl.classList.remove('err');
      if(!ok) return;

      submitBtn.disabled = true;

      function showSuccess(){ if(content) content.style.display='none'; if(success) success.style.display='block'; }
      if(emailEl.dataset.mx==='ok'){ submitBtn.textContent='Sending…'; proceed(); }
      else {
        submitBtn.textContent='Verifying…';
        Forms.checkEmail(emailEl, msgEmail, chkEmail).then(function(okk){
          emailEl.dataset.mx = okk ? 'ok' : 'bad';
          if(!okk){ submitBtn.disabled=false; submitBtn.textContent=SUBMIT_LABEL; return; }
          submitBtn.textContent='Sending…'; proceed();
        });
      }

      function proceed(){
      var c = COPY[role];
      var endpoint = modal.getAttribute('data-endpoint');
      function send(fileData){
        if(!endpoint){ showSuccess(); return; }
        var data = {
          form: c.form, role: role,
          name: nameEl.value.trim(), company: companyEl.value.trim(),
          email: emailEl.value.trim(),
          phone: Forms.getPhone(phoneEl), phone_country: Forms.getCountry(phoneEl),
          source: 'sponsorship-landing-india', page: location.href
        };
        data[c.fieldKey] = roleVal;
        try { console.log('[bds] submitting lead →', endpoint, JSON.parse(JSON.stringify(data))); } catch(e){}
        if(fileData){
          data.file_base64 = fileData.b64; data.file_name = fileData.name; data.file_type = fileData.type;
          fetch(endpoint, {method:'POST', mode:'no-cors', body: JSON.stringify(data)}).then(showSuccess).catch(showSuccess);
        } else {
          var qs = Object.keys(data).map(function(k){ return encodeURIComponent(k)+'='+encodeURIComponent(data[k]==null?'':data[k]); }).join('&');
          fetch(endpoint+'?'+qs, {method:'GET', mode:'no-cors'}).then(showSuccess).catch(showSuccess);
        }
        setTimeout(showSuccess, 1200);
      }

      if(f){
        var rd = new FileReader();
        rd.onload = function(){ var s=(''+rd.result), i=s.indexOf(','); send({b64:(i>-1?s.slice(i+1):s), name:f.name, type:f.type||'application/octet-stream'}); };
        rd.onerror = function(){ send(null); };
        rd.readAsDataURL(f);
      } else { send(null); }
      } /* end proceed() */
    });
  })();
  </script>

