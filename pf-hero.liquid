{%- liquid
  assign stats = section.blocks | where: 'type', 'stat'
  assign fans = section.blocks | where: 'type', 'fan_card'
-%}
<section class="pf-hero">
  <div class="pf-hero-inner">
    <span class="pf-crop tl"></span><span class="pf-crop br"></span>
    <div class="pf-hero-copy">
      {%- if section.settings.eyebrow != blank -%}
        <div class="eyebrow"><span class="cmyk"><i></i><i></i><i></i><i></i></span> {{ section.settings.eyebrow }}</div>
      {%- endif -%}
      <h1>
        {{- section.settings.heading_line_1 }}<br>
        {{ section.settings.heading_line_2 }}<br>
        <em>{{ section.settings.heading_line_3 }}</em>
      </h1>
      {%- if section.settings.lede != blank -%}
        <p class="lede">{{ section.settings.lede }}</p>
      {%- endif -%}
      <div class="pf-actions">
        {%- if section.settings.cta_primary_label != blank -%}
          <a class="btn btn-primary" href="{{ section.settings.cta_primary_link | default: '#' }}">{{ section.settings.cta_primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta_secondary_label != blank -%}
          <a class="btn btn-ghost pf-ghost-light" href="{{ section.settings.cta_secondary_link | default: '#' }}">{{ section.settings.cta_secondary_label }}</a>
        {%- endif -%}
      </div>
      {%- if stats.size > 0 -%}
        <div class="pf-hero-stats">
          {%- for block in stats -%}
            <div {{ block.shopify_attributes }}>
              <b>{{ block.settings.value }}</b>
              <span>{{ block.settings.label }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pf-swatch-fan" aria-hidden="true">
      {%- for block in fans -%}
        <div class="pf-fan-card tex {{ block.settings.texture }}"{% if block.settings.image != blank %} style="background-image: url('{{ block.settings.image }}'); background-size: contain; background-repeat: no-repeat; background-position: center; background-color: #ffffff; background-origin: content-box; padding: 14px;"{% endif %} {{ block.shopify_attributes }}>
          <div class="pf-fan-tag">{{ block.settings.tag }}</div>
        </div>
      {%- endfor -%}
      {%- if section.settings.fan_note != blank -%}
        <div class="pf-fan-note">{{ section.settings.fan_note }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.pf-hero { background: var(--ink); color: #fff; position: relative; overflow: hidden; }
.pf-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0 1px, transparent 1px 7px),
    repeating-linear-gradient(90deg, rgba(255,255,255,.035) 0 1px, transparent 1px 7px);
}
.pf-hero-inner {
  max-width: 1240px;
  margin: 0 auto;
  padding: 84px 24px 92px;
  display: grid;
  grid-template-columns: 1.15fr .85fr;
  gap: 60px;
  position: relative;
}
.pf-crop { position: absolute; width: 22px; height: 22px; border-color: rgba(255,255,255,.4); border-style: solid; }
.pf-crop.tl { top: 34px; left: 24px; border-width: 1.5px 0 0 1.5px; }
.pf-crop.br { bottom: 34px; right: 24px; border-width: 0 1.5px 1.5px 0; }
.pf-hero .eyebrow { color: #9AA4C2; }
.pf-hero h1 {
  font-size: clamp(38px, 5.2vw, 64px);
  font-weight: 900;
  line-height: 1.02;
  letter-spacing: -.025em;
  color: #fff;
  margin-bottom: 20px;
}
.pf-hero h1 em { font-style: normal; color: var(--yellow); }
.pf-hero .lede { font-size: 17px; line-height: 1.65; color: #C3CADD; max-width: 520px; margin-bottom: 30px; }
.pf-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 34px; }
.pf-ghost-light { color: #fff; border-color: #4A5B8C; }
.pf-hero-stats { display: flex; gap: 34px; border-top: 1px solid var(--line-dark); padding-top: 22px; flex-wrap: wrap; }
.pf-hero-stats div b { display: block; font-family: 'IBM Plex Mono', monospace; font-size: 20px; font-weight: 600; color: #fff; }
.pf-hero-stats div span { font-size: 12px; color: #8E97B5; letter-spacing: .04em; }
.pf-swatch-fan { position: relative; align-self: center; height: 390px; }
.pf-fan-card {
  position: absolute;
  width: 230px;
  height: 300px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,.18);
  box-shadow: 0 24px 60px rgba(0,0,0,.45);
  overflow: hidden;
}
.pf-fan-card::after { content: ""; position: absolute; inset: 6px; border: 1.5px dashed rgba(20,28,51,.30); border-radius: 8px; }
.pf-fan-tag {
  position: absolute;
  left: 14px;
  bottom: 14px;
  background: rgba(20,28,51,.88);
  color: #fff;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10.5px;
  padding: 5px 9px;
  border-radius: 5px;
  z-index: 2;
}
.pf-fan-card:nth-child(1) { left: 2%; top: 44px; transform: rotate(-8deg); }
.pf-fan-card:nth-child(2) { left: 30%; top: 12px; transform: rotate(-1deg); z-index: 2; }
.pf-fan-card:nth-child(3) { left: 56%; top: 40px; transform: rotate(7deg); }
.pf-fan-note { position: absolute; bottom: 0; left: 30%; font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #8E97B5; letter-spacing: .08em; }
@media (max-width: 1000px) {
  .pf-hero-inner { grid-template-columns: 1fr; padding: 60px 24px; }
  .pf-swatch-fan { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "PF Hero",
  "tag": "section",
  "class": "pf-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "50 FABRICS · PRINTED TO ORDER" },
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "Any fabric." },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2", "default": "Any size." },
    { "type": "text", "id": "heading_line_3", "label": "Heading line 3 (accent / yellow)", "default": "Any shape." },
    { "type": "textarea", "id": "lede", "label": "Lede paragraph", "default": "Choose from 45 print-ready fabrics — polyester, mesh, blockout, canvas, stretch and more. Enter your exact dimensions, upload your artwork, and we print, finish and ship it worldwide." },
    { "type": "header", "content": "Call to action buttons" },
    { "type": "text", "id": "cta_primary_label", "label": "Primary button label", "default": "Browse 50 fabrics" },
    { "type": "url", "id": "cta_primary_link", "label": "Primary button link" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary button label", "default": "Shop by application" },
    { "type": "url", "id": "cta_secondary_link", "label": "Secondary button link" },
    { "type": "header", "content": "Swatch fan" },
    { "type": "text", "id": "fan_note", "label": "Fan note", "default": "// swatch 12 of 50" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "45" },
        { "type": "text", "id": "label", "label": "Label", "default": "fabric types" }
      ]
    },
    {
      "type": "fan_card",
      "name": "Fan card",
      "settings": [
        {
          "type": "select",
          "id": "texture",
          "label": "Fabric texture",
          "default": "tex-mesh",
          "options": [
            { "value": "tex-weave", "label": "Weave" },
            { "value": "tex-mesh", "label": "Mesh" },
            { "value": "tex-mesh-heavy", "label": "Mesh heavy" },
            { "value": "tex-satin", "label": "Satin" },
            { "value": "tex-canvas", "label": "Canvas" },
            { "value": "tex-blockout", "label": "Blockout" },
            { "value": "tex-stretch", "label": "Stretch" },
            { "value": "tex-backlit", "label": "Backlit" },
            { "value": "tex-flag", "label": "Flag" }
          ]
        },
        { "type": "text", "id": "tag", "label": "Tag", "default": "AIRMESH · 270 GSM" },
        { "type": "url", "id": "image", "label": "Photo (optional)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "PF Hero",
      "blocks": [
        { "type": "stat", "settings": { "value": "45", "label": "fabric types" } },
        { "type": "stat", "settings": { "value": "0.1 m²", "label": "minimum order" } },
        { "type": "stat", "settings": { "value": "3–6 d", "label": "global delivery" } },
        { "type": "stat", "settings": { "value": "Free", "label": "design help" } },
        { "type": "fan_card", "settings": { "texture": "tex-mesh", "tag": "AIRMESH · 270 GSM" } },
        { "type": "fan_card", "settings": { "texture": "tex-weave", "tag": "POLYESTER · 260 GSM" } },
        { "type": "fan_card", "settings": { "texture": "tex-satin", "tag": "SATIN · 120 GSM" } }
      ]
    }
  ]
}
{% endschema %}
