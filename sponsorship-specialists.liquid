    function clearMsgs(){
      [msgEmail, msgPhone].forEach(function(m){ if(m){ m.textContent=''; m.className='field-msg err'; } });
      if(chkEmail) chkEmail.classList.remove('show');
      modal.querySelectorAll('input.err').forEach(function(i){ i.classList.remove('err'); });
      var w=modal.querySelector('.bds-tel'); if(w) w.classList.remove('err');
    }

    function openModal(r){
      role = (r==='organiser') ? 'organiser' : 'sponsor';
      var c = COPY[role];
      if(elEyebrow) elEyebrow.textContent = c.eyebrow;
      if(elTitle)   elTitle.textContent   = c.title;
      if(elSub)     elSub.textContent     = c.sub;
      if(elCompany) elCompany.textContent = c.company + ' *';
      if(elRoleLbl) elRoleLbl.textContent = c.fieldLabel + ' *';
      if(elFileLbl) elFileLbl.textContent = c.file;
      /* Reset every field so reopening the form never shows the previous lead's data. */
      if(content){ content.querySelectorAll('input, select, textarea').forEach(function(el){ if(el.type!=='button' && el.type!=='submit'){ el.value=''; el.classList.remove('err'); } }); }
      if(emailEl) emailEl.dataset.mx='';
      /* Sponsor → Industry dropdown; Organiser → free-text Event name. */
      var roleWrap = roleSel && roleSel.closest('.bds-isel');
      if(role==='sponsor'){
        if(roleSel){ roleSel.value=''; if(roleSel._bdsReset) roleSel._bdsReset(); }
        if(roleWrap) roleWrap.style.display='';
        roleEl.style.display='none'; roleEl.placeholder='Please specify your industry';
      } else {
        if(roleSel){ roleSel.value=''; }
        if(roleWrap) roleWrap.style.display='none';
        roleEl.style.display=''; roleEl.placeholder=c.fieldPh;
      }
      clearMsgs();
      if(content) content.style.display='';
      if(success) success.style.display='none';
      var sb = modal.querySelector('[data-submit-lead]'); if(sb){ sb.disabled=false; sb.textContent=SUBMIT_LABEL; }
      modal.classList.add('open'); modal.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden';
      /* Force the visible state inline so NO theme CSS (e.g. its own .modal rule) can hide it */
      modal.style.setProperty('display','flex','important');
      modal.style.setProperty('visibility','visible','important');
      modal.style.setProperty('opacity','1','important');
      try { Forms.preload(phoneEl); } catch(ePre){} // lazy-load validators + detect country flag by IP
    }
    function closeModal(){ modal.classList.remove('open'); modal.setAttribute('aria-hidden','true'); document.body.style.overflow=''; modal.style.setProperty('display','none','important'); }

    SECT.addEventListener('click', function(e){
      var t = e.target.closest('[data-open-modal]');
      if(t){ e.preventDefault(); openModal(t.getAttribute('data-role')); }
    });
    modal.addEventListener('click', function(e){ if(e.target===modal || e.target.closest('[data-close-modal]')) closeModal(); });
    document.addEventListener('keydown', function(e){ if(e.key==='Escape' && modal.classList.contains('open')) closeModal(); });

    var submitBtn = modal.querySelector('[data-submit-lead]');
    function req(el){ var v=(el.value||'').trim(); if(!v){ el.classList.add('err'); return false; } el.classList.remove('err'); return true; }
    submitBtn && submitBtn.addEventListener('click', function(){
      var nameEl   = modal.querySelector('[data-f="name"]'),
          companyEl= modal.querySelector('[data-f="company"]'),
          fileEl   = modal.querySelector('[data-f="file"]');
      var f = fileEl && fileEl.files && fileEl.files[0];

      // All validation is instant (no network) so submit never stalls.
      var ok = true;
      if(!req(nameEl)) ok=false;
      if(!req(companyEl)) ok=false;
      // Role-specific field: sponsor = Industry dropdown, organiser = Event name text.
      var roleVal = '';
      if(role==='sponsor'){
        var roleWrap = roleSel.closest('.bds-isel');
        if(!roleSel.value){ if(roleWrap) roleWrap.classList.add('err'); ok=false; }
        else { if(roleWrap) roleWrap.classList.remove('err');
          if(roleSel.value==='__other__'){ if(!req(roleEl)) ok=false; else roleVal=roleEl.value.trim(); }
          else { roleVal=roleSel.value; }
        }
      } else {
        if(!req(roleEl)) ok=false; else roleVal=roleEl.value.trim();
      }
      var emOk = Forms.checkEmailSync(emailEl, msgEmail);
      if(emOk && emailEl.dataset.mx==='bad'){ emailEl.classList.add('err'); msgEmail.textContent="That email domain can't receive mail — please check it"; msgEmail.className='field-msg err show'; emOk=false; }
      if(!emOk) ok=false;
      if(!Forms.checkPhone(phoneEl, msgPhone)) ok=false;
      if(f && f.size > MAX_FILE){ fileEl.classList.add('err'); alert('That file is larger than 10 MB. Please attach a smaller file or send it later.'); ok=false; } else if(fileEl) fileEl.classList.remove('err');
      if(!ok) return;

      submitBtn.disabled = true;

      function showSuccess(){ if(content) content.style.display='none'; if(success) success.style.display='block'; }
      /* Email already MX-verified on blur → go straight to sending (instant).
         Not yet verified (e.g. autofill + immediate submit) → verify the domain now,
         then send. Block only if the domain genuinely can't receive mail. */
      if(emailEl.dataset.mx==='ok'){ submitBtn.textContent='Sending…'; proceed(); }
      else {
        submitBtn.textContent='Verifying…';
        Forms.checkEmail(emailEl, msgEmail, chkEmail).then(function(okk){
          emailEl.dataset.mx = okk ? 'ok' : 'bad';
          if(!okk){ submitBtn.disabled=false; submitBtn.textContent=SUBMIT_LABEL; return; }
          submitBtn.textContent='Sending…'; proceed();
        });
      }

      function proceed(){
      var c = COPY[role];
      var endpoint = modal.getAttribute('data-endpoint');
      function send(fileData){
        if(!endpoint){ showSuccess(); return; }
        var data = {
          form: c.form, role: role,
          name: nameEl.value.trim(), company: companyEl.value.trim(),
          email: emailEl.value.trim(),
          phone: Forms.getPhone(phoneEl), phone_country: Forms.getCountry(phoneEl),
          source: 'sponsorship-specialists', page: location.href
        };
        data[c.fieldKey] = roleVal;
        try { console.log('[bds] submitting lead →', endpoint, JSON.parse(JSON.stringify(data))); } catch(e){}
        if(fileData){
          /* File present → POST JSON (Apps Script reads e.postData.contents). */
          data.file_base64 = fileData.b64; data.file_name = fileData.name; data.file_type = fileData.type;
          fetch(endpoint, {method:'POST', mode:'no-cors', body: JSON.stringify(data)}).then(showSuccess).catch(showSuccess);
        } else {
          /* No file → GET query string. This ALWAYS lands in e.parameter — the most
             reliable Apps Script channel (no content-type/postData ambiguity). */
          var qs = Object.keys(data).map(function(k){ return encodeURIComponent(k)+'='+encodeURIComponent(data[k]==null?'':data[k]); }).join('&');
          fetch(endpoint+'?'+qs, {method:'GET', mode:'no-cors'}).then(showSuccess).catch(showSuccess);
        }
        // Safety: show success shortly even if the network promise is slow to resolve.
        setTimeout(showSuccess, 1200);
      }

      if(f){
        var rd = new FileReader();
        rd.onload = function(){ var s=(''+rd.result), i=s.indexOf(','); send({b64:(i>-1?s.slice(i+1):s), name:f.name, type:f.type||'application/octet-stream'}); };
        rd.onerror = function(){ send(null); };
        rd.readAsDataURL(f);
      } else { send(null); }
      } /* end proceed() */
    });
  }
})();
</script>

