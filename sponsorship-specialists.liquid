{%- liquid
  assign sp = section.settings
  assign uid = section.id
  assign fb = "https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=1600&q=80,https://images.unsplash.com/photo-1505373877841-8d25f7d46678?w=1600&q=80,https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=1600&q=80,https://images.unsplash.com/photo-1475721027785-f74eccf877e2?w=1600&q=80,https://images.unsplash.com/photo-1519167758481-83f550bb49b3?w=1600&q=80" | split: ","
-%}

<style>
#shopify-section-{{ uid }} .bds-spec{
  --bds-accent: {{ sp.color_accent | default: '#C0395B' }};
  --bds-accent-dark: {{ sp.color_accent_dark | default: '#9e2e4a' }};
  --bds-accent-light: {{ sp.color_accent_light | default: '#e8708a' }};
  --bds-navy: {{ sp.color_navy | default: '#0F2554' }};
  --bds-navy-mid: {{ sp.color_navy_mid | default: '#1A3A7A' }};
  --bds-navy-deep: {{ sp.color_navy_deep | default: '#0D1F3C' }};
  --bds-green: {{ sp.color_green | default: '#5dca8a' }};
  --bds-white:#fff; --bds-off-white:#f8f7f4;
  --bds-g100:#f1efe8; --bds-g200:#e5e3dc;
  --bds-g500:#888780; --bds-g700:#444441; --bds-g900:#2c2c2a;
  --bds-fd:'DM Serif Display', Georgia, serif;
  --bds-fb:'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  --bds-navh: 68px;
}
.bds-spec,.bds-spec *,.bds-spec *::before,.bds-spec *::after{box-sizing:border-box;margin:0;padding:0}
.bds-spec{font-family:var(--bds-fb);color:var(--bds-g900);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:clip;
  /* full-bleed out of the theme's centred container */
  width:auto;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw)}
.bds-spec p{margin:0}
.bds-spec a{text-decoration:none;color:inherit}
.bds-spec button{font-family:inherit;cursor:pointer;border:none;background:none}
.bds-spec img{max-width:100%;display:block}
.bds-spec ul{list-style:none}

/* ── NAV ── */
.bds-spec .nav{position:absolute;top:0;left:0;right:0;z-index:500;display:flex;align-items:center;justify-content:space-between;padding:0 48px;height:var(--bds-navh);background:transparent;transition:background .35s,box-shadow .35s}
.bds-spec .nav.is-fixed{position:fixed;background:rgba(13,31,60,.97);box-shadow:0 1px 0 rgba(255,255,255,.06)}
.bds-spec .nav-logo{display:flex;align-items:center;gap:10px}
.bds-spec .nav-logo-img{height:38px;width:auto;max-width:220px;object-fit:contain}
.bds-spec .nl-box{background:var(--bds-accent);padding:5px 10px;border-radius:5px;display:flex;flex-direction:column;gap:2px}
.bds-spec .nl-box .top{font-size:12px;font-weight:600;color:#fff;letter-spacing:.06em;line-height:1}
.bds-spec .nl-box .bar{width:100%;height:1px;background:rgba(255,255,255,.4)}
.bds-spec .nl-box .bot{font-size:7px;font-weight:500;color:rgba(255,255,255,.7);letter-spacing:.08em;text-transform:uppercase;line-height:1}
.bds-spec .nav-links{display:flex;gap:28px;align-items:center}
.bds-spec .nav-links a{font-size:13px;font-weight:500;color:rgba(255,255,255,.6);transition:color .2s;cursor:pointer}
.bds-spec .nav-links a:hover{color:#fff}
.bds-spec .nav-right{display:flex;gap:10px}
.bds-spec .nav-btn{font-size:13px;font-weight:500;padding:9px 20px;border-radius:8px;transition:background .2s,border-color .2s;white-space:nowrap}
.bds-spec .nav-btn.outline{border:1px solid rgba(255,255,255,.35);color:#fff}
.bds-spec .nav-btn.outline:hover{border-color:rgba(255,255,255,.7)}
.bds-spec .nav-btn.fill{background:var(--bds-accent);color:#fff}
.bds-spec .nav-btn.fill:hover{background:var(--bds-accent-dark)}
.bds-spec .nav-burger{display:none;flex-direction:column;gap:5px;padding:6px}
.bds-spec .nav-burger span{width:22px;height:2px;background:#fff;border-radius:2px;transition:.25s}

/* ── HERO ── */
.bds-spec .hero{position:relative;min-height:100vh;display:flex;align-items:center;overflow:hidden;background:linear-gradient(135deg,var(--bds-navy) 0%,var(--bds-navy-mid) 55%,var(--bds-navy-deep) 100%)}
.bds-spec .hero-slides{position:absolute;inset:0}
.bds-spec .hslide{position:absolute;inset:0;opacity:0;transition:opacity 1.4s ease;background-size:cover;background-position:center}
.bds-spec .hslide.on{opacity:1}
.bds-spec .hslide::after{content:'';position:absolute;inset:0;background:linear-gradient(100deg,rgba(13,31,60,.94) 0%,rgba(15,37,84,.7) 52%,rgba(13,31,60,.3) 100%)}
/* Decorative slide caption — sits low in the hero, in the empty band created by the
   hero-body's bottom padding, so it never overlaps the stats on any screen size. */
.bds-spec .hcap{position:absolute;bottom:20px;right:32px;z-index:10;text-align:right;opacity:0;transition:opacity .5s .6s;pointer-events:none;max-width:46%}
.bds-spec .hcap.show{opacity:1}
.bds-spec .hcap-pill{display:inline-block;background:var(--bds-accent);color:#fff;font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:4px 11px;border-radius:10px;margin-bottom:6px}
.bds-spec .hcap-name{display:block;font-family:var(--bds-fd);font-size:16px;color:#fff}
.bds-spec .hcap-loc{display:block;font-size:11px;color:rgba(255,255,255,.42);margin-top:2px}
.bds-spec .hero-body{position:relative;z-index:10;padding:90px 48px 40px;max-width:860px;width:100%}
.bds-spec .hero-flag{display:inline-flex;align-items:center;gap:8px;background:rgba(192,57,91,.15);border:1px solid rgba(192,57,91,.35);padding:6px 14px;border-radius:20px;margin-bottom:26px}
.bds-spec .hero-flag span{font-size:12px;color:var(--bds-accent-light);font-weight:500;letter-spacing:.03em}
.bds-spec .pulse{width:7px;height:7px;background:var(--bds-accent);border-radius:50%;animation:bdsPulse 1.8s ease-in-out infinite;flex-shrink:0}
@keyframes bdsPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.4)}}
.bds-spec .hero h1{font-family:var(--bds-fd);font-size:clamp(40px,6.5vw,82px);font-weight:400;color:#fff;line-height:1.05;margin-bottom:16px}
.bds-spec .hero h1 em{color:var(--bds-accent-light);font-style:italic}
.bds-spec .hero-rule{width:48px;height:3px;background:var(--bds-accent);border-radius:2px;margin:18px 0}
.bds-spec .hero-sub{font-size:17px;color:rgba(255,255,255,.65);line-height:1.75;max-width:520px;margin-bottom:34px}
.bds-spec .hero-sub strong{color:#fff;font-weight:600}
.bds-spec .hero-paths{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:44px}
.bds-spec .path-btn{display:inline-flex;align-items:center;gap:8px;padding:13px 26px;border-radius:8px;font-size:14px;font-weight:500;transition:transform .15s,background .2s,border-color .2s;cursor:pointer}
.bds-spec .path-btn:hover{transform:translateY(-2px)}
.bds-spec .path-btn.sponsor{background:var(--bds-accent);color:#fff}
.bds-spec .path-btn.sponsor:hover{background:var(--bds-accent-dark)}
.bds-spec .path-btn.organiser{background:transparent;border:1px solid rgba(255,255,255,.35);color:#fff}
.bds-spec .path-btn.organiser:hover{border-color:rgba(255,255,255,.7)}
.bds-spec .hero-stats{display:grid;grid-template-columns:repeat(var(--statn,4),1fr);border:1px solid rgba(255,255,255,.1);border-radius:16px;overflow:hidden;background:rgba(255,255,255,.04);width:fit-content;max-width:100%}
.bds-spec .hst{padding:14px 22px;text-align:center;border-right:1px solid rgba(255,255,255,.07)}
.bds-spec .hst:last-child{border-right:none}
.bds-spec .hst-n{font-size:22px;font-weight:600;color:#fff;display:block;line-height:1}
.bds-spec .hst-n span{color:var(--bds-accent-light)}
.bds-spec .hst-l{font-size:11px;color:rgba(255,255,255,.38);display:block;margin-top:3px}
.bds-spec .hdots{position:absolute;bottom:36px;left:52px;z-index:10;display:flex;gap:8px}
.bds-spec .hdot{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.25);cursor:pointer;transition:background .3s,width .3s}
.bds-spec .hdot.on{background:var(--bds-accent);width:22px;border-radius:4px}
.bds-spec .hprog{position:absolute;bottom:0;left:0;right:0;height:3px;background:rgba(255,255,255,.06);z-index:10}
.bds-spec .hprog-fill{height:100%;background:var(--bds-accent);width:0}

/* ── TICKER ── */
.bds-spec .ticker{background:var(--bds-navy-deep);border-top:2px solid var(--bds-accent);overflow:hidden;white-space:nowrap}
.bds-spec .tick-track{display:inline-flex;align-items:center;animation:bdsTick 44s linear infinite;height:46px}
.bds-spec .tick-track span{display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.45);padding:0 28px;border-right:1px solid rgba(255,255,255,.07);height:46px}
.bds-spec .tick-track span b{color:rgba(255,255,255,.8)}
@keyframes bdsTick{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

/* ── SECTIONS shared ── */
.bds-spec .section{padding:80px 48px}
.bds-spec .container{max-width:1140px;margin:0 auto}
.bds-spec .s-label{font-size:11px;font-weight:600;color:var(--bds-accent);text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px;display:flex;align-items:center;gap:8px}
.bds-spec .s-label::before{content:'';width:22px;height:2px;background:var(--bds-accent);border-radius:2px;flex-shrink:0}
.bds-spec .s-title{font-family:var(--bds-fd);font-size:clamp(26px,3.2vw,40px);font-weight:400;color:var(--bds-g900);line-height:1.15;margin-bottom:12px}
.bds-spec .s-title.light{color:#fff}
.bds-spec .s-title em{color:var(--bds-accent-light);font-style:italic}
.bds-spec .s-sub{font-size:15px;color:var(--bds-g500);max-width:560px;line-height:1.7}
.bds-spec .s-sub.light{color:rgba(255,255,255,.55)}

/* ── ABOUT ── */
.bds-spec .about{background:var(--bds-off-white)}
.bds-spec .about-est{background:var(--bds-accent);border-radius:8px;padding:8px 18px;display:inline-flex;align-items:baseline;gap:8px}
.bds-spec .about-est .y{font-family:var(--bds-fd);font-size:26px;color:#fff;line-height:1}
.bds-spec .about-est .t{font-size:10px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.75)}
.bds-spec .about-body p{font-size:15px;color:var(--bds-g700);line-height:1.8;margin-bottom:12px}
.bds-spec .about-body p strong{color:var(--bds-g900);font-weight:600}
.bds-spec .about-checks{display:grid;grid-template-columns:1fr 1fr;gap:10px 32px;margin-top:24px}
.bds-spec .acheck{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--bds-g900);font-weight:500}
.bds-spec .acheck svg{width:20px;height:20px;flex-shrink:0;color:var(--bds-accent)}

/* ── WHY BRANDING ── */
.bds-spec .branding{background:linear-gradient(135deg,var(--bds-navy) 0%,var(--bds-navy-mid) 60%,var(--bds-navy-deep) 100%)}
.bds-spec .branding-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
.bds-spec .brand-quote{font-family:var(--bds-fd);font-size:clamp(16px,2vw,22px);font-style:italic;color:#fff;line-height:1.55;border-left:3px solid var(--bds-accent);padding-left:20px;margin:24px 0}
.bds-spec .brand-stats{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.bds-spec .bsc{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);border-radius:12px;padding:22px 20px;transition:border-color .2s,background .2s}
.bds-spec .bsc:hover{border-color:rgba(192,57,91,.5);background:rgba(192,57,91,.07)}
.bds-spec .bsc-num{font-family:var(--bds-fd);font-size:38px;color:var(--bds-accent-light);line-height:1;display:block;margin-bottom:6px}
.bds-spec .bsc-lbl{font-size:13px;font-weight:500;color:rgba(255,255,255,.7);line-height:1.4}

/* ── EVENTS ── */
.bds-spec .events{background:var(--bds-white)}
.bds-spec .ev-logos{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid rgba(0,0,0,.08);border-radius:14px;overflow:hidden;background:var(--bds-white)}
.bds-spec .ev-logo{padding:32px 24px;display:flex;align-items:center;justify-content:center;border-right:1px solid rgba(0,0,0,.08);border-bottom:1px solid rgba(0,0,0,.08)}
.bds-spec .ev-logo img{max-height:40px;max-width:130px;object-fit:contain;filter:grayscale(1);opacity:.45;transition:filter .25s,opacity .25s}
.bds-spec .ev-logo:hover img{filter:grayscale(0);opacity:1}

/* ── WHO WE HELP ── */
.bds-spec .paths{background:var(--bds-g100)}
.bds-spec .paths-head{text-align:center;margin-bottom:44px}
.bds-spec .paths-head .s-label{justify-content:center}
.bds-spec .paths-head .s-title,.bds-spec .paths-head .s-sub{margin-left:auto;margin-right:auto;text-align:center}
.bds-spec .paths-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;max-width:1140px;margin:0 auto}
.bds-spec .path-col{border-radius:16px;overflow:hidden;border:1px solid rgba(0,0,0,.08);display:flex;flex-direction:column}
.bds-spec .path-col.dark{background:var(--bds-navy);border-color:transparent}
.bds-spec .path-col.lite{background:var(--bds-white)}
.bds-spec .path-header{padding:32px 36px 22px}
.bds-spec .path-tag{display:inline-block;font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:4px 12px;border-radius:20px;margin-bottom:14px}
.bds-spec .path-col.dark .path-tag{background:rgba(192,57,91,.2);color:var(--bds-accent-light)}
.bds-spec .path-col.lite .path-tag{background:rgba(15,37,84,.08);color:var(--bds-navy)}
.bds-spec .path-header h3{font-family:var(--bds-fd);font-size:24px;font-weight:400;line-height:1.2;margin-bottom:8px}
.bds-spec .path-col.dark h3{color:#fff}
.bds-spec .path-col.lite h3{color:var(--bds-g900)}
.bds-spec .path-sub{font-size:13px;line-height:1.7}
.bds-spec .path-col.dark .path-sub{color:rgba(255,255,255,.5)}
.bds-spec .path-col.lite .path-sub{color:var(--bds-g500)}
.bds-spec .path-body{padding:0 36px 32px;display:flex;flex-direction:column;flex:1}
.bds-spec .path-list{display:flex;flex-direction:column;gap:10px;margin-bottom:26px}
.bds-spec .path-list li{display:flex;align-items:flex-start;gap:10px;font-size:13px;line-height:1.5}
.bds-spec .path-col.dark .path-list li{color:rgba(255,255,255,.7)}
.bds-spec .path-col.lite .path-list li{color:var(--bds-g700)}
.bds-spec .path-list svg{width:14px;height:14px;flex-shrink:0;margin-top:2px;color:var(--bds-accent)}
.bds-spec .path-cta{display:inline-block;padding:12px 24px;border-radius:8px;font-size:13px;font-weight:500;transition:background .2s,transform .15s;margin-top:auto;align-self:flex-start;cursor:pointer}
.bds-spec .path-cta:hover{transform:translateY(-2px)}
.bds-spec .path-col.dark .path-cta{background:var(--bds-accent);color:#fff}
.bds-spec .path-col.dark .path-cta:hover{background:var(--bds-accent-dark)}
.bds-spec .path-col.lite .path-cta{background:var(--bds-navy);color:#fff}
.bds-spec .path-col.lite .path-cta:hover{background:var(--bds-navy-mid)}
/* Both "Who We Help" cards are WHITE by default and turn NAVY/BLUE on hover. */
.bds-spec .path-col.dark,.bds-spec .path-col.lite{background:var(--bds-white);border-color:rgba(0,0,0,.08);transition:background .35s,transform .35s,box-shadow .35s,border-color .35s}
.bds-spec .path-col.dark .path-tag,.bds-spec .path-col.lite .path-tag{background:rgba(15,37,84,.08);color:var(--bds-navy)}
.bds-spec .path-col.dark h3,.bds-spec .path-col.lite h3{color:var(--bds-g900)}
.bds-spec .path-col.dark .path-sub,.bds-spec .path-col.lite .path-sub{color:var(--bds-g500)}
.bds-spec .path-col.dark .path-list li,.bds-spec .path-col.lite .path-list li{color:var(--bds-g700)}
.bds-spec .path-col.dark .path-cta,.bds-spec .path-col.lite .path-cta{background:var(--bds-navy);color:#fff}
.bds-spec .path-col:hover{background:var(--bds-navy);border-color:transparent;transform:translateY(-6px);box-shadow:0 24px 60px rgba(13,31,60,.32)}
.bds-spec .path-col:hover .path-tag{background:rgba(192,57,91,.22);color:var(--bds-accent-light)}
.bds-spec .path-col:hover h3{color:#fff}
.bds-spec .path-col:hover .path-sub{color:rgba(255,255,255,.55)}
.bds-spec .path-col:hover .path-list li{color:rgba(255,255,255,.72)}
.bds-spec .path-col:hover .path-cta{background:var(--bds-accent);color:#fff}
.bds-spec .path-col:hover .path-cta:hover{background:var(--bds-accent-dark)}

/* ── TESTIMONIALS ── */
.bds-spec .testi{background:linear-gradient(135deg,var(--bds-navy) 0%,var(--bds-navy-mid) 60%,var(--bds-navy-deep) 100%)}
.bds-spec .testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:44px}
.bds-spec .tcard{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:24px;transition:border-color .2s}
.bds-spec .tcard:hover{border-color:rgba(192,57,91,.4)}
.bds-spec .tcard-stars{color:var(--bds-accent-light);font-size:13px;letter-spacing:2px;margin-bottom:10px}
.bds-spec .tcard-text{font-size:13px;color:rgba(255,255,255,.6);font-style:italic;line-height:1.75;margin-bottom:18px}
.bds-spec .tcard-author{display:flex;align-items:center;gap:10px}
.bds-spec .tca{width:36px;height:36px;border-radius:50%;background:var(--bds-accent);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;color:#fff;flex-shrink:0}
.bds-spec .tca-name{font-size:13px;font-weight:600;color:#fff}
.bds-spec .tca-role{font-size:11px;color:rgba(255,255,255,.35)}

/* ── FINAL CTA ── */
.bds-spec .final{background:var(--bds-navy-deep);padding:80px 48px;text-align:center;border-top:1px solid rgba(255,255,255,.06)}
.bds-spec .final h2{font-family:var(--bds-fd);font-size:clamp(28px,4vw,52px);font-weight:400;color:#fff;line-height:1.1;margin-bottom:12px}
.bds-spec .final h2 em{color:var(--bds-accent-light);font-style:italic}
.bds-spec .final p{font-size:16px;color:rgba(255,255,255,.5);max-width:480px;margin:0 auto 36px;line-height:1.7}
.bds-spec .final-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.bds-spec .final-btn{display:inline-flex;align-items:center;gap:8px;padding:15px 32px;border-radius:8px;font-size:15px;font-weight:500;transition:background .2s,transform .15s;cursor:pointer}
.bds-spec .final-btn:hover{transform:translateY(-2px)}
.bds-spec .final-btn.red{background:var(--bds-accent);color:#fff}
.bds-spec .final-btn.red:hover{background:var(--bds-accent-dark)}
.bds-spec .final-btn.ghost{background:transparent;border:1px solid rgba(255,255,255,.3);color:#fff}
.bds-spec .final-btn.ghost:hover{border-color:rgba(255,255,255,.65)}
.bds-spec .final-contact{font-size:12px;color:rgba(255,255,255,.22);margin-top:26px}

/* ── FOOTER ── */
.bds-spec .foot{background:var(--bds-navy-deep);padding:56px 48px 24px;border-top:1px solid rgba(255,255,255,.06)}
.bds-spec .foot-top{max-width:1140px;margin:0 auto 44px;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px}
.bds-spec .foot-brand p{font-size:13px;color:rgba(255,255,255,.35);line-height:1.7;max-width:260px;margin-top:14px}
.bds-spec .foot-addr{font-size:12px;color:rgba(255,255,255,.2);margin-top:14px;line-height:1.7}
.bds-spec .foot-ct{font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--bds-accent-light);margin-bottom:14px}
.bds-spec .foot-links{display:flex;flex-direction:column;gap:9px}
.bds-spec .foot-links a{font-size:13px;color:rgba(255,255,255,.35);transition:color .2s}
.bds-spec .foot-links a:hover{color:#fff}
.bds-spec .foot-bot{max-width:1140px;margin:0 auto;border-top:1px solid rgba(255,255,255,.06);padding-top:20px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px}
.bds-spec .foot-bot p{font-size:11px;color:rgba(255,255,255,.2)}

/* ── LEAD MODAL ── */
.bds-spec .bds-modalwrap{position:fixed;inset:0;z-index:2147483000;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(8,16,33,.72);backdrop-filter:blur(3px)}
.bds-spec .bds-modalwrap.open{display:flex}
.bds-spec .modal-box{background:#fff;border-radius:16px;width:100%;max-width:440px;padding:30px 28px;position:relative;max-height:92vh;overflow:auto;box-shadow:0 30px 80px rgba(0,0,0,.4)}
.bds-spec .modal-close{position:absolute;top:14px;right:16px;font-size:26px;line-height:1;color:var(--bds-g500);background:none}
.bds-spec .modal-eyebrow{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:var(--bds-accent);margin-bottom:8px}
.bds-spec .modal-title{font-family:var(--bds-fd);font-size:24px;color:var(--bds-g900);line-height:1.2;margin-bottom:6px}
.bds-spec .modal-sub{font-size:13px;color:var(--bds-g500);margin-bottom:18px;line-height:1.6}
.bds-spec .field{margin-bottom:14px}
.bds-spec .field label{display:block;font-size:12px;font-weight:600;color:var(--bds-g700);margin-bottom:6px}
.bds-spec .field input,.bds-spec .field textarea{width:100%;border:1px solid var(--bds-g200);border-radius:8px;padding:11px 13px;font-size:14px;font-family:inherit;color:var(--bds-g900);background:#fff;transition:border-color .2s}
.bds-spec .field input:not([type=file]){height:46px}
.bds-spec .field select{width:100%;height:46px;border:1px solid var(--bds-g200);border-radius:8px;padding:0 13px;font-size:14px;font-family:inherit;color:var(--bds-g900);background:#fff;cursor:pointer;transition:border-color .2s}
.bds-spec .field select:focus{outline:none;border-color:var(--bds-accent)}
/* custom industry dropdown (replaces native select so the long option list can never run off-screen) */
.bds-spec .bds-isel{position:relative}
.bds-spec .bds-isel-btn{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;height:46px;border:1px solid var(--bds-g200);border-radius:8px;padding:0 13px;font-size:14px;font-family:inherit;color:var(--bds-g900);background:#fff;cursor:pointer;text-align:left;transition:border-color .2s}
.bds-spec .bds-isel-btn .lbl{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bds-spec .bds-isel-btn .lbl.ph{color:var(--bds-g500)}
.bds-spec .bds-isel-btn .ar{font-size:10px;opacity:.5;flex-shrink:0}
.bds-spec .bds-isel.open .bds-isel-btn{border-color:var(--bds-accent)}
.bds-spec .bds-isel.err .bds-isel-btn{border-color:#e03b3b;background:#fff6f6}
.bds-spec .bds-isel-list{position:absolute;top:calc(100% + 4px);left:0;right:0;max-height:230px;overflow:auto;background:#fff;border:1px solid var(--bds-g200);border-radius:10px;box-shadow:0 16px 44px rgba(0,0,0,.22);z-index:40;display:none;padding:6px}
.bds-spec .bds-isel.open .bds-isel-list{display:block}
.bds-spec .bds-isel-opt{padding:10px 11px;border-radius:6px;cursor:pointer;font-size:13px;color:var(--bds-g900);line-height:1.3}
.bds-spec .bds-isel-opt:hover{background:var(--bds-g100)}
.bds-spec .bds-isel-opt.sel{background:rgba(192,57,91,.1);color:var(--bds-accent-dark);font-weight:600}
.bds-spec .field input:focus,.bds-spec .field textarea:focus{outline:none;border-color:var(--bds-accent)}
.bds-spec .field input.err,.bds-spec .field textarea.err,.bds-spec .field select.err{border-color:#e03b3b;background:#fff6f6}
.bds-spec .field input[type=file]{padding:9px 11px;font-size:13px;background:var(--bds-off-white);cursor:pointer}
.bds-spec .field input[type=file]::file-selector-button{font-family:inherit;font-size:12px;font-weight:600;border:none;background:var(--bds-navy);color:#fff;padding:7px 12px;border-radius:6px;margin-right:10px;cursor:pointer}
.bds-spec .modal-filehint{font-size:11px;color:var(--bds-g500);margin-top:5px}
/* field validation messages */
.bds-spec .field-msg{font-size:11px;margin-top:5px;display:none}
.bds-spec .field-msg.show{display:block}
.bds-spec .field-msg.err{color:#e03b3b}
.bds-spec .field-msg.ok{color:#1a9e5f}
.bds-spec .field-checking{font-size:11px;color:var(--bds-g500);margin-top:5px;display:none}
.bds-spec .field-checking.show{display:block}
/* international phone input */
.bds-spec .bds-tel{display:flex;align-items:stretch;height:46px;border:1px solid var(--bds-g200);border-radius:8px;background:#fff;position:relative;transition:border-color .2s}
.bds-spec .bds-tel:focus-within{border-color:var(--bds-accent)}
.bds-spec .bds-tel.err{border-color:#e03b3b;background:#fff6f6}
.bds-spec .bds-tel-btn{display:flex;align-items:center;gap:6px;padding:0 11px;background:var(--bds-off-white);border:none;border-right:1px solid var(--bds-g200);border-radius:8px 0 0 8px;white-space:nowrap;cursor:pointer;color:var(--bds-g900);transition:background .2s}
.bds-spec .bds-tel-btn:hover{background:var(--bds-g100)}
.bds-spec .bds-tel-btn .fl{display:flex;align-items:center;line-height:0}
.bds-spec .bds-fl{display:block;width:21px;height:15px;object-fit:cover;border-radius:2px;box-shadow:0 0 0 1px rgba(0,0,0,.08)}
.bds-spec .bds-tel-btn .dc{font-size:14px;font-weight:600;color:var(--bds-g900)}
.bds-spec .bds-tel-btn .ar{font-size:9px;opacity:.45}
.bds-spec .bds-tel input[type=tel]{border:none!important;border-radius:0 8px 8px 0!important;background:transparent!important;flex:1;min-width:0;height:100%;padding:0 13px;font-size:14px;line-height:normal}
.bds-spec .bds-tel input[type=tel]:focus{outline:none;box-shadow:none!important}
.bds-spec .bds-tel-list{position:absolute;top:calc(100% + 4px);left:0;width:300px;max-width:88vw;max-height:260px;overflow:auto;background:#fff;border:1px solid var(--bds-g200);border-radius:10px;box-shadow:0 16px 44px rgba(0,0,0,.2);z-index:30;display:none;padding:6px}
.bds-spec .bds-tel-list.open{display:block}
.bds-spec .bds-tel-search{width:100%;border:1px solid var(--bds-g200);border-radius:6px;padding:8px 10px;font-size:13px;margin-bottom:6px}
.bds-spec .bds-tel-opt{display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:6px;cursor:pointer;font-size:13px;color:var(--bds-g900)}
.bds-spec .bds-tel-opt:hover,.bds-spec .bds-tel-opt.hi{background:var(--bds-g100)}
.bds-spec .bds-tel-opt .nm{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bds-spec .bds-tel-opt .dc{color:var(--bds-g500);font-size:12px}
.bds-spec .modal-submit{width:100%;background:var(--bds-accent);color:#fff;border:none;border-radius:8px;padding:14px;font-size:15px;font-weight:600;margin-top:6px;transition:background .2s}
.bds-spec .modal-submit:hover{background:var(--bds-accent-dark)}
.bds-spec .modal-submit:disabled{opacity:.6;cursor:default}
.bds-spec .modal-note{font-size:11px;color:var(--bds-g500);text-align:center;margin-top:12px;line-height:1.5}
.bds-spec .modal-success{display:none;text-align:center;padding:14px 0}
.bds-spec .modal-success .ic{font-size:42px;margin-bottom:10px}
.bds-spec .modal-success h3{font-family:var(--bds-fd);font-size:24px;color:var(--bds-g900);margin-bottom:8px}
.bds-spec .modal-success p{font-size:14px;color:var(--bds-g500);line-height:1.6}

/* ── RESPONSIVE ── */
@media(max-width:960px){
  .bds-spec .nav{padding:0 20px}
  .bds-spec .nav-links{display:none;position:absolute;top:var(--bds-navh);left:0;right:0;flex-direction:column;gap:0;background:rgba(13,31,60,.98);padding:8px 0}
  .bds-spec .nav.menu-open .nav-links{display:flex}
  .bds-spec .nav.menu-open{background:rgba(13,31,60,.97)}
  .bds-spec .nav-links a{padding:13px 24px;width:100%;border-bottom:1px solid rgba(255,255,255,.06)}
  .bds-spec .nav-burger{display:flex}
  .bds-spec .nav-btn.outline,.bds-spec .nav-btn.fill{display:none}
  /* hero adapts to its content height on mobile so the absolute caption / dots
     never float up into the stats (the overlap) */
  /* hero becomes a vertical stack on mobile; the caption drops into normal flow
     BELOW the stats (flex order) so the two can never overlap */
  .bds-spec .hero{min-height:auto;flex-direction:column;align-items:stretch}
  .bds-spec .hero-body{order:2;padding:104px 22px 16px}
  .bds-spec .hero-stats{grid-template-columns:repeat(2,1fr);width:100%}
  .bds-spec .hcap{order:3;position:static;max-width:none;text-align:left;opacity:1;padding:14px 22px 54px}
  .bds-spec .hcap-name{font-size:14px}
  .bds-spec .hcap-loc{font-size:11px}
  .bds-spec .hdots{left:22px;bottom:22px}
  .bds-spec .section,.bds-spec .final,.bds-spec .foot{padding:60px 22px}
  .bds-spec .branding-grid{grid-template-columns:1fr;gap:36px}
  .bds-spec .paths-grid{grid-template-columns:1fr}
  .bds-spec .brand-stats{grid-template-columns:1fr 1fr}
  .bds-spec .testi-grid{grid-template-columns:1fr}
  .bds-spec .ev-logos{grid-template-columns:repeat(3,1fr)}
  .bds-spec .foot-top{grid-template-columns:1fr 1fr}
}
@media(max-width:560px){
  .bds-spec .about-checks{grid-template-columns:1fr}
  .bds-spec .ev-logos{grid-template-columns:repeat(2,1fr)}
  .bds-spec .hst-n{font-size:19px}
  /* modal fits small screens + 16px inputs stop iOS auto-zoom on focus */
  .bds-spec .modal-box{padding:26px 20px;border-radius:14px}
  .bds-spec .field input,.bds-spec .field textarea,.bds-spec .field select,.bds-spec .bds-tel input[type=tel]{font-size:16px}
  .bds-spec .bds-tel-list{width:100%}
  .bds-spec .bds-tel-btn{padding:0 10px}
}
@media(prefers-reduced-motion:reduce){
  .bds-spec .hslide{transition:none}
  .bds-spec .tick-track{animation:none}
  .bds-spec .pulse{animation:none}
}
</style>

{%- comment -%} ── Inline icons ── {%- endcomment -%}
{%- capture ic_check -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>{%- endcapture -%}
{%- capture ic_pin -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>{%- endcapture -%}

{%- comment -%} ── Hide the theme's own header so it doesn't stack on the in-page nav (the "collapse" fix) ── {%- endcomment -%}
{%- if sp.hide_theme_header -%}
<style>
  /* Hide this theme's header / announcement / nav / USP bars on this page only */
  .shopify-section-group-header-group,.header-section,#shopify-section-header,
  .announcement-bar,.announcement-bar-section,.utility-bar,.section-header,
  .bds-header,.ext-new-header,.bds-nav-bar,.header.section--padding,
  #shopify-section-sticky-atc-bar{display:none!important}
</style>
<script>
  (function(){
    function hide(el){ if(el&&el.style) el.style.setProperty('display','none','important'); }
    function run(){
      var main=document.getElementById('MainContent');
      /* 0) STRUCTURE-AGNOSTIC: walk up from THIS section to <body>; at every level
            hide all siblings that come BEFORE us. That removes the header / announcement
            / USP bars whatever the theme's wrapper layout is, and never needs #MainContent. */
      var wrap=document.querySelector('.section-sponsorship-specialists');
      if(wrap){ var node=wrap; while(node && node!==document.body){ var s=node.previousElementSibling; while(s){ if(s.tagName!=='SCRIPT'&&s.tagName!=='STYLE') hide(s); s=s.previousElementSibling; } node=node.parentElement; } }
      /* 1) hide every sibling rendered before #MainContent (themes that use it) */
      if(main){ var el=main.previousElementSibling; while(el){ if(el.tagName!=='SCRIPT'&&el.tagName!=='STYLE') hide(el); el=el.previousElementSibling; } }
      /* 2) hide any <header> landmark outside this page's content */
      var hs=document.getElementsByTagName('header'); for(var i=0;i<hs.length;i++){ if(!main||!main.contains(hs[i])) hide(hs[i]); }
      /* 3) hide known header / announcement wrappers by class (covers themes without the group wrapper) */
      var sel=document.querySelectorAll('.shopify-section-group-header-group,.header-section,#shopify-section-header,.announcement-bar,.announcement-bar-section,.utility-bar,.section-header,.bds-header,.ext-new-header,.bds-nav-bar,.header.section--padding,#shopify-section-sticky-atc-bar');
      for(var j=0;j<sel.length;j++) hide(sel[j]);
      /* 4) hide any leftover full-width bar pinned at the very top (sticky announcement apps) */
      var spec=document.querySelector('.section-sponsorship-specialists'); var all=document.body.getElementsByTagName('*');
      for(var k=0;k<all.length;k++){ var e=all[k]; if(!e||(spec&&(spec===e||spec.contains(e)))||(main&&main.contains(e))) continue;
        var cs=getComputedStyle(e); if((cs.position==='fixed'||cs.position==='sticky')){ var r=e.getBoundingClientRect(); if(r.top<=1&&r.width>=window.innerWidth*0.7&&r.height<window.innerHeight*0.5) hide(e); } }
    }
    if(document.readyState!=='loading'){ run(); } else { document.addEventListener('DOMContentLoaded',run); }
    [120,400,1000].forEach(function(d){ setTimeout(run,d); });
    document.addEventListener('shopify:section:load',run);
  })();
</script>
{%- endif -%}

<div class="bds-spec" id="bds-spec-{{ uid }}" data-autorotate="{{ sp.hero_autorotate | default: true }}" data-interval="{{ sp.hero_interval | default: 6 }}">

  {%- comment -%} ══ NAV ══ {%- endcomment -%}
  {%- if sp.show_nav -%}
  <nav class="nav" id="bds-nav-{{ uid }}">
    <a class="nav-logo" href="{{ sp.nav_logo_link | default: '/' }}">
      {%- if sp.nav_logo_image != blank -%}
        <img class="nav-logo-img" src="{{ sp.nav_logo_image | image_url: width: 440 }}" alt="{{ sp.nav_logo_top | default: shop.name | escape }}" width="{{ sp.nav_logo_image.width }}" height="{{ sp.nav_logo_image.height }}" loading="eager">
      {%- else -%}
        <span class="nl-box">
          <span class="top">{{ sp.nav_logo_top | default: 'BACKDROP SOURCE' }}</span>
          <span class="bar"></span>
          <span class="bot">{{ sp.nav_logo_bottom | default: 'Making Brands Desirable Since 2004' }}</span>
        </span>
      {%- endif -%}
    </a>
    {%- if sp.nav_links != blank -%}
    <ul class="nav-links">
      {%- assign links = sp.nav_links | newline_to_br | strip_newlines | split: '<br />' -%}
      {%- for ln in links -%}
        {%- assign parts = ln | split: '|' -%}
        {%- assign label = parts[0] | strip -%}
        {%- assign target = parts[1] | default: '' | strip -%}
        {%- if label != blank -%}
          {%- if target != blank -%}<li><a data-scroll="bds-{{ target }}-{{ uid }}">{{ label }}</a></li>
          {%- else -%}<li><a>{{ label }}</a></li>{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- endif -%}
    <div class="nav-right">
      <button type="button" class="nav-btn outline" data-open-modal data-role="organiser">{{ sp.nav_btn_organiser | default: "I'm an Organiser" }}</button>
      <button type="button" class="nav-btn fill" data-open-modal data-role="sponsor">{{ sp.nav_btn_sponsor | default: 'Become a Sponsor' }}</button>
      <button type="button" class="nav-burger" aria-label="Menu" data-burger><span></span><span></span><span></span></button>
    </div>
  </nav>
  {%- endif -%}

  {%- comment -%} ══ HERO ══ {%- endcomment -%}
  <div class="hero" id="bds-hero-{{ uid }}">
    <div class="hero-slides">
      {%- assign slides = section.blocks | where: 'type', 'slide' -%}
      {%- if slides.size > 0 -%}
        {%- for b in slides -%}
          {%- assign img = b.settings.image -%}
          {%- if img != blank -%}{%- assign url = img | image_url: width: 1600 -%}{%- else -%}{%- assign url = fb[forloop.index0] | default: fb[0] -%}{%- endif -%}
          <div class="hslide{% if forloop.first %} on{% endif %}" style="background-image:url('{{ url }}')" data-cat="{{ b.settings.category | escape }}" data-name="{{ b.settings.title | escape }}" data-loc="{{ b.settings.location | escape }}" {{ b.shopify_attributes }}></div>
        {%- endfor -%}
      {%- else -%}
        {%- assign fcat = "Conference,Trade Expo,Festival,Summit,Gala" | split: "," -%}
        {%- assign fname = "Tech Summit · Stage Backdrop,Pan-Africa Trade Expo · Booth Displays,Afro Vibes Festival · Brand Activation,Women in Business · Press Wall,Leadership Awards · Red Carpet Setup" | split: "," -%}
        {%- assign floc = "Nairobi, Kenya · 3,200 attendees;Kigali, Rwanda · 12,000 attendees;Accra, Ghana · 18,000 attendees;Lagos, Nigeria · 1,800 attendees;Johannesburg, SA · 600 guests" | split: ";" -%}
        {%- for u in fb -%}
          <div class="hslide{% if forloop.first %} on{% endif %}" style="background-image:url('{{ u }}')" data-cat="{{ fcat[forloop.index0] }}" data-name="{{ fname[forloop.index0] }}" data-loc="{{ floc[forloop.index0] }}"></div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="hero-body">
      {%- if sp.hero_flag != blank -%}<div class="hero-flag"><span class="pulse"></span><span>{{ sp.hero_flag }}</span></div>{%- endif -%}
      <h1>{{ sp.hero_title | default: 'Where Brands<br>Meet <em>Events</em>' }}</h1>
      <div class="hero-rule"></div>
      {%- if sp.hero_sub != blank -%}<p class="hero-sub">{{ sp.hero_sub }}</p>{%- endif -%}
      <div class="hero-paths">
        <button type="button" class="path-btn sponsor" data-open-modal data-role="sponsor">{{ sp.hero_btn_sponsor | default: 'Become a Sponsor →' }}</button>
        <button type="button" class="path-btn organiser" data-open-modal data-role="organiser">{{ sp.hero_btn_organiser | default: "I'm an Event Organiser →" }}</button>
      </div>

      {%- assign stats = section.blocks | where: 'type', 'stat' -%}
      <div class="hero-stats" style="--statn:{% if stats.size > 0 %}{{ stats.size }}{% else %}4{% endif %}">
        {%- if stats.size > 0 -%}
          {%- for b in stats -%}
          <div class="hst" {{ b.shopify_attributes }}><span class="hst-n"><span>{{ b.settings.num }}</span></span><span class="hst-l">{{ b.settings.label }}</span></div>
          {%- endfor -%}
        {%- else -%}
          <div class="hst"><span class="hst-n"><span>22+</span></span><span class="hst-l">Years in events</span></div>
          <div class="hst"><span class="hst-n"><span>10</span></span><span class="hst-l">Countries</span></div>
          <div class="hst"><span class="hst-n"><span>100K+</span></span><span class="hst-l">Products delivered</span></div>
          <div class="hst"><span class="hst-n"><span>$6.2M</span></span><span class="hst-l">Sponsorships secured</span></div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} dot nav + progress (filled by JS to match slide count) {%- endcomment -%}
    <div class="hdots" id="bds-hdots-{{ uid }}"></div>
    <div class="hprog"><div class="hprog-fill" id="bds-pf-{{ uid }}"></div></div>
  </div>

  {%- comment -%} ══ TICKER ══ {%- endcomment -%}
  {%- assign ticks = section.blocks | where: 'type', 'ticker' -%}
  {%- if sp.show_ticker -%}
  <div class="ticker"><div class="tick-track" id="bds-tick-{{ uid }}">
    {%- if ticks.size > 0 -%}
      {%- for b in ticks -%}
      <span>{%- if b.settings.bold != blank -%}<b>{{ b.settings.bold }}</b> {%- endif -%}{{ b.settings.text }}</span>
      {%- endfor -%}
    {%- else -%}
      <span><b>22 YEARS</b> IN EVENT BRANDING</span>
      <span><b>10</b> COUNTRIES SERVED</span>
      <span><b>100,000+</b> PRODUCTS DELIVERED</span>
      <span><b>265+</b> TRUSTPILOT REVIEWS</span>
      <span><b>$6.2M</b> SPONSORSHIPS SECURED</span>
    {%- endif -%}
  </div></div>
  {%- endif -%}

  {%- comment -%} ══ ABOUT ══ {%- endcomment -%}
  {%- if sp.show_about -%}
  <section class="section about" id="bds-about-{{ uid }}">
    <div class="container">
      <div style="max-width:800px">
        <div style="display:flex;align-items:center;gap:18px;margin-bottom:18px;flex-wrap:wrap">
          {%- if sp.about_label != blank -%}<div class="s-label" style="margin-bottom:0">{{ sp.about_label }}</div>{%- endif -%}
          {%- if sp.about_est_year != blank -%}<div class="about-est"><span class="y">{{ sp.about_est_year }}</span><span class="t">{{ sp.about_est_note }}</span></div>{%- endif -%}
        </div>
        <h2 class="s-title">{{ sp.about_title | default: 'We Built the Backdrops.<br>Now We Fill the Room.' }}</h2>
        {%- if sp.about_body != blank -%}<div class="about-body" style="margin-top:16px">{{ sp.about_body }}</div>{%- endif -%}
        {%- if sp.about_checks != blank -%}
        <div class="about-checks">
          {%- assign checks = sp.about_checks | newline_to_br | strip_newlines | split: '<br />' -%}
          {%- for c in checks -%}{%- assign cc = c | strip -%}{%- if cc != blank -%}<div class="acheck">{{ ic_check }}{{ cc }}</div>{%- endif -%}{%- endfor -%}
        </div>
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ══ WHY BRANDING ══ {%- endcomment -%}
  {%- if sp.show_branding -%}
  <section class="section branding" id="bds-why-{{ uid }}">
    <div class="container">
      <div class="branding-grid">
        <div>
          {%- if sp.branding_label != blank -%}<div class="s-label" style="color:rgba(255,255,255,.5)">{{ sp.branding_label }}</div>{%- endif -%}
          <h2 class="s-title light">{{ sp.branding_title | default: "Sponsoring an Event Isn't a Cost.<br>It's a Room Full of Your Customers." }}</h2>
          {%- if sp.branding_quote != blank -%}<blockquote class="brand-quote">{{ sp.branding_quote }}</blockquote>{%- endif -%}
          {%- if sp.branding_sub != blank -%}<p class="s-sub light">{{ sp.branding_sub }}</p>{%- endif -%}
        </div>
        {%- assign bstats = section.blocks | where: 'type', 'brand_stat' -%}
        <div class="brand-stats">
          {%- if bstats.size > 0 -%}
            {%- for b in bstats -%}
            <div class="bsc" {{ b.shopify_attributes }}><span class="bsc-num">{{ b.settings.num }}</span><span class="bsc-lbl">{{ b.settings.label }}</span></div>
            {%- endfor -%}
          {%- else -%}
            <div class="bsc"><span class="bsc-num">74%</span><span class="bsc-lbl">of attendees have a more positive opinion of a brand after live sponsorship</span></div>
            <div class="bsc"><span class="bsc-num">5×</span><span class="bsc-lbl">higher brand recall vs. online display advertising</span></div>
            <div class="bsc"><span class="bsc-num">$1.65</span><span class="bsc-lbl">returned for every $1 spent on event sponsorship</span></div>
            <div class="bsc"><span class="bsc-num">94%</span><span class="bsc-lbl">of our sponsor partners renew for subsequent events</span></div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ══ EVENTS ══ {%- endcomment -%}
  {%- assign logos = section.blocks | where: 'type', 'logo' -%}
  {%- if sp.show_events -%}
  <section class="section events" id="bds-events-{{ uid }}">
    <div class="container">
      {%- if sp.events_label != blank -%}<div class="s-label">{{ sp.events_label }}</div>{%- endif -%}
      <h2 class="s-title">{{ sp.events_title | default: "Events We've Powered" }}</h2>
      {%- if sp.events_sub != blank -%}<p class="s-sub" style="margin-bottom:40px">{{ sp.events_sub }}</p>{%- endif -%}
      <div class="ev-logos">
        {%- if logos.size > 0 -%}
          {%- for b in logos -%}
          <div class="ev-logo" {{ b.shopify_attributes }}>
            {%- if b.settings.image != blank -%}
              <img src="{{ b.settings.image | image_url: width: 260 }}" alt="{{ b.settings.name | escape }}" width="130" height="40" loading="lazy">
            {%- else -%}<span style="font-family:var(--bds-fd);color:var(--bds-g500)">{{ b.settings.name }}</span>{%- endif -%}
          </div>
          {%- endfor -%}
        {%- else -%}
          {%- assign deflogos = "FIFA,SXSW,TED,CES,Davos WEF,Comic Con,Coachella,Cannes Lions" | split: "," -%}
          {%- for n in deflogos -%}
          <div class="ev-logo"><span style="font-family:var(--bds-fd);color:var(--bds-g500)">{{ n }}</span></div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ══ WHO WE HELP ══ {%- endcomment -%}
  {%- if sp.show_paths -%}
  <section class="section paths" id="bds-paths-{{ uid }}">
    <div class="paths-head">
      {%- if sp.paths_label != blank -%}<div class="s-label">{{ sp.paths_label }}</div>{%- endif -%}
      <h2 class="s-title">{{ sp.paths_title | default: 'One Firm. Two Ways to Win.' }}</h2>
      {%- if sp.paths_sub != blank -%}<p class="s-sub">{{ sp.paths_sub }}</p>{%- endif -%}
    </div>
    <div class="paths-grid">
      <div class="path-col dark">
        <div class="path-header">
          <div class="path-tag">{{ sp.sponsor_tag | default: 'For Sponsors & Brands' }}</div>
          <h3>{{ sp.sponsor_h | default: 'Put Your Brand in<br>the Right Room' }}</h3>
          {%- if sp.sponsor_sub != blank -%}<p class="path-sub">{{ sp.sponsor_sub }}</p>{%- endif -%}
        </div>
        <div class="path-body">
          {%- if sp.sponsor_points != blank -%}
          <ul class="path-list">
            {%- assign sps = sp.sponsor_points | newline_to_br | strip_newlines | split: '<br />' -%}
            {%- for p in sps -%}{%- assign pp = p | strip -%}{%- if pp != blank -%}<li>{{ ic_check }}<span>{{ pp }}</span></li>{%- endif -%}{%- endfor -%}
          </ul>
          {%- endif -%}
          <button type="button" class="path-cta" data-open-modal data-role="sponsor">{{ sp.sponsor_cta | default: 'Become a Sponsor →' }}</button>
        </div>
      </div>
      <div class="path-col lite">
        <div class="path-header">
          <div class="path-tag">{{ sp.organiser_tag | default: 'For Event Organisers' }}</div>
          <h3>{{ sp.organiser_h | default: 'Fund Your Event.<br>Focus on Delivery.' }}</h3>
          {%- if sp.organiser_sub != blank -%}<p class="path-sub">{{ sp.organiser_sub }}</p>{%- endif -%}
        </div>
        <div class="path-body">
          {%- if sp.organiser_points != blank -%}
          <ul class="path-list">
            {%- assign ops = sp.organiser_points | newline_to_br | strip_newlines | split: '<br />' -%}
            {%- for p in ops -%}{%- assign pp = p | strip -%}{%- if pp != blank -%}<li>{{ ic_check }}<span>{{ pp }}</span></li>{%- endif -%}{%- endfor -%}
          </ul>
          {%- endif -%}
          <button type="button" class="path-cta" data-open-modal data-role="organiser">{{ sp.organiser_cta | default: 'Submit Your Event →' }}</button>
        </div>
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ══ TESTIMONIALS ══ {%- endcomment -%}
  {%- assign testis = section.blocks | where: 'type', 'testimonial' -%}
  {%- if sp.show_testi -%}
  <section class="section testi" id="bds-testi-{{ uid }}">
    <div class="container">
      {%- if sp.testi_label != blank -%}<div class="s-label" style="color:rgba(255,255,255,.45)">{{ sp.testi_label }}</div>{%- endif -%}
      <h2 class="s-title light">{{ sp.testi_title | default: 'Trusted by Organisers<br>and Sponsors Alike' }}</h2>
      <div class="testi-grid">
        {%- if testis.size > 0 -%}
          {%- for b in testis -%}
          {%- assign stars = b.settings.stars | default: 5 -%}
          <div class="tcard" {{ b.shopify_attributes }}>
            <div class="tcard-stars">{% for i in (1..stars) %}★{% endfor %}</div>
            <p class="tcard-text">{{ b.settings.quote }}</p>
            <div class="tcard-author">
              <div class="tca">{{ b.settings.initials }}</div>
              <div><div class="tca-name">{{ b.settings.name }}</div><div class="tca-role">{{ b.settings.role }}</div></div>
            </div>
          </div>
          {%- endfor -%}
        {%- else -%}
          <div class="tcard"><div class="tcard-stars">★★★★★</div><p class="tcard-text">"They understand what event branding looks like from the inside. They didn't just find us a sponsor slot — they designed the activation. Our booth was incredible."</p><div class="tcard-author"><div class="tca">KR</div><div><div class="tca-name">Karthik Rajendhran</div><div class="tca-role">Director, Kovai TechVentures</div></div></div></div>
          <div class="tcard"><div class="tcard-stars">★★★★★</div><p class="tcard-text">"First agency that walked in already knowing how our brand should look on a backdrop. We signed in 48 hours and have renewed twice since."</p><div class="tcard-author"><div class="tca">PS</div><div><div class="tca-name">Priya Subramaniam</div><div class="tca-role">Head of Marketing, SRM Capitals</div></div></div></div>
          <div class="tcard"><div class="tcard-stars">★★★★★</div><p class="tcard-text">"They closed $280K in sponsorships for our forum. One team handled everything — proposals, backdrops, activation. Nothing like it."</p><div class="tcard-author"><div class="tca">AM</div><div><div class="tca-name">Arvind Muthukumar</div><div class="tca-role">Founder, Nilgiris Event Studio</div></div></div></div>
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ══ FINAL CTA ══ {%- endcomment -%}
  {%- if sp.show_final -%}
  <section class="final" id="bds-contact-{{ uid }}">
    <h2>{{ sp.final_title | default: "Let's Put Your Brand<br>in the <em>Right Room.</em>" }}</h2>
    {%- if sp.final_sub != blank -%}<p>{{ sp.final_sub }}</p>{%- endif -%}
    <div class="final-btns">
      <button type="button" class="final-btn red" data-open-modal data-role="sponsor">{{ sp.final_btn_sponsor | default: "I'm a Sponsor →" }}</button>
      <button type="button" class="final-btn ghost" data-open-modal data-role="organiser">{{ sp.final_btn_organiser | default: "I'm an Event Organiser →" }}</button>
    </div>
    {%- if sp.final_contact != blank -%}<p class="final-contact">{{ sp.final_contact }}</p>{%- endif -%}
  </section>
  {%- endif -%}

  {%- comment -%} ══ FOOTER (optional — theme already has one) ══ {%- endcomment -%}
  {%- if sp.show_footer -%}
  <footer class="foot">
    <div class="foot-top">
      <div class="foot-brand">
        {%- if sp.nav_logo_image != blank -%}
          <img class="nav-logo-img" src="{{ sp.nav_logo_image | image_url: width: 440 }}" alt="{{ shop.name | escape }}" width="{{ sp.nav_logo_image.width }}" height="{{ sp.nav_logo_image.height }}" loading="lazy">
        {%- else -%}
          <span class="nl-box" style="display:inline-flex"><span class="top">{{ sp.nav_logo_top | default: 'BACKDROP SOURCE' }}</span><span class="bar"></span><span class="bot">{{ sp.nav_logo_bottom | default: 'Making Brands Desirable Since 2004' }}</span></span>
        {%- endif -%}
        {%- if sp.foot_blurb != blank -%}<p>{{ sp.foot_blurb }}</p>{%- endif -%}
        {%- if sp.foot_address != blank -%}<p class="foot-addr">{{ sp.foot_address }}</p>{%- endif -%}
      </div>
      {%- for i in (1..3) -%}
        {%- assign tkey = 'foot_col' | append: i | append: '_title' -%}
        {%- assign lkey = 'foot_col' | append: i | append: '_links' -%}
        {%- assign ctitle = sp[tkey] -%}
        {%- assign clinks = sp[lkey] -%}
        {%- if ctitle != blank or clinks != blank -%}
        <div>
          {%- if ctitle != blank -%}<div class="foot-ct">{{ ctitle }}</div>{%- endif -%}
          <ul class="foot-links">
            {%- assign rows = clinks | newline_to_br | strip_newlines | split: '<br />' -%}
            {%- for r in rows -%}
              {%- assign parts = r | split: '|' -%}
              {%- assign label = parts[0] | strip -%}
              {%- assign href = parts[1] | default: '#' | strip -%}
              {%- if label != blank -%}<li><a href="{{ href }}">{{ label }}</a></li>{%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="foot-bot">
      {%- if sp.foot_copy_left != blank -%}<p>{{ sp.foot_copy_left }}</p>{%- endif -%}
      {%- if sp.foot_copy_right != blank -%}<p>{{ sp.foot_copy_right }}</p>{%- endif -%}
    </div>
  </footer>
  {%- endif -%}

  {%- comment -%} ══ LEAD MODAL ══ {%- endcomment -%}
  <div class="bds-modalwrap" id="bds-modal-{{ uid }}" data-endpoint="{{ sp.lead_endpoint_v2 | default: 'https://script.google.com/macros/s/AKfycbx_hQHsmINYPqZerYkrjplNuicvG9OfkGOxoduVrrdBXsxTgbrsqMh1jKPEz7JyfCiO/exec' | escape }}" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="modal-box">
      <button class="modal-close" type="button" data-close-modal aria-label="Close">&times;</button>
      <div data-form-content>
        <div class="modal-eyebrow" data-modal-eyebrow>{{ sp.modal_eyebrow_sponsor | default: 'For Sponsors & Brands' }}</div>
        <div class="modal-title" data-modal-title>{{ sp.modal_title_sponsor | default: 'Become a Sponsor' }}</div>
        <div class="modal-sub" data-modal-sub>{{ sp.modal_sub_sponsor | default: 'Share your brand details and campaign goals so we can explore the right sponsorship opportunities for you.' }}</div>
        <div class="field"><label for="bds-name-{{ uid }}">{{ sp.lead_name_label | default: 'Full name' }} *</label><input type="text" id="bds-name-{{ uid }}" data-f="name" data-required placeholder="e.g. Sarah Mitchell" autocomplete="name"></div>
        <div class="field"><label for="bds-company-{{ uid }}" data-lbl-company>{{ sp.lead_company_label_sponsor | default: 'Company / Brand name' }} *</label><input type="text" id="bds-company-{{ uid }}" data-f="company" data-required placeholder="Your company" autocomplete="organization"></div>
        <div class="field"><label for="bds-email-{{ uid }}">{{ sp.lead_email_label | default: 'Email address' }} *</label><input type="email" id="bds-email-{{ uid }}" data-f="email" data-required placeholder="you@example.com" autocomplete="email"><div class="field-checking" data-checking="email">Checking email…</div><div class="field-msg err" data-msg="email"></div></div>
        <div class="field"><label for="bds-phone-{{ uid }}">{{ sp.lead_phone_label | default: 'Phone number' }} *</label><input type="tel" id="bds-phone-{{ uid }}" data-f="phone" data-required placeholder="98765 43210" autocomplete="tel"><div class="field-msg err" data-msg="phone"></div></div>
        <div class="field"><label for="bds-role-{{ uid }}" data-lbl-role>{{ sp.lead_industry_label | default: 'Industry' }} *</label>
          <select id="bds-role-sel-{{ uid }}" data-f="industry-select" style="display:none">
            <option value="">Select your industry…</option>
            <option>Retail &amp; Consumer Goods</option>
            <option>Food &amp; Beverage (FMCG)</option>
            <option>Technology &amp; IT Services</option>
            <option>Manufacturing &amp; Engineering</option>
            <option>Textile &amp; Apparel</option>
            <option>Real Estate &amp; Construction</option>
            <option>Education &amp; EdTech</option>
            <option>Healthcare &amp; Pharma</option>
            <option>Banking, Finance &amp; Insurance (BFSI)</option>
            <option>Logistics &amp; Supply Chain</option>
            <option>Automobile &amp; Auto Components</option>
            <option>Media, PR &amp; Advertising</option>
            <option>Hospitality &amp; Tourism</option>
            <option>Events &amp; Entertainment</option>
            <option>Wedding &amp; Celebrations Industry</option>
            <option>E-commerce &amp; D2C Brands</option>
            <option>Jewellery &amp; Lifestyle</option>
            <option value="__other__">Other (Please specify)</option>
          </select>
          <input type="text" id="bds-role-{{ uid }}" data-f="rolefield" data-required placeholder=""></div>
        <div class="field"><label for="bds-file-{{ uid }}" data-lbl-file>{{ sp.lead_file_label_sponsor | default: 'Upload brand guidelines or campaign brief' }}</label><input type="file" id="bds-file-{{ uid }}" data-f="file" accept=".pdf,.doc,.docx,.ppt,.pptx,.png,.jpg,.jpeg,.gif,.ai,.eps,.zip"><div class="modal-filehint">{{ sp.lead_file_note | default: 'PDF, DOC, PPT, image or ZIP · max 10 MB · optional' }}</div></div>
        <button class="modal-submit" type="button" data-submit-lead>{{ sp.submit_label | default: 'Send my details →' }}</button>
        {%- if sp.form_note != blank -%}<div class="modal-note">{{ sp.form_note }}</div>{%- endif -%}
      </div>
      <div class="modal-success" data-form-success>
        <div class="ic">🎉</div>
        <h3>{{ sp.success_title | default: "You're all set!" }}</h3>
        <p>{{ sp.success_text | default: "Thanks — our team will be in touch within 24 hours." }}</p>
      </div>
    </div>
  </div>

</div>

<script>
(function(){
  var SECT = document.getElementById('bds-spec-{{ uid }}');
  if(!SECT) return;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ════ Self-contained form validation: email deliverability + intl phone (flag by IP) ════ */
  var Forms = (function(){
    var DEFAULT_ISO = {{ sp.default_country | default: 'IN' | json }};
    var COUNTRIES = ("IN:91:India,US:1:United States,GB:44:United Kingdom,AE:971:United Arab Emirates,CA:1:Canada,AU:61:Australia,SG:65:Singapore,SA:966:Saudi Arabia,QA:974:Qatar,KW:965:Kuwait,BH:973:Bahrain,OM:968:Oman,DE:49:Germany,FR:33:France,NL:31:Netherlands,ES:34:Spain,IT:39:Italy,IE:353:Ireland,ZA:27:South Africa,NG:234:Nigeria,KE:254:Kenya,GH:233:Ghana,EG:20:Egypt,PK:92:Pakistan,BD:880:Bangladesh,LK:94:Sri Lanka,NP:977:Nepal,MY:60:Malaysia,ID:62:Indonesia,TH:66:Thailand,PH:63:Philippines,VN:84:Vietnam,CN:86:China,HK:852:Hong Kong,JP:81:Japan,KR:82:South Korea,NZ:64:New Zealand,BR:55:Brazil,MX:52:Mexico,AR:54:Argentina,CH:41:Switzerland,SE:46:Sweden,NO:47:Norway,DK:45:Denmark,BE:32:Belgium,AT:43:Austria,PT:351:Portugal,PL:48:Poland,TR:90:Turkey,RU:7:Russia,UA:380:Ukraine,IL:972:Israel")
      .split(",").map(function(s){ var a=s.split(":"); return {iso:a[0], dial:a[1], name:a[2]}; });
    function byIso(iso){ for(var i=0;i<COUNTRIES.length;i++){ if(COUNTRIES[i].iso===iso) return COUNTRIES[i]; } return null; }
    /* Real flag IMAGES (emoji flags don't render on Windows) */
    function flag(iso){ iso=(iso||'').toLowerCase(); return '<img class="bds-fl" src="https://flagcdn.com/24x18/'+iso+'.png" srcset="https://flagcdn.com/48x36/'+iso+'.png 2x" width="24" height="18" alt="" loading="lazy">'; }

    /* National-number length rules per country (min,max digits). Fallback 6–15. */
    var LEN = {IN:[10,10],US:[10,10],CA:[10,10],GB:[10,10],AE:[9,9],AU:[9,9],SG:[8,8],SA:[9,9],QA:[8,8],KW:[8,8],BH:[8,8],OM:[8,8],PK:[10,10],BD:[10,11],LK:[9,9],NP:[10,10],MY:[9,10],ID:[9,12],TH:[9,9],PH:[10,10],VN:[9,10],CN:[11,11],HK:[8,8],JP:[10,10],KR:[9,10],NZ:[8,10],DE:[10,11],FR:[9,9],NL:[9,9],ES:[9,9],IT:[9,10],IE:[9,9],ZA:[9,9],NG:[10,10],KE:[9,9],GH:[9,9],EG:[10,10],BR:[10,11],MX:[10,10],AR:[10,10],CH:[9,9],SE:[7,9],NO:[8,8],DK:[8,8],BE:[9,9],AT:[10,11],PT:[9,9],PL:[9,9],TR:[10,10],RU:[10,10],UA:[9,9],IL:[9,9]};
    /* Stricter mobile patterns (leading digit matters) for key markets. Others fall back to LEN. */
    var PAT = {IN:/^[6-9]\d{9}$/,US:/^[2-9]\d{9}$/,CA:/^[2-9]\d{9}$/,GB:/^7\d{9}$/,AE:/^5\d{8}$/,AU:/^4\d{8}$/,SA:/^5\d{8}$/,PK:/^3\d{9}$/,BD:/^1[3-9]\d{8}$/,SG:/^[89]\d{7}$/,NP:/^9\d{9}$/,LK:/^7\d{8}$/,QA:/^[3567]\d{7}$/,KW:/^[569]\d{7}$/,NG:/^[789]\d{9}$/,KE:/^[17]\d{8}$/,ZA:/^[6-8]\d{8}$/,EG:/^1\d{9}$/};

    var DISPOSABLE = {'mailinator.com':1,'guerrillamail.com':1,'10minutemail.com':1,'tempmail.com':1,'temp-mail.org':1,'yopmail.com':1,'trashmail.com':1,'sharklasers.com':1,'getnada.com':1,'dispostable.com':1,'maildrop.cc':1,'fakeinbox.com':1};
    var TYPOS = {'gmial.com':'gmail.com','gmai.com':'gmail.com','gmail.con':'gmail.com','gmail.co':'gmail.com','gmal.com':'gmail.com','gmaill.com':'gmail.com','hotmial.com':'hotmail.com','hotmail.con':'hotmail.com','hotmal.com':'hotmail.com','yahoo.con':'yahoo.com','yaho.com':'yahoo.com','yahooo.com':'yahoo.com','outlook.con':'outlook.com','outlok.com':'outlook.com','rediffmail.con':'rediffmail.com'};
    var EMAIL_RE = /^[a-z0-9!#$%&'*+\/=?^_`{|}~.-]+@[a-z0-9-]+(\.[a-z0-9-]+)*\.[a-z]{2,}$/i;

    var st = {}; // per-input phone state keyed by element id

    function setMsg(el, text, type){ if(!el) return; el.textContent=text||''; el.className='field-msg '+(type||'err')+(text?' show':''); }

    function buildTel(input){
      if(input.dataset.telReady) return;
      input.dataset.telReady='1';
      var wrap=document.createElement('div'); wrap.className='bds-tel';
      input.parentNode.insertBefore(wrap, input);
      var btn=document.createElement('button'); btn.type='button'; btn.className='bds-tel-btn';
      btn.innerHTML='<span class="fl"></span><span class="dc"></span><span class="ar">▼</span>';
      var list=document.createElement('div'); list.className='bds-tel-list';
      var search=document.createElement('input'); search.type='text'; search.className='bds-tel-search'; search.placeholder='Search country…';
      list.appendChild(search);
      var optsWrap=document.createElement('div');
      list.appendChild(optsWrap);
      wrap.appendChild(btn); wrap.appendChild(input); wrap.appendChild(list);

      function render(filter){
        optsWrap.innerHTML='';
        var f=(filter||'').toLowerCase();
        COUNTRIES.forEach(function(c){
          if(f && c.name.toLowerCase().indexOf(f)===-1 && c.dial.indexOf(f)===-1 && c.iso.toLowerCase().indexOf(f)===-1) return;
          var o=document.createElement('div'); o.className='bds-tel-opt';
          o.innerHTML='<span class="fl">'+flag(c.iso)+'</span><span class="nm">'+c.name+'</span><span class="dc">+'+c.dial+'</span>';
          o.addEventListener('click', function(){ select(c.iso); closeList(); input.focus(); });
          optsWrap.appendChild(o);
        });
      }
      function select(iso){ var c=byIso(iso)||byIso(DEFAULT_ISO)||COUNTRIES[0]; st[input.id]=c; btn.querySelector('.fl').innerHTML=flag(c.iso); btn.querySelector('.dc').textContent='+'+c.dial; }
      function openList(){ render(''); search.value=''; list.classList.add('open'); setTimeout(function(){ search.focus(); },30); }
      function closeList(){ list.classList.remove('open'); }
      btn.addEventListener('click', function(e){ e.stopPropagation(); list.classList.contains('open')?closeList():openList(); });
      search.addEventListener('input', function(){ render(search.value); });
      search.addEventListener('click', function(e){ e.stopPropagation(); });
      document.addEventListener('click', function(e){ if(!wrap.contains(e.target)) closeList(); });
      select(DEFAULT_ISO);
      render('');
    }

    function detectCountry(input){
      function trySet(iso){ if(!iso) return; var c=byIso((''+iso).toUpperCase()); if(c && st[input.id] && !input.dataset.userPicked){ st[input.id]=c; var btn=input.parentNode && input.parentNode.querySelector('.bds-tel-btn'); if(btn){ btn.querySelector('.fl').innerHTML=flag(c.iso); btn.querySelector('.dc').textContent='+'+c.dial; } } }
      // Every provider call swallows its own error (rate-limit / ad-blocker / offline)
      // so a failed lookup is silent — the page just keeps the default country.
      function safe(url){ try { return fetch(url).then(function(r){ return r.ok ? r.json() : null; })['catch'](function(){ return null; }); } catch(e){ return Promise.resolve(null); } }
      safe('https://ipapi.co/json/').then(function(d){
        if(d && d.country_code){ trySet(d.country_code); return null; }
        return safe('https://get.geojs.io/v1/ip/country.json').then(function(d2){
          if(d2 && d2.country){ trySet(d2.country); return null; }
          return safe('https://api.country.is/').then(function(d3){ if(d3 && d3.country) trySet(d3.country); });
        });
      })['catch'](function(){});
    }

    return {
      initPhone: function(input){ if(input){ buildTel(input); input.addEventListener('input', function(){ input.dataset.userTyped='1'; }); } },
      initCountryPicked: function(input){ var btn=input&&input.parentNode&&input.parentNode.querySelector('.bds-tel-btn'); if(btn){ btn.addEventListener('click', function(){ input.dataset.userPicked='1'; }); } },
      preload: function(input){ if(input) detectCountry(input); },
      getCountry: function(input){ var c=st[input.id]; return c?c.iso:DEFAULT_ISO; },
      getPhone: function(input){ var c=st[input.id]||byIso(DEFAULT_ISO); var nat=(input.value||'').replace(/[^\d]/g,''); return '+'+(c?c.dial:'')+' '+nat; },
      checkPhone: function(input, msgEl){
        var c=st[input.id]||byIso(DEFAULT_ISO);
        var nat=(input.value||'').replace(/[^\d]/g,'');
        var wrap=input.closest('.bds-tel');
        if(!nat){ setMsg(msgEl,'Phone number is required'); if(wrap) wrap.classList.add('err'); return false; }
        var pat = PAT[c.iso], ok;
        if(pat){ ok = pat.test(nat); }                       // strict mobile pattern (e.g. India must start 6–9)
        else { var rule = LEN[c.iso] || [6,15]; ok = (nat.length>=rule[0] && nat.length<=rule[1]); }
        if(!ok){ setMsg(msgEl,'Enter a valid '+c.name+' mobile number'); if(wrap) wrap.classList.add('err'); return false; }
        setMsg(msgEl,'',''); if(wrap) wrap.classList.remove('err'); return true;
      },
      /* Instant, network-free email check (format + typo + disposable). */
      checkEmailSync: function(input, msgEl){
        var v=(input.value||'').trim();
        if(!v || !EMAIL_RE.test(v)){ input.classList.add('err'); setMsg(msgEl,'Enter a valid email address'); return false; }
        var domain=v.split('@')[1].toLowerCase();
        if(TYPOS[domain]){ input.classList.add('err'); setMsg(msgEl,'Did you mean @'+TYPOS[domain]+'?'); return false; }
        if(DISPOSABLE[domain]){ input.classList.add('err'); setMsg(msgEl,'Please use a permanent email address'); return false; }
        input.classList.remove('err'); setMsg(msgEl,'',''); return true;
      },
      checkEmail: function(input, msgEl, checkingEl){
        return new Promise(function(resolve){
          var v=(input.value||'').trim();
          if(!v || !EMAIL_RE.test(v)){ input.classList.add('err'); setMsg(msgEl,'Enter a valid email address'); return resolve(false); }
          var domain=v.split('@')[1].toLowerCase();
          if(TYPOS[domain]){ input.classList.add('err'); setMsg(msgEl,'Did you mean @'+TYPOS[domain]+'?'); return resolve(false); }
          if(DISPOSABLE[domain]){ input.classList.add('err'); setMsg(msgEl,'Please use a permanent email address'); return resolve(false); }
          input.classList.remove('err'); setMsg(msgEl,'','');
          if(checkingEl) checkingEl.classList.add('show');
          function done(ok,text,type){ if(checkingEl) checkingEl.classList.remove('show'); if(!ok){ input.classList.add('err'); setMsg(msgEl,text||'',type||'err'); } else { input.classList.remove('err'); setMsg(msgEl,text||'',type||'ok'); } resolve(ok); }
          var settled=false;
          var ctrl=setTimeout(function(){ if(!settled){ settled=true; done(true,''); } }, 5000); // never block on a slow lookup
          /* SAME deliverability check as the USA forms (bds-forms.js): MX records ONLY.
             A domain with a website (A record) but no mail server (MX) is rejected as
             "can't receive mail". Two providers so an ad-blocker on one still verifies. */
          function dohGoogle(){ return fetch('https://dns.google/resolve?name='+encodeURIComponent(domain)+'&type=MX').then(function(r){return r.ok?r.json():null;}); }
          function dohCloudflare(){ return fetch('https://cloudflare-dns.com/dns-query?name='+encodeURIComponent(domain)+'&type=MX',{headers:{accept:'application/dns-json'}}).then(function(r){return r.ok?r.json():null;}); }
          function realMX(d){
            if(!d) return null;                       // no response → unknown (don't block submit)
            if(d.Status===3) return false;            // NXDOMAIN — domain doesn't exist
            if(d.Status===0 && Array.isArray(d.Answer) && d.Answer.length){
              var real=d.Answer.filter(function(a){
                if(a.type!==15) return false;          // 15 = MX record
                var ex=String(a.data||'').trim().split(/\s+/).pop().replace(/\.$/,'').toLowerCase();
                return ex && ex!=='localhost' && ex!=='0.0.0.0' && ex!=='127.0.0.1';
              });
              return real.length>0;                    // has a real mail exchanger?
            }
            if(d.Status===0) return false;            // resolved but NO MX → can't receive mail
            return null;
          }
          dohGoogle().then(function(d){
            var res=realMX(d);
            if(res===null){ return dohCloudflare().then(function(d2){ return realMX(d2); }); } // retry on other provider
            return res;
          })['catch'](function(){ return null; }).then(function(res){
            if(settled) return; settled=true; clearTimeout(ctrl);
            if(res===false){ done(false,"That email domain can't receive mail — please check it"); }
            else if(res===true){ done(true,'Email verified ✓','ok'); }
            else { done(true,''); }                    // both providers blocked → don't trap real users
          });
        });
      }
    };
  })();

  /* ---- NAV: solid on scroll + mobile burger ---- */
  var nav = document.getElementById('bds-nav-{{ uid }}');
  if(nav){
    var onScroll = function(){ nav.classList.toggle('is-fixed', window.pageYOffset > 60); };
    onScroll(); window.addEventListener('scroll', onScroll, {passive:true});
    var burger = nav.querySelector('[data-burger]');
    if(burger){ burger.addEventListener('click', function(){ nav.classList.toggle('menu-open'); }); }
    nav.querySelectorAll('.nav-links a').forEach(function(a){ a.addEventListener('click', function(){ nav.classList.remove('menu-open'); }); });
  }

  /* ---- smooth-scroll anchors ---- */
  SECT.addEventListener('click', function(e){
    var s = e.target.closest('[data-scroll]');
    if(s){ var t = document.getElementById(s.getAttribute('data-scroll')); if(t){ e.preventDefault(); t.scrollIntoView({behavior:'smooth',block:'start'}); } }
  });

  /* ---- HERO slideshow ---- */
  var hero = document.getElementById('bds-hero-{{ uid }}');
  if(hero){
    var slides = [].slice.call(hero.querySelectorAll('.hslide'));
    var dotsWrap = document.getElementById('bds-hdots-{{ uid }}');
    var pf = document.getElementById('bds-pf-{{ uid }}');
    var cap = document.getElementById('bds-hcap-{{ uid }}');
    var capPill = cap && cap.querySelector('[data-cap-pill]');
    var capName = cap && cap.querySelector('[data-cap-name]');
    var capLoc  = cap && cap.querySelector('[data-cap-loc]');
    var cur = 0, tmr = null;
    var auto = SECT.getAttribute('data-autorotate') !== 'false' && !reduce;
    var interval = (parseFloat(SECT.getAttribute('data-interval')) || 6) * 1000;

    function setCap(i){
      if(!cap) return;
      var s = slides[i]; if(!s) return;
      var pill = s.getAttribute('data-cat')||'', nm = s.getAttribute('data-name')||'', lc = s.getAttribute('data-loc')||'';
      if(capPill){ capPill.textContent = pill; capPill.style.display = pill ? '' : 'none'; }
      if(capName) capName.textContent = nm;
      if(capLoc){ capLoc.textContent = lc; capLoc.style.display = lc ? '' : 'none'; }
      cap.classList.remove('show'); setTimeout(function(){ cap.classList.add('show'); }, 260);
    }
    function resetProg(){
      if(!pf || reduce) return;
      pf.style.transition='none'; pf.style.width='0%';
      requestAnimationFrame(function(){ requestAnimationFrame(function(){ pf.style.transition='width '+(interval/1000)+'s linear'; pf.style.width='100%'; }); });
    }
    function go(n){
      if(slides.length<2 && n!==0){ return; }
      slides[cur].classList.remove('on');
      var d0 = dotsWrap && dotsWrap.children[cur]; if(d0) d0.classList.remove('on');
      cur = (n + slides.length) % slides.length;
      slides[cur].classList.add('on');
      var d1 = dotsWrap && dotsWrap.children[cur]; if(d1) d1.classList.add('on');
      setCap(cur); resetProg();
      if(auto){ clearInterval(tmr); tmr = setInterval(function(){ go(cur+1); }, interval); }
    }
    // build dots
    if(dotsWrap && slides.length > 1){
      slides.forEach(function(_,i){
        var b = document.createElement('button'); b.className='hdot'+(i===0?' on':''); b.setAttribute('aria-label','Slide '+(i+1));
        b.addEventListener('click', function(){ go(i); }); dotsWrap.appendChild(b);
      });
    }
    setCap(0);
    if(slides.length > 1 && auto){ resetProg(); tmr = setInterval(function(){ go(cur+1); }, interval); }
  }

  /* ---- TICKER: duplicate track for seamless loop ---- */
  var tick = document.getElementById('bds-tick-{{ uid }}');
  if(tick && !reduce && tick.children.length){ tick.innerHTML += tick.innerHTML; }

  /* ---- LEAD MODAL (dual role) ---- */
  var modal = document.getElementById('bds-modal-{{ uid }}');
  if(modal){
    /* Portal the modal to <body> so a transformed / overflow-clipped theme ancestor
       can never hide it. Copy the section's CSS variables onto the portal so all
       .bds-spec modal styles still resolve. */
    try {
      var portal = document.createElement('div'); portal.className = 'bds-spec'; portal.setAttribute('data-bds-portal','');
      portal.style.margin='0'; portal.style.width='auto'; portal.style.overflow='visible';
      var csv = getComputedStyle(SECT);
      ['--bds-accent','--bds-accent-dark','--bds-accent-light','--bds-navy','--bds-navy-mid','--bds-navy-deep','--bds-green','--bds-white','--bds-off-white','--bds-g100','--bds-g200','--bds-g500','--bds-g700','--bds-g900','--bds-fd','--bds-fb'].forEach(function(v){ portal.style.setProperty(v, csv.getPropertyValue(v)); });
      document.body.appendChild(portal); portal.appendChild(modal);
    } catch(ePortal){}

    var COPY = {
      sponsor: {
        eyebrow:   {{ sp.modal_eyebrow_sponsor | default: 'For Sponsors & Brands' | json }},
        title:     {{ sp.modal_title_sponsor | default: 'Become a Sponsor' | json }},
        sub:       {{ sp.modal_sub_sponsor | default: 'Share your brand details and campaign goals so we can explore the right sponsorship opportunities for you.' | json }},
        form:      {{ sp.sponsor_sheet_tab | default: 'Sponsors' | json }},
        company:   {{ sp.lead_company_label_sponsor | default: 'Company / Brand name' | json }},
        fieldKey:  'industry',
        fieldLabel:{{ sp.lead_industry_label | default: 'Industry' | json }},
        fieldPh:   {{ sp.lead_industry_ph | default: 'e.g. Fintech, FMCG, Telecom' | json }},
        file:      {{ sp.lead_file_label_sponsor | default: 'Upload brand guidelines or campaign brief' | json }}
      },
      organiser: {
        eyebrow:   {{ sp.modal_eyebrow_organiser | default: 'For Event Organisers' | json }},
        title:     {{ sp.modal_title_organiser | default: "I'm an Organiser" | json }},
        sub:       {{ sp.modal_sub_organiser | default: 'Tell us about your event needs. Share a few details below so we can review your request and get back to you.' | json }},
        form:      {{ sp.organiser_sheet_tab | default: 'Event Owners' | json }},
        company:   {{ sp.lead_company_label_organiser | default: 'Company / Organization name' | json }},
        fieldKey:  'event_name',
        fieldLabel:{{ sp.lead_event_label | default: 'Event name' | json }},
        fieldPh:   {{ sp.lead_event_ph | default: 'e.g. Africa Tech Summit 2026' | json }},
        file:      {{ sp.lead_file_label_organiser | default: 'Upload event brief or reference file' | json }}
      }
    };
    var SUBMIT_LABEL = {{ sp.submit_label | default: 'Send my details →' | json }};
    var MAX_FILE = 10 * 1024 * 1024; // 10 MB
    var role = 'sponsor';
    var elEyebrow = modal.querySelector('[data-modal-eyebrow]');
    var elTitle   = modal.querySelector('[data-modal-title]');
    var elSub     = modal.querySelector('[data-modal-sub]');
    var elCompany = modal.querySelector('[data-lbl-company]');
    var elRoleLbl = modal.querySelector('[data-lbl-role]');
    var elFileLbl = modal.querySelector('[data-lbl-file]');
    var roleEl    = modal.querySelector('[data-f="rolefield"]');
    var roleSel   = modal.querySelector('[data-f="industry-select"]');
    var content   = modal.querySelector('[data-form-content]');
    var success   = modal.querySelector('[data-form-success]');
    var emailEl   = modal.querySelector('[data-f="email"]');
    var phoneEl   = modal.querySelector('[data-f="phone"]');
    var msgEmail  = modal.querySelector('[data-msg="email"]');
    var msgPhone  = modal.querySelector('[data-msg="phone"]');
    var chkEmail  = modal.querySelector('[data-checking="email"]');

    try { Forms.initPhone(phoneEl); Forms.initCountryPicked(phoneEl); } catch(eInit){}
    /* Replace the native <select> with a custom, in-modal dropdown so the long industry
       list can never overflow the screen. The hidden <select> stays the value source. */
    function buildSelect(sel){
      if(!sel || sel.dataset.selReady) return; sel.dataset.selReady='1';
      sel.style.display='none';
      var wrap=document.createElement('div'); wrap.className='bds-isel';
      sel.parentNode.insertBefore(wrap, sel);
      var btn=document.createElement('button'); btn.type='button'; btn.className='bds-isel-btn';
      btn.innerHTML='<span class="lbl ph"></span><span class="ar">▼</span>';
      var list=document.createElement('div'); list.className='bds-isel-list';
      wrap.appendChild(btn); wrap.appendChild(sel); wrap.appendChild(list);
      var lblEl=btn.querySelector('.lbl');
      function setLabel(){ var o=sel.options[sel.selectedIndex]; lblEl.textContent=o?o.textContent:'Select…'; lblEl.classList.toggle('ph', !sel.value); }
      [].forEach.call(sel.options, function(opt){
        var o=document.createElement('div'); o.className='bds-isel-opt'; o.textContent=opt.textContent;
        if(opt.value==='') o.style.color='var(--bds-g500)';
        o.addEventListener('click', function(){
          sel.value=opt.value; setLabel(); wrap.classList.remove('open','err');
          var ev; try{ ev=new Event('change',{bubbles:true}); }catch(e){ ev=document.createEvent('Event'); ev.initEvent('change',true,true); }
          sel.dispatchEvent(ev);
        });
        list.appendChild(o);
      });
      btn.addEventListener('click', function(e){ e.stopPropagation(); wrap.classList.toggle('open'); });
      document.addEventListener('click', function(e){ if(!wrap.contains(e.target)) wrap.classList.remove('open'); });
      setLabel();
      sel._bdsReset=function(){ setLabel(); wrap.classList.remove('err','open'); };
    }
    try { buildSelect(roleSel); } catch(eSel){}
    /* Verify the email's domain (MX) the moment the user leaves the field — shows
       "that domain can't receive mail" inline, and remembers the result for submit. */
    if(emailEl){
      emailEl.addEventListener('blur', function(){
        if(!emailEl.value.trim()) return;
        Forms.checkEmail(emailEl, msgEmail, chkEmail).then(function(okk){ emailEl.dataset.mx = okk ? 'ok' : 'bad'; });
      });
      emailEl.addEventListener('input', function(){ emailEl.dataset.mx=''; emailEl.classList.remove('err'); if(msgEmail){ msgEmail.textContent=''; msgEmail.className='field-msg err'; } if(chkEmail) chkEmail.classList.remove('show'); });
    }
    /* Industry dropdown: when "Other (Please specify)" is picked, reveal the text box. */
    if(roleSel){
      roleSel.addEventListener('change', function(){
        var w=roleSel.closest('.bds-isel'); if(w) w.classList.remove('err');
        if(role==='sponsor'){
          if(roleSel.value==='__other__'){ roleEl.style.display=''; roleEl.value=''; roleEl.placeholder='Please specify your industry'; roleEl.focus(); }
          else { roleEl.style.display='none'; roleEl.value=''; }
        }
      });
