{%- assign all_blog_articles = '' | split: '' -%}
{%- for article in blog.articles -%}
  {%- assign all_blog_articles = all_blog_articles | push: article -%}
{%- endfor -%}
{%- assign sid = section.id -%}

<div class="bh">

{%- comment -%}── HERO ──{%- endcomment -%}
{%- if section.settings.show_featured and featured_post != blank -%}
  {%- liquid
    assign fp_words = featured_post.content | strip_html | split: ' ' | size
    assign fp_mins  = fp_words | divided_by: 200
    if fp_mins < 1
      assign fp_mins = 1
    endif
  -%}
  <section class="bh-hero">
    <div class="bh-hero__inner">
      <div>
        <div class="bh-hero__label">Main Featured Post</div>
        <h1 class="bh-hero__title">{{ featured_post.title }}</h1>
        {%- if featured_post.excerpt != blank -%}
          <p class="bh-hero__excerpt">{{ featured_post.excerpt | strip_html | truncate: 160 }}</p>
        {%- endif -%}
        <a href="{{ featured_post.url }}" class="bh-hero__btn">
          Read More
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="bh-hero__visual">
        {%- if featured_post.image -%}
          {{ featured_post.image | image_url: width: 1040 | image_tag: loading: loading, fetchpriority: fetchpriority, alt: featured_post.image.alt }}
        {%- else -%}
          <div class="bh-hero__visual-placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <div>Featured Article Hero Image</div>
          </div>
        {%- endif -%}
        {%- if featured_post.tags.size > 0 -%}
          <div class="bh-hero__tag">✦ {{ featured_post.tags | first }}</div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{%- comment -%}
  SEARCH + CATEGORIES
  Exactly two separate rows as per source wireframe:
  Row 1 — search input  (has border-bottom)
  Row 2 — category tabs (below the border)
{%- endcomment -%}
<div class="bh-search-section">
  <div class="bh-search-section__inner">

    <div class="bh-search-row">
      <div class="bh-search-wrap">
        <span class="bh-search-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        </span>
        <input class="bh-search-input" type="text" placeholder="Search articles, guides, tips…" id="bh-search-input" aria-label="Search articles">
      </div>
      <div class="bh-search-hint" id="bh-search-hint"></div>
    </div>

    <div class="bh-cat-tabs">
      <a href="{{ blog.url }}" class="bh-cat-tab{% unless current_tags %} active{% endunless %}">
        <span class="bh-cat-dot" style="background:var(--bh-navy)"></span>All Posts
      </a>
      {%- assign dot_colors = '#b81c3c,#1a6b4a,#1a50a0,#8b3a8b,#b86a1c,#1a7a9a,#7a3a20,#4a2060' | split: ',' -%}
      {%- for tag in blog.tags limit: 8 -%}
        <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="bh-cat-tab{% if current_tags contains tag %} active{% endif %}">
          <span class="bh-cat-dot" style="background:{{ dot_colors[forloop.index0] | default: '#888' }}"></span>{{ tag }}
        </a>
      {%- endfor -%}
    </div>

  </div>
</div>

<div class="bh-page" style="padding-top:0;">

{%- comment -%}── TOP ARTICLES ──{%- endcomment -%}
<div class="bh-sec-hdr">
  <h2>Top Articles</h2>
  <a href="{{ blog.url }}" class="bh-view-all">View All <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
</div>
{%- paginate blog.articles by 1000 -%}
<div class="bh-art-grid" id="bh-art-grid">
  {%- for article in blog.articles -%}
    {%- liquid
      assign a_words = article.content | strip_html | split: ' ' | size
      assign a_mins  = a_words | divided_by: 200
      if a_mins < 1
        assign a_mins = 1
      endif
      assign a_tag = article.tags | first
    -%}
    <a href="{{ article.url }}" class="bh-art-card bh-art-page-item" data-title="{{ article.title | downcase | escape }}" data-tags="{{ article.tags | join: ',' | downcase | escape }}">
      <div class="bh-art-card__img">
