            </div>
            <input type="hidden" id="psp-uc-{{ sid }}" role="uploadcare-uploader" data-public-key="6a247f0aaa7dfa6d2ce3" data-multiple="true" data-tabs="file">
            <div class="psp-up-st" id="psp-up-st-{{ sid }}"></div>
          </div>
          <div class="psp-uov-ft"><span class="psp-fnote">For files over 500 MB, use Link Upload.</span><button type="button" class="psp-svcont" id="psp-sv-{{ sid }}">Save &amp; Continue</button></div>
        </div>
        <div data-up-con="link" style="display:none;flex-direction:column;height:100%;">
          <div class="psp-uov-th"><div class="psp-uov-th-ic"><svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></div><div><div class="psp-uov-th-t">Link Upload</div><div class="psp-uov-th-s">Dropbox, Google Drive, WeTransfer or OneDrive</div></div></div>
          <div class="psp-uov-sc">
