{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}
{{ 'section-bs-blog.css' | asset_url | stylesheet_tag }}

{% liquid
  assign loading = 'lazy'
  assign fetchpriority = 'low'
  if section.index < 3
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif

  assign post_limit = section.settings.post_limit | default: 6
  assign featured_post = blog.articles | first
%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600;700&display=swap" rel="stylesheet">

<style>
  :root {
    --bs-navy: #0A3161;
    --bs-crimson: #B31942;
    --bs-white: #FFFFFF;
    --bs-offwhite: #F5F6F8;
    --bs-border: #E0E4EE;
    --bs-text: #1a2540;
    --bs-muted: #6b7a99;
    --bs-font: 'Inter', sans-serif;
  }
  .bs-blog-wrap * {
    font-family: var(--bs-font) !important;
    box-sizing: border-box;
  }

  /* ── FEATURED HERO ── */
  .bs-blog-hero {
    background: var(--bs-offwhite);
    padding: 52px 0;
  }
  .bs-blog-hero__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr 480px;
    gap: 48px;
    align-items: center;
  }
  .bs-blog-hero__label {
    font-size: 11px;
    font-weight: 600;
    color: var(--bs-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 16px;
  }
  .bs-blog-hero__title {
    font-size: 45px !important;
    font-weight: 500 !important;
    color: var(--bs-navy) !important;
    line-height: 1.15 !important;
    margin: 0 0 16px !important;
    letter-spacing: -0.02em;
  }
  .bs-blog-hero__excerpt {
    font-size: 15px;
    font-weight: 300;
    color: var(--bs-muted);
    line-height: 1.7;
    margin-bottom: 28px;
    max-width: 480px;
  }
  .bs-blog-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 28px;
    background: var(--bs-navy);
    color: #fff;
    border-radius: 30px;
    font-size: 15px;
    font-weight: 400;
    text-decoration: none;
    transition: background 0.2s;
  }
  .bs-blog-hero__btn:hover {
    background: var(--bs-crimson);
    color: #fff;
  }
  .bs-blog-hero__image-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--bs-navy) 0%, var(--bs-crimson) 100%);
    aspect-ratio: 16/10;
    box-shadow: 0 24px 64px rgba(10,49,97,0.2);
  }
  .bs-blog-hero__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .bs-blog-hero__image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: rgba(255,255,255,0.35);
    font-size: 14px;
  }
  .bs-blog-hero__image-placeholder svg {
    width: 48px;
    height: 48px;
  }
  .bs-blog-hero__image-tag {
    position: absolute;
    bottom: 16px;
    left: 16px;
  }
  .bs-blog-hero__image-tag a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    background: rgba(255,255,255,0.92);
    color: var(--bs-navy);
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    backdrop-filter: blur(4px);
  }

  /* ── SEARCH + FILTER ── */
  .bs-blog-filter {
    background: var(--bs-white);
    border-bottom: 1px solid var(--bs-border);
    padding: 28px 0;
  }
  .bs-blog-filter__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .bs-blog-filter__search {
    position: relative;
    width: 360px;
    max-width: 100%;
  }
  .bs-blog-filter__search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--bs-muted);
    display: flex;
  }
  .bs-blog-filter__search-icon svg {
    width: 16px;
    height: 16px;
  }
  .bs-blog-filter__search input {
    width: 100%;
    padding: 11px 16px 11px 40px;
    border: 1.5px solid var(--bs-border);
    border-radius: 30px;
    font-size: 14px;
    font-weight: 300;
    color: var(--bs-text);
    background: var(--bs-offwhite);
    outline: none;
    font-family: var(--bs-font) !important;
    transition: border-color 0.2s;
  }
  .bs-blog-filter__search input:focus {
    border-color: var(--bs-navy);
    background: var(--bs-white);
  }
  .bs-blog-filter__search input::placeholder {
    color: var(--bs-muted);
  }
  .bs-blog-filter__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .bs-blog-filter__tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    border-radius: 30px;
    border: 1.5px solid var(--bs-border);
    font-size: 14px;
    font-weight: 400;
    color: var(--bs-text);
    text-decoration: none;
    background: var(--bs-white);
    transition: all 0.2s;
    cursor: pointer;
  }
  .bs-blog-filter__tag:hover {
    border-color: var(--bs-navy);
    color: var(--bs-navy);
  }
  .bs-blog-filter__tag.active,
  .bs-blog-filter__tag--all.active {
    background: var(--bs-navy);
    border-color: var(--bs-navy);
    color: #fff;
  }
  .bs-blog-filter__tag-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ── SECTION LAYOUT SHARED ── */
  .bs-section {
    padding: 56px 0;
  }
  .bs-section--offwhite {
    background: var(--bs-offwhite);
  }
  .bs-section__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .bs-section__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }
  .bs-section__header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .bs-section__tag-pill {
    display: inline-block;
    padding: 5px 14px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    border: 1.5px solid var(--bs-border);
    color: var(--bs-muted);
    background: var(--bs-white);
  }
  .bs-section__heading {
    font-size: 25px !important;
    font-weight: 500 !important;
    color: var(--bs-navy) !important;
    margin: 0 !important;
  }
  .bs-section__view-all {
    font-size: 14px;
    font-weight: 400;
    color: var(--bs-navy);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    transition: color 0.2s;
  }
  .bs-section__view-all:hover {
    color: var(--bs-crimson);
  }

  /* ── TOP ARTICLES 3-COL GRID ── */
  .bs-top-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .bs-article-card {
    background: var(--bs-white);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--bs-border);
    transition: box-shadow 0.2s, transform 0.2s;
    text-decoration: none;
    color: var(--bs-text);
    display: block;
  }
  .bs-article-card:hover {
    box-shadow: 0 8px 32px rgba(10,49,97,0.1);
    transform: translateY(-2px);
    color: var(--bs-text);
  }
  .bs-article-card__image {
    position: relative;
    aspect-ratio: 16/10;
    background: var(--bs-navy);
    overflow: hidden;
  }
  .bs-article-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s;
  }
  .bs-article-card:hover .bs-article-card__image img {
    transform: scale(1.04);
  }
  .bs-article-card__image-tag {
    position: absolute;
    bottom: 12px;
    left: 12px;
    padding: 5px 12px;
    background: rgba(255,255,255,0.9);
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    color: var(--bs-navy);
    backdrop-filter: blur(4px);
  }
  .bs-article-card__body {
    padding: 20px 24px;
  }
  .bs-article-card__cat {
    font-size: 11px;
    font-weight: 700;
    color: var(--bs-crimson);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }
  .bs-article-card__title {
    font-size: 16px !important;
    font-weight: 500 !important;
    color: var(--bs-navy) !important;
    line-height: 1.45;
    margin: 0 0 10px !important;
  }
  .bs-article-card__readtime {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 400;
    color: var(--bs-muted);
  }
  .bs-article-card__readtime svg {
    width: 14px;
    height: 14px;
  }

  /* ── CATEGORY SPLIT LAYOUT ── */
  .bs-cat-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 24px;
    align-items: start;
  }
  .bs-cat-featured {
    background: var(--bs-white);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--bs-border);
    text-decoration: none;
    color: var(--bs-text);
    display: block;
    transition: box-shadow 0.2s;
  }
  .bs-cat-featured:hover {
    box-shadow: 0 8px 32px rgba(10,49,97,0.1);
    color: var(--bs-text);
  }
  .bs-cat-featured__image {
    aspect-ratio: 16/10;
    background: var(--bs-navy);
    overflow: hidden;
    position: relative;
  }
  .bs-cat-featured__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s;
  }
  .bs-cat-featured:hover .bs-cat-featured__image img {
    transform: scale(1.04);
  }
  .bs-cat-featured__body {
    padding: 24px 28px;
  }
  .bs-cat-featured__cat {
    font-size: 11px;
    font-weight: 700;
    color: var(--bs-crimson);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }
  .bs-cat-featured__title {
    font-size: 22px !important;
    font-weight: 500 !important;
    color: var(--bs-navy) !important;
    line-height: 1.35;
    margin: 0 0 12px !important;
  }
  .bs-cat-featured__excerpt {
    font-size: 14px;
    font-weight: 300;
    color: var(--bs-muted);
    line-height: 1.6;
    margin-bottom: 16px;
  }
  .bs-cat-featured__link {
    font-size: 14px;
    font-weight: 500;
    color: var(--bs-crimson);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .bs-cat-featured__link:hover {
    color: var(--bs-navy);
  }

  /* Small cards list */
  .bs-cat-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .bs-cat-small {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: var(--bs-white);
    border-radius: 12px;
    border: 1px solid var(--bs-border);
    padding: 16px;
    text-decoration: none;
    color: var(--bs-text);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .bs-cat-small:hover {
    box-shadow: 0 4px 16px rgba(10,49,97,0.08);
    transform: translateY(-1px);
    color: var(--bs-text);
  }
  .bs-cat-small__image {
    width: 80px;
    height: 64px;
    border-radius: 8px;
    background: var(--bs-navy);
    overflow: hidden;
    flex-shrink: 0;
  }
  .bs-cat-small__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .bs-cat-small__body {
    flex: 1;
    min-width: 0;
  }
  .bs-cat-small__cat {
    font-size: 10px;
    font-weight: 700;
    color: var(--bs-crimson);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 5px;
  }
  .bs-cat-small__title {
    font-size: 14px !important;
    font-weight: 500 !important;
    color: var(--bs-navy) !important;
    line-height: 1.4;
    margin: 0 0 6px !important;
  }
  .bs-cat-small__readtime {
    font-size: 11px;
    font-weight: 400;
    color: var(--bs-muted);
  }

  /* ── INLINE CTA BANNER ── */
  .bs-cta-banner {
    border-radius: 20px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0 0 16px;
    border: 1px solid var(--bs-border);
  }
  .bs-cta-banner__left {
    background: var(--bs-navy);
    padding: 40px 40px;
    color: #fff;
  }
  .bs-cta-banner__label {
    font-size: 11px;
    font-weight: 600;
    color: rgba(255,255,255,0.6);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .bs-cta-banner__title {
    font-size: 26px !important;
    font-weight: 500 !important;
    color: #fff !important;
    line-height: 1.3;
    margin: 0 0 12px !important;
  }
  .bs-cta-banner__desc {
    font-size: 14px;
    font-weight: 300;
    color: rgba(255,255,255,0.75);
    line-height: 1.6;
    margin-bottom: 24px;
  }
  .bs-cta-banner__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    background: var(--bs-crimson);
    color: #fff;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .bs-cta-banner__btn:hover {
    opacity: 0.88;
    color: #fff;
  }
  .bs-cta-banner__right {
    background: var(--bs-offwhite);
    padding: 40px 40px;
  }
  .bs-cta-banner__ql-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--bs-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 20px;
  }
  .bs-cta-banner__ql-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .bs-cta-banner__ql-list a {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 400;
    color: var(--bs-text);
    text-decoration: none;
    transition: color 0.2s;
  }
  .bs-cta-banner__ql-list a:hover {
    color: var(--bs-crimson);
  }
  .bs-cta-banner__ql-arrow {
    color: var(--bs-navy);
    font-size: 16px;
    flex-shrink: 0;
  }

  /* ── DESIGN HELP CARDS ── */
  .bs-design-help {
    border: 1px solid var(--bs-border);
    border-radius: 20px;
    padding: 28px 32px;
    margin: 16px 0;
  }
  .bs-design-help__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }
  .bs-design-help__label {
    font-size: 11px;
    font-weight: 700;
    color: var(--bs-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .bs-design-help__view {
    font-size: 13px;
    font-weight: 500;
    color: var(--bs-crimson);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .bs-design-help__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .bs-design-help__card {
    border: 1px solid var(--bs-border);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: var(--bs-text);
    display: block;
    transition: box-shadow 0.2s;
  }
  .bs-design-help__card:hover {
    box-shadow: 0 4px 16px rgba(10,49,97,0.1);
    color: var(--bs-text);
  }
  .bs-design-help__card-image {
    aspect-ratio: 16/9;
    background: var(--bs-navy);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.4);
  }
  .bs-design-help__card-image svg {
    width: 28px;
    height: 28px;
  }
  .bs-design-help__card-body {
    padding: 14px 16px;
  }
  .bs-design-help__card-title {
    font-size: 14px;
    font-weight: 500;
    color: var(--bs-navy);
    margin-bottom: 4px;
  }
  .bs-design-help__card-sub {
    font-size: 12px;
    font-weight: 300;
    color: var(--bs-muted);
    margin-bottom: 10px;
  }
  .bs-design-help__card-link {
    font-size: 12px;
    font-weight: 600;
    color: var(--bs-crimson);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* ── PRODUCT PROMO STRIP ── */
  .bs-product-strip {
    border: 1px solid var(--bs-border);
    border-radius: 20px;
    padding: 24px 28px;
    margin: 16px 0;
  }
  .bs-product-strip__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .bs-product-strip__label {
    font-size: 11px;
    font-weight: 700;
    color: var(--bs-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .bs-product-strip__shop {
    font-size: 13px;
    font-weight: 500;
    color: var(--bs-crimson);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .bs-product-strip__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .bs-product-card {
    border: 1px solid var(--bs-border);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: var(--bs-text);
    background: var(--bs-white);
    display: block;
    transition: box-shadow 0.2s;
  }
  .bs-product-card:hover {
    box-shadow: 0 4px 16px rgba(10,49,97,0.1);
    color: var(--bs-text);
  }
  .bs-product-card__image {
    aspect-ratio: 16/9;
    background: var(--bs-navy);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bs-product-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .bs-product-card__body {
    padding: 14px 16px;
  }
  .bs-product-card__name {
    font-size: 14px;
    font-weight: 500;
    color: var(--bs-navy);
    margin-bottom: 3px;
  }
  .bs-product-card__sub {
    font-size: 12px;
    font-weight: 300;
    color: var(--bs-muted);
    margin-bottom: 10px;
  }
  .bs-product-card__link {
    font-size: 12px;
    font-weight: 600;
    color: var(--bs-crimson);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .bs-product-card__link:hover {
    color: var(--bs-navy);
  }

  /* ── BOTTOM CTA BANNER ── */
  .bs-bottom-cta {
    padding: 40px;
    background: linear-gradient(135deg, var(--bs-navy) 0%, #3a1060 50%, var(--bs-crimson) 100%);
    border-radius: 20px;
    text-align: center;
    margin: 0 40px 64px;
    max-width: 1120px;
    margin-left: auto;
    margin-right: auto;
  }
  .bs-bottom-cta__title {
    font-size: 32px !important;
    font-weight: 600 !important;
    color: #fff !important;
    margin: 0 0 12px !important;
    line-height: 1.3;
  }
  .bs-bottom-cta__desc {
    font-size: 14px;
    font-weight: 300;
    color: rgba(255,255,255,0.75);
    margin-bottom: 28px;
  }
  .bs-bottom-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 36px;
    background: #fff;
    color: var(--bs-navy);
    border-radius: 30px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .bs-bottom-cta__btn:hover {
    opacity: 0.9;
    color: var(--bs-navy);
  }

  /* ── ALL POSTS GRID ── */
  .bs-all-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* ── RESPONSIVE ── */
