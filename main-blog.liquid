{%- liquid
  assign featured_post = blog.articles | first
  assign post_limit    = section.settings.post_limit | default: 6
  assign top_count     = section.settings.top_articles_count | default: 6
  assign loading       = 'eager'
  assign fetchpriority = 'high'
  if section.index >= 2
    assign loading       = 'lazy'
    assign fetchpriority = 'low'
  endif
-%}

