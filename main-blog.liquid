        <button type="button" class="psp-stab" data-up-side="link"><div class="psp-stab-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></div>Link Upload</button>
        <button type="button" class="psp-stab" data-up-side="email"><div class="psp-stab-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></div>Email Later</button>
      </div>
      <div class="psp-uov-con">
        <div data-up-con="direct" style="display:flex;flex-direction:column;height:100%;">
          <div class="psp-uov-th"><div class="psp-uov-th-ic"><svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg></div><div><div class="psp-uov-th-t">Direct Upload</div><div class="psp-uov-th-s">Upload from your device — JPG, PNG, PDF, AI, PSD</div></div></div>
          <div class="psp-uov-sc">
            <div class="psp-dz" id="psp-dz-{{ sid }}" role="button" tabindex="0">
              <div class="psp-dz-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg></div>
              <div class="psp-dz-txt"><strong>Drag &amp; drop</strong> your file here</div>
