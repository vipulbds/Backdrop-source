    .bs-top-grid, .bs-all-grid { grid-template-columns: 1fr; }
    .bs-design-help__grid { grid-template-columns: repeat(2, 1fr); }
    .bs-product-strip__grid { grid-template-columns: repeat(2, 1fr); }
    .bs-bottom-cta { margin: 0 16px 40px; padding: 32px 24px; }
