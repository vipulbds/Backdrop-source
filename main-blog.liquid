{%- paginate blog.articles by 100 -%}

<div class="bs-blog-wrap">

  <div class="bs-blog-main-content" id="bs-hub-content">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'hero' -%}
          {%- liquid
            assign f_art = articles[block.settings.article] | default: featured_post
          -%}
          {%- if f_art != blank -%}
            <div class="bs-blog-hero" {{ block.shopify_attributes }}>
              <div class="bs-blog-hero__inner">
                <div class="bs-blog-hero__left">
                  <div class="bs-blog-hero__label">{{ block.settings.label | default: 'Featured' }}</div>
                  <h1 class="bs-blog-hero__title">{{ f_art.title }}</h1>
                  <p class="bs-blog-hero__excerpt">{{ f_art.excerpt | strip_html | truncate: 160 }}</p>
                  <a href="{{ f_art.url }}" class="bs-blog-hero__btn">Read More &rarr;</a>
                </div>
                <div class="bs-blog-hero__image-wrap">
                  {%- if f_art.image -%}
                    {{ f_art.image | image_url: width: 960 | image_tag: loading: 'eager' }}
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}

        {%- when 'search_bar' -%}
          <div class="bs-blog-filter" {{ block.shopify_attributes }}>
            <div class="bs-blog-filter__inner">
              <div class="bs-blog-filter__search">
                <span class="bs-blog-filter__search-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </span>
                <input type="text" placeholder="{{ block.settings.placeholder | default: 'Search articles...' }}" id="bs-search-input">
              </div>
            </div>
          </div>

        {%- when 'top_articles' -%}
          <div class="bs-section" {{ block.shopify_attributes }}>
            <div class="bs-section__inner">
              <div class="bs-section__header">
                <h2 class="bs-section__heading">{{ block.settings.title | default: 'Top Articles' }}</h2>
                <a href="{{ blog.url }}" class="bs-section__view-all">View All &rarr;</a>
              </div>
              <div class="bs-top-grid">
                {%- for article in blog.articles limit: block.settings.count -%}
                  <a href="{{ article.url }}" class="bs-article-card" data-title="{{ article.title | downcase }}">
                    <div class="bs-article-card__image">
                      {%- if article.image -%}
                        {{ article.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
                      {%- endif -%}
                    </div>
                    <div class="bs-article-card__body">
                      <h3 class="bs-article-card__title">{{ article.title }}</h3>
                      <span class="bs-article-card__cat">Read article &rarr;</span>
                    </div>
                  </a>
                {%- endfor -%}
              </div>
            </div>
          </div>

        {%- when 'category_section' -%}
          {%- liquid
            assign tag = block.settings.tag
            assign tag_articles = blog.articles | where: 'tags', tag
          -%}
          {%- if tag_articles.size > 0 -%}
            <div class="bs-section" {{ block.shopify_attributes }}>
              <div class="bs-section__inner">
                <div class="bs-section__header">
                  <div class="bs-section__header-left">
                    <span class="bs-section__tag-pill">{{ tag | upcase }}</span>
                    <h2 class="bs-section__heading">{{ block.settings.title | default: tag }}</h2>
                  </div>
                  <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="bs-section__view-all">View All &rarr;</a>
                </div>
                <div class="bs-cat-layout">
                  {%- assign cat_f = tag_articles | first -%}
                  <a href="{{ cat_f.url }}" class="bs-cat-featured" data-title="{{ cat_f.title | downcase }}">
                    <div class="bs-cat-featured__image">
                      {%- if cat_f.image -%}
                        {{ cat_f.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
                      {%- endif -%}
                    </div>
                    <div class="bs-cat-featured__body">
                      <h3 class="bs-cat-featured__title">{{ cat_f.title }}</h3>
                      <span class="bs-cat-featured__link">Read more &rarr;</span>
                    </div>
                  </a>
                  <div class="bs-cat-list">
                    {%- for a in tag_articles offset: 1 limit: 3 -%}
                      <a href="{{ a.url }}" class="bs-cat-small" data-title="{{ a.title | downcase }}">
                        <div class="bs-cat-small__body">
                          <h4 class="bs-cat-small__title">{{ a.title }}</h4>
                        </div>
                      </a>
                    {%- endfor -%}
                  </div>
                </div>
                
                {%- if block.settings.collection != blank -%}
                  {%- assign promo_col = collections[block.settings.collection] -%}
                  <div class="bs-product-strip" style="margin-top: 32px;">
                    <div class="bs-product-strip__header">
                      <div class="bs-product-strip__label">🎯 Recommended for {{ tag }}</div>
                      <a href="{{ promo_col.url }}" class="bs-product-strip__shop">Shop all &rarr;</a>
                    </div>
                    <div class="bs-product-strip__grid">
                      {%- for product in promo_col.products limit: 4 -%}
                        <a href="{{ product.url }}" class="bs-product-card">
                          <div class="bs-product-card__image">
                            {%- if product.featured_image -%}
                              {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy' }}
                            {%- endif -%}
                          </div>
                          <div class="bs-product-card__body">
                            <div class="bs-product-card__name">{{ product.title }}</div>
                            <div class="bs-product-card__sub">From {{ product.price_min | money }}</div>
                          </div>
                        </a>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

        {%- when 'product_strip' -%}
          {%- assign promo_col = collections[block.settings.collection] -%}
          {%- if promo_col != blank -%}
            <div class="bs-section" {{ block.shopify_attributes }}>
              <div class="bs-section__inner">
                <div class="bs-product-strip">
                  <div class="bs-product-strip__header">
                    <h2 class="bs-section__heading">{{ block.settings.title | default: promo_col.title }}</h2>
                    <a href="{{ promo_col.url }}" class="bs-product-strip__shop">Shop Collection &rarr;</a>
                  </div>
                  <div class="bs-product-strip__grid">
                    {%- for product in promo_col.products limit: block.settings.count -%}
                      <a href="{{ product.url }}" class="bs-product-card">
                        <div class="bs-product-card__image">
                          {%- if product.featured_image -%}
                            {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy' }}
                          {%- endif -%}
                        </div>
                        <div class="bs-product-card__body">
                          <div class="bs-product-card__name">{{ product.title }}</div>
                          <div class="bs-product-card__sub">{{ product.price | money }}</div>
                        </div>
                      </a>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}

        {%- when 'cta_banner' -%}
          <div class="bs-section" {{ block.shopify_attributes }}>
            <div class="bs-section__inner">
              <div class="bs-cta-banner">
                <div class="bs-cta-banner__left">
                  <div class="bs-cta-banner__label">+ {{ block.settings.label }}</div>
                  <h3 class="bs-cta-banner__title">{{ block.settings.title }}</h3>
                  <p class="bs-cta-banner__desc">{{ block.settings.desc }}</p>
                  <a href="{{ block.settings.button_url | default: '#' }}" class="bs-cta-banner__btn">{{ block.settings.button_label }} &rarr;</a>
                </div>
                <div class="bs-cta-banner__right">
                  <div class="bs-cta-banner__ql-label">Quick Links</div>
                  <ul class="bs-cta-banner__ql-list">
                    <li><a href="#" data-psp-open="cs-{{ section.id }}"><span class="bs-cta-banner__ql-arrow">→</span> Custom Size Quote</a></li>
                    <li><a href="#" data-psp-open="dh-{{ section.id }}"><span class="bs-cta-banner__ql-arrow">→</span> Request 2D Mockup</a></li>
                    <li><a href="#" data-psp-open="up-{{ section.id }}"><span class="bs-cta-banner__ql-arrow">→</span> Upload Artwork</a></li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

        {%- when 'design_help' -%}
          <div class="bs-section" {{ block.shopify_attributes }}>
            <div class="bs-section__inner">
              <div class="bs-design-help">
                <div class="bs-design-help__header">
                  <div class="bs-design-help__label">🎨 Need Design Help?</div>
                </div>
                <div class="bs-design-help__grid">
                  <a href="#" class="bs-design-help__card" data-psp-open="cs-{{ section.id }}">
                    <div class="bs-design-help__card-image" style="background: linear-gradient(135deg,#1a4a2e,#2d7a4f);">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="m18.5 2.5 2 2L12 13l-3 1 1-3 7.5-7.5z"/></svg>
                    </div>
                    <div class="bs-design-help__card-body">
                      <div class="bs-design-help__card-title">Custom Quote</div>
                      <span class="bs-design-help__card-link">Get a quote &rarr;</span>
                    </div>
                  </a>
                  <a href="#" class="bs-design-help__card" data-psp-open="dh-{{ section.id }}">
                    <div class="bs-design-help__card-image" style="background: linear-gradient(135deg,#1a1a4e,#3a3a9e);">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                    </div>
                    <div class="bs-design-help__card-body">
                      <div class="bs-design-help__card-title">2D Mockup Proof</div>
                      <span class="bs-design-help__card-link">Request mockup &rarr;</span>
                    </div>
                  </a>
                  <a href="#" class="bs-design-help__card" data-psp-open="up-{{ section.id }}">
                    <div class="bs-design-help__card-image" style="background: linear-gradient(135deg,#6a1030,#b31942);">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    </div>
                    <div class="bs-design-help__card-body">
                      <div class="bs-design-help__card-title">Upload Artwork</div>
                      <span class="bs-design-help__card-link">Upload now &rarr;</span>
                    </div>
                  </a>
                  <a href="{{ block.settings.templates_url | default: '#' }}" class="bs-design-help__card">
                    <div class="bs-design-help__card-image" style="background: linear-gradient(135deg,#5a3a00,#a06010);">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 22V4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v18"/><path d="M9 22v-4h6v4"/></svg>
                    </div>
                    <div class="bs-design-help__card-body">
                      <div class="bs-design-help__card-title">Design Templates</div>
                      <span class="bs-design-help__card-link">Download &rarr;</span>
                    </div>
                  </a>
                </div>
              </div>
            </div>
          </div>

        {%- when 'bottom_cta' -%}
          <div style="padding: 48px 0;" {{ block.shopify_attributes }}>
            <div class="bs-bottom-cta">
              <h2 class="bs-bottom-cta__title">{{ block.settings.title }}</h2>
              <p class="bs-bottom-cta__desc">{{ block.settings.desc }}</p>
              <a href="{{ block.settings.button_url | default: '#' }}" class="bs-bottom-cta__btn">{{ block.settings.button_label }} &rarr;</a>
            </div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- comment -%}── PAGINATION ──{%- endcomment -%}
  {%- if paginate.pages > 1 -%}
    <div class="bs-section">
      <div class="bs-section__inner">
        {%- render 'pagination', paginate: paginate -%}
      </div>
    </div>
  {%- endif -%}

</div>

<script>
(function() {
  // ── SEARCH FUNCTIONALITY ──
  var searchInput = document.getElementById('bs-search-input');
  var hubContent = document.getElementById('bs-hub-content');

  if (searchInput && hubContent) {
    searchInput.addEventListener('input', function(e) {
      var query = e.target.value.toLowerCase().trim();
      var articles = hubContent.querySelectorAll('[data-title]');

      articles.forEach(function(article) {
        var title = article.getAttribute('data-title') || '';
        if (title.includes(query)) {
          article.style.display = '';
          article.style.opacity = '1';
        } else {
          article.style.display = 'none';
          article.style.opacity = '0';
        }
      });
    });
  }
})();
</script>

