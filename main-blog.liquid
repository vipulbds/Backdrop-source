            <div class="psp-link-logos" style="margin-top:16px;">
              <a href="https://www.dropbox.com/" target="_blank" rel="noopener"><img src="https://cdn.shopify.com/s/files/1/1065/1408/files/Drop_Box.png?v=1649155936" alt="Dropbox"></a>
              <a href="https://wetransfer.com/" target="_blank" rel="noopener"><img src="https://cdn.shopify.com/s/files/1/1065/1408/files/Wetransfer.png?v=1649155936" alt="WeTransfer" style="width:44px"></a>
              <a href="https://onedrive.live.com/" target="_blank" rel="noopener"><img src="https://cdn.shopify.com/s/files/1/1065/1408/files/One_Drive.png?v=1649155936" alt="OneDrive" style="width:38px"></a>
              <a href="https://drive.google.com/" target="_blank" rel="noopener"><img src="https://cdn.shopify.com/s/files/1/1065/1408/files/Google_drive.png?v=1649155936" alt="Google Drive"></a>
            </div>
            <div class="psp-up-st" id="psp-lk-st-{{ sid }}"></div>
          </div>
          <div class="psp-uov-ft"><span class="psp-fnote">Zip multiple files or paste a shared folder link.</span><button type="button" class="psp-svcont" id="psp-lk-sv-{{ sid }}">Save &amp; Continue</button></div>
        </div>
        <div data-up-con="email" style="display:none;flex-direction:column;height:100%;">
          <div class="psp-uov-th"><div class="psp-uov-th-ic"><svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></div><div><div class="psp-uov-th-t">Email Later</div><div class="psp-uov-th-s">Place your order now and email files after</div></div></div>
          <div class="psp-uov-sc"><div class="psp-eml-card" style="font-size:15px;padding:20px;">You can proceed now and email your artwork to <strong>{{ shop.email }}</strong> later.<br><br>We will send a proof once we receive your files.</div></div>
          <div class="psp-uov-ft"><button type="button" class="psp-svcont" id="psp-em-sv-{{ sid }}">Save &amp; Continue</button></div>
