<style>
/* ==========================================================
   BDS BLOG HUB  |  Brand Design System
   Font   : Inter
   H1     : 45px / 900  → mobile 28px / 400
   H2     : 30px / 400  → mobile 25px / 300
   H3     : 20px / 400
   H4     : 19px / 300
   Body   : 15px / 200  → mobile 14px / 200
   Btn/Nav: 15px / 200  → mobile 13px / 200
   Navy   : #0A3161   Crimson : #B31942
   White  : #FFFFFF   Off-white: #F5F6F8   Border: #E0E4EE
========================================================== */
:root {
  --bh-navy       : #0A3161;
  --bh-navy-mid   : #1a4a8a;
  --bh-navy-light : #2e5fa0;
  --bh-crimson    : #B31942;
  --bh-crimson-hov: #8f0f2e;
  --bh-crimson-soft: rgba(179,25,66,.08);
  --bh-white      : #ffffff;
  --bh-offwhite   : #F5F6F8;
  --bh-gray-light : #f8f9fb;
  --bh-border     : #E0E4EE;
  --bh-text       : #0A3161;
  --bh-text-mid   : #4a5568;
  --bh-text-light : #8896a8;
  --bh-font       : 'Inter', sans-serif;
  --bh-max        : 1200px;
  --bh-h1         : 45px;
  --bh-h2         : 30px;
  --bh-h3         : 20px;
  --bh-h4         : 19px;
  --bh-body       : 15px;
  --bh-btn        : 15px;
  --bh-nav        : 15px;
}

.bh *, .bh *::before, .bh *::after { box-sizing: border-box; margin: 0; padding: 0; }
.bh { font-family: var(--bh-font); color: var(--bh-text); background: var(--bh-white); }
.bh a { text-decoration: none; color: inherit; }
.bh-inner { max-width: var(--bh-max); margin: 0 auto; padding: 0 48px; }

/* ── HERO FEATURED ── */
.bh-hero {
  background: linear-gradient(120deg, #f0f3fa 0%, #e8ecf6 100%);
  padding: 60px 0;
}
.bh-hero__inner {
  max-width: var(--bh-max); margin: 0 auto; padding: 0 48px;
  display: grid; grid-template-columns: 1fr 520px;
  gap: 56px; align-items: center;
}
.bh-hero__label {
  font-size: 11px; font-weight: 800; text-transform: uppercase;
  letter-spacing: 2px; color: var(--bh-text-light);
  margin-bottom: 14px; text-align: left !important;
}
.bh-hero__title {
  font-size: var(--bh-h1); font-weight: 900; line-height: 1.1;
  color: var(--bh-navy); margin-bottom: 18px; letter-spacing: -1px;
}
.bh-hero__excerpt {
  font-size: var(--bh-body); font-weight: 300; color: var(--bh-text-mid);
  line-height: 1.7; margin-bottom: 28px; max-width: 420px;
}
.bh-hero__btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 13px 28px; background: var(--bh-navy); color: var(--bh-white);
  border-radius: 50px; font-family: var(--bh-font);
  font-size: var(--bh-btn); font-weight: 700;
  transition: background .2s, transform .15s;
}
.bh-hero__btn:hover { background: var(--bh-navy-mid); transform: translateY(-1px); }
/* Force white text — overrides Sleek theme global a{} rules */
.bh-hero__btn,
.bh-hero__btn:link,
.bh-hero__btn:visited { color: #ffffff !important; text-decoration: none !important; }
.bh-hero__btn:hover,
.bh-hero__btn:active { color: #ffffff !important; text-decoration: none !important; }
.bh-hero__btn svg { width: 16px; height: 16px; }
.bh-hero__visual {
  border-radius: 20px; overflow: hidden; aspect-ratio: 16/10;
  background: linear-gradient(135deg, var(--bh-navy) 0%, #3a5080 40%, var(--bh-crimson) 100%);
  display: flex; align-items: center; justify-content: center;
  position: relative; box-shadow: 0 20px 60px rgba(10,49,97,.2);
}
.bh-hero__visual img { width: 100%; height: 100%; object-fit: cover; display: block; }
.bh-hero__visual-placeholder {
  text-align: center; color: rgba(255,255,255,.35); font-size: 13px; font-weight: 600;
}
.bh-hero__visual-placeholder svg { width: 52px; height: 52px; opacity: .3; margin: 0 auto 10px; display: block; }
.bh-hero__tag {
  position: absolute; bottom: 20px; left: 20px;
  background: rgba(255,255,255,.15); backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,.2); color: var(--bh-white);
  padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 700;
}

/* ── SEARCH SECTION — two separate rows, exactly as source ── */
.bh-search-section {
  background: var(--bh-white);
  border-bottom: 1px solid var(--bh-border);
  padding: 0 48px;
  position: sticky; top: 0; z-index: 150;
}
.bh-search-section__inner { max-width: var(--bh-max); margin: 0 auto; }

/* ROW 1: search input */
.bh-search-row {
  display: flex; align-items: center; gap: 16px;
  padding: 16px 0;
  border-bottom: 1px solid var(--bh-border);
}
.bh-search-wrap { position: relative; width: 320px; flex-shrink: 0; }
.bh-search-icon {
  position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
  color: var(--bh-text-light); display: flex;
}
.bh-search-icon svg { width: 16px; height: 16px; }
.bh-search-input {
  width: 100%; padding: 10px 14px 10px 40px;
  border: 1.5px solid var(--bh-border); border-radius: 50px;
  font-family: var(--bh-font); font-size: var(--bh-nav); font-weight: 300;
  color: var(--bh-text); background: var(--bh-gray-light);
  outline: none; transition: border-color .2s, box-shadow .2s;
}
.bh-search-input::placeholder { color: var(--bh-text-light); }
.bh-search-input:focus {
  border-color: var(--bh-navy);
  box-shadow: 0 0 0 3px rgba(10,49,97,.07);
  background: var(--bh-white);
}
.bh-search-hint { font-size: 12.5px; color: var(--bh-text-light); }

/* ROW 2: category tabs */
.bh-cat-tabs {
  display: flex; gap: 4px;
  padding: 14px 0;
  overflow-x: auto; scrollbar-width: none;
}
.bh-cat-tabs::-webkit-scrollbar { display: none; }
.bh-cat-tab {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 8px 18px; border-radius: 50px;
  border: 1.5px solid var(--bh-border); background: var(--bh-white);
  font-family: var(--bh-font); font-size: var(--bh-nav); font-weight: 600;
  color: var(--bh-text-mid); cursor: pointer; white-space: nowrap;
  text-decoration: none; flex-shrink: 0; transition: all .18s;
}
.bh-cat-tab:hover { border-color: var(--bh-navy); color: var(--bh-navy); background: var(--bh-gray-light); }
.bh-cat-tab.active { background: var(--bh-navy); border-color: var(--bh-navy); color: var(--bh-white); }
.bh-cat-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; flex-shrink: 0; }

/* ── PAGE WRAP ── */
.bh-page { max-width: var(--bh-max); margin: 0 auto; padding: 0 48px; }

/* ── SECTION HEADER ── */
.bh-sec-hdr {
  display: flex; align-items: baseline; justify-content: space-between;
  margin: 48px 0 24px;
}
.bh-sec-hdr h2 { font-size: var(--bh-h2); font-weight: 800; color: var(--bh-navy); letter-spacing: -.3px; }
.bh-view-all {
  font-size: var(--bh-nav); font-weight: 700; color: var(--bh-text-mid);
  display: flex; align-items: center; gap: 4px; transition: color .15s;
}
.bh-view-all:hover { color: var(--bh-crimson); }
.bh-view-all svg { width: 14px; height: 14px; }

/* ── TOP ARTICLES GRID ── */
.bh-art-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
.bh-art-card {
  border-radius: 16px; overflow: hidden;
  border: 1px solid var(--bh-border); background: var(--bh-white);
  transition: transform .2s, box-shadow .2s;
  display: block; text-decoration: none; color: inherit; cursor: pointer;
}
.bh-art-card:hover { transform: translateY(-3px); box-shadow: 0 12px 36px rgba(10,49,97,.1); }
.bh-art-card__img {
  height: 200px; display: flex; align-items: center; justify-content: center;
  position: relative; overflow: hidden;
  background: linear-gradient(135deg, var(--bh-navy), var(--bh-navy-light));
}
.bh-art-card__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s; }
.bh-art-card:hover .bh-art-card__img img { transform: scale(1.04); }
.bh-art-card__label {
  position: absolute; bottom: 12px; left: 12px;
  background: rgba(255,255,255,.15); backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.2); color: var(--bh-white);
  padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700;
}
.bh-art-card__body { padding: 18px 20px 20px; }
.bh-art-card__cat {
  font-size: 10.5px; font-weight: 800; text-transform: uppercase;
  letter-spacing: 1px; color: var(--bh-crimson); margin-bottom: 8px;
}
.bh-art-card__title { font-size: var(--bh-h4); font-weight: 700; color: var(--bh-navy); line-height: 1.4; margin-bottom: 10px; }
.bh-art-card__meta { font-size: 12px; color: var(--bh-text-light); display: flex; align-items: center; gap: 8px; }

/* ── ARTICLES PAGINATION ── */
.bh-pagination { display: flex; align-items: center; justify-content: center; gap: 10px; margin: 36px 0 0; flex-wrap: wrap; }
.bh-pg-btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 10px 22px; border: 1.5px solid var(--bh-border); border-radius: 50px;
  background: var(--bh-white); color: var(--bh-text-mid);
  font-family: var(--bh-font); font-size: 14px; font-weight: 600;
  cursor: pointer; transition: all .18s;
}
.bh-pg-btn:hover:not(:disabled) { border-color: var(--bh-navy); color: var(--bh-navy); background: var(--bh-gray-light); }
.bh-pg-btn:disabled { opacity: .35; cursor: not-allowed; pointer-events: none; }
.bh-pg-btn svg { width: 14px; height: 14px; flex-shrink: 0; }
.bh-pg-nums { display: flex; gap: 6px; align-items: center; }
.bh-pg-num {
  width: 38px; height: 38px; border-radius: 50%;
  border: 1.5px solid var(--bh-border); background: var(--bh-white); color: var(--bh-text-mid);
  font-family: var(--bh-font); font-size: 14px; font-weight: 600;
  cursor: pointer; transition: all .18s; display: flex; align-items: center; justify-content: center;
}
.bh-pg-num:hover { border-color: var(--bh-navy); color: var(--bh-navy); background: var(--bh-gray-light); }
.bh-pg-num.active { background: var(--bh-navy); border-color: var(--bh-navy); color: var(--bh-white); }

/* ── PROMO BANNER ── */
.bh-promo {
  margin: 52px 0; border-radius: 20px; overflow: hidden;
  display: grid; grid-template-columns: 1fr 1fr; min-height: 280px;
}
.bh-promo__left {
  background: linear-gradient(135deg, var(--bh-navy) 0%, var(--bh-navy-light) 100%);
  padding: 44px 48px; display: flex; flex-direction: column; justify-content: center;
}
.bh-promo__kicker {
  font-size: 11px; font-weight: 800; letter-spacing: 2px;
  text-transform: uppercase; color: rgba(255,255,255,.5); margin-bottom: 12px;
}
.bh-promo__title {
  font-size: var(--bh-h2); font-weight: 900; color: var(--bh-white);
  line-height: 1.2; letter-spacing: -.5px; margin-bottom: 14px;
}
.bh-promo__desc {
  font-size: 14.5px; font-weight: 300; color: rgba(255,255,255,.65);
  line-height: 1.6; margin-bottom: 24px;
}
.bh-promo__btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 26px; background: var(--bh-crimson); color: #ffffff !important;
  border-radius: 50px; font-family: var(--bh-font);
  font-size: var(--bh-btn); font-weight: 700;
  align-self: flex-start; transition: background .2s, color .2s;
  border: none; cursor: pointer; text-decoration: none;
}
.bh-promo__btn:link, .bh-promo__btn:visited { color: #ffffff !important; }
.bh-promo__btn:hover { background: var(--bh-crimson-hov); color: #ffffff !important; text-decoration: none; }
.bh-promo__right {
  background: linear-gradient(135deg, #edf1fa, #e0e6f5);
  border-left: 1px solid var(--bh-border);
  padding: 32px; display: flex; align-items: center;
}
.bh-promo__ql {
  background: var(--bh-white); border: 1px solid var(--bh-border);
  border-radius: 14px; padding: 20px 22px; width: 100%;
}
.bh-promo__ql-label {
  font-size: 11px; font-weight: 800; letter-spacing: 1px;
  text-transform: uppercase; color: var(--bh-text-light); margin-bottom: 8px;
}
.bh-promo__ql-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
.bh-promo__ql-list li a {
  font-size: 13.5px; font-weight: 600; color: var(--bh-text-mid);
  display: flex; align-items: center; gap: 8px;
  transition: color .15s; cursor: pointer;
}
.bh-promo__ql-list li a:hover { color: var(--bh-crimson); }

/* ── CATEGORY SECTION ── */
.bh-cat { margin: 56px 0; }
.bh-cat__hdr { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
.bh-cat__hdr-left { display: flex; align-items: center; gap: 12px; }
.bh-cat__pill { padding: 5px 14px; border-radius: 20px; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .8px; }
.bh-cat__hdr-left h2 { font-size: 22px; font-weight: 800; color: var(--bh-navy); }
.bh-cat__layout { display: grid; grid-template-columns: 1.3fr 1fr; gap: 24px; margin-bottom: 24px; }

.bh-cat__feat {
  border-radius: 16px; overflow: hidden; border: 1px solid var(--bh-border);
  background: var(--bh-white); display: flex; flex-direction: column;
  transition: transform .2s, box-shadow .2s; cursor: pointer; text-decoration: none; color: inherit;
}
.bh-cat__feat:hover { transform: translateY(-3px); box-shadow: 0 12px 36px rgba(10,49,97,.1); }
.bh-cat__feat-img { height: 260px; position: relative; overflow: hidden; background: linear-gradient(135deg, var(--bh-navy), var(--bh-navy-light)); }
.bh-cat__feat-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s; }
.bh-cat__feat:hover .bh-cat__feat-img img { transform: scale(1.04); }
.bh-cat__feat-label {
  position: absolute; bottom: 12px; left: 12px;
  background: rgba(255,255,255,.15); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.2); color: var(--bh-white);
  padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700;
}
.bh-cat__feat-body { padding: 22px 24px 24px; flex: 1; }
.bh-cat__feat-cat { font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--bh-crimson); margin-bottom: 8px; }
.bh-cat__feat-title { font-size: var(--bh-h3); font-weight: 800; color: var(--bh-navy); line-height: 1.35; margin-bottom: 10px; }
.bh-cat__feat-exc { font-size: var(--bh-body); font-weight: 300; color: var(--bh-text-mid); line-height: 1.6; margin-bottom: 14px; }
.bh-cat__feat-link { font-size: 13px; font-weight: 700; color: var(--bh-crimson); display: flex; align-items: center; gap: 5px; }

.bh-cat__side-list { display: flex; flex-direction: column; gap: 14px; }
.bh-cat__side-card {
  border-radius: 12px; overflow: hidden; border: 1px solid var(--bh-border);
  background: var(--bh-white); display: grid; grid-template-columns: 100px 1fr;
  transition: transform .2s, box-shadow .2s; cursor: pointer; text-decoration: none; color: inherit;
}
.bh-cat__side-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(10,49,97,.08); }
.bh-cat__side-img { height: 90px; width: 100px; background: linear-gradient(135deg, var(--bh-navy), var(--bh-navy-light)); overflow: hidden; }
.bh-cat__side-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.bh-cat__side-body { padding: 12px 14px; display: flex; flex-direction: column; justify-content: center; }
.bh-cat__side-cat { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--bh-crimson); margin-bottom: 4px; }
.bh-cat__side-title { font-size: 13.5px; font-weight: 700; color: var(--bh-navy); line-height: 1.35; }
.bh-cat__side-meta { font-size: 12px; color: var(--bh-text-light); margin-top: 6px; }

/* ── PRODUCT STRIP ── */
.bh-prod-strip { background: var(--bh-gray-light); border: 1px solid var(--bh-border); border-radius: 16px; padding: 22px 24px; margin-top: 8px; }
.bh-prod-strip__hdr { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
.bh-prod-strip__title { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--bh-text-light); }
.bh-prod-strip__link { font-size: 12.5px; font-weight: 700; color: var(--bh-crimson); text-decoration: none; }
.bh-prod-strip__link:hover { text-decoration: underline; }
.bh-prod-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; }
.bh-prod-card {
  background: var(--bh-white); border: 1.5px solid var(--bh-border);
  border-radius: 12px; overflow: hidden;
  transition: border-color .18s, transform .18s, box-shadow .18s;
  text-decoration: none; color: inherit; display: block; cursor: pointer;
}
.bh-prod-card:hover { border-color: var(--bh-crimson); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(179,25,66,.1); }
.bh-prod-card__img {
  height: 90px; background: linear-gradient(135deg, var(--bh-navy), var(--bh-navy-light));
  display: flex; align-items: center; justify-content: center; overflow: hidden;
}
.bh-prod-card__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.bh-prod-card__img svg { width: 28px; height: 28px; opacity: .3; color: var(--bh-white); }
.bh-prod-card__body { padding: 10px 12px 12px; }
.bh-prod-card__name { font-size: 12px; font-weight: 700; color: var(--bh-navy); margin-bottom: 3px; line-height: 1.3; }
.bh-prod-card__sub { font-size: 11px; color: var(--bh-text-light); }
.bh-prod-card__action { display: inline-flex; align-items: center; gap: 4px; margin-top: 8px; font-size: 11.5px; font-weight: 700; color: var(--bh-crimson); }

/* ── EDITOR'S PICK ── */
.bh-editors-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
.bh-editor-card {
  border-radius: 16px; overflow: hidden; cursor: pointer;
  transition: transform .2s, box-shadow .2s; text-decoration: none; color: inherit; display: block;
}
.bh-editor-card:hover { transform: translateY(-3px); box-shadow: 0 12px 36px rgba(10,49,97,.12); }
.bh-editor-card__img {
  height: 240px; background: linear-gradient(135deg, var(--bh-navy), var(--bh-navy-light));
  position: relative; overflow: hidden; border-radius: 16px;
}
.bh-editor-card__img img { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 16px; transition: transform .4s; }
.bh-editor-card:hover .bh-editor-card__img img { transform: scale(1.04); }
.bh-editor-card__label {
  position: absolute; bottom: 12px; left: 12px;
  background: rgba(255,255,255,.15); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.2); color: var(--bh-white);
  padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700;
}
.bh-editor-card__body { padding: 16px 0 4px; }
.bh-editor-card__cat { font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--bh-crimson); margin-bottom: 6px; }
.bh-editor-card__title { font-size: var(--bh-h4); font-weight: 700; color: var(--bh-navy); line-height: 1.4; }

/* ── CTA BANNER ── */
.bh-cta {
  margin: 52px 0;
  background: linear-gradient(130deg, var(--bh-navy) 0%, var(--bh-navy-light) 60%, var(--bh-crimson) 100%);
  border-radius: 20px; padding: 60px 64px; text-align: center; position: relative; overflow: hidden;
}
.bh-cta::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(ellipse at 70% 50%, rgba(179,25,66,.3) 0%, transparent 60%);
  pointer-events: none;
}
.bh-cta__title { font-size: var(--bh-h1); font-weight: 900; color: var(--bh-white); line-height: 1.15; letter-spacing: -.8px; margin-bottom: 16px; position: relative; }
.bh-cta__desc { font-size: var(--bh-body); font-weight: 300; color: rgba(255,255,255,.65); margin-bottom: 30px; position: relative; }
.bh-cta__btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 15px 36px; background: var(--bh-white); color: var(--bh-navy);
  border-radius: 50px; font-family: var(--bh-font); font-size: var(--bh-btn); font-weight: 800;
  position: relative; transition: transform .15s, box-shadow .15s; text-decoration: none;
}
.bh-cta__btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.2); }

