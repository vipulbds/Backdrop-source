{%- comment -%}── CATEGORY SECTIONS — supports up to 8 tags ──{%- endcomment -%}
{%- assign pill_bgs  = 'rgba(179,25,66,.1)||rgba(26,107,74,.1)||rgba(26,80,160,.1)||rgba(139,58,139,.1)||rgba(184,106,28,.1)||rgba(26,122,154,.1)||rgba(122,58,32,.1)||rgba(74,32,96,.1)' | split: '||' -%}
{%- assign pill_cols = '#b81c3c||#1a6b4a||#1a50a0||#8b3a8b||#b86a1c||#1a7a9a||#7a3a20||#4a2060' | split: '||' -%}
{%- assign cat_emojis = '🎯||🎨||🏛️||💍||🖨️||✨||📸||🎪' | split: '||' -%}


{%- for tag in blog.tags limit: 8 -%}
  {%- liquid
    assign cat_key     = 'cat_heading_' | append: forloop.index
    assign cat_heading = section.settings[cat_key] | default: tag
    assign col_key     = 'product_collection_' | append: forloop.index
    assign col_handle  = section.settings[col_key]
    assign pill_bg     = pill_bgs[forloop.index0]  | default: 'rgba(179,25,66,.1)'
    assign pill_color  = pill_cols[forloop.index0] | default: '#b81c3c'
    assign cat_emoji   = cat_emojis[forloop.index0] | default: '🎯'

    assign cat_articles = '' | split: ','
  -%}
  {%- assign tag_lc = tag | downcase -%}
  {%- for article in blog.articles -%}
    {%- assign a_tags_lc = article.tags | join: '|' | downcase -%}
    {%- if article.tags contains tag or a_tags_lc contains tag_lc -%}
      {%- assign cat_articles = cat_articles | push: article -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign cat_feat = cat_articles | first -%}

  {%- if cat_articles.size > 0 and cat_feat.url != blank -%}
    <div class="bh-cat">
      <div class="bh-cat__hdr">
        <div class="bh-cat__hdr-left">
          <span class="bh-cat__pill" style="background:{{ pill_bg }};color:{{ pill_color }};">{{ tag | upcase }}</span>
          <h2>{{ cat_heading }}</h2>
        </div>
        <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="bh-view-all">View All <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </div>

      <div class="bh-cat__layout">
        {%- liquid
          assign cf_words = cat_feat.content | strip_html | split: ' ' | size
          assign cf_mins  = cf_words | divided_by: 200
          if cf_mins < 1
            assign cf_mins = 1
          endif
        -%}
        <a href="{{ cat_feat.url }}" class="bh-cat__feat">
          <div class="bh-cat__feat-img">
            {%- if cat_feat.image -%}{{ cat_feat.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: cat_feat.image.alt }}{%- endif -%}
            <div class="bh-cat__feat-label">Featured</div>
          </div>
          <div class="bh-cat__feat-body">
            <div class="bh-cat__feat-cat">{{ tag | upcase }}</div>
            <h3 class="bh-cat__feat-title">{{ cat_feat.title }}</h3>
            {%- if cat_feat.excerpt != blank -%}<p class="bh-cat__feat-exc">{{ cat_feat.excerpt | strip_html | truncate: 120 }}</p>{%- endif -%}
            <span class="bh-cat__feat-link">Read article →</span>
          </div>
        </a>

        <div class="bh-cat__side-list">
          {%- assign side_count = 0 -%}
          {%- for sa in cat_articles -%}
            {%- if sa.id == cat_feat.id -%}{%- continue -%}{%- endif -%}
            {%- if side_count >= 3 -%}{%- break -%}{%- endif -%}
            {%- assign side_count = side_count | plus: 1 -%}
            {%- liquid
              assign sa_words = sa.content | strip_html | split: ' ' | size
              assign sa_mins  = sa_words | divided_by: 200
              if sa_mins < 1
                assign sa_mins = 1
              endif
            -%}
            <a href="{{ sa.url }}" class="bh-cat__side-card">
              <div class="bh-cat__side-img">{%- if sa.image -%}{{ sa.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: sa.image.alt }}{%- endif -%}</div>
              <div class="bh-cat__side-body">
                <div class="bh-cat__side-cat">{{ tag | upcase }}</div>
                <div class="bh-cat__side-title">{{ sa.title }}</div>
                <div class="bh-cat__side-meta">{{ sa_mins }} min read</div>
              </div>
            </a>
          {%- endfor -%}
        </div>
      </div>

      {%- if col_handle != blank -%}
        {%- assign promo_col = collections[col_handle] -%}
        {%- if promo_col == blank -%}{%- assign promo_col = col_handle -%}{%- endif -%}
        {%- if promo_col != blank and promo_col.products.size > 0 -%}
          <div class="bh-prod-strip">
            <div class="bh-prod-strip__hdr">
              <div class="bh-prod-strip__title">{{ cat_emoji }} Popular for {{ tag }}</div>
              <a href="{{ promo_col.url }}" class="bh-prod-strip__link">Shop all →</a>
            </div>
            <div class="bh-prod-row">
              {%- for product in promo_col.products limit: 4 -%}
                <a href="{{ product.url }}" class="bh-prod-card">
                  <div class="bh-prod-card__img">
                    {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: product.featured_image.alt }}{%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/></svg>{%- endif -%}
                  </div>
                  <div class="bh-prod-card__body">
                    <div class="bh-prod-card__name">{{ product.title }}</div>
                    <div class="bh-prod-card__sub">From {{ product.price_min | money }}</div>
                    <div class="bh-prod-card__action">Order now →</div>
                  </div>
                </a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endfor -%}
{%- endpaginate -%}

{%- comment -%}── EDITOR'S PICK — latest 3 non-featured ──{%- endcomment -%}
{%- assign featured_id   = featured_post.id -%}
{%- assign editors_count = 0 -%}
<div class="bh-sec-hdr">
  <h2>Editor's Pick</h2>
  <a href="{{ blog.url }}" class="bh-view-all">View All <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
</div>
<div class="bh-editors-grid">
  {%- for article in all_blog_articles -%}
    {%- if editors_count >= 3 -%}{%- break -%}{%- endif -%}
    {%- if article.id == featured_id -%}{%- continue -%}{%- endif -%}
    {%- assign ed_tag = article.tags | first -%}
    {%- assign editors_count = editors_count | plus: 1 -%}
    <a href="{{ article.url }}" class="bh-editor-card">
      <div class="bh-editor-card__img">
        {%- if article.image -%}{{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: article.image.alt }}{%- endif -%}
        {%- if ed_tag != blank -%}<div class="bh-editor-card__label">{{ ed_tag }}</div>{%- endif -%}
      </div>
      <div class="bh-editor-card__body">
        {%- if ed_tag != blank -%}<div class="bh-editor-card__cat">{{ ed_tag | upcase }}</div>{%- endif -%}
        <div class="bh-editor-card__title">{{ article.title }}</div>
      </div>
    </a>
  {%- endfor -%}
</div>

{%- comment -%}── CTA BANNER ──{%- endcomment -%}
{%- if section.settings.show_cta -%}
<div class="bh-cta">
  <div class="bh-cta__title">{{ section.settings.cta_title | default: 'Print a backdrop that makes every event unforgettable' }}</div>
  <p class="bh-cta__desc">{{ section.settings.cta_desc | default: 'Free shipping · 1-year warranty · Delivered in 3–5 business days · 22 years of service' }}</p>
