/* ── Article pagination ── */
var bhPgSize={{ top_count }},bhPgCur=1;
var bhItems=Array.from(document.querySelectorAll('.bh-art-page-item'));
var bhPgTotal=Math.ceil(bhItems.length/bhPgSize);
function bhBuildNums(){
  var nums=$i('bh-pg-nums');if(!nums)return;
  nums.innerHTML='';
  var start=Math.max(1,bhPgCur-2),end=Math.min(bhPgTotal,start+4);
  start=Math.max(1,end-4);
  for(var p=start;p<=end;p++){
    (function(pg){
      var b=document.createElement('button');
      b.className='bh-pg-num'+(pg===bhPgCur?' active':'');
      b.textContent=pg;
      b.addEventListener('click',function(){bhShowPage(pg);});
      nums.appendChild(b);
    })(p);
  }
}
function bhShowPage(n){
  bhPgCur=Math.max(1,Math.min(n,bhPgTotal));
  var s=(bhPgCur-1)*bhPgSize,e=s+bhPgSize;
  bhItems.forEach(function(c,i){c.style.display=(i>=s&&i<e)?'':'none';});
  var prev=$i('bh-pg-prev'),next=$i('bh-pg-next');
  if(prev)prev.disabled=bhPgCur<=1;
  if(next)next.disabled=bhPgCur>=bhPgTotal;
  bhBuildNums();
  var grid=$i('bh-art-grid');
  if(grid)grid.scrollIntoView({behavior:'smooth',block:'nearest'});
}
if(bhItems.length>bhPgSize){
  var bhPgEl=$i('bh-pagination');if(bhPgEl)bhPgEl.style.display='';
  bhShowPage(1);
  var bhPrev=$i('bh-pg-prev'),bhNext=$i('bh-pg-next');
  if(bhPrev)bhPrev.addEventListener('click',function(){bhShowPage(bhPgCur-1);});
  if(bhNext)bhNext.addEventListener('click',function(){bhShowPage(bhPgCur+1);});
}

/* ── Search filter ── */
var searchInput=$i('bh-search-input'),hint=$i('bh-search-hint');
var cards=document.querySelectorAll('.bh-art-card[data-title]');
if(searchInput&&cards.length){searchInput.addEventListener('input',function(){
  var q=this.value.toLowerCase().trim();
  if(hint)hint.textContent=q.length>2?'Searching for "'+q+'"…':'';
  var pg=$i('bh-pagination');
  if(q){
    if(pg)pg.style.display='none';
    cards.forEach(function(c){var t=c.getAttribute('data-title')||'',tg=c.getAttribute('data-tags')||'';c.style.display=(t.includes(q)||tg.includes(q))?'':'none';});
  } else {
    if(bhItems.length>bhPgSize){if(pg)pg.style.display='';bhShowPage(1);}
    else{cards.forEach(function(c){c.style.display='';});}
  }
});}
})();
</script>

