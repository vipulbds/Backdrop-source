</div>

<script>
(function(){
'use strict';
var SID='{{ sid }}',AC='#B31942';
function $i(id){return document.getElementById(id);}
function gv(id){var e=$i(id);return e?e.value:'';}
function wt(ms){return new Promise(function(r){setTimeout(r,ms);});}
async function re(nm,fn,n,d){var er=null;for(var i=1;i<=n;i++){try{return await fn();}catch(e){er=e;if(i<n)await wt(d);}}throw er||new Error(nm);}

/* ── Open / Close ── */
function openM(id){
  var m=$i('psp-m-'+id);if(!m)return;
  if(m.parentElement!==document.body)document.body.appendChild(m);
  m.classList.add('open');m.scrollTop=0;document.body.style.overflow='hidden';
  ['cs','dh'].forEach(function(k){if(id===k+'-'+SID){var s=$i('psp-'+k+'-st-'+SID);if(s)s.value=String(Date.now());fetchGeo(k);}});
}
function closeAll(){
  document.querySelectorAll('.psp-ov.open').forEach(function(m){m.classList.remove('open');});
  document.body.style.overflow='';
}
document.querySelectorAll('[data-psp-open]').forEach(function(b){b.addEventListener('click',function(e){e.preventDefault();openM(b.dataset.pspOpen);});});
document.querySelectorAll('[data-psp-close="'+SID+'"]').forEach(function(el){el.addEventListener('click',closeAll);});
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeAll();});

/* Reset on close */
['cs','dh'].forEach(function(k){
  var mo=$i('psp-m-'+k+'-'+SID);if(!mo)return;
  new MutationObserver(function(){if(!mo.classList.contains('open'))setTimeout(function(){
    ['ld','sc','er'].forEach(function(s){var el=$i('psp-'+k+'-'+s+'-'+SID);if(el)el.classList.remove('on');});
    var w=$i('psp-'+k+'-w-'+SID);if(w)w.style.display='';
    var f=$i('psp-'+k+'-f-'+SID);if(f)f.reset();
  },300);}).observe(mo,{attributes:true,attributeFilter:['class']});
});
var uovm=$i('psp-m-up-'+SID);
if(uovm){uovm.querySelectorAll('[data-psp-close="'+SID+'"]').forEach(function(el){el.addEventListener('click',closeAll);});}

/* ── Geo ── */
var gCache={};
function fetchGeo(k){
  if(gCache[k])return;gCache[k]=true;
  fetch('https://api.ipgeolocation.io/ipgeo?apiKey=d8219c97f06142f1b715280e15e42214')
    .then(function(r){return r.json();})
    .then(function(d){
      var sf=function(s,v){var el=$i('psp-'+k+'-'+s+'-'+SID);if(el)el.value=v||'';};
      sf('gi',d.ip);sf('gc',d.city);sf('gs',d.state_prov);
      sf('gz',d.time_zone&&d.time_zone.name);sf('gt',d.time_zone&&d.time_zone.current_time);
    }).catch(function(){});
}

/* ── Uploadcare ── */
var ucP=null,ucW={};
function ensUC(){
  if(window.uploadcare&&typeof window.uploadcare.Widget==='function')return Promise.resolve();
  if(ucP)return ucP;
  ucP=new Promise(function(res,rej){var s=document.createElement('script');s.src='https://ucarecdn.com/libs/widget/3.x/uploadcare.full.min.js';s.async=s.defer=true;s.onload=res;s.onerror=rej;document.head.appendChild(s);}).catch(function(e){ucP=null;throw e;});
  return ucP;
}
function initUC(inputId,cb){
  if(ucW[inputId])return Promise.resolve(ucW[inputId]);
  var inp=$i(inputId);if(!inp)return Promise.resolve(null);
  return ensUC().then(function(){
    if(!window.uploadcare||typeof window.uploadcare.Widget!=='function')return null;
    var w=window.uploadcare.Widget(inp);
    w.onUploadComplete(function(info){var url=(info&&(info.cdnUrl||info.originalUrl))||'';if(url)cb(url);});
    ucW[inputId]=w;return w;
  }).catch(function(){return null;});
}

/* ── Upload Artwork modal ── */
var uploadedUrl='';
function setFV(val,msg){var st=$i('psp-up-st-'+SID);if(st){st.textContent=msg||'';st.style.color=val?AC:'#888';}}
function setUpSide(name){
  if(!uovm)return;
  uovm.querySelectorAll('[data-up-side]').forEach(function(b){b.classList.toggle('on',b.dataset.upSide===name);});
  uovm.querySelectorAll('[data-up-con]').forEach(function(p){p.style.display=p.dataset.upCon===name?'flex':'none';});
}
if(uovm){uovm.querySelectorAll('[data-up-side]').forEach(function(btn){btn.addEventListener('click',function(){setUpSide(btn.dataset.upSide);});});}
var dz=$i('psp-dz-'+SID),br=$i('psp-br-'+SID);
function trigUC(){initUC('psp-uc-'+SID,function(url){uploadedUrl=url;setFV(url,'✓ File uploaded successfully');}).then(function(w){if(w&&typeof w.openDialog==='function')w.openDialog();});}
if(br)br.addEventListener('click',function(e){e.stopPropagation();trigUC();});
if(dz){dz.addEventListener('click',trigUC);dz.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();trigUC();}});dz.addEventListener('dragover',function(e){e.preventDefault();dz.classList.add('dg');});dz.addEventListener('dragleave',function(){dz.classList.remove('dg');});dz.addEventListener('drop',function(e){e.preventDefault();dz.classList.remove('dg');trigUC();});}
initUC('psp-uc-'+SID,function(url){uploadedUrl=url;setFV(url,'✓ File uploaded successfully');});
var svBtn=$i('psp-sv-'+SID);if(svBtn){svBtn.addEventListener('click',function(){if(!uploadedUrl){var st=$i('psp-up-st-'+SID);if(st){st.textContent='⚠ Please upload a file first.';st.style.color='#c0392b';}return;}closeAll();});}
var lkInp=$i('psp-lk-'+SID),lkSt=$i('psp-lk-st-'+SID);
if(lkInp){lkInp.addEventListener('input',function(){var v=lkInp.value.trim();if(lkSt){lkSt.textContent=v?'✓ Link saved':'';lkSt.style.color=AC;}});}
var lkSv=$i('psp-lk-sv-'+SID);if(lkSv){lkSv.addEventListener('click',function(){var v=lkInp?lkInp.value.trim():'';if(!v){if(lkSt){lkSt.textContent='⚠ Please paste a link first.';lkSt.style.color='#c0392b';}return;}closeAll();});}
var emSv=$i('psp-em-sv-'+SID);if(emSv){emSv.addEventListener('click',function(){closeAll();});}

/* ── 2D modal upload tabs ── */
var dhm=$i('psp-m-dh-'+SID),dhFl=$i('psp-dh-fl-'+SID),dhUst=$i('psp-dh-ust-'+SID);
if(dhm){
  dhm.querySelectorAll('[data-dh-tab]').forEach(function(tab){tab.addEventListener('click',function(){
    if(tab.classList.contains('lk'))return;
    dhm.querySelectorAll('[data-dh-tab]').forEach(function(t){t.classList.remove('on');});
    dhm.querySelectorAll('[data-dh-panel]').forEach(function(p){p.classList.remove('on');});
    tab.classList.add('on');
    var pan=dhm.querySelector('[data-dh-panel="'+tab.dataset.dhTab+'"]');if(pan)pan.classList.add('on');
    if(tab.dataset.dhTab==='email'){if(dhFl)dhFl.value='Customer will email files later';if(dhUst){dhUst.textContent='✉ You can email files after ordering';dhUst.style.color=AC;}}
  });});
  var dhLk=$i('psp-dh-lk-'+SID);
  if(dhLk){dhLk.addEventListener('input',function(){var v=dhLk.value.trim();if(dhFl)dhFl.value=v;if(dhUst){dhUst.textContent=v?'✓ Link saved':'';dhUst.style.color=AC;}dhm.querySelectorAll('[data-dh-tab]').forEach(function(t){if(v)t.classList.toggle('lk',t.dataset.dhTab!=='link');else t.classList.remove('lk');});});}
  var dhUCO=$i('psp-dh-uco-'+SID);
  if(dhUCO){dhUCO.addEventListener('click',function(e){e.stopPropagation();initUC('psp-dh-uc-'+SID,function(url){if(dhFl)dhFl.value=url;if(dhUst){dhUst.textContent='✓ File uploaded';dhUst.style.color=AC;}dhm.querySelectorAll('[data-dh-tab]').forEach(function(t){t.classList.toggle('lk',t.dataset.dhTab!=='direct');});}).then(function(w){if(w&&typeof w.openDialog==='function')w.openDialog();});});}
}

/* ── EmailJS + Sheets ── */
var SURLS=['https://script.google.com/macros/s/AKfycbyr8HLOBRhWEVINMGSPgJXwMAP638vg5Lni2tpwsSVHAvUSXPJ2kqABi0pRb2br0j20/exec','https://script.google.com/macros/s/AKfycbxNU0RTh63GR5v1woeu8I_r2MAVLqrTJ8GFT8O1qs2gBjW0CcgD62ON2oQgAKYOhQcj/exec'];
var CURL='https://script.google.com/macros/s/AKfycbysdhq2w-U1_HhSkCQceMuwEDMGjL5lJUMtZWQ7LQIYaXe0E50vhOTebHLp6jr4v1Ofuw/exec';
var ESVC='service_t2nlztf',ejP=null;
function ensEJ(){if(window.emailjs)return Promise.resolve();if(ejP)return ejP;ejP=new Promise(function(res,rej){var s=document.createElement('script');s.src='https://cdn.jsdelivr.net/npm/emailjs-com@3/dist/email.min.js';s.async=true;s.onload=res;s.onerror=rej;document.head.appendChild(s);});return ejP;}
async function getCtr(ft){try{var d=await re('ctr',async function(){var r=await fetch(CURL+'?country=USA&formType='+ft,{method:'GET',redirect:'follow'});if(!r.ok)throw new Error('HTTP '+r.status);return r.json();},3,700);return d.counter||'0';}catch(e){return '0';}}
async function subSheets(p){await Promise.all(SURLS.map(function(u){return re('sh',async function(){await fetch(u,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:p});},3,700);}));}
function mkP(tok,d,tgt){return new URLSearchParams({requestId:tok,country:'USA',customerName:d.n,emailId:d.e,phoneNumber:d.ph||'',customerCity:d.gc||'',customerState:d.gs||'',customerTimezone:d.gz||'',customerTime:d.gt||'',target:tgt,origin:window.location.origin,token:tok});}
function showSt(k,st){
  ['ld','sc','er'].forEach(function(s){var el=$i('psp-'+k+'-'+s+'-'+SID);if(el)el.classList.toggle('on',s===st);});
  var w=$i('psp-'+k+'-w-'+SID);if(w)w.style.display=(st==='sc'||st==='ld')?'none':'';
}

/* Custom Size submit */
var csF=$i('psp-cs-f-'+SID);
if(csF){csF.addEventListener('submit',async function(e){
  e.preventDefault();
  var hp=$i('psp-cs-hp-'+SID);if(hp&&hp.value.trim()!=='')return;
  var st=$i('psp-cs-st-'+SID);if(st&&(Date.now()-parseInt(st.value||'0',10))<5000)return;
  var n=gv('psp-cs-n-'+SID).trim(),em=gv('psp-cs-e-'+SID).trim(),ph=gv('psp-cs-p-'+SID).trim();
  if(!n||!em||!ph){alert('Please fill in Name, Email and Phone Number.');return;}
  showSt('cs','ld');
  try{
    var ctr=await getCtr('CUSTOM_REQ');var tok='CSR-US#'+String(ctr).padStart(3,'0');
    var d={n:n,e:em,ph:ph,w:gv('psp-cs-w2-'+SID),h:gv('psp-cs-h-'+SID),u:gv('psp-cs-u-'+SID),msg:gv('psp-cs-m-'+SID),gc:gv('psp-cs-gc-'+SID),gs:gv('psp-cs-gs-'+SID),gz:gv('psp-cs-gz-'+SID),gt:gv('psp-cs-gt-'+SID)};
    showSt('cs','sc');
    Promise.allSettled([subSheets(mkP(tok,d,'Custom-Size')),subSheets(mkP(tok,d,'Pr-form')),ensEJ().then(function(){window.emailjs.init('Qy8GnlfeI_jayLu47');return Promise.all([re('cs1',function(){return window.emailjs.send(ESVC,'template_pcbfdk6',{to_email:'proofs@backdropsource.com',subject:'Backdropsource - Custom Size Request',reply_to:em,shop_name:'Backdropsource - USA',customer_name:n,customer_email:em,customer_phone:ph,width:d.w,height:d.h,measurement:d.u,customer_message:d.msg,product_name:'Blog Page',product_url:window.location.href,customer_city:d.gc,customer_state:d.gs,customer_timezone:d.gz,customer_time:d.gt});},3,800),re('cs2',function(){return window.emailjs.send(ESVC,'template_ges800l',{shop_token:tok,to_email:em,from_name:n,subject:'Backdropsource - Custom Size Request',width:d.w,height:d.h,measurement:d.u,product:'Blog Page',product_url:window.location.href,reply_to:'proofs@backdropsource.com',shop_name:'Backdropsource - USA',executive_name:'Jennifer Rytter  (She/Her)',designation:'Sales Manager | Backdropsource',phone_number:'📞 Tel: +1 650 614 1888 | 📱 WhatsApp: +1 737 204 1523',store_email:'📧 Email: sales@backdropsource.com',website:'🌐 www.backdropsource.com'});},3,800)]);})]);}
  catch(er){showSt('cs','er');console.error('[BH]CS',er);}
});}

/* 2D Mockup submit */
var dhF=$i('psp-dh-f-'+SID);
if(dhF){dhF.addEventListener('submit',async function(e){
  e.preventDefault();
  var hp=$i('psp-dh-hp-'+SID);if(hp&&hp.value.trim()!=='')return;
  var st=$i('psp-dh-st-'+SID);if(st&&(Date.now()-parseInt(st.value||'0',10))<5000)return;
  var n=gv('psp-dh-n-'+SID).trim(),em=gv('psp-dh-e-'+SID).trim(),ph=gv('psp-dh-p-'+SID).trim();
  if(!n||!em||!ph){alert('Please fill in Name, Email and Phone Number.');return;}
  showSt('dh','ld');
  try{
    var ctr=await getCtr('2D_MOCK');var tok='2RP-US#'+String(ctr).padStart(3,'0');
    var d={n:n,e:em,ph:ph,w:gv('psp-dh-w2-'+SID),h:gv('psp-dh-h-'+SID),u:gv('psp-dh-u-'+SID),msg:gv('psp-dh-m-'+SID),fl:gv('psp-dh-fl-'+SID),gc:gv('psp-dh-gc-'+SID),gs:gv('psp-dh-gs-'+SID),gz:gv('psp-dh-gz-'+SID),gt:gv('psp-dh-gt-'+SID)};
