{% comment %}
  File: snippets/product-tabs-auto.liquid
  Mobile (≤768px): accordion with inline !important styles
  Desktop (>768px): tabs with class-based styles
{% endcomment %}

<style>
/* ── Shared content ── */
#apt-root { margin-top: 28px; font-family: inherit; }
#apt-root h4 { margin: 18px 0 8px; color: #1d2b4f; font-size: 15px; font-weight: 700; }
#apt-root h4:first-child { margin-top: 0; }
#apt-root p { margin: 0 0 12px; line-height: 1.75; color: #333; font-size: 14.5px; }
#apt-root ul, #apt-root ol { padding-left: 20px; margin: 0 0 14px; }
#apt-root li { margin-bottom: 6px; line-height: 1.65; color: #333; font-size: 14.5px; }
#apt-root strong { color: #111; }
#apt-root table { width: 100%; border-collapse: collapse; margin-bottom: 14px; font-size: 14px; }
#apt-root td, #apt-root th { padding: 8px 12px; border: 1px solid #e0e0e0; text-align: left; }
#apt-root th { background: #f7f7f7; font-weight: 600; }

/* ── Desktop tabs ── */
#apt-root .apt-nav { display: flex !important; flex-wrap: wrap; list-style: none; margin: 0; padding: 0; border-bottom: 2px solid #e0e0e0; }
#apt-root .apt-nav li { margin: 0; padding: 0; }
#apt-root .apt-nav-btn {
  display: block !important; padding: 10px 18px; font-size: 13.5px; font-weight: 600;
  color: #666 !important; background: transparent !important; border: none !important;
  border-bottom: 3px solid transparent; margin-bottom: -2px;
  cursor: pointer; white-space: nowrap;
  transition: color .2s, border-color .2s; letter-spacing: .01em;
  border-radius: 0 !important;
}
#apt-root .apt-nav-btn:hover { color: #111 !important; }
#apt-root .apt-nav-btn.apt-active { color: #0A3161 !important; border-bottom-color: #0A3161 !important; font-weight: 700; background: transparent !important; }
#apt-root .apt-panels { padding: 20px 4px 10px; }
#apt-root .apt-panel { display: none !important; }
#apt-root .apt-panel.apt-active { display: block !important; animation: aptFadeIn .2s ease; }
@keyframes aptFadeIn { from { opacity:0; transform:translateY(4px); } to { opacity:1; transform:translateY(0); } }
</style>

<div id="apt-root">
  <div id="apt-source" style="display:none">{{ product.description }}</div>
</div>

<script>
(function () {
  var root   = document.getElementById('apt-root');
  var source = document.getElementById('apt-source');
  if (!root || !source) return;

  /* Strip embedded <style> blocks so they don't interfere */
  var raw = source.innerHTML;
  raw = raw.replace(/<style[\s\S]*?<\/style>/gi, '');
  raw = raw.trim();
  if (!raw) return;

  var tabs   = [];
  var tmp    = document.createElement('div');
  tmp.innerHTML = raw;

  /* ── Format 1: jQuery UI tabs <div id="tabs">…<ul><li><a href="#tabs-N"> ── */
  var jqRoot  = tmp.querySelector('[id="tabs"], [id^="tabs-"]');
  var jqLinks = jqRoot ? jqRoot.querySelectorAll('ul li a') : [];
  if (jqLinks.length) {
    jqLinks.forEach(function (a) {
      var id    = (a.getAttribute('href') || '').replace('#', '');
      var panel = id ? jqRoot.querySelector('#' + id) : null;
      if (a.textContent.trim() && panel)
        tabs.push({ title: a.textContent.trim(), content: panel.innerHTML.trim() });
    });

  } else {
    /* ── Format 2: CSS radio tabs <div class="tabs">…<label class="tab-label" for="tabN">…<div id="contentN"> ── */
    var tabsRoot   = tmp.querySelector('.tabs, div[class*="tab"]');
    var tabLabels  = tabsRoot ? tabsRoot.querySelectorAll('.tab-label, label[for^="tab"]') : [];
    if (tabLabels.length) {
      tabLabels.forEach(function (lbl) {
        var forVal = lbl.getAttribute('for') || '';
        var num    = forVal.replace(/[^0-9]/g, '');
        var panel  = num ? (tmp.querySelector('#content' + num) || tmp.querySelector('#tab-content-' + num)) : null;
        if (!panel && forVal) panel = tmp.querySelector('#' + forVal + '-content, [id="content-' + forVal + '"]');
        if (lbl.textContent.trim() && panel)
          tabs.push({ title: lbl.textContent.trim(), content: panel.innerHTML.trim() });
      });

    } else {
      /* ── Format 3: H4 headings ── */
      var current  = null;
      var preNodes = [];
      Array.from(tmp.childNodes).forEach(function (node) {
        if (node.nodeType === 1 && node.tagName === 'H4') {
          if (current) tabs.push(current);
          else if (preNodes.length) {
            var d = document.createElement('div');
            preNodes.forEach(function (n) { d.appendChild(n.cloneNode(true)); });
            tabs.push({ title: 'Overview', content: d.innerHTML });
            preNodes = [];
          }
          current = { title: node.textContent.trim(), nodes: [] };
        } else {
          (current ? current.nodes : preNodes).push(node);
        }
      });
      if (current) tabs.push(current);
      else if (preNodes.length) {
        var d2 = document.createElement('div');
        preNodes.forEach(function (n) { d2.appendChild(n.cloneNode(true)); });
        tabs.push({ title: 'Overview', content: d2.innerHTML });
      }
      tabs = tabs.map(function (t) {
        if (!t.nodes) return t;
        var d3 = document.createElement('div');
        t.nodes.forEach(function (n) { d3.appendChild(n.cloneNode(true)); });
        return { title: t.title, content: d3.innerHTML };
      });
    }
  }

  /* Fallback */
  if (tabs.length <= 1) {
    root.innerHTML = '<div style="padding:4px 0">' + raw + '</div>';
    return;
  }

  /* ── Decide layout ── */
  var w        = window.innerWidth || document.documentElement.clientWidth || 9999;
  var isMobile = w <= 768;

  if (isMobile) {
    /* ════ ACCORDION — inline !important styles, immune to theme CSS overrides ════ */
    var out = '<div style="margin-top:0!important;">';
    tabs.forEach(function (tab, i) {
      var isFirst  = i === 0;
      var bodyMH   = isFirst ? '3000px' : '0';
      var iconRot  = isFirst ? 'rotate(45deg)' : '';
      var expanded = isFirst ? 'true' : 'false';
      out +=
        '<div style="background:#f5f5f5!important;border-radius:10px!important;margin-bottom:8px!important;overflow:hidden!important;display:block!important;">' +
        '<button type="button" data-mbi="' + i + '" aria-expanded="' + expanded + '" ' +
        'style="display:flex!important;align-items:center!important;justify-content:space-between!important;gap:10px!important;' +
        'width:100%!important;padding:15px 18px!important;background:transparent!important;border:none!important;' +
        'box-shadow:none!important;border-radius:0!important;cursor:pointer!important;text-align:left!important;' +
        'font-size:14px!important;font-weight:600!important;color:#111!important;line-height:1.3!important;">' +
        '<span style="font-size:14px!important;font-weight:600!important;color:#111!important;line-height:1.3!important;flex:1!important;">' + tab.title + '</span>' +
        '<span data-mbic style="font-size:20px!important;font-weight:400!important;color:#555!important;line-height:1!important;' +
        'flex-shrink:0!important;display:inline-block!important;transition:transform .25s ease;transform:' + iconRot + ';">+</span>' +
        '</button>' +
        '<div data-mbb style="display:block!important;overflow:hidden!important;transition:max-height .4s ease!important;max-height:' + bodyMH + '!important;">' +
        '<div style="padding:6px 18px 18px!important;font-size:14px!important;font-weight:400!important;color:#333!important;line-height:1.7!important;">' +
        tab.content +
        '</div></div></div>';
    });
    out += '</div>';
    root.innerHTML = out;

    root.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-mbi]');
      if (!btn) return;
      var isOpen = btn.getAttribute('aria-expanded') === 'true';
      root.querySelectorAll('[data-mbi]').forEach(function (b) {
        b.setAttribute('aria-expanded', 'false');
        var ic = b.querySelector('[data-mbic]'); if (ic) ic.style.transform = '';
        var bd = b.nextElementSibling; if (bd) { bd.style.maxHeight = '0'; }
      });
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        var ic = btn.querySelector('[data-mbic]'); if (ic) ic.style.transform = 'rotate(45deg)';
        var bd = btn.nextElementSibling; if (bd) { bd.style.maxHeight = '3000px'; }
      }
    });

  } else {
    /* ════ TABS ════ */
    var nav = '<ul class="apt-nav" role="tablist">';
    tabs.forEach(function (tab, i) {
      nav += '<li><button class="apt-nav-btn' + (i ? '' : ' apt-active') + '" data-tab="' + i + '" role="tab">' + tab.title + '</button></li>';
    });
    nav += '</ul><div class="apt-panels">';
    tabs.forEach(function (tab, i) {
      nav += '<div class="apt-panel' + (i ? '' : ' apt-active') + '" data-panel="' + i + '">' + tab.content + '</div>';
    });
    nav += '</div>';
    root.innerHTML = nav;

    root.addEventListener('click', function (e) {
      var btn = e.target.closest('.apt-nav-btn');
      if (!btn) return;
      var ti = btn.getAttribute('data-tab');
      root.querySelectorAll('.apt-nav-btn').forEach(function (b) {
        b.classList.toggle('apt-active', b === btn);
      });
      root.querySelectorAll('.apt-panel').forEach(function (p) {
        p.classList.toggle('apt-active', p.getAttribute('data-panel') === ti);
      });
    });
  }
})();
</script>
