      "block_order": [
        "title",
        "sku",
        "psg_short_description",
        "price",
        "inventory",
        "psg_tag_no_return",
        "variant_picker",
        "psg_360",
        "psg_delivery",
        "buy_buttons",
        "description",
        "assembly_guide",
        "trust_badges",
        "addons"
      ],
      "settings": {
        "color_scheme": "",
