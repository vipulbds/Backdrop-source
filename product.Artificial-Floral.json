        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "psg_360": {
          "type": "psg_360_video",
          "settings": {
            "btn_label": "VIEW 360° VIDEO"
          }
        },
        "psg_delivery": {
