            "divider_top": true,
            "divider_bottom": true
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "inventory_threshold": 10,
            "show_inventory_quantity": true
          }
        },
        "psg_tag_no_return": {
