(\"ac83e291-11d9-4bf5-a6db-f82d8d4a8070\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Playfair Display';\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n  src: url(\"face5a5d-bbe6-41ce-88a3-1105b26c8ecc\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>/* ============================================================\n   BACKDROP SOURCE — Church Landing Page  (v2 · flat, professional)\n   Reverent + premium: Playfair Display headings · Archivo UI\n   Brand: navy #0A3161 · crimson #B31942 · gold #E0A93B\n   ============================================================ */\n\n:root {\n  --navy: #0A3161;\n  --navy-800: #0a274d;\n  --navy-900: #061d3c;\n  --crimson: #B31942;\n  --crimson-600: #9b1338;\n  --gold: #C8932E;\n  --gold-soft: #E0A93B;\n\n  --accent: var(--crimson);\n  --accent-600: var(--crimson-600);\n\n  --paper: #FBF8F2;\n  --paper-2: #F3ECDF;\n  --cream: #FFFFFF;\n  --line: #E8DFCF;\n  --ink: #16243a;\n  --muted: #5a6678;\n\n  --serif: \"Playfair Display\", Georgia, serif;\n  --sans: \"Archivo\", system-ui, sans-serif;\n\n  --maxw: 1200px;\n  --radius: 16px;\n  --shadow-sm: 0 1px 3px rgba(10,49,97,.06), 0 8px 24px -16px rgba(10,49,97,.22);\n  --shadow-md: 0 18px 44px -22px rgba(10,49,97,.34);\n  --shadow-lg: 0 34px 70px -30px rgba(10,49,97,.42);\n}\n\n* { box-sizing: border-box; }\nhtml { scroll-behavior: smooth; }\nbody {\n  margin: 0; font-family: var(--sans); color: var(--ink);\n  background: var(--paper); -webkit-font-smoothing: antialiased;\n  text-rendering: optimizeLegibility; overflow-x: hidden;\n}\nimg { max-width: 100%; display: block; }\na { color: inherit; text-decoration: none; }\n.wrap { width: 100%; max-width: var(--maxw); margin: 0 auto; padding: 0 28px; }\n\n/* ---------- Type ---------- */\nh1, h2, h3 { font-family: var(--serif); font-weight: 700; line-height: 1.08; margin: 0; }\n.eyebrow {\n  font-family: var(--sans); font-weight: 700; font-size: 12.5px;\n  letter-spacing: .26em; text-transform: uppercase; color: var(--accent);\n  display: inline-flex; align-items: center; gap: 10px;\n}\n.eyebrow::before { content: \"\"; width: 26px; height: 2px; background: currentColor; display: inline-block; }\n.eyebrow.center::after { content: \"\"; width: 26px; height: 2px; background: currentColor; display: inline-block; }\n.eyebrow.on-dark { color: var(--gold-soft); }\np { line-height: 1.65; }\n\n/* ---------- Buttons ---------- */\n.btn {\n  display: inline-flex; align-items: center; gap: 10px;\n  font-family: var(--sans); font-weight: 700; font-size: 15px; letter-spacing: .01em;\n  padding: 15px 28px; border-radius: 100px; border: 1.5px solid transparent; cursor: pointer;\n  transition: transform .2s ease, box-shadow .2s ease, background .2s, color .2s, border-color .2s;\n}\n.btn .arr { transition: transform .2s; }\n.btn:hover .arr { transform: translateX(4px); }\n.btn-primary { background: var(--accent); color: #fff; box-shadow: 0 16px 34px -16px rgba(179,25,66,.6); }\n.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 22px 44px -18px rgba(179,25,66,.7); }\n.btn-gold { background: var(--gold-soft); color: var(--navy-900); }\n.btn-gold:hover { transform: translateY(-2px); box-shadow: 0 18px 36px -16px rgba(224,169,59,.6); }\n.btn-outline { background: transparent; color: #fff; border-color: rgba(255,255,255,.5); }\n.btn-outline:hover { background: rgba(255,255,255,.12); border-color: #fff; }\n.btn-navy { background: var(--navy); color: #fff; }\n.btn-navy:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }\n\n/* ============================================================ NAV */\n.nav {\n  position: sticky; top: 0; z-index: 60; transition: background .3s, box-shadow .3s;\n  background: rgba(10,49,97,.96); backdrop-filter: blur(10px);\n  border-bottom: 1px solid rgba(255,255,255,.08);\n}\n.nav.solid { box-shadow: 0 10px 30px -18px rgba(0,0,0,.5); }\n.nav-inner { display: flex; align-items: center; justify-content: space-between; height: 74px; }\n.logo { display: flex; align-items: center; gap: 12px; }\n.logo-mark {\n  background: #fff; color: var(--navy); font-family: var(--serif); font-weight: 900;\n  font-size: 18px; padding: 8px 11px 6px; border-radius: 8px; line-height: 1; position: relative;\n}\n.logo-mark::after { content: \"\"; position: absolute; right: -3px; top: 7px; width: 8px; height: 8px; background: var(--crimson); border-radius: 2px; transform: rotate(45deg); }\n.logo-text b { font-family: var(--sans); font-weight: 800; font-size: 16px; letter-spacing: .12em; color: #fff; display: block; line-height: 1.05; }\n.logo-text span { font-size: 9.5px; letter-spacing: .2em; color: #9db4d4; text-transform: uppercase; }\n.nav-links { display: flex; gap: 32px; align-items: center; }\n.nav-links a { color: #d7e2f1; font-weight: 600; font-size: 14.5px; position: relative; padding: 6px 0; }\n.nav-links a::after { content: \"\"; position: absolute; left: 0; bottom: 0; width: 0; height: 2px; background: var(--gold-soft); transition: width .25s; }\n.nav-links a:hover::after, .nav-links a.active::after { width: 100%; }\n.nav-links a:hover { color: #fff; }\n.nav-cta { display: flex; align-items: center; gap: 18px; }\n.nav-phone { color: #9db4d4; font-weight: 700; font-size: 13.5px; }\n.nav-burger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 8px; }\n.nav-burger span { width: 24px; height: 2px; background: #fff; transition: .25s; }\n\n/* mobile menu */\n.mobile-menu { display: none; }\n\n/* ============================================================ HERO */\n.hero { position: relative; min-height: 92vh; display: flex; align-items: center; color: #fff; overflow: hidden; }\n.hero-bg { position: absolute; inset: 0; z-index: 0; }\n.hero-bg img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); animation: heroZoom 18s ease-out forwards; }\n@keyframes heroZoom { to { transform: scale(1); } }\n.hero-bg::after {\n  content: \"\"; position: absolute; inset: 0;\n  background:\n    linear-gradient(100deg, rgba(6,29,60,.94) 0%, rgba(6,29,60,.8) 38%, rgba(6,29,60,.42) 70%, rgba(6,29,60,.25) 100%),\n    linear-gradient(0deg, rgba(6,29,60,.55), rgba(6,29,60,0) 40%);\n}\n.hero .wrap { position: relative; z-index: 2; padding-top: 70px; padding-bottom: 70px; }\n.hero-inner { max-width: 680px; }\n.hero-kicker {\n  display: inline-flex; align-items: center; gap: 9px; padding: 8px 16px; border-radius: 100px;\n  background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.22);\n  font-weight: 700; font-size: 12.5px; letter-spacing: .14em; text-transform: uppercase; color: #fff;\n}\n.hero-kicker .ico { color: var(--gold-soft); }\n.hero h1 { font-size: clamp(40px, 6vw, 74px); margin: 24px 0 0; letter-spacing: -.01em; }\n.hero h1 em { font-style: italic; color: var(--gold-soft); }\n.hero-sub { font-size: clamp(17px, 2vw, 20px); color: #d7e1ef; max-width: 560px; margin: 22px 0 34px; line-height: 1.6; }\n.hero-cta { display: flex; gap: 14px; flex-wrap: wrap; }\n.hero-trust { display: flex; align-items: center; gap: 26px; margin-top: 46px; flex-wrap: wrap; }\n.hero-trust .t { display: flex; flex-direction: column; }\n.hero-trust b { font-family: var(--serif); font-size: 30px; line-height: 1; color: #fff; }\n.hero-trust b em { font-style: normal; color: var(--gold-soft); }\n.hero-trust span { font-size: 12.5px; color: #aebfd6; letter-spacing: .04em; margin-top: 5px; }\n.hero-trust .div { width: 1px; height: 40px; background: rgba(255,255,255,.2); }\n.scroll-cue { position: absolute; bottom: 26px; left: 50%; transform: translateX(-50%); z-index: 3; color: rgba(255,255,255,.7); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; display: flex; flex-direction: column; align-items: center; gap: 8px; }\n.scroll-cue .mouse { width: 22px; height: 36px; border: 2px solid rgba(255,255,255,.5); border-radius: 12px; position: relative; }\n.scroll-cue .mouse::after { content: \"\"; position: absolute; left: 50%; top: 7px; width: 3px; height: 7px; background: #fff; border-radius: 2px; transform: translateX(-50%); animation: scrollDot 1.6s infinite; }\n@keyframes scrollDot { 0% { opacity: 0; top: 6px; } 40% { opacity: 1; } 100% { opacity: 0; top: 16px; } }\n\n/* marquee logos */\n.logos-band { background: var(--navy-900); padding: 22px 0; }\n.logos-row { display: flex; align-items: center; gap: 54px; justify-content: center; flex-wrap: wrap; }\n.logos-row span { color: #7e95b6; font-weight: 800; letter-spacing: .12em; font-size: 15px; font-family: var(--serif); font-style: italic; }\n.logos-lead { color: #aebfd6; font-size: 12px; letter-spacing: .18em; text-transform: uppercase; font-weight: 700; }\n\n/* ============================================================ SECTION SHELL */\n.sec { padding: 100px 0; position: relative; }\n.sec-head { max-width: 700px; margin-bottom: 56px; }\n.sec-head.center { margin-left: auto; margin-right: auto; text-align: center; }\n.sec-title { font-size: clamp(32px, 4.4vw, 52px); margin-top: 16px; letter-spacing: -.01em; }\n.sec-desc { color: var(--muted); font-size: 18px; margin-top: 18px; }\n.sec-head.on-dark .sec-title { color: #fff; }\n.sec-head.on-dark .sec-desc { color: #b6c5da; }\n\n/* ============================================================ FEATURED PRODUCTS */\n.products { background: var(--cream); }\n.prod-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }\n.prod-card {\n  background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden;\n  box-shadow: var(--shadow-sm); transition: transform .28s ease, box-shadow .28s ease; display: flex; flex-direction: column;\n}\n.prod-card:hover { transform: translateY(-7px); box-shadow: var(--shadow-md); }\n.prod-media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--navy); }\n.prod-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .55s ease; }\n.prod-card:hover .prod-media img { transform: scale(1.07); }\n.prod-media::after { content: \"\"; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(6,29,60,0) 50%, rgba(6,29,60,.45)); }\n.prod-tag { position: absolute; top: 14px; left: 14px; z-index: 2; background: var(--accent); color: #fff; font-weight: 800; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; padding: 6px 12px; border-radius: 8px; }\n.prod-tag.gold { background: var(--gold-soft); color: var(--navy-900); }\n.prod-body { padding: 24px 24px 26px; flex: 1; display: flex; flex-direction: column; }\n.prod-body h3 { font-size: 23px; margin-bottom: 9px; }\n.prod-body p { color: var(--muted); font-size: 14.5px; margin: 0 0 18px; flex: 1; }\n.prod-foot { display: flex; align-items: center; justify-content: space-between; padding-top: 16px; border-top: 1px solid var(--line); }\n.prod-price { font-family: var(--serif); font-size: 23px; color: var(--navy); font-weight: 700; }\n.prod-price small { font-family: var(--sans); font-size: 12px; color: var(--muted); font-weight: 600; }\n.prod-link { font-weight: 800; font-size: 13px; color: var(--accent); letter-spacing: .03em; text-transform: uppercase; display: inline-flex; gap: 6px; align-items: center; }\n.prod-link .arr { transition: transform .2s; }\n.prod-card:hover .prod-link .arr { transform: translateX(4px); }\n\n/* ============================================================ USE CASES */\n.usecases { background: var(--paper); }\n.uc-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }\n.uc-card {\n  position: relative; border-radius: var(--radius); overflow: hidden; min-height: 340px;\n  display: flex; align-items: flex-end; color: #fff; box-shadow: var(--shadow-md);\n}\n.uc-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }\n.uc-card:hover img { transform: scale(1.06); }\n.uc-card::after { content: \"\"; position: absolute; inset: 0; background: linear-gradient(160deg, rgba(6,29,60,.15) 0%, rgba(6,29,60,.55) 55%, rgba(6,29,60,.92) 100%); }\n.uc-body { position: relative; z-index: 2; padding: 34px; }\n.uc-body .num { font-family: var(--serif); font-style: italic; font-size: 16px; color: var(--gold-soft); font-weight: 700; }\n.uc-body h3 { font-size: 27px; margin: 8px 0 10px; }\n.uc-body p { color: #dde6f3; font-size: 15px; margin: 0; max-width: 460px; }\n.uc-card.tall { grid-row: span 2; min-height: 100%; }\n\n/* ============================================================ HOW IT WORKS / STEPS */\n.steps { background: var(--navy); color: #fff; }\n.steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }\n.step { text-align: left; }\n.step .n { width: 56px; height: 56px; border-radius: 14px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.16); display: flex; align-items: center; justify-content: center; font-family: var(--serif); font-size: 24px; color: var(--gold-soft); margin-bottom: 20px; }\n.step h3 { font-size: 22px; margin-bottom: 10px; }\n.step p { color: #b6c5da; font-size: 15px; margin: 0; }\n\n/* ============================================================ SEASONAL */\n.seasonal { background: var(--cream); }\n.season-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }\n.season-card { position: relative; border-radius: var(--radius); overflow: hidden; min-height: 380px; display: flex; align-items: flex-end; color: #fff; box-shadow: var(--shadow-md); transition: transform .3s; }\n.season-card:hover { transform: translateY(-7px); }\n.season-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s; }\n.season-card:hover img { transform: scale(1.07); }\n.season-card::after { content: \"\"; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(6,29,60,.05) 25%, rgba(6,29,60,.9) 100%); }\n.season-body { position: relative; z-index: 2; padding: 30px; }\n.season-pill { display: inline-block; background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.4); padding: 6px 13px; border-radius: 100px; font-weight: 700; font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; }\n.season-body h3 { font-size: 28px; margin: 14px 0 8px; }\n.season-body p { color: #e7eefa; font-size: 14.5px; margin: 0; }\n\n/* ============================================================ WHY US (split image) */\n.why { background: var(--paper); overflow: hidden; }\n.why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }\n.why-media { position: relative; border-radius: 20px; overflow: hidden; box-shadow: var(--shadow-lg); }\n.why-media img { width: 100%; height: 560px; object-fit: cover; }\n.why-badge {\n  position: absolute; bottom: 24px; left: 24px; right: 24px; background: rgba(10,49,97,.92);\n  backdrop-filter: blur(6px); color: #fff; border-radius: 14px; padding: 22px 24px;\n  display: flex; align-items: center; gap: 20px;\n}\n.why-badge .big { font-family: var(--serif); font-size: 46px; line-height: 1; color: var(--gold-soft); }\n.why-badge p { font-size: 14px; color: #cdd9ec; margin: 0; }\n.why-list { display: grid; gap: 26px; }\n.why-item { display: flex; gap: 18px; align-items: flex-start; }\n.why-ic { flex: none; width: 52px; height: 52px; border-radius: 13px; background: #fff; border: 1px solid var(--line); color: var(--accent); display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-sm); }\n.why-item h3 { font-size: 21px; margin-bottom: 7px; }\n.why-item p { color: var(--muted); font-size: 14.5px; margin: 0; }\n\n/* ============================================================ TESTIMONIALS */\n.testi { background: var(--navy-900); color: #fff; }\n.testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }\n.testi-card { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: var(--radius); padding: 32px; display: flex; flex-direction: column; }\n.testi-card .quote-mark { font-family: var(--serif); font-size: 60px; line-height: .6; color: var(--gold-soft); height: 30px; }\n.stars { color: var(--gold-soft); letter-spacing: 3px; margin: 6px 0 14px; font-size: 15px; }\n.testi-card blockquote { margin: 0 0 22px; font-size: 16.5px; line-height: 1.6; color: #eaf1fb; flex: 1; }\n.testi-who { display: flex; align-items: center; gap: 13px; }\n.avatar { width: 46px; height: 46px; border-radius: 50%; background: linear-gradient(135deg, var(--accent), #e2557a); display: flex; align-items: center; justify-content: center; font-weight: 800; font-family: var(--serif); }\n.testi-who b { display: block; font-size: 14.5px; }\n.testi-who span { font-size: 12.5px; color: #9db4d4; }\n\n/* ============================================================ FAQ */\n.faq { background: var(--paper); }\n.faq-wrap { max-width: 820px; margin: 0 auto; }\n.faq-item { border: 1px solid var(--line); background: #fff; border-radius: 14px; margin-bottom: 14px; overflow: hidden; transition: box-shadow .2s, border-color .2s; }\n.faq-item.open { box-shadow: var(--shadow-sm); border-color: #d9cdb5; }\n.faq-q { width: 100%; text-align: left; background: none; border: none; cursor: pointer; padding: 22px 24px; display: flex; align-items: center; justify-content: space-between; gap: 20px; font-family: var(--serif); font-weight: 700; font-size: 19px; color: var(--navy); }\n.faq-q .pm { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--paper-2); display: flex; align-items: center; justify-content: center; font-size: 20px; transition: transform .25s, background .2s, color .2s; color: var(--accent); }\n.faq-item.open .pm { transform: rotate(45deg); background: var(--accent); color: #fff; }\n.faq-a { max-height: 0; overflow: hidden; transition: max-height .35s ease; }\n.faq-a p { color: var(--muted); font-size: 15.5px; padding: 0 24px 24px; margin: 0; max-width: 700px; }\n\n/* ============================================================ CTA BAND */\n.cta { position: relative; color: #fff; overflow: hidden; text-align: center; }\n.cta-bg { position: absolute; inset: 0; z-index: 0; }\n.cta-bg img { width: 100%; height: 100%; object-fit: cover; }\n.cta-bg::after { content: \"\"; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(6,29,60,.86), rgba(6,29,60,.92)); }\n.cta .wrap { position: relative; z-index: 2; padding: 110px 0; }\n.cta h2 { font-size: clamp(34px, 5vw, 60px); margin-bottom: 18px; }\n.cta h2 em { font-style: italic; color: var(--gold-soft); }\n.cta p { color: #d7e1ef; font-size: 18px; max-width: 560px; margin: 0 auto 34px; }\n.cta .hero-cta { justify-content: center; }\n\n/* ============================================================ FOOTER */\n.footer { background: var(--navy-900); color: #b8c8e0; padding: 64px 0 34px; }\n.foot-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 40px; }\n.foot-col h4 { color: #fff; font-size: 12.5px; letter-spacing: .16em; text-transform: uppercase; margin-bottom: 16px; }\n.foot-col a { display: block; color: #9db4d4; font-size: 14px; padding: 6px 0; transition: color .15s; }\n.foot-col a:hover { color: #fff; }\n.foot-col p { color: #9db4d4; font-size: 14px; max-width: 300px; }\n.foot-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 48px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.1); font-size: 13px; color: #7f95b5; flex-wrap: wrap; gap: 12px; }\n\n/* ============================================================ REVEAL */\n.anim .reveal { opacity: 0; }\n.anim .reveal.shown { opacity: 1; }\n.anim .reveal.in { opacity: 1; animation: revealIn .7s cubic-bezier(.2,.7,.2,1); }\n@keyframes revealIn { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }\n@media (prefers-reduced-motion: reduce) { .anim .reveal, .anim .reveal.in { opacity: 1; animation: none; transform: none; } }\n\n/* ============================================================ RESPONSIVE */\n@media (max-width: 980px) {\n  .nav-links, .nav-phone { display: none; }\n  .nav-burger { display: flex; }\n  .why-grid { grid-template-columns: 1fr; gap: 40px; }\n  .why-media img { height: 420px; }\n  .prod-grid, .season-grid, .steps-grid, .testi-grid { grid-template-columns: 1fr 1fr; }\n  .foot-grid { grid-template-columns: 1fr 1fr; }\n  .uc-card.tall { grid-row: span 1; }\n  .hero { min-height: 88vh; }\n\n  .mobile-menu { display: block; position: fixed; inset: 74px 0 auto 0; z-index: 55; background: var(--navy); border-bottom: 1px solid rgba(255,255,255,.1); transform: translateY(-120%); transition: transform .3s ease; padding: 12px 0 20px; }\n  .mobile-menu.open { transform: translateY(0); }\n  .mobile-menu a { display: block; color: #d7e2f1; font-weight: 600; font-size: 16px; padding: 14px 28px; border-bottom: 1px solid rgba(255,255,255,.06); }\n  .nav-burger.x span:nth-child(1) { transform: translateY(7px) rotate(45deg); }\n  .nav-burger.x span:nth-child(2) { opacity: 0; }\n  .nav-burger.x span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }\n}\n@media (max-width: 640px) {\n  .wrap { padding: 0 18px; }\n  .sec { padding: 64px 0; }\n  .sec-head { margin-bottom: 38px; }\n  .prod-grid, .uc-grid, .season-grid, .steps-grid, .testi-grid, .foot-grid { grid-template-columns: 1fr; }\n  .hero-trust { gap: 18px; }\n  .hero-trust .div { display: none; }\n  .hero .wrap { padding-top: 40px; }\n  .nav-cta .btn { display: none; }\n  .cta .wrap { padding: 72px 0; }\n  .why-badge { flex-direction: column; align-items: flex-start; gap: 12px; }\n}\n<\u002Fstyle>\n<\u002Fhead>\n<body>\n\n<!-- ===================== NAV ===================== -->\n<header class=\"nav\" id=\"nav\">\n  <div class=\"wrap nav-inner\">\n    <a class=\"logo\" href=\"#top\" aria-label=\"Backdrop Source home\">\n      <span class=\"logo-mark\">BS<\u002Fspan>\n      <span class=\"logo-text\"><b>BACKDROP SOURCE<\u002Fb><span>Setting the stage since 2004<\u002Fspan><\u002Fspan>\n    <\u002Fa>\n    <nav class=\"nav-links\">\n      <a href=\"#products\">Backdrops<\u002Fa>\n      <a href=\"#usecases\">For Churches<\u002Fa>\n      <a href=\"#seasonal\">Seasonal<\u002Fa>\n      <a href=\"#why\">Why Us<\u002Fa>\n      <a href=\"#faq\">FAQ<\u002Fa>\n    <\u002Fnav>\n    <div class=\"nav-cta\">\n      <span class=\"nav-phone\">24/7 · 1-800-BACKDROP<\u002Fspan>\n      <a href=\"#products\" class=\"btn btn-primary\" style=\"padding:12px 22px;font-size:13.5px;\">Shop Church Backdrops<\u002Fa>\n      <button class=\"nav-burger\" id=\"burger\" aria-label=\"Menu\"><span><\u002Fspan><span><\u002Fspan><span><\u002Fspan><\u002Fbutton>\n    <\u002Fdiv>\n  <\u002Fdiv>\n  <div class=\"mobile-menu\" id=\"mobileMenu\">\n    <a href=\"#products\">Backdrops<\u002Fa>\n    <a href=\"#usecases\">For Churches<\u002Fa>\n    <a href=\"#seasonal\">Seasonal<\u002Fa>\n    <a href=\"#why\">Why Us<\u002Fa>\n    <a href=\"#faq\">FAQ<\u002Fa>\n    <a href=\"#products\" style=\"color:var(--gold-soft);font-weight:800;\">Shop Church Backdrops →<\u002Fa>\n  <\u002Fdiv>\n<\u002Fheader>\n\n<!-- ===================== HERO ===================== -->\n<section class=\"hero\" id=\"top\" data-screen-label=\"Hero\">\n  <div class=\"hero-bg\">\n    <img src=\"4686445f-836f-45df-89e7-2f7c9f151bd4\" alt=\"Congregation worshipping with hands raised under warm stage light\">\n  <\u002Fdiv>\n  <div class=\"wrap\">\n    <div class=\"hero-inner reveal\">\n      <span class=\"hero-kicker\"><span class=\"ico\">✦<\u002Fspan> Trusted by ministry media teams since 2004<\u002Fspan>\n      <h1>Set the stage for <em>worship<\u002Fem> that moves people.<\u002Fh1>\n      <p class=\"hero-sub\">Premium printed backdrops, green-screen kits, and studio lighting that turn any sanctuary, livestream, or seasonal production into a moment your congregation remembers.<\u002Fp>\n      <div class=\"hero-cta\">\n        <a href=\"#products\" class=\"btn btn-gold\">Shop Church Backdrops <span class=\"arr\">→<\u002Fspan><\u002Fa>\n        <a href=\"#usecases\" class=\"btn btn-outline\">See it in your church<\u002Fa>\n      <\u002Fdiv>\n      <div class=\"hero-trust\">\n        <div class=\"t\"><b data-count=\"20\"><em>20+<\u002Fem><\u002Fb><span>Years of stagecraft<\u002Fspan><\u002Fdiv>\n        <div class=\"div\"><\u002Fdiv>\n        <div class=\"t\"><b data-count=\"500\">500+<\u002Fb><span>Backdrop designs<\u002Fspan><\u002Fdiv>\n        <div class=\"div\"><\u002Fdiv>\n        <div class=\"t\"><b data-count=\"12000\">12k+<\u002Fb><span>Ministries served<\u002Fspan><\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n  <div class=\"scroll-cue\"><div class=\"mouse\"><\u002Fdiv><span>Scroll<\u002Fspan><\u002Fdiv>\n<\u002Fsection>\n\n<!-- ===================== LOGOS BAND ===================== -->\n<div class=\"logos-band\">\n  <div class=\"wrap logos-row\">\n    <span class=\"logos-lead\">Partnered with<\u002Fspan>\n    <span>Savage<\u002Fspan><span>JTL<\u002Fspan><span>Norman<\u002Fspan><span>Photogenic<\u002Fspan><span>Speedotron<\u002Fspan><span>DJI<\u002Fspan>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<!-- ===================== FEATURED PRODUCTS ===================== -->\n<section class=\"sec products\" id=\"products\" data-screen-label=\"Featured products\">\n  <div class=\"wrap\">\n    <div class=\"sec-head center reveal\">\n      <span class=\"eyebrow center\">Church-ready collection<\u002Fspan>\n      <h2 class=\"sec-title\">Built for the sanctuary<\u002Fh2>\n      <p class=\"sec-desc\">The backdrops, kits, and gear ministry media teams reach for every week — durable, camera-perfect, and fast to set up.<\u002Fp>\n    <\u002Fdiv>\n    <div class=\"prod-grid\">\n\n      <article class=\"prod-card reveal\">\n        <div class=\"prod-media\"><span class=\"prod-tag\">Bestseller<\u002Fspan><img src=\"89961031-c369-44a3-8074-4a9cec9740fc\" alt=\"Stained-glass style printed church backdrop\"><\u002Fdiv>\n        <div class=\"prod-body\">\n          <h3>Wrinkle-Resistant Backdrops<\u002Fh3>\n          <p>Polyester backdrops that hang ready-to-shoot — no steaming, no creases under stage lights.<\u002Fp>\n          <div class=\"prod-foot\"><div class=\"prod-price\">$129<small> / from<\u002Fsmall><\u002Fdiv><a class=\"prod-link\" href=\"#\">Shop <span class=\"arr\">→<\u002Fspan><\u002Fa><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Farticle>\n\n      <article class=\"prod-card reveal\">\n        <div class=\"prod-media\"><span class=\"prod-tag gold\">Popular<\u002Fspan><img src=\"1fbde5c0-9d99-4131-bdc8-143f3ec1db59\" alt=\"Cathedral interior scene backdrop\"><\u002Fdiv>\n        <div class=\"prod-body\">\n          <h3>Church Scene Backdrops<\u002Fh3>\n          <p>High-definition cathedral, stained-glass, and chapel scenes that bring reverence to any stage.<\u002Fp>\n          <div class=\"prod-foot\"><div class=\"prod-price\">$159<small> / from<\u002Fsmall><\u002Fdiv><a class=\"prod-link\" href=\"#\">Shop <span class=\"arr\">→<\u002Fspan><\u002Fa><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Farticle>\n\n      <article class=\"prod-card reveal\">\n        <div class=\"prod-media\"><span class=\"prod-tag\">Custom Print<\u002Fspan><img src=\"21caa3fd-23c3-4e6d-9511-b5fc37cb73a3\" alt=\"Large printed stage backdrop with worship graphics\"><\u002Fdiv>\n        <div class=\"prod-body\">\n          <h3>Large Fabric Printing<\u002Fh3>\n          <p>Your sermon series art, printed full-stage on premium fabric in vivid, true-to-brand color.<\u002Fp>\n          <div class=\"prod-foot\"><div class=\"prod-price\">Quote<\u002Fdiv><a class=\"prod-link\" href=\"#\">Customize <span class=\"arr\">→<\u002Fspan><\u002Fa><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Farticle>\n\n      <article class=\"prod-card reveal\">\n        <div class=\"prod-media\"><span class=\"prod-tag\">Livestream<\u002Fspan><img src=\"0b41ed60-5a99-4980-aebf-b1be09fa0a77\" alt=\"Video camera filming for church livestream\"><\u002Fdiv>\n        <div class=\"prod-body\">\n          <h3>Chromakey Green-Screen Kits<\u002Fh3>\n          <p>Pop-up green screens and stands for broadcast-clean keying on every streamed service.<\u002Fp>\n          <div class=\"prod-foot\"><div class=\"prod-price\">$199<small> / kit<\u002Fsmall><\u002Fdiv><a class=\"prod-link\" href=\"#\">Shop <span class=\"arr\">→<\u002Fspan><\u002Fa><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Farticle>\n\n      <article class=\"prod-card reveal\">\n        <div class=\"prod-media\"><span class=\"prod-tag gold\">New<\u002Fspan><img src=\"ae40eed6-fcfc-4fa9-a2da-9eb337ce8fa8\" alt=\"Sanctuary interior with pews\"><\u002Fdiv>\n        <div class=\"prod-body\">\n          <h3>Worship Stage Backdrops<\u002Fh3>\n          <p>Full-width statement panels and muslin sets that transform the platform for any series.<\u002Fp>\n          <div class=\"prod-foot\"><div class=\"prod-price\">$149<small> / from<\u002Fsmall><\u002Fdiv><a class=\"prod-link\" href=\"#\">Shop <span class=\"arr\">→<\u002Fspan><\u002Fa><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Farticle>\n\n      <article class=\"prod-card reveal\">\n        <div class=\"prod-media\"><span class=\"prod-tag\">Lobby &amp; Welcome<\u002Fspan><img src=\"35f4d6be-9faf-4c0f-afca-bb644c800d9d\" alt=\"Congregation in church lobby and seating area\"><\u002Fdiv>\n        <div class=\"prod-body\">\n          <h3>Banners &amp; Way-Finding<\u002Fh3>\n          <p>Portable printed banners to welcome visitors, mark kids' areas, and promote what's next.<\u002Fp>\n          <div class=\"prod-foot\"><div class=\"prod-price\">$89<small> / from<\u002Fsmall><\u002Fdiv><a class=\"prod-link\" href=\"#\">Shop <span class=\"arr\">→<\u002Fspan><\u002Fa><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Farticle>\n\n    <\u002Fdiv>\n    <div style=\"text-align:center;margin-top:44px;\" class=\"reveal\">\n      <a href=\"#\" class=\"btn btn-navy\">Browse the full church collection <span class=\"arr\">→<\u002Fspan><\u002Fa>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- ===================== USE CASES ===================== -->\n<section class=\"sec usecases\" id=\"usecases\" data-screen-label=\"Use cases\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"eyebrow\">How churches use it<\u002Fspan>\n      <h2 class=\"sec-title\">One source for every ministry moment<\u002Fh2>\n      <p class=\"sec-desc\">From Sunday mornings to midweek streams, our gear flexes to whatever the room — and the camera — needs.<\u002Fp>\n    <\u002Fdiv>\n    <div class=\"uc-grid\">\n      <div class=\"uc-card tall reveal\">\n        <img src=\"6953ce2b-5923-4c64-ac33-42291b9ff9d1\" alt=\"Worship service with raised hands\">\n        <div class=\"uc-body\">\n          <div class=\"num\">01 — Weekly worship<\u002Fdiv>\n          <h3>Sunday stage sets<\u002Fh3>\n          <p>Transform the platform for every sermon series with full-width statement backdrops that set a worshipful tone before the first song.<\u002Fp>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div class=\"uc-card reveal\">\n        <img src=\"0b41ed60-5a99-4980-aebf-b1be09fa0a77\" alt=\"Camera filming church service\">\n        <div class=\"uc-body\">\n          <div class=\"num\">02 — Online campus<\u002Fdiv>\n          <h3>Livestream &amp; broadcast<\u002Fh3>\n          <p>Green-screen kits and clean backgrounds keep your online congregation distraction-free.<\u002Fp>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div class=\"uc-card reveal\">\n        <img src=\"60dffc4c-046c-4f15-a6a7-b597c50f3527\" alt=\"Worshipper silhouette under starlit sky\">\n        <div class=\"uc-body\">\n          <div class=\"num\">03 — Nights &amp; events<\u002Fdiv>\n          <h3>Worship nights<\u002Fh3>\n          <p>Atmospheric backdrops and lighting that turn the room into an immersive encounter.<\u002Fp>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div class=\"uc-card reveal\">\n        <img src=\"92f3239c-96a8-479f-8587-d4dc3846557a\" alt=\"Open Bible during study\">\n        <div class=\"uc-body\">\n          <div class=\"num\">04 — Reverent moments<\u002Fdiv>\n          <h3>Choir, baptism &amp; study<\u002Fh3>\n          <p>Soft muslin backdrops for baptisms, choir features, small groups, and directory portraits.<\u002Fp>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div class=\"uc-card reveal\">\n        <img src=\"2e1df4b8-b267-47fc-bd93-b35f7d47e964\" alt=\"Conference hall set for an event\">\n        <div class=\"uc-body\">\n          <div class=\"num\">05 — Big gatherings<\u002Fdiv>\n          <h3>Conferences &amp; productions<\u002Fh3>\n          <p>Arena-ready branded sets and lighting that make your event stage feel larger than life.<\u002Fp>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- ===================== HOW IT WORKS ===================== -->\n<section class=\"sec steps\" data-screen-label=\"How it works\">\n  <div class=\"wrap\">\n    <div class=\"sec-head center on-dark reveal\">\n      <span class=\"eyebrow center on-dark\">Simple from cart to platform<\u002Fspan>\n      <h2 class=\"sec-title\">Set your stage in three steps<\u002Fh2>\n    <\u002Fdiv>\n    <div class=\"steps-grid\">\n      <div class=\"step reveal\"><div class=\"n\">1<\u002Fdiv><h3>Tell us your space<\u002Fh3><p>Share your stage width and camera frame — our team specs the exact size and fabric, free, over chat or phone.<\u002Fp><\u002Fdiv>\n      <div class=\"step reveal\"><div class=\"n\">2<\u002Fdiv><h3>We ship it fast<\u002Fh3><p>In-stock backdrops and kits ship within 1–2 business days from the US, with rush options before major seasons.<\u002Fp><\u002Fdiv>\n      <div class=\"step reveal\"><div class=\"n\">3<\u002Fdiv><h3>Hang &amp; go live<\u002Fh3><p>Wrinkle-resistant fabric hangs ready-to-shoot, so volunteers set the stage in minutes — not hours.<\u002Fp><\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- ===================== SEASONAL ===================== -->\n<section class=\"sec seasonal\" id=\"seasonal\" data-screen-label=\"Seasonal collections\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"eyebrow\">Seasonal collections<\u002Fspan>\n      <h2 class=\"sec-title\">A set for every sacred season<\u002Fh2>\n      <p class=\"sec-desc\">Story-driven backdrops designed to pack down fast and come back year after year.<\u002Fp>\n    <\u002Fdiv>\n    <div class=\"season-grid\">\n      <article class=\"season-card reveal\">\n        <img src=\"0facc63c-8212-49c1-91d6-0f7e2c4b3e21\" alt=\"Christmas lights and tree\">\n        <div class=\"season-body\"><span class=\"season-pill\">Advent · Christmas<\u002Fspan><h3>Silent Night<\u002Fh3><p>Starlit backdrops and warm lighting for candlelight Christmas Eve services.<\u002Fp><\u002Fdiv>\n      <\u002Farticle>\n      <article class=\"season-card reveal\">\n        <img src=\"89961031-c369-44a3-8074-4a9cec9740fc\" alt=\"Stained glass windows\">\n        <div class=\"season-body\"><span class=\"season-pill\">Lent · Easter<\u002Fspan><h3>He Is Risen<\u002Fh3><p>Stained-glass and sunrise sets to anchor your resurrection celebration.<\u002Fp><\u002Fdiv>\n      <\u002Farticle>\n      <article class=\"season-card reveal\">\n        <img src=\"2e1df4b8-b267-47fc-bd93-b35f7d47e964\" alt=\"Conference stage and seating\">\n        <div class=\"season-body\"><span class=\"season-pill\">Conference<\u002Fspan><h3>Gather &amp; Go<\u002Fh3><p>Bold branded backdrops and lighting that make any event stage arena-ready.<\u002Fp><\u002Fdiv>\n      <\u002Farticle>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- ===================== WHY US ===================== -->\n<section class=\"sec why\" id=\"why\" data-screen-label=\"Why us\">\n  <div class=\"wrap why-grid\">\n    <div class=\"why-media reveal\">\n      <img src=\"e1817134-5c54-41c7-9277-f580871b8ad0\" alt=\"Elegant cathedral interior\">\n      <div class=\"why-badge\">\n        <div class=\"big\">2004<\u002Fdiv>\n        <p>Serving ministry media teams for over two decades — from a single backdrop to full-campus rollouts.<\u002Fp>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div class=\"reveal\">\n      <span class=\"eyebrow\">Why ministries choose us<\u002Fspan>\n      <h2 class=\"sec-title\" style=\"margin:16px 0 34px;\">Quality you can trust on stage<\u002Fh2>\n      <div class=\"why-list\">\n        <div class=\"why-item\"><div class=\"why-ic\">✓<\u002Fdiv><div><h3>Genuine, quality-tested gear<\u002Fh3><p>Every backdrop and light is inspected before it ships — built to survive years of weekly setups.<\u002Fp><\u002Fdiv><\u002Fdiv>\n        <div class=\"why-item\"><div class=\"why-ic\">☎<\u002Fdiv><div><h3>24/7 expert support<\u002Fh3><p>Real photography pros help your volunteers choose the right size, fabric, and lighting — any time.<\u002Fp><\u002Fdiv><\u002Fdiv>\n        <div class=\"why-item\"><div class=\"why-ic\">✦<\u002Fdiv><div><h3>Ministry &amp; bulk pricing<\u002Fh3><p>Special pricing for churches and non-profits, plus 100% purchase protection on every order.<\u002Fp><\u002Fdiv><\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"margin-top:34px;\"><a href=\"#products\" class=\"btn btn-primary\">Shop the collection <span class=\"arr\">→<\u002Fspan><\u002Fa><\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- ===================== TESTIMONIALS ===================== -->\n<section class=\"sec testi\" data-screen-label=\"Testimonials\">\n  <div class=\"wrap\">\n    <div class=\"sec-head center on-dark reveal\">\n      <span class=\"eyebrow center on-dark\">Loved by media teams<\u002Fspan>\n      <h2 class=\"sec-title\">Trusted from the booth to the platform<\u002Fh2>\n    <\u002Fdiv>\n    <div class=\"testi-grid\">\n      <div class=\"testi-card reveal\"><div class=\"quote-mark\">”<\u002Fdiv><div class=\"stars\">★★★★★<\u002Fdiv><blockquote>Our Christmas set went from cardboard to cinematic. The backdrops hung perfectly and looked incredible on the livestream.<\u002Fblockquote><div class=\"testi-who\"><div class=\"avatar\">DM<\u002Fdiv><div><b>Daniel Mercer<\u002Fb><span>Media Director · Grace City Church<\u002Fspan><\u002Fdiv><\u002Fdiv><\u002Fdiv>\n      <div class=\"testi-card reveal\"><div class=\"quote-mark\">”<\u002Fdiv><div class=\"stars\">★★★★★<\u002Fdiv><blockquote>The green-screen kit transformed our online campus. Keying is clean every week and setup takes our volunteers minutes.<\u002Fblockquote><div class=\"testi-who\"><div class=\"avatar\">RT<\u002Fdiv><div><b>Rachel Tan<\u002Fb><span>Online Pastor · Living Hope<\u002Fspan><\u002Fdiv><\u002Fdiv><\u002Fdiv>\n      <div class=\"testi-card reveal\"><div class=\"quote-mark\">”<\u002Fdiv><div class=\"stars\">★★★★★<\u002Fdiv><blockquote>Support picked up at 11pm before Easter weekend and walked me through lighting. That's why we keep coming back.<\u002Fblockquote><div class=\"testi-who\"><div class=\"avatar\">JF<\u002Fdiv><div><b>Jonah Fields<\u002Fb><span>Tech Lead · Cornerstone Fellowship<\u002Fspan><\u002Fdiv><\u002Fdiv><\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- ===================== FAQ ===================== -->\n<section class=\"sec faq\" id=\"faq\" data-screen-label=\"FAQ\">\n  <div class=\"wrap\">\n    <div class=\"sec-head center reveal\">\n      <span class=\"eyebrow center\">Questions, answered<\u002Fspan>\n      <h2 class=\"sec-title\">Before you set the stage<\u002Fh2>\n    <\u002Fdiv>\n    <div class=\"faq-wrap reveal\">\n      <div class=\"faq-item\"><button class=\"faq-q\">What size backdrop does our stage need?<span class=\"pm\">+<\u002Fspan><\u002Fbutton><div class=\"faq-a\"><p>Measure your platform width and your camera frame. Most church stages use 10–20 ft backdrops; our team will spec the exact size for free over chat or phone.<\u002Fp><\u002Fdiv><\u002Fdiv>\n      <div class=\"faq-item\"><button class=\"faq-q\">Will the backdrop wrinkle under stage lights?<span class=\"pm\">+<\u002Fspan><\u002Fbutton><div class=\"faq-a\"><p>Our wrinkle-resistant polyester and premium muslin lines hang ready-to-shoot. Polyester needs no steaming; muslin smooths with light steaming if folded.<\u002Fp><\u002Fdiv><\u002Fdiv>\n      <div class=\"faq-item\"><button class=\"faq-q\">Do you offer green screens for livestreaming?<span class=\"pm\">+<\u002Fspan><\u002Fbutton><div class=\"faq-a\"><p>Yes — pop-up and panel chromakey kits with stands, plus chroma paint and editing software so your broadcast keys cleanly every service.<\u002Fp><\u002Fdiv><\u002Fdiv>\n      <div class=\"faq-item\"><button class=\"faq-q\">Can we get bulk or ministry pricing?<span class=\"pm\">+<\u002Fspan><\u002Fbutton><div class=\"faq-a\"><p>Absolutely. Churches, schools, and non-profits qualify for special pricing — request a quote and a specialist will build your package.<\u002Fp><\u002Fdiv><\u002Fdiv>\n      <div class=\"faq-item\"><button class=\"faq-q\">How fast does it ship?<span class=\"pm\">+<\u002Fspan><\u002Fbutton><div class=\"faq-a\"><p>In-stock backdrops and kits ship within 1–2 business days from the US, with rush options before major seasons like Christmas and Easter.<\u002Fp><\u002Fdiv><\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- ===================== CTA ===================== -->\n<section class=\"cta\" data-screen-label=\"CTA\">\n  <div class=\"cta-bg\"><img src=\"7fdf9bc1-1118-41e0-b00d-1928c37e9719\" alt=\"Worshipper under a starlit sky\"><\u002Fdiv>\n  <div class=\"wrap reveal\">\n    <h2>Ready to set your stage for <em>worship?<\u002Fem><\u002Fh2>\n    <p>Talk to a backdrop specialist or shop the full church-ready collection today.<\u002Fp>\n    <div class=\"hero-cta\">\n      <a href=\"#products\" class=\"btn btn-gold\">Shop Church Backdrops <span class=\"arr\">→<\u002Fspan><\u002Fa>\n      <a href=\"#\" class=\"btn btn-outline\">Request a free quote<\u002Fa>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- ===================== FOOTER ===================== -->\n<footer class=\"footer\">\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div class=\"foot-col\">\n        <a class=\"logo\" href=\"#top\" style=\"margin-bottom:16px;\"><span class=\"logo-mark\">BS<\u002Fspan><span class=\"logo-text\"><b>BACKDROP SOURCE<\u002Fb><span>Setting the stage since 2004<\u002Fspan><\u002Fspan><\u002Fa>\n        <p>The largest collection of photography backdrops, studio gear, and chromakey kits in the USA — now church-ready.<\u002Fp>\n      <\u002Fdiv>\n      <div class=\"foot-col\"><h4>Shop<\u002Fh4><a href=\"#products\">Wrinkle-Resistant<\u002Fa><a href=\"#products\">Church Scenes<\u002Fa><a href=\"#products\">Chromakey Kits<\u002Fa><a href=\"#products\">Large Fabric Printing<\u002Fa><a href=\"#products\">Banners<\u002Fa><\u002Fdiv>\n      <div class=\"foot-col\"><h4>For Churches<\u002Fh4><a href=\"#usecases\">Sanctuary Sets<\u002Fa><a href=\"#usecases\">Livestream<\u002Fa><a href=\"#seasonal\">Seasonal<\u002Fa><a href=\"#why\">Bulk Pricing<\u002Fa><\u002Fdiv>\n      <div class=\"foot-col\"><h4>Support<\u002Fh4><a href=\"#faq\">FAQ<\u002Fa><a href=\"#\">24/7 Help<\u002Fa><a href=\"#\">Shipping<\u002Fa><a href=\"#\">Contact Sales<\u002Fa><\u002Fdiv>\n    <\u002Fdiv>\n    <div class=\"foot-bottom\"><span>© 2026 Backdrop Source · Las Vegas, NV<\u002Fspan><span>Making brands desirable since 2004<\u002Fspan><\u002Fdiv>\n  <\u002Fdiv>\n<\u002Ffooter>\n\n<div id=\"tweaks-root\"><\u002Fdiv>\n\n\n\n<script src=\"b5588787-701e-4d3b-8255-a7b07b4c5c22\" integrity=\"sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L\" crossorigin=\"anonymous\"><\u002Fscript>\n<script src=\"7d86a199-060b-4516-b449-2a7e782190e6\" integrity=\"sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm\" crossorigin=\"anonymous\"><\u002Fscript>\n<script src=\"2a5ab0f9-71f7-4d9d-9427-f81e5c40c8b7\" integrity=\"sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y\" crossorigin=\"anonymous\"><\u002Fscript>\n<script src=\"151b26f0-df0a-459b-8636-b51b1e068e15\"><\u002Fscript>\n<script type=\"text/babel\" src=\"8d9a20a5-a1a8-417f-924a-3eaa19b918ee\"><\u002Fscript>\n<script type=\"text/babel\" src=\"d310cdb0-5704-4fe1-aa9c-5bcad543e957\"><\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
