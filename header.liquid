  "@context":"http://schema.org","@type":"Organization",
  "name":{{ shop.name | json }},
  {% if settings.logo %}"logo":{{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},{% endif %}
  "url":{{ request.origin | append: page.url | json }}
}
</script>
{%- if request.page_type == 'index' -%}
{%- assign _sat = request.origin | append: routes.search_url | append: '?q=' -%}
{%- assign _sat = _sat | append: '{search_term_string}' -%}
<script type="application/ld+json">
{
  "@context":"http://schema.org","@type":"WebSite",
  "name":{{ shop.name | json }},
  "potentialAction":{"@type":"SearchAction","target":{{ _sat | json }},"query-input":"required name=search_term_string"},
  "url":{{ request.origin | append: page.url | json }}
}
</script>
{%- endif -%}

<script>
(function(){
  'use strict';
  const SID = '{{ section.id }}';
  const SEARCH_URL = '{{ routes.search_url }}';

  /* ── 1. PREDICTIVE SEARCH ──────────────────────────────── */
  const input   = document.getElementById('BdsSearchInput-'  + SID);
  const wrap    = document.getElementById('BdsSearchWrap-'   + SID);
  const panel   = document.getElementById('BdsSearchResults-'+ SID);
  const submitB = document.getElementById('BdsSearchSubmit-' + SID);

  if (input && panel) {
    let abort = null, timer = null, current = '';

    const fmt  = c => '$' + (c/100).toFixed(2).replace(/\.00$/,'');
    const esc  = s => s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const mark = (t,q) => t.replace(new RegExp('('+q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+')','gi'),'<mark>$1</mark>');

    const positionPanel = () => {
      if (!wrap) return;
      const r = wrap.getBoundingClientRect();
      panel.style.top   = (r.bottom + 6) + 'px';
      panel.style.left  = r.left + 'px';
      panel.style.width = r.width + 'px';
    };

    const open  = () => {
      positionPanel();
      panel.classList.add('is-open');
      input.setAttribute('aria-expanded','true');
    };
    const close = () => {
      panel.classList.remove('is-open');
      input.setAttribute('aria-expanded','false');
    };

    // Reposition on scroll/resize (sticky header moves)
    window.addEventListener('scroll', () => { if (panel.classList.contains('is-open')) positionPanel(); }, { passive: true });
    window.addEventListener('resize', () => { if (panel.classList.contains('is-open')) positionPanel(); }, { passive: true });

    const skeleton = () => {
      panel.innerHTML = '<div class="bds-results__loading">'
        + [1,2,3].map(()=>'<div class="bds-skel"><div class="bds-skel__img"></div><div class="bds-skel__text"><div class="bds-skel__line"></div><div class="bds-skel__line bds-skel__line--s"></div></div></div>').join('')
        + '</div>';
    };

    const empty = q => {
      panel.innerHTML = '<div class="bds-results__empty"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>No results for <strong>' + esc(q) + '</strong></div>'
        + '<div class="bds-results__footer"><a class="bds-results__viewall" href="'+SEARCH_URL+'?q='+encodeURIComponent(q)+'&type=product">Browse all products</a></div>';
    };

    const render = (products, q) => {
      if (!products || !products.length) { empty(q); return; }
      let html = '<p class="bds-results__label">Products</p>';
      products.forEach(p => {
        const raw = p.featured_image;
        const src = raw ? (typeof raw==='object' ? raw.url : raw).replace(/(\.[a-z]+)(\?|$)/,'_44x44_crop_center$1$2') : null;
        const img = src
          ? '<img class="bds-results__img" src="'+src+'" alt="'+esc(p.title)+'" loading="lazy" width="44" height="44">'
          : '<div class="bds-results__placeholder"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg></div>';
        const price = (p.price||p.price_min) ? fmt(p.price||p.price_min) : '';
        const cmp   = (p.compare_at_price_min && p.compare_at_price_min>(p.price||p.price_min)) ? fmt(p.compare_at_price_min) : '';
        html += '<a class="bds-results__item" href="'+p.url+'" role="option">'
          + img
          + '<div class="bds-results__info">'
          + '<div class="bds-results__title">'+mark(esc(p.title),q)+'</div>'
          + (p.vendor ? '<div class="bds-results__vendor">'+esc(p.vendor)+'</div>' : '')
          + (price ? '<div style="display:flex;align-items:center;gap:5px;"><span class="bds-results__price">'+price+'</span>'+(cmp?'<span class="bds-results__compare">'+cmp+'</span>':'')+'</div>' : '')
          + '</div></a>';
      });
      html += '<div class="bds-results__footer"><a class="bds-results__viewall" href="'+SEARCH_URL+'?q='+encodeURIComponent(q)+'&type=product">View all results for <strong>'+esc(q)+'</strong> &rarr;</a></div>';
      panel.innerHTML = html;
    };

    const fetch_ = async q => {
      if (abort) abort.abort();
      abort = new AbortController();
      try {
        const r = await fetch('/search/suggest.json?q='+encodeURIComponent(q)+'&resources[type]=product&resources[limit]=8&resources[options][fields]=title,product_type,variants.title,vendor&resources[options][unavailable_products]=last',{signal:abort.signal});
        if (!r.ok) throw new Error();
        const d = await r.json();
        render((d.resources&&d.resources.results&&d.resources.results.products)||[], q);
      } catch(e) {
        if (e.name==='AbortError') return;
        panel.innerHTML = '<div class="bds-results__empty">Something went wrong. <a href="'+SEARCH_URL+'?q='+encodeURIComponent(q)+'" style="color:var(--ha)">View all</a></div>';
      }
    };

    input.addEventListener('input', () => {
      const q = input.value.trim();
      if (q === current) return;
      current = q;
      clearTimeout(timer);
      if (q.length < 2) { close(); return; }
      open(); skeleton();
      timer = setTimeout(() => fetch_(q), 260);
    });

    input.addEventListener('focus', () => { if (input.value.trim().length >= 2) open(); });

    input.addEventListener('keydown', e => {
      if (e.key === 'Escape') { close(); input.blur(); }
      if (e.key === 'Enter' && input.value.trim()) {
        window.location.href = SEARCH_URL + '?q=' + encodeURIComponent(input.value.trim()) + '&type=product';
      }
    });

    document.addEventListener('click', e => {
      if (wrap && !wrap.contains(e.target)) close();
    });
  }

  if (submitB && input) {
    submitB.addEventListener('click', () => {
      const q = input.value.trim();
      if (q) window.location.href = SEARCH_URL + '?q=' + encodeURIComponent(q) + '&type=product';
    });
  }

  /* ── 2. VOICE SEARCH ────────────────────────────────────── */
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  const voiceBtn = document.getElementById('BdsVoiceBtn-' + SID);
  if (SR && voiceBtn && input) {
    const rec = new SR();
    rec.continuous = false; rec.interimResults = true;
    rec.lang = document.documentElement.lang || 'en-US';
    let listening = false;

    voiceBtn.addEventListener('click', () => { listening ? rec.stop() : rec.start(); });

    rec.onstart  = () => { listening=true;  voiceBtn.classList.add('is-listening');    voiceBtn.setAttribute('aria-label','Listening…'); input.placeholder='Listening…'; };
    rec.onend    = () => { listening=false; voiceBtn.classList.remove('is-listening'); voiceBtn.setAttribute('aria-label','Voice search'); input.placeholder='{{ section.settings.search_placeholder | default: "Search" }}'; };
    rec.onerror  = e => { rec.onend(); if (e.error==='not-allowed') alert('Microphone access denied. Please allow it in browser settings.'); };
    rec.onresult = e => {
      const t = Array.from(e.results).map(r=>r[0].transcript).join('');
      input.value = t;
      input.dispatchEvent(new Event('input',{bubbles:true}));
      if (e.results[e.results.length-1].isFinal && t.trim())
        setTimeout(() => { window.location.href = SEARCH_URL+'?q='+encodeURIComponent(t.trim())+'&type=product'; }, 600);
    };
  } else if (voiceBtn) {
    voiceBtn.style.display = 'none';
  }



  /* ── 3. TRACK ORDER (desktop dropdown) ──────────────────── */
  const trackTrig   = document.getElementById('BdsTrackTrigger-' + SID);
  const trackDrop   = document.getElementById('BdsTrackDropdown-'+ SID);
  const trackInput  = document.getElementById('BdsTrackInput-'   + SID);
  const trackBtn    = document.getElementById('BdsTrackBtn-'     + SID);
  const trackResult = document.getElementById('BdsTrackResult-'  + SID);
  const trackWrap   = trackTrig && trackTrig.closest('.bds-track-wrapper');

  if (trackTrig && trackWrap) {
    const toggle = force => {
      const open = trackWrap.classList.toggle('is-open', force);
      trackTrig.setAttribute('aria-expanded', open);
    };
    trackTrig.addEventListener('click', () => toggle());
    trackTrig.addEventListener('keydown', e => { if (e.key==='Enter'||e.key===' '){e.preventDefault();toggle();} });
    document.addEventListener('click', e => { if (trackWrap && !trackWrap.contains(e.target)) toggle(false); });
  }

  const doTrack = async (inp, resultEl) => {
    if (!inp||!resultEl) return;
    const val = inp.value.trim();
    if (!val) { resultEl.className='bds-track-drop-result err'; resultEl.innerHTML='<strong>Please enter an order number.</strong>'; return; }
    resultEl.className='bds-track-drop-result ok'; resultEl.innerHTML='<strong>Looking up your order…</strong>';
    try {
      const r = await fetch('/account/orders.json',{headers:{'Content-Type':'application/json'},credentials:'same-origin'});
      if (r.ok) {
        const d = await r.json();
        const clean = val.replace(/^#/,'').toLowerCase();
        const found = (d.orders||[]).find(o => String(o.order_number).toLowerCase()===clean || (o.fulfillments||[]).some(f=>(f.tracking_numbers||[]).some(t=>t.toLowerCase()===clean)));
        if (found) {
          const ff = (found.fulfillments||[])[0];
          const tn = ff&&ff.tracking_numbers&&ff.tracking_numbers[0];
          const tu = ff&&ff.tracking_urls&&ff.tracking_urls[0];
          const st = found.fulfillment_status||'processing';
          resultEl.className='bds-track-drop-result ok';
          resultEl.innerHTML='<strong>Order #'+found.order_number+'</strong>Status: '+st.charAt(0).toUpperCase()+st.slice(1)+(tn?'<br>Tracking: '+tn:'')+(tu?'<a href="'+tu+'" target="_blank" rel="noopener">Track Shipment →</a>':'')+'<a href="/account/orders/'+found.id+'">View Order →</a>';
          return;
        }
      }
    } catch(e){}
    resultEl.className='bds-track-drop-result ok';
    resultEl.innerHTML='<strong>Searching…</strong><a href="/pages/track-order?order='+encodeURIComponent(val)+'">View tracking →</a>';
  };

  if (trackBtn) {
    trackBtn.addEventListener('click',()=>doTrack(trackInput,trackResult));
    trackInput&&trackInput.addEventListener('keydown',e=>{ if(e.key==='Enter') doTrack(trackInput,trackResult); });
  }

  /* ── 4. MOBILE DRAWER INJECT ────────────────────────────── */
  const injectMobile = () => {
    const tpl = document.getElementById('BdsMobileActionsTemplate-' + SID);
    if (!tpl || document.querySelector('.bds-drawer-actions')) return;
    const anchor = document.querySelector('.menu-drawer__utility-links, .menu-drawer__footer, .menu-drawer nav');
    if (!anchor) return;
    anchor.parentNode.insertBefore(tpl.content.cloneNode(true), anchor.nextSibling);

    setTimeout(() => {
      // Track Order removed from mobile drawer
    },150);
  };

  document.addEventListener('DOMContentLoaded', injectMobile);
  document.querySelectorAll('[aria-controls="MenuDrawer"]').forEach(b => b.addEventListener('click',()=>setTimeout(injectMobile,420)));

  /* ── INJECT VOICE SEARCH INTO SEARCH DRAWER ──────────────────
     When the search icon opens the theme's SearchDrawer,
     we inject a voice mic button inside the search input field.
  ──────────────────────────────────────────────────────────────── */
  (function() {
    let drawerVoiceInjected = false;

    const injectDrawerVoice = () => {
      if (drawerVoiceInjected) return;
      const drawer = document.getElementById('SearchDrawer');
      if (!drawer) return;

      // Find the search input inside the drawer
      const drawerInput = drawer.querySelector('input[type="search"], input[name="q"], .search__input');
      if (!drawerInput) return;

      drawerVoiceInjected = true;

      // Create voice button
      const voiceBtn = document.createElement('button');
      voiceBtn.type = 'button';
      voiceBtn.setAttribute('aria-label', 'Voice search');
      voiceBtn.setAttribute('title', 'Voice search');
      voiceBtn.style.cssText = [
        'position:absolute',
        'right:48px',
        'top:50%',
        'transform:translateY(-50%)',
        'background:none',
        'border:none',
        'cursor:pointer',
        'padding:6px',
        'color:#9ca3af',
        'border-radius:50%',
        'display:flex',
        'align-items:center',
        'justify-content:center',
        'width:32px',
        'height:32px',
        'transition:color 0.18s,background 0.18s',
        'z-index:10',
      ].join(';');
      voiceBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="width:18px;height:18px;"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>';

      // Ensure the input wrapper is position:relative
      const inputWrapper = drawerInput.parentElement;
      if (inputWrapper) {
        inputWrapper.style.position = 'relative';
        inputWrapper.appendChild(voiceBtn);
      }

      // Wire up SpeechRecognition
      const SRClass = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SRClass) { voiceBtn.style.display = 'none'; return; }

      const rec = new SRClass();
      rec.continuous = false;
      rec.interimResults = true;
      rec.lang = document.documentElement.lang || 'en-US';
      let isListening = false;

      const setListening = (val) => {
        isListening = val;
        voiceBtn.style.color = val ? '#e53935' : '#9ca3af';
        voiceBtn.style.background = val ? 'rgba(229,57,53,0.09)' : 'none';
        voiceBtn.setAttribute('aria-label', val ? 'Listening…' : 'Voice search');
        if (val) {
          voiceBtn.style.animation = 'voicePulse 1.2s infinite';
        } else {
          voiceBtn.style.animation = 'none';
        }
      };

      voiceBtn.addEventListener('click', (e) => {
        e.preventDefault();
        isListening ? rec.stop() : rec.start();
      });

      voiceBtn.addEventListener('mouseenter', () => {
        if (!isListening) voiceBtn.style.color = '#b41943';
      });
      voiceBtn.addEventListener('mouseleave', () => {
        if (!isListening) voiceBtn.style.color = '#9ca3af';
      });

      rec.onstart  = () => setListening(true);
      rec.onend    = () => setListening(false);
      rec.onerror  = (e) => {
        setListening(false);
        if (e.error === 'not-allowed') alert('Microphone access denied. Please allow it in browser settings.');
      };
      rec.onresult = (e) => {
        const transcript = Array.from(e.results).map(r => r[0].transcript).join('');
        drawerInput.value = transcript;
        drawerInput.dispatchEvent(new Event('input', { bubbles: true }));
        if (e.results[e.results.length - 1].isFinal && transcript.trim()) {
          setTimeout(() => {
            window.location.href = SEARCH_URL + '?q=' + encodeURIComponent(transcript.trim()) + '&type=product';
          }, 500);
        }
      };
    };

    // Try on search drawer open
    document.querySelectorAll('[aria-controls="SearchDrawer"]').forEach(btn => {
      btn.addEventListener('click', () => setTimeout(injectDrawerVoice, 350));
    });

    // Also observe via MutationObserver in case drawer opens programmatically
    const drawerEl = document.getElementById('SearchDrawer');
    if (drawerEl && window.MutationObserver) {
      new MutationObserver((mutations) => {
        mutations.forEach(m => {
          if (m.type === 'attributes' && (m.attributeName === 'open' || m.attributeName === 'class')) {
            if (drawerEl.hasAttribute('open') || drawerEl.classList.contains('active') || drawerEl.classList.contains('is-open')) {
              setTimeout(injectDrawerVoice, 200);
            }
          }
        });
      }).observe(drawerEl, { attributes: true });
    }

    document.addEventListener('DOMContentLoaded', () => {
      // Also run on DOMContentLoaded in case drawer is already in DOM
      document.querySelectorAll('[aria-controls="SearchDrawer"]').forEach(btn => {
        btn.addEventListener('click', () => setTimeout(injectDrawerVoice, 350));
      });
    });
  })();

  /* ── 5. MEGA MENU TOP POSITION — set CSS var from nav bar bottom ──
     position:fixed panels need --bds-nav-bottom to know where to appear.
     Uses rAF + passive listeners = zero layout thrashing.
  ───────────────────────────────────────────────────────────────── */
  (function() {
    const setNavBottom = () => {
      const nb = document.querySelector('.bds-nav-bar');
      if (!nb) return;
      requestAnimationFrame(() => {
        const r = nb.getBoundingClientRect();
        // Use Math.floor to avoid subpixel gap between nav bar and mega panel
        document.documentElement.style.setProperty('--bds-nav-bottom', Math.floor(r.bottom) + 'px');
      });
    };
    setNavBottom();
    document.addEventListener('DOMContentLoaded', setNavBottom);
    window.addEventListener('scroll', setNavBottom, { passive: true });
    window.addEventListener('resize', () => requestAnimationFrame(setNavBottom), { passive: true });
  })();

  /* ── 6. MEGA MENU STYLE ENFORCER (exact snippet classes) ───────
     Applies inline overrides using exact class names from snippet:
     .mega-menu__link--top = headings, .mega-menu__item-child = links
  ──────────────────────────────────────────────────────────────── */
  (function() {
    const applyMegaStyles = (detail) => {
      if (!detail) return;

      // Headings: a.mega-menu__link--top  +  a.h4 inside .mega-menu__item
      detail.querySelectorAll('.mega-menu__link--top, .mega-menu__item > a.h4, .mega-menu__item > a.h3').forEach(el => {
        el.style.cssText += ';font-size:10px!important;font-weight:800!important;letter-spacing:0.13em!important;text-transform:uppercase!important;color:#111827!important;padding:0 0 10px 0!important;margin:0 0 8px 0!important;border-bottom:1px solid #e8eaed!important;line-height:1.4!important;display:flex!important;align-items:center!important;gap:8px!important;background:none!important;';
      });

      // Child links: .mega-menu__item-child li a
      detail.querySelectorAll('.mega-menu__item-child a').forEach(a => {
        a.style.cssText += ';font-size:13px!important;font-weight:400!important;color:#374151!important;padding:3.5px 0!important;display:block!important;text-decoration:none!important;line-height:1.5!important;background:none!important;border-bottom:none!important;';
      });

      // Each column: .mega-menu__item
      detail.querySelectorAll('.mega-menu__item').forEach(col => {
        col.style.cssText += ';flex:1 1 180px!important;min-width:160px!important;max-width:230px!important;padding:0 32px 16px 0!important;';
      });
    };

    // Apply when mega menu opens (theme dispatches menu:handleAfterShow)
    document.addEventListener('menu:handleAfterShow', (e) => {
      const detail = e.target && e.target.closest('details[is="details-mega"]');
      if (detail) applyMegaStyles(detail);
    });

    // Also apply on mouseenter as fallback
    document.addEventListener('mouseenter', (e) => {
      const detail = e.target && e.target.closest && e.target.closest('details[is="details-mega"][open]');
      if (detail) applyMegaStyles(detail);
    }, { passive: true, capture: true });
  })();

})();
</script>

