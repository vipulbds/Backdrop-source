{%- liquid
  assign enable_rtl = settings.enable_rtl
  assign language_support_rtl = settings.language_support_rtl
  if enable_rtl and language_support_rtl != blank
    assign shop_locale = localization.language.iso_code
    assign language_support_rtl_list = language_support_rtl | split: ','
    assign is_rtl = language_support_rtl_list | where: shop_locale
    if is_rtl.size > 0
      assign enable_rtl = true
    else
      assign enable_rtl = false
    endif
  endif
-%}
<!doctype html>
<html
  class="no-js{% if cart != empty %} cart-has-items{% endif %}"
  lang="{{ request.locale.iso_code }}"
  {% if enable_rtl %}
    dir="rtl"
  {% endif %}
>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {{- '<!-- ═══ BRAND FONTS: Inter / Google Sans — preconnect + non-blocking load ═══ -->' -}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    >
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500&display=swap"
      >
    </noscript>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{- page_title -}}
      {%- if current_tags -%}
        {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
      {%- endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- if template == 'password' -%}
        {{- shop.name -}}
      {%- else -%}
        {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
      {%- endif -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {%- liquid
      render 'meta-tags'
      render 'css-variables'

      echo 'vendor.css' | asset_url | stylesheet_tag: preload: true
      echo 'theme.css' | asset_url | stylesheet_tag: preload: true
      echo 'cust-main.css' | asset_url | stylesheet_tag: preload: true

      if enable_rtl
        echo 'rtl.css' | asset_url | stylesheet_tag: preload: true
      endif
    -%}

    {{ content_for_header }}

    <script src="{{ 'vendor.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {% if template.name == 'index' %}
      {{ 'component-custom-text-card-with-image.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'scrolling-promotion.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if request.page_type contains 'customers/' -%}
      <script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
    {%- endif -%}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>

    {%- if request.design_mode -%}
      <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- render 'js-variables' -%}

    {{- '<!-- ═══ BRAND TYPOGRAPHY SYSTEM — Backdropsource ═══ -->' -}}
    <style id="bds-brand-typography">
    /*
      ═══════════════════════════════════════════════════════════════
      BRAND TYPOGRAPHY — Backdropsource
      Font  : Inter / Google Sans — all elements, all pages
      Spec  : Industry-standard scale (Shopify Dawn / Apple / Nike / Material)
      ───────────────────────────────────────────────────────────────
      Element    Desktop    Tablet     Mobile
      H1         32 / 700   28 / 700   24 / 700
      H2         24 / 700   22 / 700   20 / 700
      H3         20 / 600   19 / 600   18 / 600
      H4         17 / 600   17 / 600   16 / 600
      H5         16 / 600   15 / 600   14 / 600
      H6         14 / 500   14 / 500   13 / 500
      Body/Para  16 / 400   16 / 400   15 / 400
      Inputs     16 / 400   16 / 400   16 / 400  (16px prevents iOS zoom)
      Button     14 / 600   14 / 600   13 / 600
      Nav/Menu   15 / 500   14 / 500   13 / 500
      Small      14 / 400   14 / 400   13 / 400
      ═══════════════════════════════════════════════════════════════
    */

    /* ── Font stack variable ─────────────────────────────────── */
    :root {
      --bds-font: 'Inter', 'Google Sans', -apple-system, BlinkMacSystemFont,
                  'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    /* ── Smooth rendering ───────────────────────────────────── */
    html {
      -webkit-font-smoothing:  antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
    }

    /* ══════════════════════════════════════════════════════════
       DESKTOP — ≥ 1024px  (base layer; tablet + mobile override)
    ══════════════════════════════════════════════════════════ */

    /* Body / base — 16px / 400 (industry-standard accessible body) */
    body,
    p,
    li,
    dd,
    dt,
    td,
    th,
    figcaption,
    blockquote,
    span,
    div,
    .rte,
    .rte p,
    .rte li {
      font-family: var(--bds-font) !important;
      font-size:   16px !important;
      font-weight: 400 !important;
      line-height: 1.6 !important;
    }

    /* H1 — 32px / 700 (product/page title, hero) */
    h1,
    .h1,
    [class*="heading--h1"],
    .hero__title,
    .banner__heading,
    .page-title,
    .page-header__title,
    .product__title h1 {
      font-family: var(--bds-font) !important;
      font-size:   32px !important;
      font-weight: 700 !important;
      line-height: 1.15 !important;
      letter-spacing: -0.01em !important;
    }

    /* H2 — 24px / 700 (section heading) */
    h2,
    .h2,
    [class*="heading--h2"],
    .section__heading,
    .section-header__title,
    .collection__title,
    .article__title {
      font-family: var(--bds-font) !important;
      font-size:   24px !important;
      font-weight: 700 !important;
      line-height: 1.25 !important;
      letter-spacing: -0.005em !important;
    }

    /* H3 — 20px / 600 (sub-section / card titles) */
    h3,
    .h3,
    [class*="heading--h3"],
    .card__title,
    .product-card__title,
    .block__title {
      font-family: var(--bds-font) !important;
      font-size:   20px !important;
      font-weight: 600 !important;
      line-height: 1.3 !important;
    }

    /* H4 — 17px / 600 (small heading / accordion) */
    h4,
    .h4,
    [class*="heading--h4"],
    .accordion-details summary,
    .collapsible__title {
      font-family: var(--bds-font) !important;
      font-size:   17px !important;
      font-weight: 600 !important;
      line-height: 1.35 !important;
    }

    /* H5 + H6 */
    h5, .h5 {
      font-family: var(--bds-font) !important;
      font-size:   16px !important;
      font-weight: 600 !important;
      line-height: 1.4 !important;
    }
    h6, .h6 {
      font-family: var(--bds-font) !important;
      font-size:   14px !important;
      font-weight: 500 !important;
      line-height: 1.4 !important;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Form inputs — 16px / 400 (16px prevents iOS auto-zoom on focus) */
    input,
    input[type="text"],
    input[type="email"],
    input[type="tel"],
    input[type="number"],
    input[type="search"],
    input[type="password"],
    input[type="url"],
    select,
    textarea {
      font-family: var(--bds-font) !important;
      font-size:   16px !important;
      font-weight: 400 !important;
    }

    /* Buttons — 14px / 600 */
    button,
    .btn,
    .button,
    [class*="btn--"],
    [class*="button--"],
    input[type="submit"],
    input[type="button"],
    input[type="reset"],
    .product-form__submit,
    .product-form__cart-submit,
    .shopify-payment-button__button,
    .shopify-payment-button__button--unbranded,
    a.btn,
    a.button {
      font-family: var(--bds-font) !important;
      font-size:   14px !important;
      font-weight: 600 !important;
      letter-spacing: 0.04em !important;
    }

    /* Navigation / Menu — 15px / 500 */
    nav a,
    .nav__link,
    .site-nav a,
    .site-nav__link,
    .header__nav-link,
    .header__menu-item,
    .header__menu-item > a,
    .menu-drawer__menu-item,
    .menu-drawer__menu-item > a,
    .mega-menu a,
    .mega-menu__link,
    .navigation__item,
    .navigation__link,
    .breadcrumb a,
    .breadcrumb__link,
    .footer__link,
    .footer a {
      font-family: var(--bds-font) !important;
      font-size:   15px !important;
      font-weight: 500 !important;
    }

    /* Labels / badges / price / misc — 14px / 500 */
    label,
    .label,
    .badge,
    .tag,
    .price,
    .price-item,
    .product__sku,
    .product__vendor,
    .product__badge {
      font-family: var(--bds-font) !important;
      font-size:   14px !important;
      font-weight: 500 !important;
    }

    /* Small / caption text — 14px / 400 */
    small,
    .small,
    .caption,
    .text-sm,
    .text-small {
      font-family: var(--bds-font) !important;
      font-size:   14px !important;
      font-weight: 400 !important;
    }

    /* RTE (product descriptions / blog / pages) */
    .rte h1 { font-size: 32px !important; font-weight: 700 !important; }
    .rte h2 { font-size: 24px !important; font-weight: 700 !important; }
    .rte h3 { font-size: 20px !important; font-weight: 600 !important; }
    .rte h4 { font-size: 17px !important; font-weight: 600 !important; }
    .rte p,
    .rte li { font-size: 16px !important; font-weight: 400 !important; }

    /* ══════════════════════════════════════════════════════════
       TABLET — 768px to 1023px
       Slightly smaller scale between mobile and desktop
    ══════════════════════════════════════════════════════════ */
    @media screen and (min-width: 768px) and (max-width: 1023px) {

      h1, .h1, .hero__title, .banner__heading,
      .page-title, .product__title h1        { font-size: 28px !important; font-weight: 700 !important; }
      h2, .h2, .section__heading,
      .collection__title                     { font-size: 22px !important; font-weight: 700 !important; }
      h3, .h3, .card__title                  { font-size: 19px !important; font-weight: 600 !important; }
      h4, .h4, .collapsible__title           { font-size: 17px !important; font-weight: 600 !important; }
      h5, .h5                                { font-size: 15px !important; font-weight: 600 !important; }

      body, p, li, td, th,
      .rte, .rte p, .rte li,
      input, select, textarea                { font-size: 16px !important; font-weight: 400 !important; }

      button, .btn, .button,
      input[type="submit"], input[type="button"],
      .product-form__submit,
      a.btn, a.button                        { font-size: 14px !important; font-weight: 600 !important; }

      nav a, .header__menu-item,
      .menu-drawer__menu-item,
      .navigation__item, .footer a           { font-size: 14px !important; font-weight: 500 !important; }

      .rte h1 { font-size: 28px !important; }
      .rte h2 { font-size: 22px !important; }
      .rte h3 { font-size: 19px !important; }
      .rte h4 { font-size: 17px !important; }
    }

    /* ══════════════════════════════════════════════════════════
       MOBILE — ≤ 767px
       Standard mobile scale — readable on small screens
    ══════════════════════════════════════════════════════════ */
    @media screen and (max-width: 767px) {

      /* H1 — 24px / 700 */
      h1, .h1,
      .hero__title, .banner__heading,
      .page-title, .page-header__title,
      .product__title h1 {
        font-size:   24px !important;
        font-weight: 700 !important;
        line-height: 1.2 !important;
      }

      /* H2 — 20px / 700 */
      h2, .h2,
      .section__heading, .section-header__title,
      .collection__title, .article__title {
        font-size:   20px !important;
        font-weight: 700 !important;
        line-height: 1.3 !important;
      }

      /* H3 — 18px / 600 */
      h3, .h3,
      .card__title, .product-card__title {
        font-size:   18px !important;
        font-weight: 600 !important;
      }

      /* H4 — 16px / 600 */
      h4, .h4,
      .accordion-details summary,
      .collapsible__title {
        font-size:   16px !important;
        font-weight: 600 !important;
      }

      /* H5 — 14px / 600 */
      h5, .h5 {
        font-size:   14px !important;
        font-weight: 600 !important;
      }

      /* H6 — 13px / 500 */
      h6, .h6 {
        font-size:   13px !important;
        font-weight: 500 !important;
      }

      /* Body / Para / FAQs — 15px / 400 (16px on form inputs to prevent iOS zoom) */
      body, p, li, dd, dt, td, th,
      figcaption, blockquote, span, div,
      .rte, .rte p, .rte li {
        font-size:   15px !important;
        font-weight: 400 !important;
      }

      input, select, textarea {
        font-size:   16px !important;  /* keep 16px — iOS auto-zooms anything below */
        font-weight: 400 !important;
      }

      /* Buttons — 13px / 600 */
      button, .btn, .button,
      [class*="btn--"], [class*="button--"],
      input[type="submit"], input[type="button"],
      input[type="reset"],
      .product-form__submit,
      .shopify-payment-button__button,
      a.btn, a.button {
        font-size:   13px !important;
        font-weight: 600 !important;
      }

      /* Navigation / Menu — 13px / 500 */
      nav a, .nav__link, .site-nav a,
      .header__nav-link,
      .header__menu-item, .header__menu-item > a,
      .menu-drawer__menu-item, .menu-drawer__menu-item > a,
      .mega-menu a, .navigation__item,
      .breadcrumb__link, .footer__link, .footer a {
        font-size:   13px !important;
        font-weight: 500 !important;
      }

      /* Labels / badges / price — 13px / 500 */
      label, .label, .badge, .tag,
      .price, .price-item,
      .product__sku, .product__vendor, .product__badge {
        font-size:   13px !important;
        font-weight: 500 !important;
      }

      /* Small / caption — 13px / 400 */
      small, .small, .caption, .text-sm, .text-small {
        font-size: 13px !important;
        font-weight: 400 !important;
      }

      /* RTE mobile */
      .rte h1 { font-size: 24px !important; font-weight: 700 !important; }
      .rte h2 { font-size: 20px !important; font-weight: 700 !important; }
      .rte h3 { font-size: 18px !important; font-weight: 600 !important; }
      .rte h4 { font-size: 16px !important; font-weight: 600 !important; }
      .rte p,
      .rte li { font-size: 15px !important; font-weight: 400 !important; }
    }

    </style>

    <style id="bds-mobile-accordion">
    /*
      Mobile accordion for product description CSS radio tabs.
      Pure CSS — no JS dependency. Works on first paint.
      Targets .tabs wherever product description is rendered.
    */
    @media screen and (max-width: 768px) {

      /* 1. Vertical flex column layout */
      .rte .tabs,
      .product__description-fullwidth .tabs,
      .product__block--description .tabs {
        display: flex !important;
        flex-direction: column !important;
        gap: 6px !important;
        margin-top: 0 !important;
      }

      /* 2. Dissolve .tab-labels wrapper so labels participate in flex ordering */
      .rte .tabs .tab-labels,
      .product__description-fullwidth .tabs .tab-labels,
      .product__block--description .tabs .tab-labels {
        display: contents !important;
      }

      /* 3. Hide radio inputs (already hidden, just ensure) */
      .rte .tabs input[type="radio"],
      .product__description-fullwidth .tabs input[type="radio"],
      .product__block--description .tabs input[type="radio"] {
        display: none !important;
      }

      /* 4. Style labels as accordion card headers */
      .rte .tabs .tab-label,
      .product__description-fullwidth .tabs .tab-label,
      .product__block--description .tabs .tab-label {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        width: 100% !important;
        box-sizing: border-box !important;
        background: #f5f5f5 !important;
        border-radius: 10px !important;
        padding: 15px 18px !important;
        font-size: 14px !important;
        font-weight: 600 !important;
        color: #111 !important;
        cursor: pointer !important;
        border: none !important;
        margin: 0 !important;
        line-height: 1.35 !important;
        -webkit-user-select: none !important;
        user-select: none !important;
      }

      /* 5. + icon on each label */
      .rte .tabs .tab-label::after,
      .product__description-fullwidth .tabs .tab-label::after,
      .product__block--description .tabs .tab-label::after {
        content: '+' !important;
        font-size: 22px !important;
        font-weight: 300 !important;
        color: #555 !important;
        line-height: 1 !important;
        flex-shrink: 0 !important;
        margin-left: 10px !important;
      }

      /* 6. Active label: rounded top only, × icon */
      .rte .tabs input#tab1:checked ~ .tab-labels label[for="tab1"],
      .rte .tabs input#tab2:checked ~ .tab-labels label[for="tab2"],
      .rte .tabs input#tab3:checked ~ .tab-labels label[for="tab3"],
      .rte .tabs input#tab4:checked ~ .tab-labels label[for="tab4"],
      .product__description-fullwidth .tabs input#tab1:checked ~ .tab-labels label[for="tab1"],
      .product__description-fullwidth .tabs input#tab2:checked ~ .tab-labels label[for="tab2"],
      .product__description-fullwidth .tabs input#tab3:checked ~ .tab-labels label[for="tab3"],
      .product__description-fullwidth .tabs input#tab4:checked ~ .tab-labels label[for="tab4"],
      .product__block--description .tabs input#tab1:checked ~ .tab-labels label[for="tab1"],
      .product__block--description .tabs input#tab2:checked ~ .tab-labels label[for="tab2"],
      .product__block--description .tabs input#tab3:checked ~ .tab-labels label[for="tab3"],
      .product__block--description .tabs input#tab4:checked ~ .tab-labels label[for="tab4"] {
        border-radius: 10px 10px 0 0 !important;
        background: #eaeaea !important;
      }

      .rte .tabs input#tab1:checked ~ .tab-labels label[for="tab1"]::after,
      .rte .tabs input#tab2:checked ~ .tab-labels label[for="tab2"]::after,
      .rte .tabs input#tab3:checked ~ .tab-labels label[for="tab3"]::after,
      .rte .tabs input#tab4:checked ~ .tab-labels label[for="tab4"]::after,
      .product__description-fullwidth .tabs input#tab1:checked ~ .tab-labels label[for="tab1"]::after,
      .product__description-fullwidth .tabs input#tab2:checked ~ .tab-labels label[for="tab2"]::after,
      .product__description-fullwidth .tabs input#tab3:checked ~ .tab-labels label[for="tab3"]::after,
      .product__description-fullwidth .tabs input#tab4:checked ~ .tab-labels label[for="tab4"]::after,
      .product__block--description .tabs input#tab1:checked ~ .tab-labels label[for="tab1"]::after,
      .product__block--description .tabs input#tab2:checked ~ .tab-labels label[for="tab2"]::after,
      .product__block--description .tabs input#tab3:checked ~ .tab-labels label[for="tab3"]::after,
      .product__block--description .tabs input#tab4:checked ~ .tab-labels label[for="tab4"]::after {
        content: '\00D7' !important;
        color: #111 !important;
      }

      /* 7. Flex order: interleave label above its content */
      .rte .tabs label[for="tab1"],
      .product__description-fullwidth .tabs label[for="tab1"],
      .product__block--description .tabs label[for="tab1"] { order: 1 !important; }
      .rte .tabs #content1,
      .product__description-fullwidth .tabs #content1,
      .product__block--description .tabs #content1                                  { order: 2 !important; }
      .rte .tabs label[for="tab2"],
      .product__description-fullwidth .tabs label[for="tab2"],
      .product__block--description .tabs label[for="tab2"] { order: 3 !important; }
      .rte .tabs #content2,
      .product__description-fullwidth .tabs #content2,
      .product__block--description .tabs #content2                                  { order: 4 !important; }
      .rte .tabs label[for="tab3"],
      .product__description-fullwidth .tabs label[for="tab3"],
      .product__block--description .tabs label[for="tab3"] { order: 5 !important; }
      .rte .tabs #content3,
      .product__description-fullwidth .tabs #content3,
      .product__block--description .tabs #content3                                  { order: 6 !important; }
      .rte .tabs label[for="tab4"],
      .product__description-fullwidth .tabs label[for="tab4"],
      .product__block--description .tabs label[for="tab4"] { order: 7 !important; }
      .rte .tabs #content4,
      .product__description-fullwidth .tabs #content4,
      .product__block--description .tabs #content4                                  { order: 8 !important; }

      /* 8. Content panels: override display:none, collapse with max-height */
      .rte .tabs .tab-content,
      .product__description-fullwidth .tabs .tab-content,
      .product__block--description .tabs .tab-content {
        display: block !important;
        max-height: 0 !important;
        overflow: hidden !important;
        transition: max-height 0.35s ease, padding 0.35s ease !important;
        padding: 0 18px !important;
        background: #fff !important;
        border-radius: 0 0 10px 10px !important;
        border: 1px solid #ebebeb !important;
        border-top: none !important;
        box-sizing: border-box !important;
        font-size: 14px !important;
        font-weight: 400 !important;
        color: #333 !important;
        line-height: 1.7 !important;
      }

      /* 9. Expand active panel */
      .rte .tabs input#tab1:checked ~ #content1,
      .rte .tabs input#tab2:checked ~ #content2,
      .rte .tabs input#tab3:checked ~ #content3,
      .rte .tabs input#tab4:checked ~ #content4,
      .product__description-fullwidth .tabs input#tab1:checked ~ #content1,
      .product__description-fullwidth .tabs input#tab2:checked ~ #content2,
      .product__description-fullwidth .tabs input#tab3:checked ~ #content3,
      .product__description-fullwidth .tabs input#tab4:checked ~ #content4,
      .product__block--description .tabs input#tab1:checked ~ #content1,
      .product__block--description .tabs input#tab2:checked ~ #content2,
      .product__block--description .tabs input#tab3:checked ~ #content3,
      .product__block--description .tabs input#tab4:checked ~ #content4 {
        max-height: 3000px !important;
        padding: 14px 18px 20px !important;
      }

    }
    </style>

    {% comment %} Custom metafield for head tag like GTag tracking {% endcomment %}
    {{ shop.metafields.foxtheme.code_head.value }}
    {% comment %} End custom metafield for head tag like GTag tracking {% endcomment %}

    
  </head>

  <body
    class="{{ request.page_type }}-template {{ template.suffix }} blocks-corner--{{ settings.blocks_corner_radius }}{% if request.design_mode %} shopify-design-mode{% endif %}"
    data-initializing
  >
    {% comment %} Custom metafield for body tag like GTag tracking {% endcomment %}
    {{ shop.metafields.foxtheme.code_body.value }}
    {% comment %} End custom metafield for body tab like GTag tracking {% endcomment %}

    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- liquid
      if settings.enable_page_transition
        render 'page-transition'
      endif
    -%}

    <div class="site-wrapper min-height-screen">
      {% sections 'header-group' %}

      <main id="MainContent" class="main-content content-for-layout focus-none" role="main" tabindex="-1">
        {{ content_for_layout }}
      </main>

      {% sections 'footer-group' %}
    </div>

    {% sections 'overlay-group' %}
    {%- liquid
      if template.name == 'product'
        section 'sticky-atc-bar'
      endif
      if settings.enable_back_to_top
        render 'back-to-top'
      endif
    -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    {% if settings.pcard_show_quickview_button or settings.pcard_choose_options_actions == 'open_popup' %}
      <script src="{{ 'quick-view.js' | asset_url }}" defer="defer"></script>
    {% endif %}

    {% if template.name == 'product' %}
    <script>
    (function () {
      if ((window.innerWidth || document.documentElement.clientWidth || 9999) > 768) return;

      function buildAcc() {
        /* Covers: full-width via product-tabs-auto fallback, inline description block, and any .rte .tabs */
        var host = document.querySelector(
          '.product__description-fullwidth .tabs, .product__block--description .tabs, .rte .tabs, #apt-root .tabs'
        );
        if (!host || host.dataset.mba) return;

        var labels = Array.from(host.querySelectorAll('label.tab-label, label[for^="tab"]'));
        if (!labels.length) return;

        var items = [];
        labels.forEach(function (lbl) {
          var num   = (lbl.getAttribute('for') || '').replace(/\D/g, '');
          var panel = num ? host.querySelector('#content' + num) : null;
          if (lbl.textContent.trim() && panel)
            items.push({ title: lbl.textContent.trim(), html: panel.innerHTML });
        });
        if (!items.length) return;

        var out = '';
        items.forEach(function (item, i) {
          var isFirst  = i === 0;
          var bodyMH   = isFirst ? '3000px' : '0';
          var iconRot  = isFirst ? 'rotate(45deg)' : '';
          var expanded = isFirst ? 'true' : 'false';
          out +=
            '<div style="background:#f5f5f5!important;border-radius:10px!important;margin-bottom:8px!important;overflow:hidden!important;display:block!important;">' +
            '<button type="button" data-mbi="' + i + '" aria-expanded="' + expanded + '" style="display:flex!important;align-items:center!important;justify-content:space-between!important;gap:10px!important;width:100%!important;padding:15px 18px!important;background:transparent!important;border:none!important;box-shadow:none!important;border-radius:0!important;cursor:pointer!important;text-align:left!important;font-size:14px!important;font-weight:600!important;color:#111!important;line-height:1.3!important;">' +
            '<span style="font-size:14px!important;font-weight:600!important;color:#111!important;line-height:1.3!important;flex:1!important;">' + item.title + '</span>' +
            '<span data-mbic style="font-size:20px!important;font-weight:400!important;color:#555!important;line-height:1!important;flex-shrink:0!important;display:inline-block!important;transition:transform .25s ease;transform:' + iconRot + ';">+</span>' +
            '</button>' +
            '<div data-mbb style="display:block!important;overflow:hidden!important;transition:max-height .4s ease!important;max-height:' + bodyMH + '!important;">' +
            '<div style="padding:6px 18px 18px!important;font-size:14px!important;font-weight:400!important;color:#333!important;line-height:1.7!important;">' + item.html + '</div>' +
            '</div></div>';
        });

        var wrap = document.createElement('div');
        wrap.innerHTML = out;
        host.dataset.mba = '1';
        host.parentNode.replaceChild(wrap, host);

        wrap.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-mbi]');
          if (!btn) return;
          var isOpen = btn.getAttribute('aria-expanded') === 'true';
          wrap.querySelectorAll('[data-mbi]').forEach(function (b) {
            b.setAttribute('aria-expanded', 'false');
            var ic = b.querySelector('[data-mbic]'); if (ic) ic.style.transform = '';
            var bd = b.nextElementSibling; if (bd) bd.style.maxHeight = '0';
          });
          if (!isOpen) {
            btn.setAttribute('aria-expanded', 'true');
            var ic = btn.querySelector('[data-mbic]'); if (ic) ic.style.transform = 'rotate(45deg)';
            var bd = btn.nextElementSibling; if (bd) bd.style.maxHeight = '3000px';
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', buildAcc);
      } else {
        buildAcc();
      }
      setTimeout(buildAcc, 800);
    })();
    </script>
    {% endif %}

  </body>
</html>
