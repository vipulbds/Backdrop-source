    .pf-search__skeleton {
      padding: 16px 18px;
    }

    .pf-search__skeleton-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 9px 10px;
    }

    .pf-search__skeleton i,
    .pf-search__skeleton b {
      display: block;
      border-radius: 8px;
      background: linear-gradient(90deg, #eef1f7 25%, #f7f9fd 50%, #eef1f7 75%);
      background-size: 400% 100%;
      animation: pf-search-shimmer 1.2s linear infinite;
    }

    .pf-search__skeleton i {
      width: 46px;
      height: 46px;
      flex: none;
      border-radius: 10px;
    }

    .pf-search__skeleton b {
      height: 11px;
    }

    .pf-search__skeleton b:first-child {
      width: 62%;
      margin-bottom: 7px;
    }

    .pf-search__skeleton b:last-child {
      width: 34%;
    }

    .pf-search__skeleton div {
      flex: 1 1 auto;
    }

    @keyframes pf-search-shimmer {
      to {
        background-position: -400% 0;
      }
    }

