            var meta = product.product_type || product.vendor || '';
            html +=
              '<a class="pf-search__row" role="option" href="' + esc(product.url) + '">' +
              '<span class="pf-search__row-media">' +
              (image
                ? '<img src="' + esc(sized(image, 96)) + '" alt="" loading="lazy" width="46" height="46">'
                : '') +
              '</span><span class="pf-search__row-text">' +
              '<span class="pf-search__row-title">' + highlight(product.title, query) + '</span>' +
              (meta ? '<span class="pf-search__row-meta">' + esc(meta) + '</span>' : '') +
              '</span></a>';
          });
          html += '</section>';
        }

        if (collections.length || pages.length) {
          html += '<section class="pf-search__group" role="group" aria-label="Collections and pages"><div class="pf-search__group-head" aria-hidden="true">';
          html += '<h2 class="pf-search__group-title">Collections &amp; pages</h2></div>';
          collections.concat(pages).forEach(function (item) {
            html +=
              '<a class="pf-search__row" role="option" href="' + esc(item.url) + '">' +
              '<span class="pf-search__row-media" aria-hidden="true">' +
              '<svg viewBox="0 0 20 20" fill="none"><rect x="3" y="4" width="14" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/>' +
              '<path d="M3 8h14" stroke="currentColor" stroke-width="1.5"/></svg></span>' +
              '<span class="pf-search__row-text"><span class="pf-search__row-title">' +
              highlight(item.title, query) +
              '</span></span></a>';
          });
          html += '</section>';
        }

        html +=
          '<a class="pf-search__all" role="option" href="' +
          esc(this.config.searchUrl + '?q=' + encodeURIComponent(query) + '&options%5Bprefix%5D=last') +
          '"><span>See all results for &ldquo;' + esc(query) + '&rdquo;</span><span aria-hidden="true">&rarr;</span></a>';

        this.defaults.hidden = true;
        this.results.hidden = false;
        this.results.innerHTML = html;
        this.rows = Array.prototype.slice.call(this.results.querySelectorAll('.pf-search__row, .pf-search__all'));
        this.rows.forEach(function (row, index) {
          row.id = 'pf-search-row-' + index;
        });
        this.setActive(-1);
        this.lastQuery = query;
        this.input.setAttribute('aria-expanded', 'true');
        this.setStatus(total + (total === 1 ? ' result' : ' results'));
      };

      /* ── keyboard ──────────────────────────────────────────────── */
      PFSearch.prototype.onKeydown = function (event) {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          if (!this.rows.length) return;
          event.preventDefault();
          var next =
            event.key === 'ArrowDown'
              ? (this.activeIndex + 1) % this.rows.length
              : (this.activeIndex <= 0 ? this.rows.length : this.activeIndex) - 1;
          this.setActive(next);
          return;
        }

        if (event.key === 'Escape' && this.listening) {
          event.preventDefault();
          this.stopVoice();
          return;
        }

        if (event.key === 'Tab' && this.activeIndex > -1) {
          this.setActive(-1);
        }
      };

      PFSearch.prototype.setActive = function (index, scroll) {
        if (this.rows[this.activeIndex]) this.rows[this.activeIndex].removeAttribute('data-active');
        this.activeIndex = index;

        var row = this.rows[index];
        if (!row) {
          this.input.removeAttribute('aria-activedescendant');
          return;
        }

        row.setAttribute('data-active', 'true');
        this.input.setAttribute('aria-activedescendant', row.id);
        if (scroll !== false && row.scrollIntoView) row.scrollIntoView({ block: 'nearest' });
      };

      PFSearch.prototype.setStatus = function (message, tone) {
        this.status.textContent = message || '';
        if (tone) {
          this.status.setAttribute('data-tone', tone);
        } else {
          this.status.removeAttribute('data-tone');
        }
      };

      /* ── recents ───────────────────────────────────────────────── */
      PFSearch.prototype.remember = function (query) {
        var list = readRecent().filter(function (item) {
          return item.toLowerCase() !== query.toLowerCase();
        });
        list.unshift(query);
        writeRecent(list);
      };

      PFSearch.prototype.paintRecent = function () {
        if (!this.recentGroup || !this.recentList) return;
        var list = readRecent();
        this.recentGroup.hidden = list.length === 0;
        this.recentList.innerHTML = list
          .map(function (term) {
            return (
              '<button type="button" class="pf-search__chip pf-search__chip--recent" data-pf-recent-term="' +
              esc(term) +
              '"><span class="pf-search__chip-dot" aria-hidden="true"></span><span>' +
              esc(term) +
              '</span></button>'
            );
          })
          .join('');
      };

      /* ── voice ─────────────────────────────────────────────────── */
      PFSearch.prototype.setupVoice = function () {
        if (!this.config.voice || !this.micBtn) return;

        var Recognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        /* Requires a secure context. Shopify is always https, but a local
           tunnel may not be — hide the button rather than fail on click. */
        if (!Recognition || !window.isSecureContext) return;

        var self = this;
        this.micBtn.hidden = false;

        this.micBtn.addEventListener('click', function () {
          if (self.listening) {
            self.stopVoice();
          } else {
            self.startVoice(Recognition);
          }
        });
      };

      PFSearch.prototype.startVoice = function (Recognition) {
        var self = this;

        var recognition = new Recognition();
        recognition.lang = document.documentElement.lang || this.config.lang || 'en-US';
        recognition.interimResults = true;
        recognition.continuous = false;
        recognition.maxAlternatives = 1;

        recognition.onstart = function () {
          self.listening = true;
          self.micBtn.setAttribute('aria-pressed', 'true');
          self.micBtn.setAttribute('aria-label', 'Stop voice search');
          self.setStatus('Listening… say what you are looking for', 'listening');
        };

        recognition.onresult = function (event) {
          var transcript = '';
          var isFinal = false;
          for (var i = event.resultIndex; i < event.results.length; i++) {
            transcript += event.results[i][0].transcript;
            if (event.results[i].isFinal) isFinal = true;
          }
          transcript = transcript.trim();
          if (!transcript) return;

          self.input.value = transcript;
          self.clearBtn.hidden = false;

          if (isFinal) {
            self.setStatus('');
            self.schedule(transcript, true);
          } else {
            /* Interim words: show them, but don't burn a request per syllable. */
            self.setStatus('“' + transcript + '”', 'listening');
          }
        };

        recognition.onerror = function (event) {
          var message = {
            'not-allowed': 'Microphone access is blocked. Allow it in your browser settings, then try again.',
            'service-not-allowed': 'Microphone access is blocked. Allow it in your browser settings, then try again.',
            'audio-capture': 'No microphone found.',
            'no-speech': "Didn't catch that — tap the mic and try again.",
            network: 'Voice search needs a connection. Type instead?'
          }[event.error];
          if (event.error !== 'aborted') self.setStatus(message || 'Voice search stopped. Tap the mic to retry.', 'error');
        };

        recognition.onend = function () {
          self.listening = false;
          self.recognition = null;
          self.micBtn.setAttribute('aria-pressed', 'false');
          self.micBtn.setAttribute('aria-label', 'Search by voice');
          if (self.status.getAttribute('data-tone') === 'listening') self.setStatus('');
          self.input.focus({ preventScroll: true });
        };

        this.recognition = recognition;

        try {
          recognition.start();
        } catch (error) {
          /* start() throws if called twice in a row — treat as a no-op. */
          this.listening = false;
        }
      };

      PFSearch.prototype.stopVoice = function () {
        if (!this.recognition) return;
        try {
          this.recognition.abort();
        } catch (error) {
          /* already stopped */
        }
        this.recognition = null;
        this.listening = false;
        this.micBtn.setAttribute('aria-pressed', 'false');
        this.micBtn.setAttribute('aria-label', 'Search by voice');
        if (this.status.getAttribute('data-tone') === 'listening') this.setStatus('');
      };

      /* ── boot ──────────────────────────────────────────────────── */
      function boot() {
        var dialog = document.getElementById(DIALOG_ID);
        if (!dialog) return;

        /* Out of the header subtree — see the note at the top of the file. */
        if (dialog.parentElement !== document.body) document.body.appendChild(dialog);

        window.PFSearch = new PFSearch(dialog);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot, { once: true });
      } else {
        boot();
      }
    })();
  </script>
{%- endif -%}
