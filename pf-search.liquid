    /* Ported from snippets/search.liquid. That snippet is no longer rendered
       by the header, so its stylesheet block may not be compiled into the
       bundle at all — without these two rules the desktop trigger and the
       drawer duplicate would both be visible at once.
       (Do not write that tag name in braces anywhere in this file: Liquid
       parses it even inside a CSS comment and then demands a closing tag.) */
    .search-action {
      display: flex;
    }

    @media screen and (max-width: 749px) {
      .search-action--hidden-on-drawer {
        display: none;
      }
    }

    @media screen and (min-width: 750px) {
      [data-menu-style='drawer'] .search-action--hidden-on-drawer {
        display: none;
      }

      [data-menu-style='menu'] .search-action--hidden-on-menu {
        display: none;
      }
    }

    .pf-search-trigger {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 0;
      border: 0;
      background: none;
      color: inherit;
      font: inherit;
      cursor: pointer;
    }

    .pf-search-trigger__icon {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .pf-search-trigger__label {
      font-size: var(--header-actions-font-size, 0.875rem);
      font-family: var(--header-actions-font-family, inherit);
      font-weight: var(--header-actions-font-weight, inherit);
      text-transform: var(--header-actions-text-case, none);
      white-space: nowrap;
    }

    /* ── Mobile: full-screen sheet ──────────────────────────────── */
    @media screen and (max-width: 749px) {
      .pf-search {
        width: 100vw;
        max-width: 100vw;
        height: 100dvh;
        max-height: 100dvh;
        margin: 0;
        border-radius: 0;
      }

      .pf-search__sheet {
        border-radius: 0;
        padding-bottom: env(safe-area-inset-bottom);
      }

      .pf-search__bar {
        gap: 4px;
        padding: 10px 8px 10px 14px;
        padding-top: max(10px, env(safe-area-inset-top));
      }

      .pf-search__input {
        font-size: 16px; /* < 16px makes iOS zoom on focus */
      }

      /* The submit button is redundant next to the keyboard's Search key. */
      .pf-search__go {
        display: none;
      }

      .pf-search__tiles {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .pf-search__group {
        padding: 14px;
      }

      .pf-search__all {
        padding: 14px;
      }
    }

    @media screen and (min-width: 750px) and (max-width: 1023px) {
      .pf-search {
        width: min(680px, calc(100vw - 48px));
        margin-top: 7vh;
      }
    }

    /* Short viewports (laptops at 125% scaling, landscape phones). */
    @media screen and (min-width: 750px) and (max-height: 700px) {
      .pf-search {
        margin-top: 4vh;
        max-height: 88vh;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .pf-search,
      .pf-search[open],
      .pf-search[open]::backdrop,
      .pf-search *,
      .pf-search *::before,
      .pf-search *::after {
        animation-duration: 1ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 1ms !important;
      }

      .pf-search__mic[aria-pressed='true'] {
        outline: 2px solid var(--pfs-magenta);
        outline-offset: 2px;
      }
    }

    /* Scroll lock. scrollbar-gutter reserves the bar we just hid, so the
       page — and the header measuring itself — never shifts. */
    html.pf-search-open {
