{%- comment -%}
  ═══════════════════════════════════════════════════════════════
  MAIN PRODUCT ARTIFICIAL FLORAL SECTION
  ═══════════════════════════════════════════════════════════════
  Dedicated section for products with template_suffix: Artificial-Floral.
  - Same block system as main-product-banner (shares product-information-blocks)
  - Mageworx APO renders the 60+ "Choose Design" image swatches via its app block
  - Variant picker handles the "Choose Size" buttons (4ft x 8ft, 8ft x 8ft, ...)
  - All other behavior identical to main-product-banner
{%- endcomment -%}

{%- liquid
  assign media_layout = section.settings.gallery_layout | default: 'carousel'
  assign mobile_thumbnails = section.settings.mobile_thumbnails | default: 'hide'
  assign enable_image_zoom = section.settings.enable_image_zoom | default: false
  assign enable_sticky_info = section.settings.enable_sticky_info

  assign product_class = 'product--' | append: section.settings.media_size
  assign product_class = product_class | append: ' product--' | append: media_layout
  assign product_class = product_class | append: ' product--media-has-' | append: product.media.size
  if product.media.size > 1
    assign product_class = product_class | append: ' product--media-has-many'
  endif

  case media_layout
    when 'grid-mix'
      assign media_modulo = product.media.size | modulo: 3
      if media_modulo == 2
        assign product_class = product_class | append: ' product--odd-media'
      endif
  endcase

  assign current_variant = product.selected_or_first_available_variant
  assign show_percent_badge = false
  if current_variant.compare_at_price > current_variant.price
    assign show_percent_badge = true
    assign savings_amount = current_variant.compare_at_price | minus: current_variant.price
    assign percent_off = savings_amount | times: 100 | divided_by: current_variant.compare_at_price
  endif
-%}
<product-info
  id="MainProduct-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  class="section block section-{{ section.id }} section--padding page-width color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- assign has_models = product.media | where: 'media_type', 'model' | first -%}
  {%- if has_models -%}
    <link id="ModelViewerStyle" rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print" onload="this.media='all'">
    <link id="ModelViewerOverride" rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print" onload="this.media='all'">
  {%- endif -%}
  {%- if enable_image_zoom -%}
    <link id="Photoswipe" rel="stylesheet"
      href="{{ 'photoswipe-component.css' | asset_url }}"
      media="print" onload="this.media='all'">
  {%- endif -%}

  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>

  <style>
    :root {
      --color-crimson: #B31942;
      --color-navy: #0A3161;
      --color-white: #FFFFFF;
      --color-off-white: #F5F6F8;
      --color-border-gray: #E0E4EE;
    }

    .section-{{ section.id }} {
      background-color: var(--color-white) !important;
      color: var(--color-navy) !important;
    }

    .section-{{ section.id }} h1, .section-{{ section.id }} h2,
    .section-{{ section.id }} h3, .section-{{ section.id }} h4 {
      color: var(--color-navy) !important;
    }

    .product__percent-badge {
      display: inline-flex; align-items: center; justify-content: center;
      background-color: var(--color-crimson) !important; color: var(--color-white) !important;
      font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em;
      padding: 4px 10px; border-radius: 4px; line-height: 1; white-space: nowrap;
    }
    .product__badges-wrapper { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-bottom: 8px; }

    /* ── Tighten the title / SKU / reviews / price stack ── */
    .section-{{ section.id }} .product__block--title,
    .section-{{ section.id }} .product__block--sku,
    .section-{{ section.id }} .product__block--price,
    .section-{{ section.id }} .product__block--\@app {
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      border: none !important;
      box-shadow: none !important;
    }
    .section-{{ section.id }} .product__block--title h1,
    .section-{{ section.id }} .product__block--title h2,
    .section-{{ section.id }} .product__block--title .product__title {
      line-height: 1.15 !important;
      margin: 0 0 6px 0 !important;
    }
    .section-{{ section.id }} .product__block--sku p,
    .section-{{ section.id }} .product__sku {
      margin: 0 !important;
      padding: 0 !important;
      line-height: 1.4 !important;
    }
    .section-{{ section.id }} .product__block--\@app > * {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }
    /* Row gaps — keep the four blocks visually close */
    .section-{{ section.id }} .product__block--title { padding-bottom: 4px !important; }
    .section-{{ section.id }} .product__block--sku   { padding-top: 2px !important; padding-bottom: 2px !important; }
    .section-{{ section.id }} .product__block--\@app { padding-top: 2px !important; padding-bottom: 2px !important; }
    .section-{{ section.id }} .product__block--price { padding-top: 4px !important; padding-bottom: 4px !important; }

    /* ── Price layout ── */
    .section-{{ section.id }} .product__block--price .f-price {
      margin: 0 !important;
      line-height: 1.3 !important;
      border: none !important;
      box-shadow: none !important;
    }

    /* Compare-at (strikethrough) — gray, smaller */
    .section-{{ section.id }} .product__block--price .f-price__sale .f-price-item--regular,
    .section-{{ section.id }} .product__block--price .f-price__sale .f-price-item--regular s,
    .section-{{ section.id }} .product__block--price .f-price__sale .f-price-item--regular * {
      font-size: 1.4rem !important;
      font-weight: 400 !important;
      color: #9aa0ad !important;
      text-decoration: line-through !important;
    }
    /* Sale price — navy, bold, large */
    .section-{{ section.id }} .product__block--price .f-price-item--sale {
      font-size: 22px !important;
      font-weight: 700 !important;
      color: var(--color-navy) !important;
    }
    /* Regular (no-sale) price — navy, bold, large */
    .section-{{ section.id }} .product__block--price .f-price__regular .f-price-item--regular {
      font-size: 22px !important;
      font-weight: 700 !important;
      color: var(--color-navy) !important;
    }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }} .product__block--price .f-price-item--sale,
      .section-{{ section.id }} .product__block--price .f-price__regular .f-price-item--regular {
        font-size: 28px !important;
      }
      .section-{{ section.id }} .product__block--price .f-price__sale .f-price-item--regular,
      .section-{{ section.id }} .product__block--price .f-price__sale .f-price-item--regular s,
      .section-{{ section.id }} .product__block--price .f-price__sale .f-price-item--regular * {
        font-size: 1.6rem !important;
      }
    }

    .product-form__submit {
      background-color: var(--color-navy) !important; color: var(--color-white) !important;
      border: none !important; border-radius: 50px !important;
      padding: 15px 30px !important; font-weight: 700 !important;
      text-transform: uppercase !important; transition: all 0.3s ease !important;
      cursor: pointer !important;
    }
    .product-form__submit:hover {
      background-color: var(--color-crimson) !important;
      transform: translateY(-2px) !important;
      box-shadow: 0 5px 15px rgba(10, 49, 97, 0.2) !important;
    }

    /* ── Mageworx APO "Total" price — make it big, bold, navy ── */
    .section-{{ section.id }} .mw-apo-price-custom {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 12px !important;
      margin: 16px 0 12px !important;
      padding: 16px 20px !important;
      background: linear-gradient(135deg, #F8FAFE 0%, #EEF3FB 100%) !important;
      border: 1.5px solid #E0E4EE !important;
      border-radius: 10px !important;
    }
    .section-{{ section.id }} .mw-apo-price-custom > .mw-text:first-child {
      font-size: 16px !important;
      font-weight: 700 !important;
      color: #64748b !important;
      text-transform: uppercase !important;
      letter-spacing: .06em !important;
    }
    .section-{{ section.id }} .mw-apo-price-custom .mw-text--style-strong,
    .section-{{ section.id }} .mw-apo-price-custom > .mw-text:last-child {
      font-size: 32px !important;
      font-weight: 800 !important;
      color: var(--color-navy) !important;
      letter-spacing: -0.01em !important;
      line-height: 1.1 !important;
    }
    @media (max-width: 600px) {
      .section-{{ section.id }} .mw-apo-price-custom {
        flex-direction: column !important;
        align-items: flex-start !important;
        gap: 4px !important;
        padding: 14px 16px !important;
      }
      .section-{{ section.id }} .mw-apo-price-custom .mw-text--style-strong,
      .section-{{ section.id }} .mw-apo-price-custom > .mw-text:last-child {
        font-size: 28px !important;
      }
    }

    /* ── Mageworx APO option group labels ("Choose Size:", "Choose Design:") ── */
    .section-{{ section.id }} .mw-option .mw-label {
      display: block !important;
      margin-bottom: 10px !important;
    }
    .section-{{ section.id }} .mw-option .mw-label .mw-text--style-strong {
      font-size: 16px !important;
      font-weight: 700 !important;
      color: var(--color-navy) !important;
      letter-spacing: 0.01em !important;
      line-height: 1.3 !important;
    }
    .section-{{ section.id }} .mw-option .mw-label .mw-text--style-negative {
      color: var(--color-crimson) !important;
      font-weight: 700 !important;
      margin-left: 2px !important;
    }
    .section-{{ section.id }} .mw-option .mw-accumulated-title {
      color: var(--color-navy) !important;
      font-weight: 600 !important;
      margin-left: 4px !important;
    }
    .section-{{ section.id }} .mw-option {
      margin-bottom: 16px !important;
    }

    /* ── Mageworx APO size buttons ("4ft W x 8ft H", "8ft W x 8ft H") ── */
    .section-{{ section.id }} .mw-option--type-button .mw-option__container {
      display: flex !important;
      flex-wrap: wrap !important;
      gap: 8px !important;
    }
    .section-{{ section.id }} .mw-option--type-button .mw-option__value {
      flex: 0 0 auto !important;
    }
    .section-{{ section.id }} .mw-option--type-button .mw-option__button {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      min-height: 46px !important;
      padding: 10px 18px !important;
      background: #fff !important;
      border: 1.5px solid #D0D5E0 !important;
      border-radius: 8px !important;
      cursor: pointer !important;
      transition: border-color .15s, background .15s, box-shadow .15s !important;
    }
    .section-{{ section.id }} .mw-option--type-button .mw-option__button:hover {
      border-color: var(--color-navy) !important;
      background: #F5F7FB !important;
    }
    .section-{{ section.id }} .mw-option--type-button .mw-option__value-text {
      font-size: 15px !important;
      font-weight: 700 !important;
      color: var(--color-navy) !important;
      letter-spacing: 0.01em !important;
      line-height: 1.2 !important;
    }
    /* Selected state — strong navy border + tinted background */
    .section-{{ section.id }} .mw-option--type-button .mw-option__value--selected .mw-option__button {
      border-color: var(--color-navy) !important;
      border-width: 2px !important;
      background: #EEF3FB !important;
      box-shadow: 0 0 0 1px var(--color-navy) inset !important;
    }
    .section-{{ section.id }} .mw-option--type-button .mw-option__value--selected .mw-option__value-text {
      color: var(--color-navy) !important;
      font-weight: 800 !important;
    }

    /* ── Mageworx APO design swatches (the 60+ image grid) ── */
    .section-{{ section.id }} .mw-option--type-swatch .mw-option__container {
      display: flex !important;
      flex-wrap: wrap !important;
      gap: 6px !important;
    }
    .section-{{ section.id }} .mw-option--type-swatch .mw-option__value {
      width: 42px !important;
      height: 42px !important;
    }
    .section-{{ section.id }} .mw-option--type-swatch .mw-option__swatch-media {
      width: 42px !important;
      height: 42px !important;
      border: 1.5px solid #D0D5E0 !important;
      border-radius: 6px !important;
      overflow: hidden !important;
      cursor: pointer !important;
      transition: border-color .15s, transform .1s !important;
    }
    .section-{{ section.id }} .mw-option--type-swatch .mw-option__swatch-media:hover {
      border-color: var(--color-navy) !important;
      transform: scale(1.05) !important;
    }
    .section-{{ section.id }} .mw-option--type-swatch .mw-option__value--selected .mw-option__swatch-media {
      border-color: var(--color-crimson) !important;
      border-width: 2.5px !important;
      box-shadow: 0 0 0 1px var(--color-crimson) !important;
    }
    .section-{{ section.id }} .mw-option--type-swatch .mw-option__swatch-image {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      display: block !important;
    }

    /* ── Mageworx APO Add To Cart button — match site style (navy pill, bigger) ── */
    .section-{{ section.id }} .mw-apo-add-to-cart-custom {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100% !important;
      min-height: 56px !important;
      padding: 16px 24px !important;
      background: var(--color-navy) !important;
      color: #fff !important;
      border: 0 !important;
      border-radius: 50px !important;
      font-family: inherit !important;
      font-size: 15px !important;
      font-weight: 800 !important;
      letter-spacing: .08em !important;
      text-transform: uppercase !important;
      cursor: pointer !important;
      transition: background .2s, transform .15s !important;
      box-shadow: 0 4px 12px rgba(10,49,97,.18) !important;
    }
    .section-{{ section.id }} .mw-apo-add-to-cart-custom:hover {
      background: #052852 !important;
      transform: translateY(-1px) !important;
    }
  </style>

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <div class="product flex flex-wrap {{ product_class }}">
    {%- if product.media.size > 0 -%}
      <motion-element data-motion="fade-up" data-motion-delay="50" class="product__media-wrapper w-full relative">
        {%- if show_percent_badge -%}
          <div class="product__badges-wrapper" style="position:absolute;top:12px;left:12px;z-index:10;">
            <span class="product__percent-badge" data-percent-badge
              data-compare-at-price="{{ current_variant.compare_at_price }}"
              data-price="{{ current_variant.price }}">
              {{ percent_off }}% OFF
            </span>
          </div>
        {%- endif -%}
        {% render 'product-media-gallery',
          enable_sticky_info: enable_sticky_info,
          media_layout: media_layout,
          mobile_thumbnails: mobile_thumbnails,
          variant_images: variant_images,
          enable_image_zoom: enable_image_zoom
        %}
      </motion-element>
    {%- endif -%}

    <motion-element data-motion="fade-up" data-motion-delay="100" class="block product__info-wrapper w-full">
      {% comment %} All blocks (Title, Banner Picker, Assembly Guide, Trust Badges, Share & Ask, etc.) render
        in the order the merchant arranged them in the dashboard.
        picker_variant: 'banner' forces ANY 'steps_picker' block in the template JSON to render
        via product-steps-picker-banner instead of the legacy product-steps-picker snippet. {% endcomment %}
      {% render 'product-information-blocks',
        enable_sticky_info: false,
        update_browser_history: true,
        picker_variant: 'banner'
      %}
    </motion-element>
  </div>

  {%- for block in section.blocks -%}
    {%- if block.type == 'description' and block.settings.full_width -%}
      {%- if product.description != blank -%}
        <div
          class="product__description-fullwidth"
          {{ block.shopify_attributes }}
          style="margin-top: {{ block.settings.margin_top }}px; padding: {{ block.settings.padding_v }}px {{ block.settings.padding_h }}px; background: {{ block.settings.bg_color }}; border-radius: {{ block.settings.border_radius }}px; max-width: {{ block.settings.max_width }}; margin-left: auto; margin-right: auto;"
        >
          {% render 'product-tabs-auto', product: product %}
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {% render 'dimension-auto-table' %}

  <product-recently-viewed data-product-id="{{ product.id }}" class="hidden"></product-recently-viewed>

  {%- if enable_image_zoom -%}<script src="{{ 'photoswipe.js' | asset_url }}" defer="defer"></script>{%- endif -%}
  {%- if product.media.size > 0 -%}<script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>{%- endif -%}
  {%- if has_models -%}
    <script type="application/json" id="ProductJSON-{{ product.id }}">{{ product.media | where: 'media_type', 'model' | json }}</script>
    <script src="{{ 'product-model.js' | asset_url }}" defer></script>
  {%- endif -%}

  <script>
    (function () {
      const section = document.getElementById('MainProduct-{{ section.id }}');
      if (!section) return;
      function updatePercentBadge(variant) {
        let badge = section.querySelector('[data-percent-badge]');
        if (variant && variant.compare_at_price && variant.compare_at_price > variant.price) {
          const savings = variant.compare_at_price - variant.price;
          const percent = Math.round((savings / variant.compare_at_price) * 100);
          if (badge) {
            badge.textContent = percent + '% OFF';
            badge.style.display = '';
            if (badge.parentElement) badge.parentElement.style.display = '';
          }
        } else if (badge) {
          badge.style.display = 'none';
          if (badge.parentElement) badge.parentElement.style.display = 'none';
        }
      }
      section.addEventListener('variant:change', function (e) {
        if (e.detail && e.detail.variant) updatePercentBadge(e.detail.variant);
      });
    })();
  </script>

  <script type="application/ld+json">{{ product | structured_data }}</script>

</product-info>

{% schema %}
{
  "name": "Artificial Floral",
  "blocks": [
    { "type": "@app" },
    {
      "type": "banner_steps",
      "name": "Banner Picker",
      "limit": 1,
      "settings": [
        { "type": "header", "content": "Top Bar" },
        { "type": "checkbox", "id": "show_reviews_row", "label": "Show SKU row", "default": true },
        { "type": "checkbox", "id": "show_free_delivery", "label": "Show 'Free Delivery' trust bar", "default": true },
        { "type": "text", "id": "free_delivery_text", "label": "Free delivery text", "default": "FREE DELIVERY" },

        { "type": "header", "content": "Rate Display ($X/sq.ft)" },
        { "type": "paragraph", "content": "Custom override (highest priority): type anything like '$1.2/sq.ft' or 'From $5/sq.ft' or 'Starting at $10'. Leave blank to use the auto-built rate from the first Pricing Tier block." },
        { "type": "text", "id": "rate_display_text", "label": "Custom rate text (overrides everything)", "info": "Leave blank to auto-build from first Pricing Tier" },
        { "type": "checkbox", "id": "rate_show", "label": "Show auto-built rate (if custom text is blank)", "default": true },
        { "type": "text", "id": "rate_prefix", "label": "Currency prefix", "default": "$" },
        { "type": "text", "id": "rate_unit_label", "label": "Unit suffix (e.g. /sq.ft)", "default": "/sq.ft" },

        { "type": "header", "content": "Step 1 Card — Frame Size & Options" },
        { "type": "text", "id": "step1_title", "label": "Step 1 heading", "default": "Step 1: Select frame size & options" },
        { "type": "text", "id": "size_label", "label": "Size dropdown label", "default": "Choose Size (W X H X D)" },
        { "type": "text", "id": "options_label", "label": "Options group label", "default": "Choose Options" },
        { "type": "paragraph", "content": "Predefined sizes auto-populate from the first product option (max 8 values). A 'Custom size…' choice appears at the bottom of the dropdown — selecting it reveals the W/H/Unit inputs inline." },
        { "type": "text", "id": "quickpick_intro", "label": "Title above quick-pick buttons (legacy, unused)", "default": "Choose a standard size" },
        { "type": "text", "id": "size_title", "label": "Custom size section title", "default": "Or enter custom size" },

        { "type": "header", "content": "Step 1 — 'Need custom size?' Side Panel" },
        { "type": "text",     "id": "custom_size_title", "label": "Panel title", "default": "Need custom size?" },
        { "type": "textarea", "id": "custom_size_desc",  "label": "Panel description", "default": "Don't see your size? Request a custom quote — we ship custom in the same 48 hours." },
        { "type": "text",     "id": "custom_size_btn",   "label": "Button label", "default": "REQUEST CUSTOM SIZE QUOTE" },
        { "type": "text",     "id": "custom_size_toggle","label": "Custom size toggle label", "default": "Need custom size?", "info": "Shown next to the checkbox below the variant dropdown. Ticking it reveals the W/H inputs." },

        { "type": "header", "content": "Step 2 Card — Upload artwork & checkout" },
        { "type": "checkbox", "id": "show_step2",    "label": "Show Step 2 card", "default": true },
        { "type": "text",     "id": "step2_title",   "label": "Step 2 heading", "default": "Step 2: Upload artwork & checkout" },
        { "type": "text",     "id": "upload_label",  "label": "Upload section label", "default": "Upload Your Design" },
        { "type": "text",     "id": "upload_sub",    "label": "Upload zone subtext", "default": "UPLOAD NOW OR LATER" },
        { "type": "text",     "id": "upload_hint",   "label": "Upload file format hint", "default": "AI, PSD, PDF — up to 200MB" },

        { "type": "header", "content": "Step 2 — 'Need design help?' Side Panel" },
        { "type": "text",     "id": "design_title", "label": "Panel title", "default": "Need design help?" },
        { "type": "textarea", "id": "design_desc",  "label": "Panel description", "default": "Request a free 2D mockup preview before printing. Delivered in 4 hours. No commitment." },
        { "type": "text",     "id": "design_btn",   "label": "Button label", "default": "REQUEST FREE 2D DESIGN PREVIEW" },

        { "type": "header", "content": "Per-Unit Pricing (overrides Pricing Tier blocks)" },
        { "type": "paragraph", "content": "Set a rate per square-unit for each measurement unit. When a customer picks a unit, price = (raw area in that unit) × rate. Leave 0 to fall back to the Pricing Tier blocks (which are ft-based)." },
