{% render 'divider', show_divider: section.settings.show_section_divider, divider_width: section.settings.divider_width %}

<div class="coll-why color-{{ section.settings.color_scheme }}" style="--section-padding-top:{{ section.settings.padding_top }}px;--section-padding-bottom:{{ section.settings.padding_bottom }}px;">
  <div class="page-width section--padding">
    
    <div class="coll-why__head">
      {%- if section.settings.kicker != blank -%}
        <p class="coll-why__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}
      <h2 class="coll-why__title">{{ section.settings.heading }}</h2>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url }}" class="coll-why__cta">
          {{ section.settings.cta_label | upcase }} →
        </a>
      {%- endif -%}
    </div>

    <div class="coll-why__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          <div class="coll-why__card" {{ block.shopify_attributes }}>
            {%- if block.settings.kicker != blank -%}
              <p class="coll-why__card-kicker">{{ block.settings.kicker }}</p>
            {%- endif -%}
            
            <h3 class="coll-why__card-heading">{{ block.settings.heading }}</h3>
            
            {%- if block.settings.description != blank -%}
              <p class="coll-why__card-desc">{{ block.settings.description }}</p>
            {%- endif -%}

            {%- if block.settings.metric_number != blank -%}
              <div class="coll-why__metric">
                <div class="coll-why__metric-num">
                  {{ block.settings.metric_number }}<span class="coll-why__metric-suffix">{{ block.settings.metric_suffix }}</span>
                </div>
                {%- if block.settings.metric_label != blank -%}
                  <p class="coll-why__metric-label">{{ block.settings.metric_label }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
/* ====================== WHY US SECTION ====================== */
.coll-why {
  font-family: inherit;
}

.coll-why__head {
  text-align: center;
  margin-bottom: 60px;
}

.coll-why__kicker {
  font-family: inherit;
  font-size: 14px; /* brand small-desktop */
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #B31942;
  margin-bottom: 12px;
}

.coll-why__title {
  font-family: inherit;
  font-size: clamp(24px, 4vw, 32px); /* brand h2: 24px mobile → 32px desktop */
  line-height: 1.1;
  font-weight: 700;
  color: #0A3161;
  max-width: 800px;
  margin: 0 auto;
}

/* CTA */
.coll-why__cta {
  font-family: inherit;
  display: inline-block;
  margin-top: 24px;
  color: #B31942;
  font-weight: 700;
  text-decoration: underline;
  text-underline-offset: 4px;
  transition: all 0.3s ease;
}

.coll-why__cta:hover {
  color: #0A3161;
  transform: translateX(8px);
}

/* Grid */
.coll-why__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 32px;
}

/* Card */
.coll-why__card {
  background: #FFFFFF;
  border-radius: 16px;
  padding: 48px 40px;
  box-shadow: 0 10px 30px rgba(10, 49, 97, 0.05);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1px solid #E0E4EE; /* brand border-gray */
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.coll-why__card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4px;
  background: linear-gradient(to right, #B31942, #0A3161);
  opacity: 0;
  transition: opacity 0.3s;
}

.coll-why__card:hover {
  transform: translateY(-10px);
  box-shadow: 0 25px 50px rgba(10, 49, 97, 0.12);
}

.coll-why__card:hover::before {
  opacity: 1;
}

/* Card Content */
.coll-why__card-kicker {
  font-family: inherit;
  font-size: 13px; /* brand small-mobile */
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #B31942;
  margin-bottom: 12px;
}

.coll-why__card-heading {
  font-family: inherit;
  font-size: clamp(20px, 2.5vw, 24px); /* brand h3: 20px mobile → 24px desktop */
  line-height: 1.2;
  font-weight: 700;
  color: #0A3161;
  margin-bottom: 16px;
}

.coll-why__card-desc {
  font-family: inherit;
  color: #4A5878;
  font-size: clamp(15px, 1.5vw, 16px); /* brand body: 15px mobile → 16px desktop */
  line-height: 1.6;
  margin-bottom: 32px;
}

/* Big Metric */
.coll-why__metric {
  margin-top: auto;
  padding-top: 24px;
  border-top: 1px dashed rgba(10, 49, 97, 0.1);
}

.coll-why__metric-num {
  font-family: inherit;
  font-size: 3.5rem;
  font-weight: 800;
  line-height: 1;
  color: #B31942;
  margin-bottom: 4px;
  letter-spacing: -0.02em;
}

.coll-why__metric-suffix {
  font-size: 20px; /* brand h4-desktop */
  font-weight: 700;
  color: #0A3161;
  margin-left: 2px;
}

.coll-why__metric-label {
  font-family: inherit;
  font-size: 14px; /* brand small-desktop */
  font-weight: 700;
  color: #4A5878;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

/* Responsive */
@media (max-width: 767px) {
  .coll-why__grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .coll-why__card {
    padding: 32px 24px;
  }

  .coll-why__kicker {
    font-size: 13px; /* brand small-mobile */
  }

  .coll-why__card-kicker {
    font-size: 12px;
  }

  .coll-why__metric-suffix {
    font-size: 18px; /* brand h4-mobile */
  }

  .coll-why__metric-label {
    font-size: 13px; /* brand small-mobile */
  }
}
</style>

{% schema %}
{
  "name": "Why Us Cards",
  "tag": "section",
  "class": "collection-why-us-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "WHY US"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Why customers <em>choose us</em>."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Divider"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": false,
      "label": "Show divider"
    },
    {
      "type": "select",
      "id": "divider_width",
      "options": [
        { "value": "fixed", "label": "Fixed" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "fixed",
      "label": "Divider width"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Why Us Card",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "default": "FAST · RELIABLE"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Card heading",
          "default": "48-hour production, guaranteed."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card description",
          "default": "Your display prints and ships within 48 hours of mockup approval."
        },
        {
          "type": "text",
          "id": "metric_number",
          "label": "Big metric number",
          "default": "48"
        },
        {
          "type": "text",
          "id": "metric_suffix",
          "label": "Metric suffix",
          "default": "h"
        },
        {
          "type": "text",
          "id": "metric_label",
          "label": "Metric label",
          "default": "PRODUCTION TIME"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Why Us Cards" }]
}
{% endschema %}