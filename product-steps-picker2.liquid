}
html body #psp-m-up-{{ block.id }} .psp-uov-sb .psp-stab.on .psp-stab-ic{
  background:{{ accent_color }}!important;
  background-color:{{ accent_color }}!important;
}
html body #psp-m-up-{{ block.id }} .psp-uov-sb .psp-stab .psp-stab-ic svg{
  display:block!important;
  width:17px!important;
  height:17px!important;
  flex-shrink:0!important;
  overflow:visible!important;
}

/* Desktop icon size */
@media(min-width:601px){
  html body #psp-m-up-{{ block.id }} .psp-uov-sb .psp-stab .psp-stab-ic{
    width:64px!important;
    height:64px!important;
    min-width:64px!important;
    min-height:64px!important;
    max-width:64px!important;
    max-height:64px!important;
    border-radius:14px!important;
  }
  html body #psp-m-up-{{ block.id }} .psp-uov-sb .psp-stab .psp-stab-ic svg{
    width:26px!important;
    height:26px!important;
  }
}

/* ── Right content area ── */
#psp-m-up-{{ block.id }} .psp-uov-con{
  display:flex;
  flex-direction:column;
  background:#fff;
  min-width:0;
  /* mobile: natural height, no overflow clipping */
  width:100%;
  overflow:visible;
}
@media(min-width:601px){
  #psp-m-up-{{ block.id }} .psp-uov-con{
    flex:1!important;
    overflow:hidden!important;
    width:auto!important;
  }
}

/* Content sub-panels */
#psp-m-up-{{ block.id }} [data-up-con]{
  height:auto;
  min-height:300px;
}
#psp-m-up-{{ block.id }} .psp-upcon{
  /* mobile: natural height */
  height:auto;
  min-height:300px;
}
@media(min-width:601px){
  #psp-m-up-{{ block.id }} [data-up-con]{
    height:100%!important;
