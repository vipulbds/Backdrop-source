    <div class="psp-ov__body">
      <div class="psp-ml">
        <div class="psp-badge-row"><div class="psp-badge"><div class="psp-badge-circle"><span class="psp-badge-num">22</span><span class="psp-badge-lbl">Years</span></div><div class="psp-badge-tw"><span class="psp-badge-title">Years of Service</span><span class="psp-badge-sub">Trusted since 2003</span></div></div></div>
        <div class="psp-bens">
          <div class="psp-ben"><span class="psp-ben-ck">✓</span><div><div class="psp-ben-t">Free Shipping</div><div class="psp-ben-s">On all orders</div></div></div>
          <div class="psp-ben"><span class="psp-ben-ck">✓</span><div><div class="psp-ben-t">1-Year Warranty</div><div class="psp-ben-s">Product guarantee</div></div></div>
          <div class="psp-ben"><span class="psp-ben-ck">✓</span><div><div class="psp-ben-t">Best Price Guarantee</div><div class="psp-ben-s">Competitive pricing</div></div></div>
          <div class="psp-ben"><span class="psp-ben-ck">✓</span><div><div class="psp-ben-t">Eco-Friendly Materials</div><div class="psp-ben-s">PVC-free fabric</div></div></div>
        </div>
        <div class="psp-how"><div class="psp-how-t">How to Order</div><div class="psp-steps"><div class="psp-step"><div class="psp-step-n">1</div><div class="psp-step-t">Submit your bulk enquiry</div></div><div class="psp-step"><div class="psp-step-n">2</div><div class="psp-step-t">Receive quote and approve artwork</div></div><div class="psp-step"><div class="psp-step-n">3</div><div class="psp-step-t">We print and ship to your door</div></div></div></div>
        <div class="psp-need"><div class="psp-need-t">Need help?</div><div class="psp-need-s">Share your quantity + details and we'll guide you.</div></div>
      </div>
      <div class="psp-mr">
        <div id="psp-be-ld-{{ block.id }}" class="psp-ld"><div class="psp-sp"></div><p style="font-size:.88rem;color:#555">Sending your enquiry…</p></div>
        <div id="psp-be-sc-{{ block.id }}" class="psp-sc"><div class="psp-tick">✓</div><p class="psp-sc-msg">Got it! Your bulk enquiry has been received. We'll be in touch shortly.</p></div>
        <div id="psp-be-er-{{ block.id }}" class="psp-er">Something went wrong. Please try again or email us at {{ shop.email }}.</div>
        <div id="psp-be-w-{{ block.id }}">
          <form id="psp-be-f-{{ block.id }}" class="psp-form" novalidate>
            <div class="psp-fld"><label>Name <span class="psp-req">*</span></label><input type="text" id="psp-be-n-{{ block.id }}" placeholder="Your full name" required></div>
            <div class="psp-fld"><label>Email <span class="psp-req">*</span></label><input type="email" id="psp-be-e-{{ block.id }}" placeholder="your@email.com" required autocorrect="off" autocapitalize="off"></div>
            <div class="psp-fld"><label>Phone Number <span class="psp-req">*</span></label><input type="tel" id="psp-be-p-{{ block.id }}" placeholder="+1 (555) 000-0000" required></div>
            <div class="psp-fld"><label>Quantity</label><input type="number" id="psp-be-q-{{ block.id }}" placeholder="e.g. 10" min="1" style="max-width:140px;background-image:none;text-align:left;"></div>
            <div class="psp-fld"><label>Message <span class="psp-opt">(optional)</span></label><textarea id="psp-be-m-{{ block.id }}" placeholder="Tell us about your bulk order requirements…"></textarea></div>
            <input type="hidden" id="psp-be-gi-{{ block.id }}"><input type="hidden" id="psp-be-gc-{{ block.id }}"><input type="hidden" id="psp-be-gs-{{ block.id }}"><input type="hidden" id="psp-be-gz-{{ block.id }}"><input type="hidden" id="psp-be-gt-{{ block.id }}"><input type="hidden" id="psp-be-st-{{ block.id }}">
            <div class="psp-hp" aria-hidden="true"><input type="text" id="psp-be-hp-{{ block.id }}" tabindex="-1" autocomplete="off"></div>
            <button type="submit" class="psp-send">Send Enquiry</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
'use strict';
var B='{{ block.id }}',AC='{{ accent_color }}',PROD='{{ product.title | escape }}',PURL='{{ shop.domain }}{{ product.url }}';
function $i(id){return document.getElementById(id);}
function gv(id){var e=$i(id);return e?e.value:'';}
function wt(ms){return new Promise(function(r){setTimeout(r,ms);});}
async function re(nm,fn,n,d){var er=null;for(var i=1;i<=n;i++){try{return await fn();}catch(e){er=e;if(i<n)await wt(d);}}throw er||new Error(nm);}

/* ── Open / Close ── */
function open(id){
  var m=$i('psp-m-'+id);if(!m)return;
  if(m.parentElement!==document.body)document.body.appendChild(m);
  m.classList.add('open');m.scrollTop=0;
  document.body.style.overflow='hidden';document.documentElement.style.overflow='hidden';
  ['cs','dh','be'].forEach(function(k){
    if(id===k+'-'+B){var s=$i('psp-'+k+'-st-'+B);if(s)s.value=String(Date.now());fetchGeo(k);}
  });
}
function closeAll(){
  document.querySelectorAll('.psp-ov.open').forEach(function(m){m.classList.remove('open');});
  document.body.style.overflow='';document.documentElement.style.overflow='';
}

document.querySelectorAll('[data-psp-open]').forEach(function(b){b.addEventListener('click',function(){open(b.dataset.pspOpen);});});
var uz=$i('psp-uz-'+B),uzb=$i('psp-uzb-'+B);
function openUp(e){if(e)e.stopPropagation();open('up-'+B);}
if(uz){uz.addEventListener('click',openUp);uz.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();openUp();}});}
if(uzb)uzb.addEventListener('click',openUp);

document.querySelectorAll('[data-psp-close="'+B+'"]').forEach(function(el){el.addEventListener('click',closeAll);});
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeAll();});

['cs','dh','be'].forEach(function(k){
  var mo=$i('psp-m-'+k+'-'+B);if(!mo)return;
  new MutationObserver(function(){
    if(!mo.classList.contains('open'))setTimeout(function(){
      ['ld','sc','er'].forEach(function(s){var el=$i('psp-'+k+'-'+s+'-'+B);if(el)el.classList.remove('on');});
      var w=$i('psp-'+k+'-w-'+B);if(w)w.style.display='';
      var f=$i('psp-'+k+'-f-'+B);if(f)f.reset();
      var st=$i('psp-'+k+'-st-'+B);if(st)st.value=String(Date.now());
    },300);
  }).observe(mo,{attributes:true,attributeFilter:['class']});
});

/* ── Variant + qty sync ── */
var wrap=$i('psp-'+B);
if(wrap){wrap.querySelectorAll('[data-psp-opt]').forEach(function(sel){sel.addEventListener('change',function(){var idx=parseInt(sel.dataset.pspOpt);document.querySelectorAll('[data-option-position="'+(idx+1)+'"] input[type="radio"],.product-form [name="option'+(idx+1)+'"]').forEach(function(r){if(r.value===sel.value){r.checked=true;r.dispatchEvent(new Event('change',{bubbles:true}));}});document.querySelectorAll('select[data-option-index="'+idx+'"],.product-form select[name="option'+(idx+1)+'"]').forEach(function(d){d.value=sel.value;d.dispatchEvent(new Event('change',{bubbles:true}));});});});}
var qIn=$i('psp-qty-'+B);
if(qIn){qIn.addEventListener('input',function(){var nq=document.querySelector('input[name="quantity"],quantity-input input');if(nq&&nq!==qIn){nq.value=qIn.value;nq.dispatchEvent(new Event('input',{bubbles:true}));}});}
document.addEventListener('pvd:discount-applied',function(e){if(qIn&&e.detail&&e.detail.minQty)qIn.value=e.detail.minQty;},true);

/* ── Geo ── */
var gCache={};
function fetchGeo(k){if(gCache[k])return;gCache[k]=true;fetch('https://api.ipgeolocation.io/ipgeo?apiKey=d8219c97f06142f1b715280e15e42214').then(function(r){return r.json();}).then(function(d){var sf=function(s,v){var el=$i('psp-'+k+'-'+s+'-'+B);if(el)el.value=v||'';};sf('gi',d.ip);sf('gc',d.city);sf('gs',d.state_prov);sf('gz',d.time_zone&&d.time_zone.name);sf('gt',d.time_zone&&d.time_zone.current_time);}).catch(function(){});}

/* ── Uploadcare ── */
var ucP=null,ucW={};
function ensUC(){if(window.uploadcare&&typeof window.uploadcare.Widget==='function')return Promise.resolve();if(ucP)return ucP;ucP=new Promise(function(res,rej){var s=document.createElement('script');s.src='https://ucarecdn.com/libs/widget/3.x/uploadcare.full.min.js';s.async=s.defer=true;s.onload=res;s.onerror=rej;document.head.appendChild(s);}).catch(function(e){ucP=null;throw e;});return ucP;}
function initUC(inputId,cb){if(ucW[inputId])return Promise.resolve(ucW[inputId]);var inp=$i(inputId);if(!inp)return Promise.resolve(null);return ensUC().then(function(){if(!window.uploadcare||typeof window.uploadcare.Widget!=='function')return null;var w=window.uploadcare.Widget(inp);w.onUploadComplete(function(info){var url=(info&&(info.cdnUrl||info.originalUrl))||'';if(url)cb(url);});ucW[inputId]=w;return w;}).catch(function(){return null;});}

/* ── Upload Artwork Modal ── */
var fp=$i('psp-fp-'+B),fn=$i('psp-fname-'+B);
function setFV(val,msg){if(fp)fp.value=val;if(fn){fn.textContent=msg||'';fn.style.color=val?AC:'#888';}var st=$i('psp-up-st-'+B);if(st){st.textContent=msg||'';st.style.color=val?AC:'#888';}}

var uovm=$i('psp-m-up-'+B);
function setUpSide(name){if(!uovm)return;uovm.querySelectorAll('[data-up-side]').forEach(function(b){b.classList.toggle('on',b.dataset.upSide===name);});uovm.querySelectorAll('[data-up-con]').forEach(function(p){p.style.display=p.dataset.upCon===name?'flex':'none';});}
if(uovm){uovm.querySelectorAll('[data-up-side]').forEach(function(btn){btn.addEventListener('click',function(){setUpSide(btn.dataset.upSide);});});}

var dz=$i('psp-dz-'+B),br=$i('psp-br-'+B),ucInp=$i('psp-uc-'+B);
function trigUC(){initUC('psp-uc-'+B,function(url){setFV(url,'✓ File uploaded successfully');}).then(function(w){if(w&&typeof w.openDialog==='function')w.openDialog();else if(ucInp)ucInp.click();});}
if(br)br.addEventListener('click',function(e){e.stopPropagation();trigUC();});
if(dz){dz.addEventListener('click',trigUC);dz.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();trigUC();}});dz.addEventListener('dragover',function(e){e.preventDefault();dz.classList.add('dg');});dz.addEventListener('dragleave',function(){dz.classList.remove('dg');});dz.addEventListener('drop',function(e){e.preventDefault();dz.classList.remove('dg');trigUC();});}

var svBtn=$i('psp-sv-'+B);
if(svBtn){svBtn.addEventListener('click',function(){var v=fp?fp.value:'';if(!v){var st=$i('psp-up-st-'+B);if(st){st.textContent='⚠ Please upload a file, paste a link, or select Email Later.';st.style.color='#c0392b';}return;}setFV(v,'✓ '+(v==='Customer will email files later'?'You can email files after ordering':'File saved'));closeAll();});}
var lkInp=$i('psp-lk-'+B),lkSt=$i('psp-lk-st-'+B);
if(lkInp){lkInp.addEventListener('input',function(){var v=lkInp.value.trim();if(v)setFV(v,'✓ Link saved');else setFV('','');if(lkSt){lkSt.textContent=v?'✓ Link ready':'';lkSt.style.color=AC;}});}
var lkSv=$i('psp-lk-sv-'+B);
if(lkSv){lkSv.addEventListener('click',function(){var v=lkInp?lkInp.value.trim():'';if(!v){if(lkSt){lkSt.textContent='⚠ Please paste a link first.';lkSt.style.color='#c0392b';}return;}setFV(v,'✓ Link saved');closeAll();});}
var emSv=$i('psp-em-sv-'+B);
if(emSv){emSv.addEventListener('click',function(){setFV('Customer will email files later','✉ You can email files after ordering');closeAll();});}

initUC('psp-uc-'+B,function(url){setFV(url,'✓ File uploaded successfully');});

/* ── 2D Modal upload tabs ── */
var dhm=$i('psp-m-dh-'+B),dhFl=$i('psp-dh-fl-'+B),dhUst=$i('psp-dh-ust-'+B);
if(dhm){
  dhm.querySelectorAll('[data-dh-tab]').forEach(function(tab){tab.addEventListener('click',function(){if(tab.classList.contains('lk'))return;dhm.querySelectorAll('[data-dh-tab]').forEach(function(t){t.classList.remove('on');});dhm.querySelectorAll('[data-dh-panel]').forEach(function(p){p.classList.remove('on');});tab.classList.add('on');var pan=dhm.querySelector('[data-dh-panel="'+tab.dataset.dhTab+'"]');if(pan)pan.classList.add('on');if(tab.dataset.dhTab==='email'){if(dhFl)dhFl.value='Customer will email files later';if(dhUst){dhUst.textContent='✉ You can email files after ordering';dhUst.style.color=AC;}dhm.querySelectorAll('[data-dh-tab]').forEach(function(t){t.classList.remove('lk');});}});});
  var dhLk=$i('psp-dh-lk-'+B);
  if(dhLk){dhLk.addEventListener('input',function(){var v=dhLk.value.trim();if(dhFl)dhFl.value=v;if(dhUst){dhUst.textContent=v?'✓ Link saved':'';dhUst.style.color=AC;}dhm.querySelectorAll('[data-dh-tab]').forEach(function(t){if(v)t.classList.toggle('lk',t.dataset.dhTab!=='link');else t.classList.remove('lk');});});}
  var dhUCO=$i('psp-dh-uco-'+B);
  if(dhUCO){dhUCO.addEventListener('click',function(e){e.stopPropagation();initUC('psp-dh-uc-'+B,function(url){if(dhFl)dhFl.value=url;if(dhUst){dhUst.textContent='✓ File uploaded';dhUst.style.color=AC;}dhm.querySelectorAll('[data-dh-tab]').forEach(function(t){t.classList.toggle('lk',t.dataset.dhTab!=='direct');});}).then(function(w){if(w&&typeof w.openDialog==='function')w.openDialog();});});}
}

/* ── Sheets + EmailJS ── */
var SURLS=['https://script.google.com/macros/s/AKfycbyr8HLOBRhWEVINMGSPgJXwMAP638vg5Lni2tpwsSVHAvUSXPJ2kqABi0pRb2br0j20/exec','https://script.google.com/macros/s/AKfycbxNU0RTh63GR5v1woeu8I_r2MAVLqrTJ8GFT8O1qs2gBjW0CcgD62ON2oQgAKYOhQcj/exec'];
var CURL='https://script.google.com/macros/s/AKfycbysdhq2w-U1_HhSkCQceMuwEDMGjL5lJUMtZWQ7LQIYaXe0E50vhOTebHLp6jr4v1Ofuw/exec';
var ESVC='service_t2nlztf',ejP=null;
function ensEJ(){if(window.emailjs)return Promise.resolve();if(ejP)return ejP;ejP=new Promise(function(res,rej){var s=document.createElement('script');s.src='https://cdn.jsdelivr.net/npm/emailjs-com@3/dist/email.min.js';s.async=true;s.onload=res;s.onerror=rej;document.head.appendChild(s);});return ejP;}
async function getCtr(ft){try{var d=await re('ctr',async function(){var r=await fetch(CURL+'?country=USA&formType='+ft,{method:'GET',redirect:'follow'});if(!r.ok)throw new Error('HTTP '+r.status);return r.json();},3,700);return d.counter||'0';}catch(e){return '0';}}
async function subSheets(p){await Promise.all(SURLS.map(function(u){return re('sh',async function(){await fetch(u,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:p});},3,700);}));}
function mkP(tok,d,tgt){return new URLSearchParams({requestId:tok,country:'USA',customerName:d.n,emailId:d.e,phoneNumber:d.ph||'',customerCity:d.gc||'',customerState:d.gs||'',customerTimezone:d.gz||'',customerTime:d.gt||'',target:tgt,origin:window.location.origin,token:tok});}

function showSt(k,st){['ld','sc','er'].forEach(function(s){var el=$i('psp-'+k+'-'+s+'-'+B);if(el)el.classList.toggle('on',s===st);});var w=$i('psp-'+k+'-w-'+B);if(w)w.style.display=(st==='sc'||st==='ld')?'none':'';}

/* Custom Size */
var csF=$i('psp-cs-f-'+B);
if(csF){csF.addEventListener('submit',async function(e){e.preventDefault();var hp=$i('psp-cs-hp-'+B);if(hp&&hp.value.trim()!=='')return;var st=$i('psp-cs-st-'+B);if(st&&(Date.now()-parseInt(st.value||'0',10))<5000)return;var n=gv('psp-cs-n-'+B).trim(),em=gv('psp-cs-e-'+B).trim(),ph=gv('psp-cs-p-'+B).trim();if(!n||!em||!ph){alert('Please fill in Name, Email and Phone Number.');return;}showSt('cs','ld');try{var ctr=await getCtr('CUSTOM_REQ');var tok='CSR-US#'+String(ctr).padStart(3,'0');var d={n,e:em,ph,w:gv('psp-cs-w2-'+B),h:gv('psp-cs-h-'+B),u:gv('psp-cs-u-'+B),msg:gv('psp-cs-m-'+B),gc:gv('psp-cs-gc-'+B),gs:gv('psp-cs-gs-'+B),gz:gv('psp-cs-gz-'+B),gt:gv('psp-cs-gt-'+B)};showSt('cs','sc');Promise.allSettled([subSheets(mkP(tok,d,'Custom-Size')),subSheets(mkP(tok,d,'Pr-form')),ensEJ().then(function(){window.emailjs.init('Qy8GnlfeI_jayLu47');return Promise.all([re('cs1',function(){return window.emailjs.send(ESVC,'template_pcbfdk6',{to_email:'proofs@backdropsource.com',subject:'Backdropsource - Custom Size Request',reply_to:em,shop_name:'Backdropsource - USA',customer_name:n,customer_email:em,customer_phone:ph,width:d.w,height:d.h,measurement:d.u,customer_message:d.msg,product_name:PROD,product_url:PURL,customer_city:d.gc,customer_state:d.gs,customer_timezone:d.gz,customer_time:d.gt});},3,800),re('cs2',function(){return window.emailjs.send(ESVC,'template_ges800l',{shop_token:tok,to_email:em,from_name:n,subject:'Backdropsource - Custom Size Request',width:d.w,height:d.h,measurement:d.u,product:PROD,product_url:PURL,reply_to:'proofs@backdropsource.com',shop_name:'Backdropsource - USA',executive_name:'Jennifer Rytter  (She/Her)',designation:'Sales Manager | Backdropsource',phone_number:'📞 Tel: +1 650 614 1888 | 📱 WhatsApp: +1 737 204 1523',store_email:'📧 Email: sales@backdropsource.com',website:'🌐 www.backdropsource.com'});},3,800)]);})]);}catch(er){showSt('cs','er');console.error('[PSP]CS',er);}});}

/* 2D Mockup */
var dhF=$i('psp-dh-f-'+B);
if(dhF){dhF.addEventListener('submit',async function(e){e.preventDefault();var hp=$i('psp-dh-hp-'+B);if(hp&&hp.value.trim()!=='')return;var st=$i('psp-dh-st-'+B);if(st&&(Date.now()-parseInt(st.value||'0',10))<5000)return;var n=gv('psp-dh-n-'+B).trim(),em=gv('psp-dh-e-'+B).trim(),ph=gv('psp-dh-p-'+B).trim();if(!n||!em||!ph){alert('Please fill in Name, Email and Phone Number.');return;}showSt('dh','ld');try{var ctr=await getCtr('2D_MOCK');var tok='2RP-US#'+String(ctr).padStart(3,'0');var d={n,e:em,ph,w:gv('psp-dh-w2-'+B),h:gv('psp-dh-h-'+B),u:gv('psp-dh-u-'+B),msg:gv('psp-dh-m-'+B),fl:gv('psp-dh-fl-'+B),gc:gv('psp-dh-gc-'+B),gs:gv('psp-dh-gs-'+B),gz:gv('psp-dh-gz-'+B),gt:gv('psp-dh-gt-'+B)};showSt('dh','sc');Promise.allSettled([subSheets(mkP(tok,d,'Mockup')),subSheets(mkP(tok,d,'Pr-form')),ensEJ().then(function(){window.emailjs.init('Qy8GnlfeI_jayLu47');return Promise.all([re('dh1',function(){return window.emailjs.send(ESVC,'template_u35lx3l',{to_email:'proofs@backdropsource.com',subject:'Backdropsource - Request for 2D Mockup',reply_to:em,shop_name:'Backdropsource - USA',customer_name:n,customer_email:em,customer_phone:ph,width:d.w,height:d.h,measurement:d.u,customer_message:d.msg,user_uploadfile:d.fl,product_name:PROD,product_url:PURL,customer_city:d.gc,customer_state:d.gs,customer_timezone:d.gz,customer_time:d.gt});},3,800),re('dh2',function(){return window.emailjs.send(ESVC,'template_9afukap',{shop_token:tok,to_email:em,from_name:n,subject:'Backdropsource - Request for 2D Mockup',width:d.w,height:d.h,measurement:d.u,product:PROD,product_url:PURL,reply_to:'proofs@backdropsource.com',shop_name:'Backdropsource - USA',executive_name:'Jennifer Rytter  (She/Her)',designation:'Sales Manager | Backdropsource',phone_number:'📞 Tel: +1 650 614 1888 | 📱 WhatsApp: +1 737 204 1523',store_email:'📧 Email: sales@backdropsource.com',website:'🌐 www.backdropsource.com'});},3,800)]);})]);}catch(er){showSt('dh','er');console.error('[PSP]DH',er);}});}

