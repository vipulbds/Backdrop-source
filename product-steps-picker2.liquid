/* ═══ STATE OVERLAYS ═══ */
.psp-ld{display:none;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:40px 20px;text-align:center;}
.psp-ld.on{display:flex;}
.psp-sp{width:38px;height:38px;border:4px solid #f0f0f0;border-top:4px solid {{ accent_color }};border-radius:50%;animation:pspSp 1s linear infinite;}
@keyframes pspSp{to{transform:rotate(360deg);}}
.psp-sc{display:none;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:40px 20px;text-align:center;}
.psp-sc.on{display:flex;}
.psp-tick{width:60px;height:60px;border-radius:50%;background:{{ accent_color }};color:#fff;font-size:28px;font-weight:400;display:flex;align-items:center;justify-content:center;}
.psp-sc-msg{font-family:var(--f-h3,'Inter',sans-serif);font-size:var(--sz-h3,20px);font-weight:var(--wt-h3,400);color:#0A3161;line-height:1.5;max-width:300px;}
.psp-er{display:none;padding:20px;text-align:center;color:#c0392b;font-family:var(--f-body,'Inter',sans-serif);font-size:var(--sz-body,15px);font-weight:var(--wt-body,200);}
.psp-er.on{display:block;}
.psp-hp{position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important;overflow:hidden!important;}

/* Hide uploadcare widget UI — triggered programmatically */
.uploadcare-widget,.uploadcare-widget-button,.uploadcare-widget-button-base,
.uploadcare-widget-status,.uploadcare-widget-dragndrop-supported,
.uploadcare--widget,.uploadcare--widget__button{display:none!important;visibility:hidden!important;}

/* Hard containment */
#psp-{{ block.id }} .pc{overflow:hidden!important;}
#psp-{{ block.id }} .pl{overflow:hidden!important;max-width:100%!important;min-width:0!important;}
#psp-{{ block.id }} .uz{overflow:hidden!important;overflow-x:hidden!important;max-width:100%!important;}
#psp-{{ block.id }} .uz-btn{
  display:block!important;width:100%!important;max-width:100%!important;min-width:0!important;
  box-sizing:border-box!important;white-space:normal!important;
  word-break:break-word!important;overflow-wrap:break-word!important;overflow:hidden!important;
  font-size:11px!important;
}
@media(min-width:769px){#psp-{{ block.id }} .uz-btn{font-size:12px!important;}}

/* Upload modal link logos override */
#psp-m-up-{{ block.id }} .psp-link-logos img{width:32px!important;}
#psp-m-up-{{ block.id }} .psp-link-logos a img[style*="width:44px"],
#psp-m-up-{{ block.id }} .psp-link-logos a img[style*="width:38px"]{width:auto!important;}
</style>

{%- if show_step1 -%}
<div id="psp-{{ block.id }}" {{ block.shopify_attributes }}>

  <!-- STEP 1 -->
  <div class="pc">
    <div class="pc-h">{{ step1_title }}</div>
    <div class="pg">
      <div class="pl">
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="pf">
              <label for="psp-o{{ forloop.index }}-{{ block.id }}">{{ option.name }}</label>
              <select id="psp-o{{ forloop.index }}-{{ block.id }}" data-psp-opt="{{ forloop.index0 }}">
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
        {%- endunless -%}
        {%- if show_quantity -%}
          <div class="pf">
            <label for="psp-qty-{{ block.id }}">Quantity</label>
            <input type="number" id="psp-qty-{{ block.id }}" value="1" min="1">
