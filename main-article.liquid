<style>
/* ==========================================================
   BDS BLOG CHILD  |  Brand Design System
   Font   : Inter
   H1     : 45px / 800  → mobile 28px / 400
   H2     : 30px / 400  → mobile 25px / 300
   H3     : 20px / 400
   H4     : 19px / 300
   Body   : 15px / 200  → mobile 14px / 200
   Btn/Nav: 15px / 200  → mobile 13px / 200
   Navy   : #0A3161   Crimson : #B31942
   White  : #FFFFFF   Off-white: #F5F6F8   Border: #E0E4EE
========================================================== */
:root {
  --ba-navy       : #0A3161;
  --ba-navy-mid   : #1a4a8a;
  --ba-navy-light : #2e5fa0;
  --ba-crimson    : #B31942;
  --ba-crimson-hov: #8f0f2e;
  --ba-crimson-soft: rgba(179,25,66,.07);
  --ba-white      : #ffffff;
  --ba-offwhite   : #F5F6F8;
  --ba-gray-light : #f8f9fb;
  --ba-border     : #E0E4EE;
  --ba-text       : #0A3161;
  --ba-text-mid   : #4a5568;
  --ba-text-light : #8896a8;
  --ba-font       : 'Inter', sans-serif;
  --ba-max        : 1100px;
  --ba-h1         : 45px;
  --ba-h2         : 30px;
  --ba-h3         : 20px;
  --ba-h4         : 19px;
  --ba-body       : 15px;
  --ba-btn        : 15px;
  --ba-nav        : 15px;
}
.ba *, .ba *::before, .ba *::after { box-sizing: border-box; margin: 0; padding: 0; }
.ba { font-family: var(--ba-font); color: var(--ba-text); background: var(--ba-white); }
.ba a { color: var(--ba-crimson); }
.ba a:hover { text-decoration: underline; }

/* ── BREADCRUMB NAV ── */
.ba-breadcrumb {
  background: var(--ba-white);
  border-bottom: 1px solid var(--ba-border);
  padding: 14px 48px;
  display: flex; align-items: center; gap: 6px;
  font-size: 13px; color: var(--ba-text-light);
  position: sticky; top: 0; z-index: 100;
}

.ba-breadcrumb a { color: var(--ba-text-mid); font-weight: 500; text-decoration: none; }
.ba-breadcrumb a:hover { color: var(--ba-crimson); }
.ba-breadcrumb .sep { color: var(--ba-border); }
.ba-breadcrumb .current { color: var(--ba-text); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 360px; }

/* ── HERO ── */
.ba-hero {
  background: linear-gradient(135deg, #edf1f9 0%, #f5f7fb 100%);
  padding: 56px 0 48px;
}
.ba-hero__inner {
  max-width: var(--ba-max); margin: 0 auto; padding: 0 48px;
  display: grid; grid-template-columns: 1fr 420px;
  gap: 48px; align-items: center;
}
.ba-hero__badge {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 12px; font-weight: 700; color: var(--ba-text-mid);
  text-transform: uppercase; letter-spacing: .6px; margin-bottom: 16px;
}
.ba-hero__badge svg { width: 15px; height: 15px; }
.ba-hero__badge .divider-dot { color: var(--ba-border); }
.ba-hero__badge .read-time { color: var(--ba-text-light); font-weight: 500; }
.ba-hero__title {
  font-size: var(--ba-h1); font-weight: 800; line-height: 1.15;
  color: var(--ba-navy); margin-bottom: 20px; letter-spacing: -.5px;
}
.ba-hero__tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
.ba-hero__tag {
  display: inline-block;
  background: var(--ba-crimson-soft); color: var(--ba-crimson);
  font-size: 11px; font-weight: 800; letter-spacing: 1.2px;
  text-transform: uppercase; padding: 4px 10px; border-radius: 4px;
  text-decoration: none;
}
.ba-hero__tag:hover { text-decoration: none; }
.ba-hero__meta {
  display: flex; align-items: center; gap: 40px;
  padding-top: 24px; border-top: 1px solid var(--ba-border);
}
.ba-hero__author { display: flex; align-items: center; gap: 10px; }
.ba-hero__avatar {
  width: 40px; height: 40px; border-radius: 50%;
  background: linear-gradient(135deg, var(--ba-navy), var(--ba-crimson));
  display: flex; align-items: center; justify-content: center;
  color: var(--ba-white); font-size: 15px; font-weight: 800;
}
.ba-hero__author-label { font-size: 10px; font-weight: 700; color: var(--ba-text-light); text-transform: uppercase; letter-spacing: .5px; }
.ba-hero__author-name { font-size: 13.5px; font-weight: 700; color: var(--ba-text); }
.ba-hero__date-label { font-size: 10px; font-weight: 700; color: var(--ba-text-light); text-transform: uppercase; letter-spacing: .5px; }
.ba-hero__date { font-size: 13.5px; font-weight: 600; color: var(--ba-text); }
.ba-hero__image {
  border-radius: 14px; overflow: hidden;
  box-shadow: 0 12px 40px rgba(26,39,68,.14); aspect-ratio: 4/3;
  background: linear-gradient(135deg, var(--ba-navy) 0%, var(--ba-navy-light) 50%, #3a5280 100%);
  display: flex; align-items: center; justify-content: center;
}
.ba-hero__image img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ba-hero__image-placeholder {
  display: flex; flex-direction: column; align-items: center; gap: 12px;
  color: rgba(255,255,255,.4); font-size: 13px; font-weight: 600; text-align: center;
}
.ba-hero__image-placeholder svg { width: 48px; height: 48px; opacity: .35; }

/* ── FIXED SOCIAL SHARE SIDEBAR ── */
.ba-share {
  position: fixed; right: 28px; top: 50%; transform: translateY(-50%);
  display: flex; flex-direction: column; gap: 10px; z-index: 50;
}
.ba-share__btn {
  width: 38px; height: 38px; border-radius: 10px;
  background: var(--ba-gray-light); border: 1px solid var(--ba-border);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; transition: background .15s, border-color .15s;
  color: var(--ba-text-mid); text-decoration: none;
}
.ba-share__btn:hover { background: var(--ba-navy); border-color: var(--ba-navy); color: var(--ba-white); text-decoration: none; }
.ba-share__btn svg { width: 16px; height: 16px; }
.ba-share__top {
  writing-mode: vertical-rl; text-orientation: mixed;
  font-size: 10px; font-weight: 700; color: var(--ba-text-light);
  text-transform: uppercase; letter-spacing: 1px;
  cursor: pointer; text-align: center; padding: 8px 0; transition: color .15s;
}
.ba-share__top:hover { color: var(--ba-crimson); }

/* ── PAGE BODY ── */
.ba-body {
  max-width: var(--ba-max); margin: 0 auto;
  padding: 52px 48px;
  display: grid; grid-template-columns: 260px 1fr;
  gap: 52px; align-items: start;
}

/* ── SIDEBAR TOC ── */
.ba-sidebar { position: sticky; top: 72px; display: flex; flex-direction: column; }
.ba-toc {
  background: var(--ba-gray-light); border: 1px solid var(--ba-border);
  border-radius: 14px; padding: 24px 24px 20px;
}
.ba-toc__header { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
.ba-toc__icon {
  width: 30px; height: 30px; background: var(--ba-crimson-soft);
  border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.ba-toc__icon svg { width: 15px; height: 15px; stroke: var(--ba-crimson); }
.ba-toc__title { font-size: 13px; font-weight: 800; color: var(--ba-text); }
.ba-toc__list { list-style: none; display: flex; flex-direction: column; }
.ba-toc__list li a {
  display: block; font-size: 12.5px; font-weight: 500; color: var(--ba-text-mid);
  padding: 8px 4px 8px 12px; border-bottom: 1px solid var(--ba-border);
  line-height: 1.5; transition: color .15s; text-decoration: none;
  word-break: break-word;
}
.ba-toc__list li:last-child a { border-bottom: none; }
.ba-toc__list li a:hover { color: var(--ba-crimson); text-decoration: none; }
.ba-toc__list li.active a { color: var(--ba-crimson); font-weight: 700; }
.ba-toc__cta {
  background: var(--ba-navy); color: #ffffff !important; border: none;
  border-radius: 9px; padding: 13px 20px;
  font-family: var(--ba-font); font-size: var(--ba-btn); font-weight: 800;
  width: 100%; cursor: pointer; margin-top: 16px;
  transition: background .2s; letter-spacing: .3px;
  display: block; text-align: center; text-decoration: none;
}
.ba-toc__cta:link, .ba-toc__cta:visited { color: #ffffff !important; }
.ba-toc__cta:hover { background: var(--ba-navy-mid); color: #ffffff !important; text-decoration: none; }

/* ── ARTICLE CONTENT ── */
.ba-content { min-width: 0; }

/* Key Takeaways */
.ba-takeaways {
  background: #fdf8f0; border: 1px solid #e8d8b0;
  border-radius: 12px; padding: 24px 28px; margin-bottom: 36px;
}
.ba-takeaways h3 { font-size: 14px; font-weight: 800; color: var(--ba-text); margin-bottom: 14px; }
.ba-takeaways ol { padding-left: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
.ba-takeaways ol li { display: flex; gap: 12px; font-size: 14px; color: var(--ba-text-mid); line-height: 1.6; align-items: flex-start; }
.ba-takeaway-num {
  width: 22px; height: 22px; background: var(--ba-crimson); color: var(--ba-white);
  border-radius: 50%; font-size: 11px; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-top: 2px;
}

/* Prose */
.ba-prose { font-size: var(--ba-body); font-weight: 200; color: var(--ba-text-mid); line-height: 1.75; }
.ba-prose p { margin-bottom: 20px; }
.ba-prose h2 { font-size: var(--ba-h2)!important; font-weight: 800!important; color: var(--ba-navy)!important; margin: 44px 0 16px!important; line-height: 1.25; letter-spacing: -.3px; }
.ba-prose h3 { font-size: var(--ba-h3)!important; font-weight: 700!important; color: var(--ba-navy)!important; margin: 28px 0 10px!important; }
.ba-prose h4 { font-size: var(--ba-h4)!important; font-weight: 300!important; color: var(--ba-navy)!important; margin: 20px 0 8px!important; }
.ba-prose strong, .ba-prose b { color: var(--ba-text); font-weight: 700; }
.ba-prose a { color: var(--ba-crimson); text-decoration: underline; text-underline-offset: 3px; }
.ba-prose a:hover { color: var(--ba-navy); }
.ba-prose ul, .ba-prose ol { padding-left: 24px; margin-bottom: 20px; }
.ba-prose li { margin-bottom: 8px; font-size: var(--ba-body); font-weight: 200; line-height: 1.7; }
.ba-prose ul { list-style-type: disc; }
.ba-prose ol { list-style-type: decimal; }
.ba-prose .see-also { font-size: 13.5px; color: var(--ba-text-light); margin: -10px 0 24px; }
.ba-prose .see-also a { font-weight: 600; }
.ba-section-divider { border: none; border-top: 2px solid var(--ba-border); margin: 40px 0; width: 44px; display: block; }

/* Tables — covers .ba-prose, .rte, and raw HTML tables in article body */
.ba-prose table,
.ba .ba-content table,
.ba .ba-content .rte table,
.ba .ba-content .ba-prose table {
  width: 100%; border-collapse: collapse; margin: 24px 0 28px;
  font-size: 14px; border-radius: 12px; overflow: hidden;
  border: 1px solid var(--ba-border); font-family: var(--ba-font);
}
.ba-prose table thead tr,
.ba .ba-content table thead tr { background: var(--ba-navy); color: var(--ba-white); }
.ba-prose table thead th,
.ba .ba-content table thead th { padding: 14px 18px; text-align: left; font-size: 12.5px; font-weight: 700; letter-spacing: .3px; color: var(--ba-white); }
.ba-prose table tbody tr,
.ba .ba-content table tbody tr { border-bottom: 1px solid var(--ba-border); }
.ba-prose table tbody tr:last-child,
.ba .ba-content table tbody tr:last-child { border-bottom: none; }
.ba-prose table tbody tr:nth-child(even),
.ba .ba-content table tbody tr:nth-child(even) { background: var(--ba-gray-light); }
.ba-prose table tbody td,
.ba .ba-content table tbody td { padding: 13px 18px; color: var(--ba-text-mid); font-size: 14px; font-weight: 300; }
.ba-prose table tbody td:first-child,
.ba .ba-content table tbody td:first-child { font-weight: 600; color: var(--ba-text); }
@media(max-width:640px){
  .ba-prose table,
  .ba .ba-content table { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
}

/* Blockquote */
.ba-prose blockquote,
.ba .ba-content blockquote {
  border-left: none; padding: 28px 32px; margin: 36px 0;
  background: var(--ba-gray-light); border-radius: 12px; position: relative;
}
.ba-prose blockquote::before,
.ba .ba-content blockquote::before {
  content: '\201C\201C'; font-size: 64px; line-height: 1;
  color: var(--ba-crimson); opacity: .25; font-family: Georgia,serif;
  position: absolute; top: 12px; left: 24px;
}
.ba-prose blockquote p,
.ba .ba-content blockquote p { font-size: 20px!important; font-weight: 700!important; color: var(--ba-navy)!important; line-height: 1.5; margin-bottom: 14px!important; padding-top: 12px; }
.ba-prose blockquote cite,
.ba .ba-content blockquote cite { font-size: 13px; color: var(--ba-text-light); font-style: normal; }
.ba-prose blockquote cite strong,
.ba .ba-content blockquote cite strong { color: var(--ba-text-mid); font-weight: 700; }

/* More resources */
.ba-resources {
  background: var(--ba-gray-light); border: 1px solid var(--ba-border);
  border-radius: 12px; padding: 22px 24px; margin: 36px 0;
}
.ba-resources h4 { font-size: 13.5px; font-weight: 800; color: var(--ba-text); margin-bottom: 12px; }
.ba-resources ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
.ba-resources ul li::before { content: '→'; margin-right: 8px; color: var(--ba-crimson); font-weight: 700; }
.ba-resources ul li a { font-size: 13.5px; font-weight: 500; color: var(--ba-text-mid); }
.ba-resources ul li a:hover { color: var(--ba-crimson); }

/* Author bio */
.ba-author-bio {
  display: flex; gap: 18px; padding: 28px;
  background: var(--ba-gray-light); border-radius: 14px;
  border: 1px solid var(--ba-border); margin: 36px 0;
}
.ba-author-bio__avatar {
  width: 56px; height: 56px; border-radius: 50%;
  background: linear-gradient(135deg, var(--ba-navy), var(--ba-crimson));
  display: flex; align-items: center; justify-content: center;
  color: var(--ba-white); font-size: 20px; font-weight: 800; flex-shrink: 0;
}
.ba-author-bio__text { font-size: 13.5px; color: var(--ba-text-mid); line-height: 1.65; }
.ba-author-bio__text strong { color: var(--ba-text); font-weight: 700; }

/* FAQ */
.ba-faq { margin: 44px 0; }
.ba-faq h2 { font-size: var(--ba-h2); font-weight: 800; color: var(--ba-navy); margin-bottom: 28px; letter-spacing: -.4px; }
.ba-faq__item { border-top: 1px solid var(--ba-border); }
.ba-faq__item:last-child { border-bottom: 1px solid var(--ba-border); }
.ba-faq__q {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18px 0; cursor: pointer; font-size: var(--ba-body); font-weight: 600;
  color: var(--ba-text); gap: 16px; user-select: none; transition: color .15s;
}
.ba-faq__q:hover { color: var(--ba-crimson); }
.ba-faq__toggle {
  width: 30px; height: 30px; border-radius: 50%; background: var(--ba-navy);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; transition: background .2s;
}
.ba-faq__toggle svg { width: 14px; height: 14px; stroke: var(--ba-white); transition: transform .2s; }
.ba-faq__item.open .ba-faq__toggle { background: var(--ba-crimson); }
.ba-faq__item.open .ba-faq__toggle svg { transform: rotate(45deg); }
.ba-faq__a {
  font-size: 14.5px; font-weight: 200; color: var(--ba-text-mid); line-height: 1.7;
  max-height: 0; overflow: hidden;
  transition: max-height .3s cubic-bezier(.4,0,.2,1), padding .3s;
  padding: 0;
}
.ba-faq__item.open .ba-faq__a { max-height: 400px; padding: 0 0 20px; }

/* Tags footer */
.ba-tags-footer {
  display: flex; align-items: center; flex-wrap: wrap; gap: 8px;
  padding: 24px 0; border-top: 1px solid var(--ba-border); margin-top: 32px;
}
.ba-tags-footer__label { font-size: 13px; font-weight: 600; color: var(--ba-navy); }
.ba-tags-footer__tag {
  display: inline-block; padding: 4px 12px;
  background: var(--ba-gray-light); border: 1px solid var(--ba-border);
  border-radius: 20px; font-size: 12px; color: var(--ba-text-mid);
  text-decoration: none; transition: all .2s;
}
.ba-tags-footer__tag:hover { background: var(--ba-navy); color: var(--ba-white); border-color: var(--ba-navy); text-decoration: none; }

/* Prev/next nav */
.ba-art-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 32px 0; border-top: 1px solid var(--ba-border); }
.ba-art-nav__item { border: 1px solid var(--ba-border); border-radius: 12px; padding: 16px 20px; text-decoration: none; color: var(--ba-text); transition: all .2s; }
.ba-art-nav__item:hover { border-color: var(--ba-navy); box-shadow: 0 4px 16px rgba(10,49,97,.1); text-decoration: none; }
.ba-art-nav__item--next { text-align: right; }
.ba-art-nav__label { font-size: 11px; font-weight: 600; color: var(--ba-text-light); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 6px; }
.ba-art-nav__heading { font-size: var(--ba-body); font-weight: 500; color: var(--ba-navy); line-height: 1.4; }

/* ── RELATED SECTION ── */
.ba-related { padding: 52px 48px; background: var(--ba-gray-light); border-top: 1px solid var(--ba-border); }
.ba-related__inner { max-width: var(--ba-max); margin: 0 auto; }
.ba-related__header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px; }
.ba-related__header h2 { font-size: 24px; font-weight: 800; color: var(--ba-navy); }
.ba-related__nav { display: flex; gap: 8px; }
.ba-related__nav button {
  width: 38px; height: 38px; border-radius: 50%;
  border: 1.5px solid var(--ba-border); background: var(--ba-white);
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  transition: all .15s; color: var(--ba-text);
}
.ba-related__nav button:hover { background: var(--ba-navy); border-color: var(--ba-navy); color: var(--ba-white); }
.ba-related__nav button svg { width: 16px; height: 16px; }
.ba-related__grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
.ba-related-card { background: var(--ba-white); border-radius: 14px; overflow: hidden; border: 1px solid var(--ba-border); transition: box-shadow .2s, transform .2s; display: block; text-decoration: none; color: inherit; }
.ba-related-card:hover { box-shadow: 0 8px 28px rgba(10,49,97,.1); transform: translateY(-2px); }
.ba-related-card__img { height: 180px; background: linear-gradient(135deg, var(--ba-navy), var(--ba-navy-light)); overflow: hidden; }
.ba-related-card__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s; }
.ba-related-card:hover .ba-related-card__img img { transform: scale(1.04); }
.ba-related-card__body { padding: 20px; }
.ba-related-card__meta { display: flex; align-items: center; gap: 8px; font-size: 11.5px; color: var(--ba-text-light); font-weight: 600; margin-bottom: 10px; }
.ba-related-card__meta svg { width: 13px; height: 13px; }
.ba-related-card h3 { font-size: var(--ba-body); font-weight: 700; color: var(--ba-navy); line-height: 1.4; margin-bottom: 16px; }
.ba-read-more {
  display: inline-block; padding: 8px 18px;
  border: 1.5px solid var(--ba-border); border-radius: 7px;
  font-size: 13px; font-weight: 700; color: var(--ba-text); transition: all .15s;
}
.ba-read-more:hover { border-color: var(--ba-navy); color: var(--ba-navy); background: var(--ba-gray-light); text-decoration: none; }

/* ── RESPONSIVE ── */
@media(max-width:1100px){
  .ba-hero__inner,.ba-body,.ba-related { padding-left: 24px; padding-right: 24px; }
  .ba-breadcrumb { padding: 14px 24px; }
  .ba-share { display: none; }
}
@media(max-width:900px){
  .ba-hero__inner { grid-template-columns: 1fr; }
  .ba-hero__image { display: none; }
  .ba-body { grid-template-columns: 1fr; gap: 32px; }
  .ba-sidebar { position: static; }
  .ba-related__grid { grid-template-columns: 1fr 1fr; }
}
@media(max-width:640px){
  :root {
    --ba-h1: 28px; --ba-h2: 25px; --ba-h3: 18px; --ba-h4: 18px;
    --ba-body: 14px; --ba-btn: 13px; --ba-nav: 13px;
  }
  .ba-hero__inner,.ba-body,.ba-related,.ba-breadcrumb { padding-left: 16px; padding-right: 16px; }
  .ba-hero { padding: 32px 0 24px; }
  .ba-hero__meta { flex-direction: column; align-items: flex-start; gap: 12px; }
  .ba-related__grid { grid-template-columns: 1fr; }
  .ba-art-nav { grid-template-columns: 1fr; }
}
</style>

<div class="ba" id="ba-top">

{%- comment -%}── BREADCRUMB ──{%- endcomment -%}
<nav class="ba-breadcrumb" aria-label="Breadcrumb">
  <a href="{{ shop.url }}">Home</a>
  <span class="sep">›</span>
  <a href="{{ blog.url }}">{{ blog.title }}</a>
  <span class="sep">›</span>
  <span class="current">{{ article.title | truncate: 60 }}</span>
</nav>

{%- comment -%}── FIXED SOCIAL SHARE SIDEBAR ──{%- endcomment -%}
<div class="ba-share">
  <a class="ba-share__btn" href="https://x.com/backdropsource" target="_blank" rel="noopener" aria-label="Follow on X">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
  </a>
  <a class="ba-share__btn" href="https://www.facebook.com/BackDropSource/" target="_blank" rel="noopener" aria-label="Follow on Facebook">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
  </a>
  <a class="ba-share__btn" href="https://in.linkedin.com/company/thebackdropsource" target="_blank" rel="noopener" aria-label="Follow on LinkedIn">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
  </a>
  <span class="ba-share__top" onclick="window.scrollTo({top:0,behavior:'smooth'})">BACK TO TOP</span>
</div>

{%- comment -%}── HERO ──{%- endcomment -%}
<section class="ba-hero">
  <div class="ba-hero__inner">
    <div>
      <div class="ba-hero__badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Article
        <span class="divider-dot">·</span>
        <span class="read-time">{{ read_minutes }} min read</span>
      </div>
      <h1 class="ba-hero__title">{{ article.title }}</h1>
      {%- if article.tags.size > 0 -%}
        <div class="ba-hero__tags">
          {%- for tag in article.tags -%}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="ba-hero__tag">{{ tag }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="ba-hero__meta">
        <div class="ba-hero__author">
          <div class="ba-hero__avatar">{{ initials }}</div>
          <div>
            <div class="ba-hero__author-label">Author</div>
            <div class="ba-hero__author-name">{{ article.author }}</div>
          </div>
        </div>
        <div>
          <div class="ba-hero__date-label">Last Update</div>
          <div class="ba-hero__date">{{ article.published_at | time_tag: format: 'date' }}</div>
        </div>
      </div>
    </div>
    <div class="ba-hero__image">
      {%- if article.image -%}
        {{ article.image | image_url: width: 840 | image_tag: loading: loading, fetchpriority: fetchpriority, alt: article.image.alt }}
      {%- else -%}
        <div class="ba-hero__image-placeholder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <span>Event Backdrop<br>Hero Image</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- comment -%}── PAGE BODY ──{%- endcomment -%}
<div class="ba-body">

  {%- comment -%}── SIDEBAR TOC ──{%- endcomment -%}
  <aside class="ba-sidebar">
    <div class="ba-toc">
      <div class="ba-toc__header">
        <div class="ba-toc__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        </div>
        <span class="ba-toc__title">Table of Contents</span>
      </div>
      <ul class="ba-toc__list" id="ba-toc-list"></ul>
      <a href="{{ section.settings.cta_url | default: '/pages/contact-us' }}" class="ba-toc__cta">{{ section.settings.cta_label | default: 'Get a Free Quote' }}</a>
    </div>
  </aside>

  {%- comment -%}── ARTICLE ──{%- endcomment -%}
  <article class="ba-content">

    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'key_takeaways' -%}
          {%- liquid
            assign has_block_ta = false
            if block.settings.takeaway_1 != blank or block.settings.takeaway_2 != blank
              assign has_block_ta = true
            endif
          -%}
          <div class="ba-takeaways" id="ba-takeaways" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title | default: 'Key takeaways' }}</h3>
            <ol id="ba-takeaways-list">
              {%- if has_block_ta -%}
                {%- assign ta_keys = 'takeaway_1,takeaway_2,takeaway_3,takeaway_4,takeaway_5' | split: ',' -%}
                {%- assign ta_num = 0 -%}
                {%- for ta_key in ta_keys -%}
                  {%- assign ta_val = block.settings[ta_key] -%}
                  {%- if ta_val != blank -%}
                    {%- assign ta_num = ta_num | plus: 1 -%}
                    <li><div class="ba-takeaway-num">{{ ta_num }}</div><span>{{ ta_val }}</span></li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ol>
          </div>

        {%- when 'content' -%}
          <div class="ba-prose rte" id="ba-article-body" {{ block.shopify_attributes }}>
            {{ article.content }}
          </div>

        {%- when 'author_bio' -%}
          {%- liquid
            assign bio_meta = article.metafields.custom.author_bio.value
            assign bio_text = block.settings.bio
            if bio_meta != blank
              assign bio_text = bio_meta
            endif
          -%}
          <div class="ba-author-bio" {{ block.shopify_attributes }}>
            <div class="ba-author-bio__avatar">{{ initials }}</div>
            <div class="ba-author-bio__text">
              <strong>{{ article.author }}</strong>
              {%- if bio_text != blank -%}
                {{ bio_text }}
              {%- else -%}
                is a content strategist and industry writer at BackdropSource, creating practical guides for event planners, marketers, and businesses.
              {%- endif -%}
            </div>
          </div>

        {%- when 'faq' -%}
          {%- liquid
            assign meta_faq_qs = article.metafields.custom.faq_questions.value
            assign meta_faq_as = article.metafields.custom.faq_answers.value
            assign has_meta_faq = false
            if meta_faq_qs != blank and meta_faq_qs.size > 0
              assign has_meta_faq = true
            endif
          -%}
          {%- if has_meta_faq or block.settings.q1 != blank -%}
            <div class="ba-faq" id="faq" {{ block.shopify_attributes }}>
              <h2>{{ block.settings.heading | default: 'FAQs' }}</h2>
              {%- if has_meta_faq -%}
                {%- for faq_q in meta_faq_qs -%}
                  {%- assign faq_a = meta_faq_as[forloop.index0] -%}
                  <div class="ba-faq__item{% if forloop.first %} open{% endif %}">
                    <div class="ba-faq__q">
                      {{ faq_q }}
                      <div class="ba-faq__toggle">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                      </div>
                    </div>
                    <div class="ba-faq__a">{{ faq_a }}</div>
                  </div>
                {%- endfor -%}
              {%- else -%}
                {%- assign faq_qs = 'q1,q2,q3,q4,q5,q6,q7,q8' | split: ',' -%}
                {%- assign faq_as = 'a1,a2,a3,a4,a5,a6,a7,a8' | split: ',' -%}
                {%- for q_key in faq_qs -%}
                  {%- assign a_key = faq_as[forloop.index0] -%}
                  {%- assign q_val = block.settings[q_key] -%}
                  {%- assign a_val = block.settings[a_key] -%}
                  {%- if q_val != blank and a_val != blank -%}
                    <div class="ba-faq__item{% if forloop.first %} open{% endif %}">
                      <div class="ba-faq__q">
                        {{ q_val }}
                        <div class="ba-faq__toggle">
                          <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        </div>
                      </div>
                      <div class="ba-faq__a">{{ a_val }}</div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          {%- endif -%}

        {%- when 'share' -%}
          {%- if article.tags.size > 0 and block.settings.show_tags -%}
            <div class="ba-tags-footer" {{ block.shopify_attributes }}>
              <span class="ba-tags-footer__label">{{ 'blogs.article.tags' | t }}:</span>
              {%- for tag in article.tags -%}
                <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="ba-tags-footer__tag">{{ tag }}</a>
              {%- endfor -%}
            </div>
          {%- endif -%}

        {%- when 'navigation' -%}
          {%- if blog.previous_article or blog.next_article -%}
            <div class="ba-art-nav" {{ block.shopify_attributes }}>
              {%- if blog.previous_article -%}
                <a href="{{ blog.previous_article.url }}" class="ba-art-nav__item">
                  <div class="ba-art-nav__label">← {{ 'blogs.article.previous_post' | t }}</div>
                  <div class="ba-art-nav__heading">{{ blog.previous_article.title }}</div>
                </a>
              {%- else -%}<div></div>{%- endif -%}
              {%- if blog.next_article -%}
                <a href="{{ blog.next_article.url }}" class="ba-art-nav__item ba-art-nav__item--next">
                  <div class="ba-art-nav__label">{{ 'blogs.article.next_post' | t }} →</div>
                  <div class="ba-art-nav__heading">{{ blog.next_article.title }}</div>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}

        {%- when '@app' -%}
          <div class="article__block">{% render block %}</div>

      {%- endcase -%}
    {%- endfor -%}

  </article>
</div>

{%- comment -%}── RELATED POSTS ──{%- endcomment -%}
{%- if section.settings.show_related_posts -%}
  {%- assign rel_count = 0 -%}
  {%- for a in blog.articles limit: 6 -%}
    {%- if a.id != current_id -%}{%- assign rel_count = rel_count | plus: 1 -%}{%- endif -%}
  {%- endfor -%}
  {%- if rel_count > 0 -%}
    <section class="ba-related">
      <div class="ba-related__inner">
        <div class="ba-related__header">
          <h2>Related resources</h2>
          <div class="ba-related__nav">
            <button aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></button>
            <button aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></button>
          </div>
        </div>
        <div class="ba-related__grid">
          {%- assign shown = 0 -%}
          {%- for a in blog.articles limit: 6 -%}
            {%- if shown >= 3 -%}{%- break -%}{%- endif -%}
            {%- if a.id == current_id -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign rw = a.content | strip_html | split: ' ' | size
              assign rm = rw | divided_by: 200
              if rm < 1
                assign rm = 1
              endif
              assign shown = shown | plus: 1
            -%}
            <a href="{{ a.url }}" class="ba-related-card">
              <div class="ba-related-card__img">
                {%- if a.image -%}{{ a.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: a.image.alt }}{%- endif -%}
              </div>
              <div class="ba-related-card__body">
                <div class="ba-related-card__meta">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/></svg>
                  Article &nbsp;·&nbsp; {{ rm }} min read
                </div>
                <h3>{{ a.title }}</h3>
                <span class="ba-read-more">Read more</span>
              </div>
            </a>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
{%- endif -%}

{%- comment -%}── COMMENTS ──{%- endcomment -%}
{%- if blog.comments_enabled? -%}
  <div class="article-comment section section--padding">
    <div id="comments" class="page-width page-width--narrow">
      {%- if article.comments_count > 0 -%}
        <h2 class="text-center h1">{{ 'blogs.article.comments' | t: count: article.comments_count }}</h2>
        {% paginate article.comments by 5 %}
          <div class="article-comment__list">
            {%- for comment in article.comments -%}
              <article id="{{ comment.id }}" class="comment">
                {{ comment.content }}
                <footer class="comment__meta text-subtext">
                  <span class="comment__author">{{ comment.author }}</span>
                  <span class="comment__date">{{ comment.created_at | time_tag: format: 'date' }}</span>
                </footer>
              </article>
            {%- endfor -%}
            {% render 'pagination', paginate: paginate %}
          </div>
        {% endpaginate %}
      {%- endif -%}
      {% form 'new_comment', article, class: 'comment-form' %}
        <h2 class="{{ section.settings.comments_heading_size }} text-center">{{ 'blogs.article.comment_form_title' | t }}</h2>
        {%- if form.errors -%}
          <div class="form-error alert alert--error" role="alert"><h3 class="form-message form-message--error h6 m-0" tabindex="-1" autofocus>{% render 'icon-error' %}{{ 'templates.contact.form.error_heading' | t }}</h3></div>
        {%- elsif form.posted_successfully? -%}
          <div class="form-status-list" role="status"><h3 class="form-message alert alert--success h6" tabindex="-1" autofocus>{% render 'icon-success' %}{{ 'blogs.article.success' | t }}</h3></div>
        {%- endif -%}
        <div class="form-row">
          <div class="form-field"><label class="form-label" for="CommentForm-author">{{ 'blogs.article.name' | t }} *</label><input type="text" name="comment[author]" id="CommentForm-author" class="form-control" autocomplete="name" value="{{ form.author }}" required placeholder="{{ 'blogs.article.name' | t }}"></div>
          <div class="form-field"><label class="form-label" for="CommentForm-email">{{ 'blogs.article.email' | t }} *</label><input type="email" name="comment[email]" id="CommentForm-email" class="form-control" autocomplete="email" value="{{ form.email }}" required placeholder="{{ 'blogs.article.email' | t }}"></div>
        </div>
        <div class="form-field"><label class="form-label" for="CommentForm-body">{{ 'blogs.article.message' | t }} *</label><textarea rows="7" name="comment[body]" id="CommentForm-body" class="form-control" required placeholder="{{ 'blogs.article.message' | t }}">{{ form.body }}</textarea></div>
        <div class="form-footer text-center"><input type="submit" class="btn btn--primary" value="{{ 'blogs.article.post' | t }}"></div>
      {% endform %}
    </div>
  </div>
{%- endif -%}

</div>

<script>
(function(){
'use strict';

/* ── Build TOC from H2 only ── */
function buildTOC(){
  var body=document.getElementById('ba-article-body');
  var list=document.getElementById('ba-toc-list');
  if(!body||!list)return;
  var headings=body.querySelectorAll('h2');
  if(!headings.length)return;
  headings.forEach(function(h,i){
    var id='ba-h2-'+i;h.id=id;
    var li=document.createElement('li');
    var a=document.createElement('a');
    a.href='#'+id;a.textContent=h.textContent;
    a.addEventListener('click',function(e){
      e.preventDefault();
      var t=document.getElementById(id);
      if(t)window.scrollTo({top:t.getBoundingClientRect().top+window.pageYOffset-90,behavior:'smooth'});
    });
    li.appendChild(a);list.appendChild(li);
  });
}

/* ── Auto-build Key Takeaways: first sentence of each H2 section ── */
function buildTakeaways(){
  var taList=document.getElementById('ba-takeaways-list');
  var taWrap=document.getElementById('ba-takeaways');
  if(!taList||!taWrap)return;
  if(taList.children.length>0)return;
  var body=document.getElementById('ba-article-body');
  if(!body)return;
  var headings=body.querySelectorAll('h2');
  if(!headings.length){taWrap.style.display='none';return;}
  var idx=0;
  headings.forEach(function(h){
    /* walk siblings until we find a <p> or the next heading */
    var sibling=h.nextElementSibling;
    while(sibling&&sibling.tagName!=='P'&&!/^H[1-6]$/.test(sibling.tagName)){
      sibling=sibling.nextElementSibling;
    }
    var summary='';
    if(sibling&&sibling.tagName==='P'){
      var raw=sibling.textContent.replace(/\s+/g,' ').trim();
      /* first sentence — stop at . ! ? */
      var cut=raw.search(/[.!?]/);
      summary=cut>20?raw.slice(0,cut+1):raw.slice(0,160)+(raw.length>160?'…':'');
    }
    if(!summary)return; /* skip sections with no paragraph */
    idx++;
    var li=document.createElement('li');
    var num=document.createElement('div');
    num.className='ba-takeaway-num';
    num.textContent=idx;
    var span=document.createElement('span');
    span.textContent=summary;
    li.appendChild(num);li.appendChild(span);
    taList.appendChild(li);
  });
  if(taList.children.length===0)taWrap.style.display='none';
}

/* ── TOC scroll highlight (H2 only) ── */
function setupTOC(){
  var obs=new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      var id=entry.target.id;
      var lnk=document.querySelector('#ba-toc-list a[href="#'+id+'"]');
      if(lnk&&entry.isIntersecting){
        document.querySelectorAll('#ba-toc-list li').forEach(function(l){l.classList.remove('active');});
        lnk.closest('li').classList.add('active');
      }
    });
  },{rootMargin:'-80px 0px -70% 0px'});
  document.querySelectorAll('#ba-article-body h2').forEach(function(h){obs.observe(h);});
}

/* ── FAQ accordion ── */
function setupFAQ(){
  document.querySelectorAll('.ba-faq__q').forEach(function(q){
    q.addEventListener('click',function(){
      var item=q.closest('.ba-faq__item');
      var isOpen=item.classList.contains('open');
      document.querySelectorAll('.ba-faq__item').forEach(function(i){i.classList.remove('open');});
      if(!isOpen)item.classList.add('open');
    });
  });
}

document.addEventListener('DOMContentLoaded',function(){
  buildTOC();
  buildTakeaways();
  setupTOC();
  setupFAQ();
});
})();
</script>

<script type="application/ld+json">{{ article | structured_data }}</script>

{% schema %}
{
  "name": "Blog Post",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Sidebar CTA" },
    { "type": "text", "id": "cta_label", "label": "CTA button text", "default": "Get a Free Quote" },
    { "type": "url", "id": "cta_url", "label": "CTA button URL" },
    { "type": "header", "content": "Related Posts" },
    { "type": "checkbox", "id": "show_related_posts", "default": true, "label": "Show related posts" },
    { "type": "header", "content": "Comments" },
    { "type": "select", "id": "comments_heading_size", "label": "Comments heading size", "default": "h1", "options": [
      { "value": "h4", "label": "Small" },{ "value": "h3", "label": "Medium" },{ "value": "h2", "label": "Large" },{ "value": "h1", "label": "X-Large" }
    ]}
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "key_takeaways",
      "name": "Key Takeaways",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Section title", "default": "Key takeaways" },
        { "type": "paragraph", "content": "Dynamic source: create an article metafield namespace=custom, key=key_takeaways, type=list.single_line_text_field. When set it overrides the manual entries below." },
        { "type": "textarea", "id": "takeaway_1", "label": "Takeaway 1", "info": "Fallback — used only when metafield is not set" },
        { "type": "textarea", "id": "takeaway_2", "label": "Takeaway 2" },
        { "type": "textarea", "id": "takeaway_3", "label": "Takeaway 3" },
        { "type": "textarea", "id": "takeaway_4", "label": "Takeaway 4" },
        { "type": "textarea", "id": "takeaway_5", "label": "Takeaway 5" }
      ]
    },
    { "type": "content", "name": "Article Content", "limit": 1 },
    {
      "type": "author_bio",
      "name": "Author Bio",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Dynamic source: create an article metafield namespace=custom, key=author_bio, type=multi_line_text_field. When set it overrides the manual entry below." },
        { "type": "textarea", "id": "bio", "label": "Author bio text", "info": "Fallback — used only when metafield is not set. Leave blank for default text." }
      ]
    },
    {
