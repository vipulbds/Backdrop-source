<script>
function closePspModals() {
  document.querySelectorAll('.psp-ov').forEach(m => m.classList.remove('open'));
  document.body.style.overflow = '';
}

document.querySelectorAll('[data-psp-open]').forEach(btn => {
  btn.addEventListener('click', (e) => {
    e.preventDefault();
    const id = btn.getAttribute('data-psp-open');
    const modal = document.getElementById('psp-m-' + id);
    if (modal) {
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
  });
});

(function(){
  const sectionId = '{{ section_id }}';
  const SURL = 'https://script.google.com/macros/s/AKfycbyr8HLOBRhWEVINMGSPgJXwMAP638vg5Lni2tpwsSVHAvUSXPJ2kqABi0pRb2br0j20/exec';
  
  function showStatus(k, s) {
    document.querySelectorAll(`#psp-m-${k}-${sectionId} .psp-ld, #psp-m-${k}-${sectionId} .psp-sc, #psp-m-${k}-${sectionId} .psp-er`).forEach(el => el.style.display = 'none');
    const target = document.getElementById(`psp-${k}-${s}-${sectionId}`);
    if (target) target.style.display = 'flex';
    const wrapper = document.getElementById(`psp-${k}-w-${sectionId}`);
    if (wrapper) wrapper.style.display = (s === 'ld' || s === 'sc') ? 'none' : 'block';
  }

  const forms = ['cs', 'dh', 'up'];
  forms.forEach(k => {
    const f = document.getElementById(`psp-${k}-f-${sectionId}`);
    if (f) {
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        showStatus(k, 'ld');
        const data = {
          n: document.getElementById(`psp-${k}-n-${sectionId}`).value,
          e: document.getElementById(`psp-${k}-e-${sectionId}`).value,
          fl: document.getElementById(`psp-${k}-fl-${sectionId}`) ? document.getElementById(`psp-${k}-fl-${sectionId}`).value : '',
          w: document.getElementById(`psp-${k}-w2-${sectionId}`) ? document.getElementById(`psp-${k}-w2-${sectionId}`).value : '',
          h: document.getElementById(`psp-${k}-h-${sectionId}`) ? document.getElementById(`psp-${k}-h-${sectionId}`).value : '',
          u: document.getElementById(`psp-${k}-u-${sectionId}`) ? document.getElementById( `psp-${k}-u-${sectionId}`).value : '',
          msg: document.getElementById(`psp-${k}-m-${sectionId}`) ? document.getElementById(`psp-${k}-m-${sectionId}`).value : '',
          target: k === 'cs' ? 'Custom-Size' : (k === 'dh' ? 'Mockup' : 'Artwork'),
          origin: window.location.href
        };
        
        try {
          await fetch(SURL, { method: 'POST', mode: 'no-cors', body: new URLSearchParams(data) });
          showStatus(k, 'sc');
        } catch (err) {
          showStatus(k, 'er');
        }
      });
    }
  });
})();
</script>



