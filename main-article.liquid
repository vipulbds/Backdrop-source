{%- liquid
  assign current_id   = article.id
  assign loading      = 'eager'
  assign fetchpriority = 'high'
  if section.index >= 2
    assign loading       = 'lazy'
    assign fetchpriority = 'low'
  endif
  assign word_count   = article.content | strip_html | split: ' ' | size
  assign read_minutes = word_count | divided_by: 200
  if read_minutes < 1
    assign read_minutes = 1
  endif
  assign author_parts = article.author | split: ' '
  assign first_init   = author_parts[0] | slice: 0
  assign last_init    = author_parts[1] | slice: 0
  assign initials     = first_init | append: last_init
  if initials == blank
    assign initials = article.author | slice: 0, 2 | upcase
  endif
-%}

