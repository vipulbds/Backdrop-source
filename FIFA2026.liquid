<!-- ============ SCRIPTS ============ -->
<script>
(function () {

  var LIMIT       = {{ section.settings.products_limit | default: 8 }};
  var grid        = document.getElementById('wc-grid');
  var viewAllWrap = document.getElementById('wc-view-all');
  var viewAllLink = document.getElementById('wc-view-all-link');
  var tabs        = document.querySelectorAll('#wc-tabs .wc-tab');
  var cache       = {};

  function toHandle(raw) {
    if (!raw) return '';
    raw = raw.trim();
    var m = raw.match(/\/collections\/([^\/\?#]+)/);
    if (m) return m[1].toLowerCase();
    if (/^[a-z0-9\-]+$/.test(raw)) return raw;
    return raw.toLowerCase().replace(/[^a-z0-9\s\-]/g, '').trim().replace(/\s+/g, '-');
  }

  function money(cents) {
    return '$' + (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function showLoading() {
    grid.innerHTML = '<div class="wc-grid-state"><div class="wc-spinner"></div>Loading products…</div>';
    viewAllWrap.style.display = 'none';
  }

  function fetchProducts(handle, cb) {
    if (!handle) { cb(null, []); return; }
    if (cache[handle]) { cb(null, cache[handle]); return; }
    fetch('/collections/' + handle + '/products.json?limit=' + LIMIT)
      .then(function (r) {
        if (!r.ok) throw new Error('Collection not found: <b>' + handle + '</b>. Check the URL or name in Theme Editor.');
        return r.json();
      })
      .then(function (d) { cache[handle] = d.products || []; cb(null, cache[handle]); })
      .catch(function (e) { cb(e.message, []); });
  }

  function render(products, handle, viewallUrl) {
    if (!products || !products.length) {
      grid.innerHTML = '<div class="wc-grid-state">No products found in this collection.</div>';
      viewAllWrap.style.display = 'none';
      return;
    }
    grid.innerHTML = products.map(function (p) {
      var img = (p.images && p.images.length)
        ? '<a href="/products/' + p.handle + '"><img src="' + p.images[0].src + '" alt="' + p.title.replace(/"/g, '&quot;') + '" loading="lazy"></a>'
        : '<div class="no-img">No image</div>';
      var price = (p.variants && p.variants.length)
        ? '<div class="wc-product-card__price"><span class="from">From </span>' + money(p.variants[0].price * 100) + '</div>'
        : '';
      return '<div class="wc-product-card">'
        + '<div class="wc-product-card__img">' + img + '</div>'
        + '<div class="wc-product-card__body">'
        + '<span class="wc-product-card__stars">★★★★★</span>'
        + '<h4 class="wc-product-card__title">' + p.title + '</h4>'
        + price
        + '<a class="wc-product-card__btn" href="/products/' + p.handle + '">View Product</a>'
        + '</div></div>';
    }).join('');
    viewAllLink.href = (viewallUrl && viewallUrl.trim() !== '') ? viewallUrl : '/collections/' + handle;
    viewAllLink.textContent = 'View All Products →';
    viewAllWrap.style.display = 'block';
  }

  function load(raw, viewallUrl) {
    var handle = toHandle(raw);
    showLoading();
    fetchProducts(handle, function (err, products) {
      if (err) {
        grid.innerHTML = '<div class="wc-grid-state wc-error">⚠ ' + err + '</div>';
        viewAllWrap.style.display = 'none';
        return;
      }
      render(products, handle, viewallUrl);
    });
  }

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      tabs.forEach(function (t) { t.classList.remove('active'); });
      tab.classList.add('active');
      load(tab.getAttribute('data-raw'), tab.getAttribute('data-viewall'));
    });
  });

  var first = document.querySelector('#wc-tabs .wc-tab');
  if (first) load(first.getAttribute('data-raw'), first.getAttribute('data-viewall'));
  else grid.innerHTML = '<div class="wc-grid-state">Add a collection URL in the Theme Editor.</div>';

  document.querySelectorAll('.wc-city-card[data-url]').forEach(function (card) {
    card.addEventListener('click', function () {
      window.location.href = card.getAttribute('data-url');
    });
  });

  document.querySelectorAll('.wc-faq-item__q').forEach(function (q) {
    q.addEventListener('click', function () {
      q.closest('.wc-faq-item').classList.toggle('open');
    });
  });

})();
</script>

