        <div class="wc-city-card__flag">🇺🇸</div><div class="wc-city-card__name">Houston</div><div class="wc-city-card__matches">7 Matches</div>
      </div>
      <div class="wc-city-card" data-url="https://www.backdropsource.com/collections/fifa-world-cup-2026">
