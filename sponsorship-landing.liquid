    { "type": "header", "content": "Closing CTA" },
    { "type": "checkbox", "id": "show_cta_footer", "label": "Show closing CTA", "default": true },
    { "type": "text", "id": "ctaf_title", "label": "Title", "default": "Ready to get started?" },
