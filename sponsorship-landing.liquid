    { "type": "text", "id": "video_title", "label": "Title", "default": "See exactly how it works" },
    { "type": "textarea", "id": "video_sub", "label": "Sub-text (optional)" },
    { "type": "text", "id": "video_badge", "label": "Corner badge", "default": "3D mock-up · 90 sec" },
    { "type": "text", "id": "video_inner_title", "label": "Inner title", "default": "How BackdropSource Ads works" },
    { "type": "textarea", "id": "video_desc", "label": "Inner description", "default": "Set up your backdrop → brands discovered → ad placed → you get paid. Automatically, every event." },
