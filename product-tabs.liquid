        { "value": "design-1", "label": "t:sections.product-tabs.settings.tabs_nav_style.options__1.label" },
        { "value": "design-2", "label": "t:sections.product-tabs.settings.tabs_nav_style.options__2.label" }
      ],
      "default": "design-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
