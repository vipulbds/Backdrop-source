    },
    {
      "type": "rich_text",
      "name": "Content Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab name",
          "default": "Overview & Details"
        },
        {
          "type": "select",
          "id": "content_source",
          "label": "Content source",
          "default": "product_description",
          "options": [
            { "value": "product_description", "label": "Product description (auto)" },
            { "value": "richtext",            "label": "Custom rich text" },
            { "value": "page",                "label": "From a page" }
          ]
        },
        {
          "type": "header",
          "content": "Optional heading inside tab"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "default": "h3",
          "options": [
            { "value": "h6", "label": "Extra small" },
            { "value": "h5", "label": "Small" },
            { "value": "h4", "label": "Medium" },
            { "value": "h3", "label": "Large" },
            { "value": "h2", "label": "Extra large" }
          ]
