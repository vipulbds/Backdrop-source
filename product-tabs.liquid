    },
    {
      "type": "header",
      "content": "t:sections.all.section_header.content"
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "t:sections.all.layout.label",
      "options": [
        { "value": "vertical",   "label": "t:sections.all.layout.options__1.label" },
        { "value": "horizontal", "label": "t:sections.all.layout.options__2.label" }
      ],
