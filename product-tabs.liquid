{%- liquid
  assign header_layout = section.settings.header_layout
  assign show_all_button_on_top = section.settings.show_all_button_on_top

  assign nav_style = section.settings.tabs_nav_style | default: 'design-1'
  assign nav_button_class = ''
  assign nav_button_text_class = ''
  if nav_style == 'design-2'
    assign nav_button_class = nav_button_class | append: ' btn--inherit'
    assign nav_button_text_class = nav_button_text_class | append: ' h2'
  endif

  assign limit = section.settings.limit
  assign columns_desktop = section.settings.columns

  assign columns_tablet = columns_desktop | minus: 1
  if columns_desktop < 3 or request.design_mode
    assign columns_tablet = columns_desktop
  endif

  assign columns_mobile = section.settings.columns_mobile | plus: 0
  assign enable_swipe_mobile = section.settings.swipe_on_mobile

  assign is_metro = false
  if section.settings.grid_layout == 'metro'
    assign is_metro = true
  endif
-%}
{%- if is_metro -%}
  {%- render 'product-grid-metro-style',
    section_id: section.id,
    columns_desktop: columns_desktop,
    columns_tablet: columns_tablet,
    columns_mobile: columns_mobile
  -%}
{%- endif -%}
{%- capture image_sizes -%}
(max-width: 767px) calc((100vw - 30px) / {{ columns_mobile }}),
(max-width: 1023px) calc((100vw - 30px) / {{ columns_tablet }}),
{{ settings.page_width | divided_by: columns_desktop }}px
{%- endcapture -%}
{{ 'component-tabs.css' | asset_url | stylesheet_tag }}

<style>
  .tabs__content--richtext {
    padding: 32px 4px;
  }
  .tabs__content--richtext .rte {
    font-size: 1rem;
    line-height: 1.75;
  }
  .tabs__content--richtext .rte p,
  .tabs__content--richtext .rte li {
    font-size: 1rem;
    line-height: 1.75;
  }
  .tabs__content--richtext .rte img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }
  .tabs__content--richtext .rte ul,
  .tabs__content--richtext .rte ol {
    padding-left: 1.5em;
    margin-bottom: 1em;
  }
  .tabs__content--richtext .tab-rt__heading {
    margin-bottom: 16px;
  }
</style>

{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}

<div
  class="section section-{{ section.id }} section--padding section--product-tabs page-width color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-id="{{ section.id }}"
>
  {%- if header_layout == 'vertical' -%}
    {% render 'section-heading', section_settings: section.settings %}
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}

    {%- comment -%}
      We bypass tabs-component entirely and use our own markup + JS.
      The theme's tabs-component expects id="{{ block.id }}" on buttons and
      id="tab-{{ block.id }}" on panels — but rich_text panels didn't match
      that pattern, causing blanks. Our approach uses data attributes that
      are completely independent.
    {%- endcomment -%}

    <div class="tabs tabs__nav-{{ nav_style }}" id="pdt-{{ section.id }}">

      {%- liquid
        assign header_alignment = settings.section_header_alignment | replace: 'left', 'start' | replace: 'right', 'end'
        assign header_alignment_mobile = settings.section_header_alignment_mobile | replace: 'left', 'start' | replace: 'right', 'end'
        if header_alignment_mobile == 'inherit'
          assign header_alignment_mobile = header_alignment
        endif
        assign tab_header_class = 'flex md:justify-' | append: header_alignment | append: ' justify-' | append: header_alignment_mobile
        if header_layout == 'horizontal' or show_all_button_on_top
          assign tab_header_class = 'flex flex-col md:flex-row md:justify-between md:items-center' | append: ' items-' | append: header_alignment_mobile
          if header_alignment == 'end'
            assign tab_header_class = tab_header_class | append: ' md:flex-row-reverse'
          endif
        endif
      -%}

      <div class="tabs__header tabs__header--{{ header_layout }} {{ tab_header_class }}">
        {%- if header_layout == 'horizontal' -%}
          {% render 'section-heading', section_settings: section.settings %}
        {%- endif -%}

        <div class="tabs__nav-wrap">
          <div class="tabs__nav" role="tablist">
            {%- for block in section.blocks -%}
              {%- liquid
                assign collection = block.settings.collection
                if block.settings.title != blank
                  assign tab_name = block.settings.title
                elsif block.type == 'rich_text'
                  assign tab_name = 'Tab ' | append: forloop.index
                elsif collection != blank
                  assign tab_name = collection.title
                else
                  assign tab_name = 'Tab ' | append: forloop.index
                endif
              -%}
              <button
                class="tabs__tab focus-inset{{ nav_button_class }}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="pdt-panel-{{ block.id }}"
                data-pdt-tab="{{ block.id }}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                type="button"
                {{ block.shopify_attributes }}
              >
                <span class="tabs__tab-name{{ nav_button_text_class }}">{{- tab_name -}}</span>
              </button>
            {%- endfor -%}
          </div>
        </div>

        {%- if section.settings.button_label != blank and show_all_button_on_top -%}
          <div class="section__btn hidden md:block">
            <a
              class="btn {{ section.settings.button_style }}"
              {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}aria-disabled="true"{% endif %}
            >{{- section.settings.button_label -}}</a>
          </div>
        {%- endif -%}
      </div>

      <div class="tabs__panel">
        {%- for block in section.blocks -%}

          {%- if block.type == 'rich_text' -%}
            {%- assign content_source = block.settings.content_source | default: 'product_description' -%}
            <div
              class="tabs__content tabs__content--richtext"
              id="pdt-panel-{{ block.id }}"
              data-pdt-panel="{{ block.id }}"
              role="tabpanel"
              {% unless forloop.first %}hidden{% endunless %}
            >
              <div class="tab-rt__inner">
                {%- if block.settings.heading != blank -%}
                  <h2 class="tab-rt__heading {{ block.settings.heading_size }}">{{ block.settings.heading }}</h2>
                {%- endif -%}

                {%- if content_source == 'product_description' -%}
                  {%- if product.description != blank -%}
                    <div class="rte">{{ product.description }}</div>
                  {%- else -%}
                    <div class="rte"><p>No description available.</p></div>
                  {%- endif -%}
                {%- elsif content_source == 'page' -%}
                  {%- if block.settings.page != blank -%}
                    <div class="rte">{{ block.settings.page.content }}</div>
                  {%- endif -%}
                {%- else -%}
                  {%- if block.settings.richtext != blank -%}
                    <div class="rte">{{ block.settings.richtext }}</div>
                  {%- endif -%}
                {%- endif -%}

                {%- if block.settings.custom_liquid != blank -%}
                  <div class="rte">{{ block.settings.custom_liquid }}</div>
                {%- endif -%}
              </div>
            </div>

          {%- else -%}
            {%- assign collection = block.settings.collection -%}
            <div
              class="tabs__content"
              id="pdt-panel-{{ block.id }}"
              data-pdt-panel="{{ block.id }}"
              role="tabpanel"
              {% unless forloop.first %}hidden{% endunless %}
            >
              <grid-list class="block{% if enable_swipe_mobile %} swipe-mobile swipe-mobile--{{ section.settings.columns_mobile }}-cols{% endif %}">
                <div class="products-list f-grid f-grid-{{ columns_mobile }}-cols md:f-grid-{{ columns_tablet }}-cols lg:f-grid-{{ columns_desktop }}-cols f-grid--gap-{{ section.settings.column_gap }} f-grid--row-gap-{{ section.settings.row_gap }}{% if enable_swipe_mobile %} swipe-mobile__inner{% endif %}">
                  {%- if collection != blank -%}
                    {%- for product in collection.products limit: limit -%}
                      <div class="f-column">
                        {%- if is_metro -%}
                          {%- render 'card-product-metro',
                            product: product,
                            image_sizes: image_sizes,
                            image_ratio: section.settings.pcard_image_ratio,
                            quick_view_suffix: block.id,
                            section_index: section.index,
                            index: forloop.index,
                            index0: forloop.index0,
                            columns_desktop: columns_desktop,
                            columns_tablet: columns_tablet,
                            columns_mobile: columns_mobile
                          -%}
                        {%- else -%}
                          {%- render 'card-product',
                            product: product,
                            image_sizes: image_sizes,
                            image_ratio: section.settings.pcard_image_ratio,
                            quick_view_suffix: block.id,
                            section_index: section.index,
                            index: forloop.index
                          -%}
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  {%- else -%}
                    {%- for i in (1..limit) -%}
                      <div class="f-column">
                        {% render 'card-product-placeholder', image_ratio: section.settings.pcard_image_ratio %}
                      </div>
                    {%- endfor -%}
                  {%- endif -%}
                </div>
              </grid-list>
            </div>
          {%- endif -%}

        {%- endfor -%}
      </div>
    </div>

    <script>
    (function() {
      var sid = '{{ section.id }}';

      function initTabs() {
        var wrap   = document.getElementById('pdt-' + sid);
        if (!wrap) return;

        var btns   = Array.from(wrap.querySelectorAll('[data-pdt-tab]'));
        var panels = Array.from(wrap.querySelectorAll('[data-pdt-panel]'));
        if (!btns.length) return;

        function activate(id) {
          btns.forEach(function(b) {
            var active = b.getAttribute('data-pdt-tab') === id;
            b.setAttribute('aria-selected', active ? 'true' : 'false');
            b.setAttribute('tabindex',      active ? '0'    : '-1');
          });
          panels.forEach(function(p) {
            if (p.getAttribute('data-pdt-panel') === id) {
              p.removeAttribute('hidden');
            } else {
              p.setAttribute('hidden', '');
            }
          });
        }

        btns.forEach(function(btn, idx) {
          btn.addEventListener('click', function() {
            activate(btn.getAttribute('data-pdt-tab'));
          });
          btn.addEventListener('keydown', function(e) {
            var next = {
              ArrowRight: btns[idx + 1] ? btns[idx + 1].getAttribute('data-pdt-tab') : btns[0].getAttribute('data-pdt-tab'),
              ArrowLeft:  btns[idx - 1] ? btns[idx - 1].getAttribute('data-pdt-tab') : btns[btns.length - 1].getAttribute('data-pdt-tab'),
              Home:       btns[0].getAttribute('data-pdt-tab'),
              End:        btns[btns.length - 1].getAttribute('data-pdt-tab')
            };
            if (!(e.key in next)) return;
            e.preventDefault();
            activate(next[e.key]);
            wrap.querySelector('[data-pdt-tab="' + next[e.key] + '"]').focus();
          });
        });

        /* Activate first tab on init */
        activate(btns[0].getAttribute('data-pdt-tab'));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTabs);
      } else {
        initTabs();
      }

      document.addEventListener('shopify:section:load', function(e) {
        if (e.detail && e.detail.sectionId === sid) initTabs();
      });
      document.addEventListener('shopify:block:select', function(e) {
        if (e.detail && e.detail.sectionId === sid) {
          var blockId = e.detail.blockId;
          var btn = document.querySelector('[data-pdt-tab="' + blockId + '"]');
          if (btn) btn.click();
        }
      });
    })();
    </script>

    {%- if section.settings.button_label != blank -%}
      <div class="section__footer flex items-center justify-center{% if show_all_button_on_top %} md:hidden{% endif %}">
        <a
          class="btn {{ section.settings.button_style }}"
          {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}aria-disabled="true"{% endif %}
        >{{- section.settings.button_label -}}</a>
      </div>
    {%- endif -%}

  {%- endif -%}
</div>

{% schema %}
