<section class="pf-how">
  <div class="pf-section">
    {%- if section.settings.eyebrow != blank -%}
      <div class="eyebrow"><span class="cmyk"><i></i><i></i><i></i><i></i></span> {{ section.settings.eyebrow }}</div>
    {%- endif -%}
    <div class="pf-section-head">
      {%- if section.settings.heading != blank -%}
        <h2 class="pf-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    <div class="pf-how-grid">
      {%- for block in section.blocks -%}
        {%- assign step_n = forloop.index | prepend: '0' | slice: -2, 2 -%}
        <div class="pf-step" {{ block.shopify_attributes }}>
          <span class="pf-step-ghost" aria-hidden="true">{{ step_n }}</span>
          {%- if block.settings.step_label != blank -%}
            <span class="n">{{ block.settings.step_label }}</span>
          {%- endif -%}
          <h4>{{ block.settings.title }}</h4>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.pf-how { background: var(--greige); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.pf-how-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  gap: 16px;
}
.pf-step {
  --pf-accent: var(--ink, #141C33);
  --pf-accent-text: var(--magenta, #E5097F);
  position: relative;
  overflow: hidden;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: clamp(22px, 2.1vw, 30px) clamp(20px, 1.9vw, 26px);
  transition: transform .3s cubic-bezier(.22,.68,.32,1), border-color .3s ease, box-shadow .3s ease;
}
/* CMYK ribbon — one accent per step, mirroring the eyebrow swatches */
.pf-step:nth-child(4n+1) { --pf-accent: var(--cyan, #00B4D8); }
.pf-step:nth-child(4n+2) { --pf-accent: var(--magenta, #E5097F); }
.pf-step:nth-child(4n+3) { --pf-accent: var(--yellow, #F5B301); }
.pf-step:nth-child(4n+4) { --pf-accent: var(--ink, #141C33); }
/* darkened accent keeps the mono label readable on white for every hue */
@supports (color: color-mix(in srgb, red, blue)) {
  .pf-step { --pf-accent-text: color-mix(in srgb, var(--pf-accent) 72%, #0B1220); }
}
.pf-step::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 3px;
  background: var(--pf-accent);
  transform: scaleX(.32);
  transform-origin: left center;
  transition: transform .38s cubic-bezier(.22,.68,.32,1);
}
.pf-step-ghost {
  position: absolute;
  top: 2px;
  right: 14px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: clamp(44px, 4.6vw, 58px);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -.05em;
  color: var(--pf-accent);
  opacity: .11;
  pointer-events: none;
  transition: opacity .3s ease, transform .3s ease;
}
.pf-step .n {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 12px;
  color: var(--pf-accent-text);
  font-weight: 600;
  letter-spacing: .1em;
  margin-bottom: 12px;
}
.pf-step .n::before { content: ""; width: 7px; height: 7px; border-radius: 1px; background: var(--pf-accent); }
.pf-step h4 { position: relative; font-size: clamp(16px, 1.1vw, 17.5px); font-weight: 800; line-height: 1.3; color: var(--ink); margin-bottom: 8px; text-wrap: balance; }
.pf-step p { position: relative; font-size: 13.5px; line-height: 1.65; color: var(--muted); }
@media (hover: hover) and (pointer: fine) {
  .pf-step:hover { transform: translateY(-5px); border-color: var(--pf-accent); box-shadow: 0 16px 32px -16px rgba(11,18,32,.32); }
  .pf-step:hover::before { transform: scaleX(1); }
  .pf-step:hover .pf-step-ghost { opacity: .2; transform: translateY(-3px); }
}
@media (max-width: 1000px) { .pf-how-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 560px) { .pf-how-grid { grid-template-columns: minmax(0, 1fr); gap: 12px; } }
@media (prefers-reduced-motion: reduce) {
  .pf-step, .pf-step::before, .pf-step-ghost { transition: none; }
  .pf-step:hover, .pf-step:hover .pf-step-ghost { transform: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "PF How it works",
  "tag": "section",
  "class": "pf-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HOW IT WORKS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From swatch to shipped in four steps" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "step_label", "label": "Step label", "default": "STEP 01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Choose your fabric" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Browse 50 fabrics by material or by what you're making. Not sure? Order free swatches or use the Fabric Finder." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "PF How it works",
      "blocks": [
        { "type": "step", "settings": { "step_label": "STEP 01", "title": "Choose your fabric", "text": "Browse 50 fabrics by material or by what you're making. Not sure? Order free swatches or use the Fabric Finder." } },
        { "type": "step", "settings": { "step_label": "STEP 02", "title": "Enter your exact size", "text": "Type your width and height — any dimension, metric or imperial. Custom shapes and contour cutting supported." } },
        { "type": "step", "settings": { "step_label": "STEP 03", "title": "Upload artwork", "text": "Send your print file, or use our free design service. You approve a proof before anything goes to press." } },
        { "type": "step", "settings": { "step_label": "STEP 04", "title": "We print & ship", "text": "Dye-sublimation or UV printing, finished with hems, eyelets or pole pockets. Shipped worldwide in 3–6 days." } }
      ]
    }
  ]
}
{% endschema %}
