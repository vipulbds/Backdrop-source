{
  "name": "PF Product main",
  "tag": "section",
  "class": "pf-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading (blank = product title)" },
    { "type": "textarea", "id": "badges", "label": "Badges fallback (used only if product has no fabric.gsm metafield)", "default": "260 GSM\nINDOOR + SHELTERED OUTDOOR\nB1 FLAME RETARDANT\nMACHINE WASHABLE\nDYE-SUBLIMATION" },
    { "type": "header", "content": "Pricing" },
    { "type": "text", "id": "rate_per_sqft", "label": "Rate per sq ft (fallback; metafield custom.price_per_sqft overrides)", "default": "3.90" },
    { "type": "text", "id": "price_note", "label": "Price note", "default": "per sq ft onwards" },
    { "type": "checkbox", "id": "pf_use_cart_transform", "label": "Use Cart Transform pricing", "info": "Turn ON only AFTER the cart-transform function app is deployed. Off = legacy $1 × dollars. On = Qty 1 + hidden _price for the function to set the line price.", "default": false },
    { "type": "text", "id": "rating_text", "label": "Rating text" },
    { "type": "header", "content": "Gallery (used when the product has no images)" },
    {
      "type": "select", "id": "texture", "label": "Fallback texture", "default": "tex-weave",
      "options": [
        { "value": "tex-weave", "label": "Weave" },
        { "value": "tex-mesh", "label": "Mesh" },
        { "value": "tex-mesh-heavy", "label": "Mesh heavy" },
        { "value": "tex-satin", "label": "Satin" },
        { "value": "tex-canvas", "label": "Canvas" },
        { "value": "tex-blockout", "label": "Blockout" },
        { "value": "tex-stretch", "label": "Stretch" },
